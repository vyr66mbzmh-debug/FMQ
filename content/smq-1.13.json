[{"id":"smq-year1-1.13-q1","number":1,"question":"<p>Simplify the following as far as possible:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{(x+4)(x+3)}{x+3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2+11x+30}{x+5}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2+5x}{x^2+7x+10}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2+2x-35}{x^2+4x-21}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2x^2+x-1}{2x^2+15x-8}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{3x^2+7x+4}{9x^2-16}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2x^2+9x+4}{4x^3-8x^2-5x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2x^2+17x+30}{2x^3+11x^2+15x}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x+4)(x+3)}{x+3}=x+4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x+5)(x+6)}{x+5}=x+6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x(x+5)}{(x+2)(x+5)}=\\frac x{x+2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x+7)(x-5)}{(x+7)(x-3)}=\\frac{x-5}{x-3}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x+1)(2x-1)}{(2x-1)(x+8)}=\\frac{x+1}{x+8}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(3x+4)(x+1)}{(3x-4)(3x+4)}=\\frac{x+1}{3x-4}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(2x+1)(x+4)}{x(2x+1)(2x-5)}=\\frac{x+4}{x(2x-5)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(2x+5)(x+6)}{x(2x^2+11x+15)}=\\frac{(2x+5)(x+6)}{x(2x+5)(x+3)}=\\frac{x+6}{x(x+3)}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.13-q2","number":2,"question":"<p>Write as a single fully simplified fraction:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac1x+\\frac3{2x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{x^2}+\\frac1x+\\frac35\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1x+\\frac1{x+1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{x+2}+\\frac2{x+4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac3{x+1}-\\frac1{x-3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac5{x+2}+\\frac7{2x-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac3{2(x+5)}+\\frac1{4(x-3)}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac x{x^2-4}+\\frac5{x+2}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x+\\frac3{2x}=\\frac2{2x}+\\frac3{2x}=\\frac5{2x}=\\frac5{2x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{x^2}+\\frac1x+\\frac35=\\frac5{5x^2}+\\frac{5x}{5x^2}+\\frac{3x^2}{5x^2}=\\frac{3x^2+5x+5}{5x^2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x+\\frac1{x+1}=\\frac{x+1}{x(x+1)}+\\frac x{x(x+1)}=\\frac{2x+1}{x(x+1)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{x+2}+\\frac2{x+4}=\\frac{x+4}{(x+2)(x+4)}+\\frac{2(x+2)}{(x+2)(x+4)}=\\frac{x+4+2x+4}{(x+2)(x+4)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{3x+8}{(x+2)(x+4)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac3{x+1}-\\frac1{x-3}=\\frac{3(x-3)}{(x+1)(x-3)}-\\frac{x+1}{(x+1)(x-3)}=\\frac{3x-9-(x+1)}{(x+1)(x-3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{2x-10}{(x+1)(x-3)}=\\frac{2(x-5)}{(x+1)(x-3)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac5{x+2}+\\frac7{2x-1}=\\frac{5(2x-1)}{(2x-1)(x+2)}+\\frac{7(x+2)}{(2x-1)(x+2)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{5(2x-1)+7(x+2)}{(2x-1)(x+2)}=\\frac{10x-5+7x+14}{(2x-1)(x+2)}=\\frac{17x+9}{(2x-1)(x+2)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\frac3{2(x+5)}+\\frac1{4(x-3)}=\\frac{6(x-3)}{4(x+5)(x-3)}+\\frac{x+5}{4(x+5)(x-3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\frac{6x-18+x+5}{4(x+5)(x-3)}=\\frac{7x-13}{4(x+5)(x-3)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac x{x^2-4}+\\frac5{x+2}&amp;=\\frac x{(x+2)(x-2)}+\\frac{5(x-2)}{(x+2)(x-2)}\\\\&amp;=\\frac{x+5x-10}{(x+2)(x-2)}=\\frac{6x-10}{(x+2)(x-2)}=\\frac{2(3x-5)}{(x+2)(x-2)}\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.13-q3","number":3,"question":"<p>Simplify and fully factorise the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2-5x+4}{x^2-x}\\times\\frac{2x+3}{5x-20}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x-3}{3x^2-6x}\\times\\frac{3x^2-12}{x^2-9}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{16x^2-4}{3x-1}\\times\\frac{3x^2+14x-5}{4x+2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x+2}{x+3}\\div\\frac{x^2+3x+2}{2x^2-2x-12}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x-1)(x-4)}{x(x-1)}\\times\\frac{2x+3}{5(x-4)}=\\frac{2x+3}{5x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x-3}{3x(x-2)}\\times\\frac{3(x^2-4)}{(x-3)(x+3)}=\\frac1{x(x-2)}\\times\\frac{(x-2)(x+2)}{x+3}=\\frac{x+2}{x(x+3)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{4(x^2-1)}{3x-1}\\times\\frac{(3x-1)(x+5)}{2(x+1)}=\\frac{4(x+1)(x-1)}1\\times\\frac{x+5}{2(x+1)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{2(x-1)}1\\times\\frac{x+5}1=2(x-1)(x+5)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac{x+2}{x+3}\\div\\frac{(x+2)(x+1)}{2(x^2-x-6)}&amp;=\\frac{x+2}{x+3}\\div\\frac{(x+2)(x+1)}{2(x-3)(x+2)}\\\\&amp;=\\frac{x+2}{x+3}\\times\\frac{2(x-3)(x+2)}{(x+2)(x+1)}\\\\&amp;=\\frac{x+2}{x+3}\\times\\frac{2(x-3)}{x+1}=\\frac{2(x-3)(x+2)}{(x+3)(x+1)}\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.13-q4","number":4,"question":"<p>Fully simplify the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{\\frac1x}{\\frac1{x+1}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\frac1{x-2}}{\\frac1{2x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\frac1{x+3}+\\frac1{x-5}}{\\frac{x-5}{x+3}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\frac1{x+4}+\\frac1{x-1}}{\\frac{x+2}{x-1}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{(3x+1)(5x-1)+4(5x-1)}{\\frac{5x-1}{3x+1}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x\\times\\frac{x+1}1=\\frac{x+1}x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{x-2}\\times\\frac{2x}1=\\frac{2x}{x-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{1+\\frac{x+3}{x-5}}{x-5}=\\frac{x-5+x+3}{(x-5)^2}=\\frac{2x-2}{(x-5)^2}=\\frac{2(x-1)}{(x-5)^2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{\\frac{x-1}{x+4}+1}{x+2}=\\frac{x-1+(x+4)}{(x+2)(x+4)}=\\frac{2x+3}{(x+2)(x+4)}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(3x+1)^2(5x-1)+4(5x-1)(3x+1)}{5x-1}=\\frac{(3x+1)^2+4(3x+1)}1\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=9x^2+6x+1+12x+4=9x^2+18x+5\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=(3x+5)(3x+1)\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.13-q5","number":5,"question":"<p>Prove each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac3{x+2}+\\frac{x-2}{(x+2)(x+3)}\\equiv\\frac{4x+7}{(x+2)(x+3)}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2x^2-x-1}{x^2-1}-\\frac1{x^2+x}\\equiv\\frac{2x-1}x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"1-\\frac1{x-3}+\\frac2{x^2-9}\\equiv\\frac{x^2-x-10}{(x-3)(x+3)}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{9-4x}{2(x-1)}+\\frac1{x+3}+2\\equiv\\frac{7x+13}{2(x-1)(x+3)}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac3{x+2}+\\frac{x-2}{(x+2)(x+3)}=\\frac{3(x+3)}{(x+2)(x+3)}+\\frac{x-2}{(x+2)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{3(x+3)+x-2}{(x+2)(x+3)}=\\frac{3x+9+x-2}{(x+2)(x+3)}=\\frac{4x+7}{(x+2)(x+3)}\" data-display=\"false\"></span> as req.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(2x+1)(x-1)}{(x+1)(x-1)}-\\frac1{x(x+1)}=\\frac{x(2x+1)}{x(x+1)}-\\frac1{x(x+1)}=\\frac{2x^2+x-1}{x(x+1)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{(2x-1)(x+1)}{x(x+1)}=\\frac{2x-1}x\" data-display=\"false\"></span> as req.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(x-3)(x+3)}{(x-3)(x+3)}-\\frac{x+3}{(x-3)(x+3)}+\\frac2{(x-3)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{(x-3)(x+3)-(x+3)+2}{(x-3)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{x^2-9-x-3+2}{(x-3)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{x^2-x-10}{2(x-1)(x+3)}\" data-display=\"false\"></span> as req.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(9-4x)(x+3)}{2(x-1)(x+3)}+\\frac{2(x-1)}{2(x-1)(x+3)}+\\frac{4(x-1)(x+3)}{2(x-1)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{(9-4x)(x+3)+2(x-1)+4(x-1)(x+3)}{2(x-1)(x+3)}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=\\frac{-4x^2-3x+27+2x-2+4x^2+8x-12}{2(x-1)(x+3)}=\\frac{7x+13}{2(x-1)(x+3)}\" data-display=\"false\"></span> as req.</p>"]}]