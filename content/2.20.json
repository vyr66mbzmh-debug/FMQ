[{"id":"fm-core2-2.20-q1","number":1,"question":"<p><strong>The following questions in this section require the use of reversing the Chain Rule and Reciprocal Hyperbolic Functions.</strong></p><p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sinh x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosh x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sech^2x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sinh3x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosh\\frac{x}{2}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sech^2 9x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int\\sinh x\\,dx=\\cosh x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\cosh x\\,dx=\\sinh x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\int\\sech^2x\\,dx=\\tanh x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int\\sinh3x\\,dx=\\frac13\\cosh3x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\n\\int\\cosh\\frac{x}{2}\\,dx=2\\sinh\\frac{x}{2}+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\n\\int\\sech^2 9x\\,dx=\\frac19\\tanh9x+c\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q2","number":2,"question":"<p>Evaluate the following definite integral:</p><span class=\"equation\" data-math=\"\n\\int_{\\ln2}^{\\ln3}\\sinh x\\,dx\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_{\\ln2}^{\\ln3}\\sinh x\\,dx\n =[\\cosh x]_{\\ln2}^{\\ln3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\cosh(\\ln3)-\\cosh(\\ln2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{e^{\\ln3}+e^{-\\ln3}}2-\\frac{e^{\\ln2}+e^{-\\ln2}}2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{3+\\frac13}{2}-\\frac{2+\\frac12}{2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac53-\\frac54=\\frac5{12}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q3","number":3,"question":"<p>Evaluate the following definite integral:</p><span class=\"equation\" data-math=\"\n\\int_{\\ln3}^{\\ln4}\\cosh2x\\,dx\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_{\\ln3}^{\\ln4}\\cosh2x\\,dx\n =\\left[\\frac12\\sinh2x\\right]_{\\ln3}^{\\ln4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\sinh(2\\ln4)-\\frac12\\sinh(2\\ln3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\sinh(\\ln16)-\\frac12\\sinh(\\ln9)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{16-1/16}{4}-\\frac{9-1/9}{4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{255}{64}-\\frac{20}{9}=\\frac{1015}{576}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q4","number":4,"question":"<p>Evaluate the following definite integral:</p><span class=\"equation\" data-math=\"\n\\int_0^{\\ln2}(15\\cosh3x-9\\sinh3x)\\,dx\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^{\\ln2}(15\\cosh3x-9\\sinh3x)\\,dx\n =[5\\sinh3x-3\\cosh3x]_0^{\\ln2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =5\\sinh(3\\ln2)-3\\cosh(3\\ln2)-(5\\sinh0-3\\cosh0)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =5\\sinh(\\ln8)-3\\cosh(\\ln8)+3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =5\\frac{8-1/8}{2}-3\\frac{8+1/8}{2}+3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{315}{16}-\\frac{195}{16}+3=\\frac{21}{2}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q5","number":5,"question":"<p>The diagram below shows the curve <span class=\"inline-math\" data-math=\"y=\\sech^2x\" data-display=\"false\"></span>. Show that the exact shaded area is <span class=\"inline-math\" data-math=\"\\frac65\" data-display=\"false\"></span>.</p><figure class=\"diagram\"><img src=\"assets/2.20/questions/assets/diagrams/220q5.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n\\int_{-\\ln2}^{\\ln2}\\sech^2x\\,dx\n =[\\tanh x]_{-\\ln2}^{\\ln2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\tanh(\\ln2)-\\tanh(-\\ln2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{2-1/2}{2+1/2}-\\frac{1/2-2}{1/2+2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac35-\\left(-\\frac35\\right)=\\frac65.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q6","number":6,"question":"<p>Find the exact value of:</p><span class=\"equation\" data-math=\"\n\\lim_{\\delta x\\to0}\\sum_{x=0}^{\\ln2}(8\\cosh4x-5\\sinh3x)\\,\\delta x\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\lim_{\\delta x\\to0}\\sum_{x=0}^{\\ln2}(8\\cosh4x-5\\sinh3x)\\,\\delta x\n =\\int_0^{\\ln2}(8\\cosh4x-5\\sinh3x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\left[2\\sinh4x-\\frac53\\cosh3x\\right]_0^{\\ln2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2\\sinh(4\\ln2)-\\frac53\\cosh(3\\ln2)+\\frac53\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2\\sinh(\\ln16)-\\frac53\\cosh(\\ln8)+\\frac53\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =16-\\frac1{16}-\\frac56\\left(8+\\frac18\\right)+\\frac53\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{65}{6}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q7","number":7,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"f(x)=6\\sinh3x+15\\cosh3x\" data-display=\"false\"></span>. Find the exact positive value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> for which the region between the curve <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span>, the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis, the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis, and the line <span class=\"inline-math\" data-math=\"x=k\" data-display=\"false\"></span> is 8. <strong>Prerequisite knowledge for Q8: Integration of Reciprocal Trigonometric Functions</strong></p>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^k(6\\sinh3x+15\\cosh3x)\\,dx =8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n[2\\cosh3x+5\\sinh3x]_0^k =8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2\\cosh3k+5\\sinh3k-2 =8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2e^{3k}+2e^{-3k}+5e^{3k}-5e^{-3k}-4 =16\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n7e^{3k}-3e^{-3k}-20 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n7e^{6k}-20e^{3k}-3 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(7e^{3k}+1)(e^{3k}-3) =0.\n\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"e^{3k}&gt;0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"e^{3k}=-\\frac17\" data-display=\"false\"></span> is impossible. Thus <span class=\"inline-math\" data-math=\"e^{3k}=3\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"3k=\\ln3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\displaystyle k=\\frac13\\ln3\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.20-q8","number":8,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\int_{-\\pi/4}^{\\pi/4}(\\sec^2x-\\sech^2x)\\,dx&gt;\\frac4{1+e^\\pi}.\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_{-\\pi/4}^{\\pi/4}(\\sec^2x-\\sech^2x)\\,dx\n =[\\tan x-\\tanh x]_{-\\pi/4}^{\\pi/4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\left(1-\\frac{e^{\\pi/4}-e^{-\\pi/4}}{e^{\\pi/4}+e^{-\\pi/4}}\\right)\n-\\left(-1-\\frac{e^{-\\pi/4}-e^{\\pi/4}}{e^{-\\pi/4}+e^{\\pi/4}}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2+\\frac{2e^{-\\pi/4}-2e^{\\pi/4}}{e^{\\pi/4}+e^{-\\pi/4}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{4e^{-\\pi/4}}{e^{\\pi/4}+e^{-\\pi/4}}=\\frac4{e^{\\pi/2}+1}.\n\" data-display=\"true\"></span>","<p>As <span class=\"inline-math\" data-math=\"e^\\pi+1&gt;e^{\\pi/2}+1\" data-display=\"false\"></span>, we have <span class=\"inline-math\" data-math=\"\\displaystyle\\frac4{e^{\\pi/2}+1}&gt;\\frac4{e^\\pi+1}\" data-display=\"false\"></span>. Hence the required inequality follows.</p>"]},{"id":"fm-core2-2.20-q9","number":9,"question":"<p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sinh(2x+5)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int8\\cosh(3-4x)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int2x\\sech^2x^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int x\\sinh(3x^2-2)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\frac{\\cosh\\sqrt{x}}{2\\sqrt{x}}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\frac{\\sech^2(3/x^2)}{4x^3}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int\\sinh(2x+5)\\,dx=\\frac12\\cosh(2x+5)+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int8\\cosh(3-4x)\\,dx=-2\\sinh(3-4x)+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\int2x\\sech^2x^2\\,dx=\\tanh x^2+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int x\\sinh(3x^2-2)\\,dx=\\frac16\\cosh(3x^2-2)+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\n\\int\\frac{\\cosh\\sqrt{x}}{2\\sqrt{x}}\\,dx\n =\\int\\frac12x^{-1/2}\\cosh x^{1/2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\sinh\\sqrt{x}+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\n\\int\\frac{\\sech^2(3/x^2)}{4x^3}\\,dx\n =\\int\\frac14x^{-3}\\sech^2(3x^{-2})\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{24}\\tanh\\left(\\frac3{x^2}\\right)+c.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q10","number":10,"question":"<p>Evaluate the following definite integral:</p><span class=\"equation\" data-math=\"\n\\int_0^{\\ln2}\\sinh\\left(\\frac{3x+\\ln4}{2}\\right)\\,dx\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^{\\ln2}\\sinh\\left(\\frac{3x+\\ln4}{2}\\right)\\,dx\n =\\left[\\frac23\\cosh\\left(\\frac{3x+\\ln4}{2}\\right)\\right]_0^{\\ln3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac23\\cosh\\left(\\frac{3\\ln2+\\ln4}{2}\\right)-\\frac23\\cosh\\left(\\frac{\\ln4}{2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac23\\cosh\\left(\\frac12\\ln32\\right)-\\frac23\\cosh(\\ln2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac23\\cosh(\\ln(4\\sqrt2))-\\frac23\\cosh(\\ln2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac13\\left(4\\sqrt2+\\frac1{4\\sqrt2}\\right)-\\frac13\\left(2+\\frac12\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{11\\sqrt2}{8}-\\frac56.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q11","number":11,"question":"<p>Evaluate the following definite integral:</p><span class=\"equation\" data-math=\"\n\\int_0^{\\sqrt{\\ln2}}256x\\cosh(4x^2)\\,dx\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^{\\sqrt{\\ln2}}256x\\cosh(4x^2)\\,dx\n =[32\\sinh(4x^2)]_0^{\\sqrt{\\ln2}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =32\\sinh(4\\ln2)=32\\sinh(\\ln16)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =16\\left(16-\\frac1{16}\\right)=255.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q12","number":12,"question":"<p>Show that:</p><span class=\"equation\" data-math=\"\n\\int_0^{\\pi/2}\\cos x\\sinh(\\sin x)\\,dx=\\frac{(e-1)^2}{2e}.\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^{\\pi/2}\\cos x\\sinh(\\sin x)\\,dx\n =[\\cosh(\\sin x)]_0^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\cosh1-\\cosh0=\\frac{e+e^{-1}}2-1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{e^2-2e+1}{2e}=\\frac{(e-1)^2}{2e}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q13","number":13,"question":"<p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\tanh x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\coth x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int\\tanh x\\,dx=\\int\\frac{\\sinh x}{\\cosh x}\\,dx=\\ln|\\cosh x|+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\coth x\\,dx=\\int\\frac{\\cosh x}{\\sinh x}\\,dx=\\ln|\\sinh x|+c\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q14","number":14,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\int_{\\ln2}^{\\ln4}(2\\tanh2x+2\\coth2x)\\,dx=\\ln\\left(\\frac pq\\right),\n\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> are integers and <span class=\"inline-math\" data-math=\"\\frac pq\" data-display=\"false\"></span> is in its simplest form.</p>","steps":["<span class=\"equation\" data-math=\"\n\\int_{\\ln2}^{\\ln4}(2\\tanh2x+2\\coth2x)\\,dx\n =[\\ln|\\cosh2x|+\\ln|\\sinh2x|]_{\\ln2}^{\\ln4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\left(\\ln\\frac{16+1/16}{2}+\\ln\\frac{16-1/16}{2}\\right)\n-\\left(\\ln\\frac{4+1/4}{2}+\\ln\\frac{4-1/4}{2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\ln\\frac{257}{32}+\\ln\\frac{255}{32}-\\ln\\frac{17}{8}-\\ln\\frac{15}{8}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\ln\\frac{257}{16}.\n\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"p=257\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q=16\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.20-q15","number":15,"question":"<ol class=\"parts\" start=\"1\"><li><p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\frac{d}{dx}(\\cosech x)\" data-display=\"false\"></span>.</p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosech x\\coth x\\,dx\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\cosech x) =\\frac{d}{dx}((\\sinh x)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\cosh x(\\sinh x)^{-2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{\\cosh x}{\\sinh^2x}=-\\frac1{\\sinh x}\\frac{\\cosh x}{\\sinh x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\cosech x\\coth x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\cosech x\\coth x\\,dx=-\\cosech x+c\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q16","number":16,"question":"<ol class=\"parts\" start=\"1\"><li><p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\frac{d}{dx}(\\sech x)\" data-display=\"false\"></span>.</p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sech x\\tanh x\\,dx\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\sech x) =\\frac{d}{dx}((\\cosh x)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\sinh x(\\cosh x)^{-2}=-\\sech x\\tanh x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\sech x\\tanh x\\,dx=-\\sech x+c\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q17","number":17,"question":"<ol class=\"parts\" start=\"1\"><li><p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\frac{d}{dx}(\\coth x)\" data-display=\"false\"></span>.</p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosech^2x\\,dx\" data-display=\"false\"></span>.</p></li></ol><p><strong>The following questions in this section require the use of Integration by Substitution, Integration by Parts, Hyperbolic Double Angle Formulae and Partial Fractions.</strong></p>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\coth x) =\\frac{d}{dx}((\\tanh x)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\sech^2x(\\tanh x)^{-2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{1}{\\cosh^2x}\\frac{\\cosh^2x}{\\sinh^2x}=-\\frac1{\\sinh^2x}=-\\cosech^2x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\cosech^2x\\,dx=-\\coth x+c\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q18","number":18,"question":"<p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int x\\sinh3x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int x^2\\cosh\\frac{x}{4}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Use Integration by Parts:</p>","<span class=\"equation\" data-math=\"\nu=x,\\quad \\frac{dv}{dx}=\\sinh3x,\\quad \\frac{du}{dx}=1,\\quad v=\\frac13\\cosh3x.\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int x\\sinh3x\\,dx =\\frac13x\\cosh3x-\\int\\frac13\\cosh3x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac13x\\cosh3x-\\frac19\\sinh3x+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>Use Integration by Parts:</p>","<span class=\"equation\" data-math=\"\nu=x^2,\\quad \\frac{dv}{dx}=\\cosh\\frac{x}{4},\\quad \\frac{du}{dx}=2x,\\quad v=4\\sinh\\frac{x}{4}.\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int x^2\\cosh\\frac{x}{4}\\,dx =4x^2\\sinh\\frac{x}{4}-\\int8x\\sinh\\frac{x}{4}\\,dx.\n\" data-display=\"true\"></span>","<p>Use Integration by Parts again with <span class=\"inline-math\" data-math=\"u=8x\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"dv/dx=\\sinh(x/4)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"du/dx=8\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"v=4\\cosh(x/4)\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n\\int x^2\\cosh\\frac{x}{4}\\,dx\n =4x^2\\sinh\\frac{x}{4}-\\left(32x\\cosh\\frac{x}{4}-\\int32\\cosh\\frac{x}{4}\\,dx\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =4x^2\\sinh\\frac{x}{4}-32x\\cosh\\frac{x}{4}+128\\sinh\\frac{x}{4}+c.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q19","number":19,"question":"<p>The curve has gradient function</p><span class=\"equation\" data-math=\"\n\\frac{dy}{dx}=9(x+2)\\sinh3x\n\" data-display=\"true\"></span><p>and passes through the point <span class=\"inline-math\" data-math=\"(0,8)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form</p><span class=\"equation\" data-math=\"\ny=(ax+b)\\cosh3x-\\sinh3x+c,\n\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers.</p>","steps":["<p>Use Integration by Parts with <span class=\"inline-math\" data-math=\"u=9(x+2)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"dv/dx=\\sinh3x\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"du/dx=9\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"v=\\frac13\\cosh3x\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\ny =3(x+2)\\cosh3x-\\int3\\cosh3x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =3(x+2)\\cosh3x-\\sinh3x+c.\n\" data-display=\"true\"></span>","<p>The curve passes through <span class=\"inline-math\" data-math=\"(0,8)\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n8=3(0+2)\\cosh0-\\sinh0+c=6+c,\n\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"c=2\" data-display=\"false\"></span>. Therefore</p>","<span class=\"equation\" data-math=\"\ny=(3x+6)\\cosh3x-\\sinh3x+2.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q20","number":20,"question":"<p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int e^x\\sinh x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int e^{2x}\\cosh x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int e^{3x}\\sinh2x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int e^{-4x}\\cosh4x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int e^x\\sinh x\\,dx =\\int e^x\\frac{e^x-e^{-x}}2\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\int(e^{2x}-1)\\,dx=\\frac14e^{2x}-\\frac12x+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int e^{2x}\\cosh x\\,dx =\\int e^{2x}\\frac{e^x+e^{-x}}2\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\int(e^{3x}+e^x)\\,dx=\\frac16e^{3x}+\\frac12e^x+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\int e^{3x}\\sinh2x\\,dx =\\int e^{3x}\\frac{e^{2x}-e^{-2x}}2\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\int(e^{5x}-e^x)\\,dx=\\frac1{10}e^{5x}-\\frac12e^x+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int e^{-4x}\\cosh4x\\,dx =\\int e^{-4x}\\frac{e^{4x}+e^{-4x}}2\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\int(1+e^{-8x})\\,dx=\\frac12x-\\frac1{16}e^{-8x}+c.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q21","number":21,"question":"<p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosh^2x\\,dx\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n\\cosh2A \\equiv2\\cosh^2A-1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow\\cosh^2A =\\frac12\\cosh2A+\\frac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\int\\cosh^2x\\,dx =\\int\\left(\\frac12\\cosh2x+\\frac12\\right)dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac14\\sinh2x+\\frac12x+c.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q22","number":22,"question":"<p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sinh^2 6x\\,dx\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n\\cosh2A \\equiv1+2\\sinh^2A\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow\\sinh^2A =\\frac12\\cosh2A-\\frac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\int\\sinh^2 6x\\,dx =\\int\\left(\\frac12\\cosh12x-\\frac12\\right)dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{24}\\sinh12x-\\frac12x+c.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q23","number":23,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\int_{\\ln(5/6)}^{\\ln(6/5)}\\cosh^2\\frac{x}{2}\\,dx=p+\\ln q,\n\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> are positive rational numbers.</p>","steps":["<span class=\"equation\" data-math=\"\n\\cosh2A \\equiv2\\cosh^2A-1,\\qquad \\cosh^2A=\\frac12(\\cosh2A+1),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{\\ln(5/6)}^{\\ln(6/5)}\\cosh^2\\frac{x}{2}\\,dx\n =\\frac12\\int_{\\ln(5/6)}^{\\ln(6/5)}(\\cosh x+1)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12[\\sinh x+x]_{\\ln(5/6)}^{\\ln(6/5)}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\left(\\frac{11}{60}+\\ln\\frac65-\\left(-\\frac{11}{60}+\\ln\\frac56\\right)\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{11}{60}+\\frac12\\ln\\frac{36}{25}=\\frac{11}{60}+\\ln\\frac65.\n\" data-display=\"true\"></span>","<p>Thus <span class=\"inline-math\" data-math=\"p=\\frac{11}{60}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q=\\frac65\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.20-q24","number":24,"question":"<p>The diagram below shows the curve <span class=\"inline-math\" data-math=\"y=4\\cosh^2x-3\\cosh x\" data-display=\"false\"></span>. Show that the exact shaded area is <span class=\"inline-math\" data-math=\"\\frac49+\\ln9\" data-display=\"false\"></span>.</p><figure class=\"diagram\"><img src=\"assets/2.20/questions/assets/diagrams/220q24.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n\\cosh2A \\equiv2\\cosh^2A-1,\\qquad \\cosh^2A=\\frac12(\\cosh2A+1),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^{\\ln3}(4\\cosh^2x-3\\cosh x)\\,dx\n =\\int_0^{\\ln3}(2\\cosh2x+2-3\\cosh x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\sinh2x+2x-3\\sinh x]_0^{\\ln3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\sinh(2\\ln3)+2\\ln3-3\\sinh(\\ln3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac12\\left(9-\\frac19\\right)+\\ln9-\\frac32\\left(3-\\frac13\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{40}{9}+\\ln9-4=\\frac49+\\ln9.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.20-q25","number":25,"question":"<p>Find:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\sinh^3x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\int\\cosh^3x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int\\sinh^3x\\,dx\n =\\int\\sinh^2x\\,\\sinh x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\cosh^2x-1)\\sinh x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac13\\cosh^3x-\\cosh x+c.\n\" data-display=\"true\"></span>","<p>Alternatively,</p>","<span class=\"equation\" data-math=\"\n\\sinh^3x =\\frac18(e^x-e^{-x})^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac18(e^{3x}-3e^x+3e^{-x}-e^{-3x})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac14\\sinh3x-\\frac34\\sinh x,\n\" data-display=\"true\"></span>","<p>so</p>","<span class=\"equation\" data-math=\"\n\\int\\sinh^3x\\,dx=\\frac1{12}\\cosh3x-\\frac34\\cosh x+c.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int\\cosh^3x\\,dx\n =\\int\\cosh^2x\\,\\cosh x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\sinh^2x+1)\\cosh x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac13\\sinh^3x+\\sinh x+c.\n\" data-display=\"true\"></span>","<p>Alternatively,</p>","<span class=\"equation\" data-math=\"\n\\cosh^3x =\\frac18(e^x+e^{-x})^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac18(e^{3x}+3e^x+3e^{-x}+e^{-3x})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac14\\cosh3x+\\frac34\\cosh x,\n\" data-display=\"true\"></span>","<p>so</p>","<span class=\"equation\" data-math=\"\n\\int\\cosh^3x\\,dx=\\frac1{12}\\sinh3x+\\frac34\\sinh x+c.\n\" data-display=\"true\"></span>"]}]