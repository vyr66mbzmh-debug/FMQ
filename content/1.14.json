[{"id":"fm-core1-1.14-q1","number":1,"question":"<p>Find the mean value of each of the following on the given intervals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"f(x)=5x-2\" data-display=\"false\"></span> on the interval <span class=\"inline-math\" data-math=\"[3,8]\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=5x^2\" data-display=\"false\"></span> on the interval <span class=\"inline-math\" data-math=\"[2,5]\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=\\frac1{\\sqrt x}\" data-display=\"false\"></span> on the interval <span class=\"inline-math\" data-math=\"[9,16]\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac1{8-3}\\int_3^8(5x-2)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac15\\left[\\frac52x^2-2x\\right]_3^8=\\frac15\\left[(160-16)-\\left(\\frac{45}2-6\\right)\\right]=\\frac{51}2\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\frac1{5-2}\\int_2^55x^2\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\frac53x^3\\right]_2^5=\\frac13\\left[\\frac{625}3-\\frac{40}3\\right]=65\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\frac1{16-9}\\int_9^{16}\\frac1{\\sqrt x}\\,\\mathrm dx=\\frac17\\int_9^{16}x^{-\\frac12}\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac17\\left[2x^{\\frac12}\\right]_9^{16}=\\frac17[8-6]=\\frac27\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q2","number":2,"question":"<p>Find the mean value of the function</p><span class=\"equation\" data-math=\"f(x)=2x^2-1\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"-0.5\\leq x\\leq1.2\" data-display=\"false\"></span>, giving your answer to 3 significant figures.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{1.2-{-0.5}}\\int_{-0.5}^{1.2}(2x^2-1)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac{10}{17}\\left[\\frac23x^3-x\\right]_{-0.5}^{1.2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac{10}{17}\\left[\\left(\\frac{144}{125}-\\frac65\\right)-\\left(-\\frac1{12}+\\frac12\\right)\\right]=-\\frac{41}{150}=-0.273\\text{ (3 SF)}\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q3","number":3,"question":"<p>Show that the mean value of</p><span class=\"equation\" data-math=\"f(x)=x^2\" data-display=\"true\"></span><p>on the interval <span class=\"inline-math\" data-math=\"[0,k]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"\\frac13k^2\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{k-0}\\int_0^kx^2\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1k\\left[\\frac13x^3\\right]_0^k=\\frac1k\\left[\\left(\\frac13k^3\\right)-(0)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13k^2\\text{ as req.}\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q4","number":4,"question":"<p>Find the mean value of the function</p><span class=\"equation\" data-math=\"f(x)=8x^3\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"0\\leq x\\leq a\" data-display=\"false\"></span>, giving your answer in terms of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{a-0}\\int_0^a8x^3\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1a[2x^4]_0^a=\\frac1a[2a^4-0]=2a^3\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q5","number":5,"question":"<p>Show that the mean value of</p><span class=\"equation\" data-math=\"f(x)=mx+c\" data-display=\"true\"></span><p>on the interval <span class=\"inline-math\" data-math=\"[a,b]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"m\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are constants and <span class=\"inline-math\" data-math=\"a&lt;b\" data-display=\"false\"></span> is</p><span class=\"equation\" data-math=\"\\frac12m(a+b)+c\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{b-a}\\int_a^b(mx+c)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{b-a}\\left[\\frac12mx^2+cx\\right]_a^b=\\frac1{b-a}\\left[\\left(\\frac12mb^2+bc\\right)-\\left(\\frac12ma^2+ca\\right)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{b-a}\\left[\\frac12m(b^2-a^2)+c(b-a)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{b-a}\\left[\\frac12m(b-a)(b+a)+c(b-a)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12m(b+a)+c\\text{ as req.}\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q6","number":6,"question":"<p>Find the mean value of the function</p><span class=\"equation\" data-math=\"f(x)=(x+4)^2\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"a\\leq x\\leq2a\" data-display=\"false\"></span>, giving your answer in the form <span class=\"inline-math\" data-math=\"pa^2+qa+r\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"r\" data-display=\"false\"></span> are constants to be found.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{2a-a}\\int_a^{2a}(x+4)^2\\,\\mathrm dx=\\frac1a\\int_a^{2a}(x^2+8x+16)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1a\\left[\\frac13x^3+4x^2+16x\\right]_a^{2a}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1a\\left[\\left(\\frac13(2a)^3+4(2a)^2+16(2a)\\right)-\\left(\\frac13a^3+4a^2+16a\\right)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1a\\left(\\frac83a^3+16a^2+32a-\\frac13a^3-4a^2-16a\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac73a^2+12a+16\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q7","number":7,"question":"<p>Find the mean value of the function</p><span class=\"equation\" data-math=\"f(x)=\\frac{1+x}{\\sqrt x}\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"0\\leq x\\leq k\" data-display=\"false\"></span>, giving your answer in the form</p><span class=\"equation\" data-math=\"\\frac p{\\sqrt k}+\\frac{p\\sqrt k}q\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> are constants to be found.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{k-0}\\int_0^k\\frac{1+x}{\\sqrt x}\\,\\mathrm dx=\\frac1k\\int_0^k\\left(x^{-\\frac12}+x^{\\frac12}\\right)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1k\\left[2x^{\\frac12}+\\frac23x^{\\frac32}\\right]_0^k\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1k\\left[\\left(2k^{\\frac12}+\\frac23k^{\\frac32}\\right)-(0)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=2k^{-\\frac12}+\\frac23k^{\\frac12}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac2{\\sqrt k}+\\frac{2\\sqrt k}3\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q8","number":8,"question":"<p>The mean value of the function</p><span class=\"equation\" data-math=\"f(x)=2\\sqrt x+k\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"[1,9]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive constant is <span class=\"inline-math\" data-math=\"\\frac{22}3\" data-display=\"false\"></span></p><p>Find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{9-1}\\int_1^9(2\\sqrt x+k)\\,\\mathrm dx=\\frac18\\int_1^9\\left(2x^{\\frac12}+k\\right)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac18\\left[\\frac43x^{\\frac32}+kx\\right]_1^9\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac18\\left[(36+9k)-\\left(\\frac43+k\\right)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=k+\\frac{13}3\n\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"k+\\frac{13}3=\\frac{22}3\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"k=3\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q9","number":9,"question":"<p>The mean value of the function</p><span class=\"equation\" data-math=\"f(x)=x^2+1\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"[2,5]\" data-display=\"false\"></span> is half the mean value of <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> for the interval <span class=\"inline-math\" data-math=\"[0,k]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive integer. Find the exact value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{5-2}\\int_2^5(x^2+1)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\frac13x^3+x\\right]_2^5\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\left(\\frac{125}3+5\\right)-\\left(\\frac83+2\\right)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=14\n\" data-display=\"true\"></span>","<p>So that <span class=\"inline-math\" data-math=\"\\frac1{k-0}\\int_0^k(x^2+1)\\,\\mathrm dx=28\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\n\\frac1k\\left[\\frac13x^3+x\\right]_0^k=28\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac1k\\left[\\left(\\frac{k^3}3+k\\right)-0\\right]=28\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{k^2}3+1=28\n\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"k=\\pm9\\ \\therefore\" data-display=\"false\"></span> since <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is positive, <span class=\"inline-math\" data-math=\"k=9\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q10","number":10,"question":"<p>The mean value of the function</p><span class=\"equation\" data-math=\"f(x)=3x^2+12x-40\" data-display=\"true\"></span><p>in the interval <span class=\"inline-math\" data-math=\"[0,k]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive constant is 51</p><p>Find the exact value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{k-0}\\int_0^k(3x^2+12x-40)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1k[x^3+6x^2-40x]_0^k\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1k[(k^3+6k^2-40k)-0]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=k^2+6k-40\n\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"k^2+6k-40=51\" data-display=\"false\"></span> then</p>","<span class=\"equation\" data-math=\"k^2+6k-91=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"(k-7)(k+13)=0\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"k=7\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q11","number":11,"question":"<p>The mean value of the function</p><span class=\"equation\" data-math=\"f(x)=ax-4\" data-display=\"true\"></span><p>is <span class=\"inline-math\" data-math=\"-5.5\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"[-2,1]\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p>Determine the value of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span></p></li></ol><p>It is known that <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> also has a mean value of <span class=\"inline-math\" data-math=\"18.5\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"[p,2p]\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"2\"><li><p>Determine the value of <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac1{1+2}\\int_{-2}^1(ax-4)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\frac12ax^2-4x\\right]_{-2}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\left(\\frac12a-4\\right)-(2a+8)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[-\\frac32a-12\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=-\\frac12a-4\n\" data-display=\"true\"></span>","<p>And so <span class=\"inline-math\" data-math=\"-\\frac12a-4=-5.5\\Rightarrow a=3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\frac1{2p-p}\\int_p^{2p}(3x-4)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1p\\left[\\frac32x^2-4x\\right]_p^{2p}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1p\\left[\\left(\\frac32(2p)^2-4(2p)\\right)-\\left(\\frac32p^2-4p\\right)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1p\\left[\\frac92p^2-4p\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac92p-4\n\" data-display=\"true\"></span>","<p>And <span class=\"inline-math\" data-math=\"\\frac92p-4=18.5\\Rightarrow p=5\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q12","number":12,"question":"<p>The velocity of a particle after <span class=\"inline-math\" data-math=\"t\" data-display=\"false\"></span> seconds is given by</p><span class=\"equation\" data-math=\"v=\\frac16\\sqrt t\\left(12-\\frac1t\\right)\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p>Show that the mean velocity for <span class=\"inline-math\" data-math=\"1\\leq t\\leq3\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"2.68\\ \\mathrm{ms}^{-1}\" data-display=\"false\"></span> to 3 significant figures.</p></li><li><p>Calculate the mean acceleration of the particle for the same time period giving your answer to 3 significant figures.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac1{3-1}\\int_1^3\\frac16\\sqrt t\\left(12-\\frac1t\\right)\\,\\mathrm dt=\\frac12\\int_1^3\\left(2t^{\\frac12}-\\frac16t^{-\\frac12}\\right)\\,\\mathrm dt\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[\\frac43t^{\\frac32}-\\frac13t^{\\frac12}\\right]_1^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[\\left(\\frac43\\times3^{\\frac32}-\\frac13\\times3^{\\frac12}\\right)-\\left(\\frac43-\\frac13\\right)\\right]=2.675426\\ldots=2.68\\text{ (3 SF) as req.}\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"v=2t^{\\frac12}-\\frac16t^{-\\frac12}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"a=\\frac{\\mathrm dv}{\\mathrm dt}=t^{-\\frac12}+\\frac1{12}t^{-\\frac32}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac1{3-1}\\int_1^3\\left(t^{-\\frac12}+\\frac1{12}t^{-\\frac32}\\right)\\,\\mathrm dt\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[2x^{\\frac12}-\\frac16x^{-\\frac12}\\right]_1^3=\\frac12\\left[\\left(2\\times3^{\\frac12}-\\frac16\\times3^{-\\frac12}\\right)-\\left(2-\\frac16\\right)\\right]=0.7672716\\ldots\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=0.767\\ \\mathrm{ms}^{-2}\\text{ (3 SF)}\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q13","number":13,"question":"<p>The temperature of a metal rod within some machinery at a distance <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> metres from one end is modelled by <span class=\"inline-math\" data-math=\"\\mathrm T(x)=-5x^3+12x^2+4x\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"\\mathrm T(x)\" data-display=\"false\"></span> is the temperature in degrees Celsius and <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> is the distance in metres from one end of the rod. The rod is 3 metres long. Find the mean temperature of the rod over its entire length.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{3-0}\\int_0^3(-5x^3+12x^2+4x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[-\\frac54x^4+4x^3+2x^2\\right]_0^3=\\frac13\\left[\\left(-\\frac{405}4+108+18\\right)-0\\right]=8.25\\ ^\\circ\\mathrm C\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q14","number":14,"question":"<p>The growth of a population of rabbits <span class=\"inline-math\" data-math=\"\\mathrm P(t)\" data-display=\"false\"></span> during the first 12 months of the year is modelled by <span class=\"inline-math\" data-math=\"\\mathrm P(t)=2t^3-7t^2+15t+40\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"\\mathrm P(t)\" data-display=\"false\"></span> represents the number of rabbits and <span class=\"inline-math\" data-math=\"t\" data-display=\"false\"></span> is the number of months that have passed. Find the average population of rabbits over the first 12 months.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{12-0}\\int_0^{12}(2t^3-7t^2+15t+40)\\,\\mathrm dt\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{12}\\left[\\frac12t^4-\\frac73t^3+\\frac{15}2t^2+40t\\right]_0^{12}=\\frac1{12}[(10368-4032+1080+480)-0]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=658\\text{ rabbits}\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q15","number":15,"question":"<p>The diagram below shows the curve</p><span class=\"equation\" data-math=\"f(x)=x^3-6x^2+9x+4\" data-display=\"true\"></span><p>with shaded regions <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> enclosed by the lines</p><span class=\"equation\" data-math=\"y=k,x=2\\text{ and }x=5\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/1.14/questions/assets/diagrams/114-question15.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p>Given that the areas <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> are equal, find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{5-2}\\int_2^5(x^3-6x^2+9x+4)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\frac14x^4-2x^3+\\frac92x^2+4x\\right]_2^5\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac13\\left[\\left(\\frac{625}4-250+\\frac{225}2+20\\right)-(4-16+18+8)\\right]=\\frac{33}4\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore k=\\frac{33}4\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q16","number":16,"question":"<p>The diagram below shows the curve</p><span class=\"equation\" data-math=\"f(x)=x^3-3x^2-9x+10\" data-display=\"true\"></span><p>with shaded regions <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> enclosed by the lines</p><span class=\"equation\" data-math=\"y=k,x=1\\text{ and }x=3\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/1.14/questions/assets/diagrams/114-question16.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p>Given that the areas <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> are equal, find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{3-1}\\int_1^3(x^3-3x^2-9x+10)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[\\frac14x^4-x^3-\\frac92x^2+10x\\right]_1^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[\\left(\\frac{81}4-27-\\frac{81}2+30\\right)-\\left(\\frac14-1-\\frac92+10\\right)\\right]=-11\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore k=-11\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q17","number":17,"question":"<p>A function</p><span class=\"equation\" data-math=\"f(x)=x^3-2\" data-display=\"true\"></span><p>has a mean value of</p><span class=\"equation\" data-math=\"\\frac{195}4\" data-display=\"true\"></span><p>over the interval <span class=\"inline-math\" data-math=\"[2,k]\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive constant.</p><p>Find the exact value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac1{k-2}\\int_2^k(x^3-2)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{k-2}\\left[\\frac14x^4-2x\\right]_2^k\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{k-2}\\left[\\left(\\frac14k^4-2k\\right)-(4-4)\\right]\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac1{k-2}\\left(\\frac14k^4-2k\\right)\n\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\frac1{k-2}\\left(\\frac14k^4-2k\\right)=\\frac{195}4\" data-display=\"false\"></span> then</p>","<span class=\"equation\" data-math=\"\n4\\left(\\frac14k^4-2k\\right)=195(k-2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"k^4-8k=195k-390\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"k^4-203k+390=0\n\" data-display=\"true\"></span>","<p>Let <span class=\"inline-math\" data-math=\"\\mathrm p(k)=k^4-203k+390\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\mathrm p(5)=625-1015+390=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathrm p(2)=16-406+390=0\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"k=2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"k=5\" data-display=\"false\"></span> is a solution.</p>","<span class=\"equation\" data-math=\"k^4-203k+390=(k-5)(k-2)(k^2+7k+39)\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> needs to be real and <span class=\"inline-math\" data-math=\"&gt;2\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"\\therefore k=5\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.14-q18","number":18,"question":"<p>Given that the function <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span> is defined by</p><span class=\"equation\" data-math=\"f(x)=x^2+x-1\\text{ for }2\\leq x\\leq4\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p>Find the mean value of <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span></p></li></ol><p>Another function <span class=\"inline-math\" data-math=\"g\" data-display=\"false\"></span> is defined by</p><span class=\"equation\" data-math=\"g(x)=f(x)+c\\text{ for }2\\leq x\\leq4\" data-display=\"true\"></span><ol class=\"parts\" start=\"2\"><li><p>Given that the mean value of <span class=\"inline-math\" data-math=\"g\" data-display=\"false\"></span> is 25, find the value of <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac1{4-2}\\int_2^4(x^2+x-1)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac12\\left[\\frac13x^3+\\frac12x^2-x\\right]_2^4=\\frac12\\left[\\left(\\frac{64}3+8-4\\right)-\\left(\\frac83+2-2\\right)\\right]=\\frac{34}3\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"25-\\frac{34}3=\\frac{41}3\\ \\therefore c=\\frac{41}3\" data-display=\"true\"></span>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\n\\frac1{4-2}\\int_2^4(x^2+x-1+c)\\,\\mathrm dx=25\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac12\\left[\\frac13x^3+\\frac12x^2-x+cx\\right]_2^4=25\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\left(\\frac{76}3+4c\\right)-\\left(\\frac83+2c\\right)=50\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{68}3+2c=50\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore c=\\frac{41}3\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q19","number":19,"question":"<p>A function <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span> has mean value <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> over the interval</p><span class=\"equation\" data-math=\"0\\leq x\\leq4\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is an unknown constant.</p><p>In each case, find the mean value over the given interval in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"g(x)\" data-display=\"false\"></span> which is a translation of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> by <span class=\"inline-math\" data-math=\"\\binom2{-1}\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"-2\\leq x\\leq2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"h(x)\" data-display=\"false\"></span> which is a reflection in the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"0\\leq x\\leq4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"m(x)\" data-display=\"false\"></span> which is a reflection in the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"-4\\leq x\\leq0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"n(x)\" data-display=\"false\"></span> which is a translation of <span class=\"inline-math\" data-math=\"y=m(x)\" data-display=\"false\"></span> by <span class=\"inline-math\" data-math=\"\\binom13\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"-3\\leq x\\leq1\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>A horizontal translation does not affect the mean value, but a vertical one does, so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"k-1\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm g(x)=\\mathrm f(x-2)-1\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac14\\int_{-2}^2\\mathrm g(x)\\,\\mathrm dx=\\frac14\\int_{-2}^2(\\mathrm f(x-2)-1)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac14\\int_{-2}^2\\mathrm f(x-2)\\,\\mathrm dx+\\frac14\\int_{-2}^2-1\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx+\\frac14\\int_{-2}^2-1\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=k-1\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>There has been a reflection of all the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-values so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"-k\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm g(x)=-\\mathrm f(x)\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac14\\int_2^6\\mathrm g(x)\\,\\mathrm dx=\\frac14\\int_2^6(-\\mathrm f(x))\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-\\frac14\\int_2^6\\mathrm f(x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-k\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>Due to symmetry in the intervals, the mean value has not changed, so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"k+4\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm m(x)=\\mathrm f(-x)\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac14\\int_{-4}^0\\mathrm m(x)\\,\\mathrm dx=\\frac14\\int_{-4}^0\\mathrm f(-x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=k\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><p>The horizontal translation and symmetry mean the mean value does not change, but the vertical translation does affect the mean value. The mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"k+3\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm n(x)=\\mathrm m(x+1)+3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\mathrm m(x)=\\mathrm f(-x)\" data-display=\"false\"></span>, the mean value of <span class=\"inline-math\" data-math=\"\\mathrm n\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac14\\int_{-3}^1\\mathrm n(x)\\,\\mathrm dx=\\frac14\\int_{-3}^1(\\mathrm m(x+1)+3)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac14\\int_{-3}^1\\mathrm m(x+1)\\,\\mathrm dx+\\frac14\\int_{-3}^13\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac14\\int_0^4\\mathrm f(x)\\,\\mathrm dx+\\frac14\\int_{-3}^13\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=k+3\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q20","number":20,"question":"<p>A function <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span> has mean value <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> over the interval</p><span class=\"equation\" data-math=\"2\\leq x\\leq7\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is an unknown constant.</p><p>In each case, find the mean value over the given interval in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"g(x)\" data-display=\"false\"></span> which is a translation of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> by <span class=\"inline-math\" data-math=\"\\binom{-1}4\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"1\\leq x\\leq6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"h(x)\" data-display=\"false\"></span> which is a stretch, parallel to the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis, scale factor 3 of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"6\\leq x\\leq21\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"m(x)\" data-display=\"false\"></span> which is a stretch, parallel to the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis, scale factor <span class=\"inline-math\" data-math=\"\\frac12\" data-display=\"false\"></span> of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> over the interval <span class=\"inline-math\" data-math=\"2\\leq x\\leq7\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>A horizontal translation does not affect the mean value, but a vertical one does, so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"k+4\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm g(x)=\\mathrm f(x+1)+4\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac15\\int_1^6\\mathrm g(x)\\,\\mathrm dx=\\frac15\\int_1^6(\\mathrm f(x+1)+4)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac15\\int_1^6\\mathrm f(x+1)\\,\\mathrm dx+\\frac15\\int_1^64\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx+\\frac15\\int_1^64\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=k+4\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>There has been a stretch of all the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-values so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm g(x)=\\mathrm f(3x)\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac15\\int_6^{21}\\mathrm f(3x)\\,\\mathrm dx=\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=k\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>There has been a stretch of all the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-values so the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"\\frac12k\" data-display=\"false\"></span></p>","<p>Alternative Method:</p>","<span class=\"equation\" data-math=\"\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx=k\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"\\mathrm m(x)=\\frac12\\mathrm f(x)\" data-display=\"false\"></span> the mean value of <span class=\"inline-math\" data-math=\"\\mathrm g\" data-display=\"false\"></span> is given by</p>","<span class=\"equation\" data-math=\"\n\\frac15\\int_2^7\\mathrm m(x)\\,\\mathrm dx=\\frac14\\int_2^7\\frac12\\mathrm f(x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=\\frac12\\times\\frac15\\int_2^7\\mathrm f(x)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=\\frac12k\n\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.14-q21","number":21,"question":"<p>The root mean square of a function <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> defined for <span class=\"inline-math\" data-math=\"a\\leq x\\leq b\" data-display=\"false\"></span> over this interval is</p><span class=\"equation\" data-math=\"\\sqrt{\\frac1{b-a}\\int_a^b[f(x)]^2\\,\\mathrm dx}\" data-display=\"true\"></span><p>Find the root mean square of</p><span class=\"equation\" data-math=\"f(x)=-x(x-0.5)(x-1)\" data-display=\"true\"></span><p>from <span class=\"inline-math\" data-math=\"x=0.1\" data-display=\"false\"></span> to <span class=\"inline-math\" data-math=\"x=0.6\" data-display=\"false\"></span> giving your answer to 3 significant figures.</p>","steps":["<span class=\"equation\" data-math=\"\n[\\mathrm f(x)]^2=[-x(x-0.5)(x-1)]^2=x^2(x-0.5)^2(x-1)^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=x^2(x^2-x+0.25)(x^2-2x+1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=x^2(x^4-3x^3+3.25x^2-1.5x+0.25)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=x^6-3x^5+3.25x^4-1.5x^3+0.25x^2\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac1{0.6-0.1}\\int_{0.1}^{0.6}(x^6-3x^5+3.25x^4-1.5x^3+0.25x^2)\\,\\mathrm dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n=2\\left[\\frac17x^7-\\frac12x^6+\\frac{13}{20}x^5-\\frac38x^4+\\frac1{12}x^3\\right]_{0.1}^{0.6}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=0.00112648\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\sqrt{0.00112648}=0.0336\\text{ (3 SF)}\" data-display=\"true\"></span>"]}]