[{"id":"smq-year1-1.18-q1","number":1,"question":"<p>Find the equation of the following graph in the form <span class=\"inline-math\" data-math=\"y=\\frac kx\" data-display=\"false\"></span>.</p><figure class=\"diagram\"><img src=\"assets/smq-1.18/questions/assets/diagrams/q1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac56=\\frac k3\\Rightarrow k=\\frac52\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.18-q2","number":2,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=\\frac1{x-a}+b\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.18/questions/assets/diagrams/q2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.18/questions/assets/diagrams/q2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.18/questions/assets/diagrams/q2c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.18/questions/assets/diagrams/q2d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac1{x-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac1x-1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac1{x-3}-2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac1{x+2}+4\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.18-q3","number":3,"question":"<p>State the equations of the asymptotes of the curve <span class=\"inline-math\" data-math=\"y=\\frac2{x-1}+3\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.18-q4","number":4,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\frac1x-5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac1{x+3}-1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac4{x-4}+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=3-\\frac1x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=5-\\frac1{x+3}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.18/solutions/assets/diagrams/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.18/solutions/assets/diagrams/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.18/solutions/assets/diagrams/s4c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.18/solutions/assets/diagrams/s4d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.18/solutions/assets/diagrams/s4e.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.18-q5","number"