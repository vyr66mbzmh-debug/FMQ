[{"id":"smq-year1-1.01-q1","number":1,"question":"<p>Without using a calculator, evaluate:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"4^{\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"9^{-\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"7^3\\times7^{-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\times3^3\\times3^{-2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^5\\div3^{-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(64^{\\frac13}\\times16^{\\frac14})^{-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\frac1{16})^{-\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\frac{27}8)^{-\\frac13}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{64^{\\frac23}}{8^{\\frac53}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"3^{-1}=\\frac13\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"7^2=49\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"2\\times27\\times\\frac19=6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"243\\div\\frac13=729\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"(4\\times2)^{-1}=\\frac18\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"(\\frac14)^{-1}=4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"(\\frac32)^{-1}=\\frac23\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"\\frac{4^2}{2^5}=\\frac{16}{32}=\\frac12\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q2","number":2,"question":"<p>Express the following as a single power:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x\\sqrt{x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^2\\sqrt{x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x}{\\sqrt{x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2}{\\sqrt{x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt{x})^3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt[3]{x})^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{\\sqrt{x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac4{(\\sqrt{x})^3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x\\sqrt{x}}{\\sqrt[3]{x}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x^1x^{\\frac12}=x^{\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"x^2x^{\\frac12}=x^{\\frac52}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"x^1x^{-\\frac12}=x^{\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"x^2x^{-\\frac12}=x^{\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"x^{\\frac12}x^{\\frac12}x^{\\frac12}=x^{\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"x^{\\frac13}x^{\\frac13}=x^{\\frac23}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"x^{-\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"4x^{-\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"x^1x^{\\frac12}x^{-\\frac13}=x^{\\frac76}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q3","number":3,"question":"<p>Express the following in the form <span class=\"inline-math\" data-math=\"\\sqrt[a]{x^b}\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x^b\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\frac1{\\sqrt[a]{x^b}}\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"\\frac1{x^b}\" data-display=\"false\"></span> as appropriate, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are integers to be found:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x^{\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-5}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{\\frac23}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac34}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{x^{-\\frac35}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{\\sqrt x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{x^5}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt[3]{x^2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{\\sqrt[4]{x^3}}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"x^{\\frac35}=\\sqrt[5]{x^3}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q4","number":4,"question":"<p>Simplify each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"(4a^{10})^{\\frac32}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(a^3b^2c)^{\\frac13}\\times(4a^4b^2c)^{\\frac12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(16ab^2)^{\\frac12}\\times(27a^6b^3)^{-\\frac13}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(20a^8bc)\\div(5a^2b^2c^{-1})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(3a^2b^3c)^2\\div(9a^2b^{-2}c^4)^{\\frac12}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"4^{\\frac32}a^{10\\times\\frac32}=8a^{15}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"a^1b^{\\frac23}c^{\\frac13}\\times2a^2b^1c^{\\frac12}=2a^3b^{\\frac53}c^{\\frac56}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{4a^{\\frac12}b^1}{3a^2b}=\\frac43a^{-\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"4a^6b^{-1}c^2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{9a^4b^6c^2}{3ab^{-1}c^2}=3a^3b^7\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q5","number":5,"question":"<p>Simplify each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{(2a)^3\\times(3a^2)^5}{(6a^5)^2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{(3a)^3\\times(4a^2)^2}{(2a^4)^3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\left(\\frac{a^{\\frac12}\\times a^{\\frac52}}{(a^3)^4}\\right)^{-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\frac{32}{a^8})^{\\frac35}\\times(\\frac{a^7}4)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{8a^3\\times243a^{10}}{36a^{10}}=54a^3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{27a^3\\times16a^4}{8a^{12}}=54a^{-5}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(a^3)^4}{a^{\\frac12}\\times a^{\\frac52}}=\\frac{a^{12}}{a^3}=a^9\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac8{a^{\\frac{24}5}}\\times\\frac{a^7}4=2a^{\\frac{11}5}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q6","number":6,"question":"<p>Simplify each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt{x^3\\times x^5}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{x^{\\frac35}\\times x^{\\frac15}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{49x^6y^4}\\times(27x^3y^9)^{-\\frac13}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{16x^4y^6}\\times(9x^2y^3)^{-\\frac12}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"(x^8)^{\\frac12}=x^4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"(x^{\\frac45})^{\\frac12}=x^{\\frac25}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{7x^3y^2}{3xy^3}=\\frac{7x^2}{3y}=\\frac73x^2y^{-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{4x^2y^3}{(9x^2y^3)^{\\frac12}}=\\frac{4x^2y^3}{3xy^{\\frac32}}=\\frac43xy^{\\frac32}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q7","number":7,"question":"<p>Give each of the following as sums of terms in the form <span class=\"inline-math\" data-math=\"ax^n\" data-display=\"false\"></span>:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt{x}(2x+1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt{x}+1)(\\sqrt{x}-2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x+1}{\\sqrt{x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2-1}{\\sqrt{x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac4x+\\frac1{\\sqrt{9x}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{x}-3}{x\\sqrt{x}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x^{\\frac12}(2x+1)=2x^{\\frac32}+x^{\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"(x^{\\frac12}+1)(x^{\\frac12}-2)=x+x^{\\frac12}-2x^{\\frac12}-2=x-x^{\\frac12}-2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x+1}{x^{\\frac12}}=x^{\\frac12}+x^{-\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^2-1}{x^{\\frac12}}=x^{\\frac32}-x^{-\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"4x^{-1}+\\frac13x^{-\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^{\\frac12}-3}{x\\times x^{\\frac12}}=\\frac{x^{\\frac12}-3}{x^{\\frac32}}=x^{-1}-3x^{-\\frac32}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q8","number":8,"question":"<p>A right-angled triangle has perpendicular sides <span class=\"inline-math\" data-math=\"7a^{\\frac12}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"24a^{\\frac12}\" data-display=\"false\"></span>. Find</p><ol class=\"parts\" start=\"1\"><li><p>the length of the hypotenuse side.</p></li><li><p>the area of the triangle.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{(7a^{\\frac12})^2+(24a^{\\frac12})^2}=\\sqrt{49a+576a}=\\sqrt{625a}=25\\sqrt a\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac12\\times7a^{\\frac12}\\times24a^{\\frac12}=84a\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q9","number":9,"question":"<p>Solve each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x^{\\frac12}=2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac12}=3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{\\frac13}=\\frac12\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac12}=11\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac32}=\\frac8{27}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2x^{-\\frac13}=3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^{-\\frac23}=2\\frac79\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x=2^2=4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x=3^2\\Rightarrow x=\\frac19\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"x=\\frac1{2^3}=\\frac18\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x=11^2\\Rightarrow x=\\frac1{121}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x=(\\frac8{27})^{\\frac23}=\\frac49\\Rightarrow x=\\frac94\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x=(\\frac32)^3=\\frac{27}8\\Rightarrow x=\\frac8{27}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\frac1x=(\\frac{25}9)^{\\frac32}=\\frac{125}{27}\\Rightarrow x=\\frac{27}{125}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q10","number":10,"question":"<p>Mo was asked to find the solutions to</p><span class=\"equation\" data-math=\"x^{\\frac74}-2187=0.\" data-display=\"true\"></span><p>His solution is shown below.</p><span class=\"equation\" data-math=\"\\begin{aligned}x^{\\frac74}&amp;=2187\\\\x^{\\frac14}&amp;=\\sqrt[7]{2187}=\\pm3\\\\x&amp;=3^4\\text{ or }(-3)^4\\\\x&amp;=81\\text{ or }-81\\end{aligned}\" data-display=\"true\"></span><p>Find his mistake(s) and write a correct solution.</p>","steps":["<p>His mistake is that in finding the <span class=\"inline-math\" data-math=\"7^{\\text{th}}\" data-display=\"false\"></span> root, he identifies <span class=\"inline-math\" data-math=\"-3\" data-display=\"false\"></span> as an answer.</p>","<span class=\"equation\" data-math=\"\\begin{aligned}x^{\\frac14}&amp;=\\sqrt[7]{2187}=3\\\\x&amp;=3^4\\\\x&amp;=81\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.01-q11","number":11,"question":"<p>Write each of these in the form <span class=\"inline-math\" data-math=\"8^k\" data-display=\"false\"></span>:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt8\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"8^{10}\\times8^{-12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{64}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt[3]{64}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac2{\\sqrt8}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2^6}{\\sqrt8}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt[3]{16}\\times(8^3)^{\\frac19}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\times\\sqrt{64}\\times\\sqrt[3]{16}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"8^{\\frac12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"8^{10-12}=8^{-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{8^2}=8^{-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"64^{\\frac13}=(8^2)^{\\frac13}=8^{\\frac23}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{8^{\\frac13}}{8^{\\frac12}}=8^{-\\frac16}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{(8^{\\frac13})^6}{8^{\\frac12}}=8^{\\frac32}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"(8^{\\frac43})^{\\frac13}\\times(8^3)^{\\frac19}=8^{\\frac49}\\times8^{\\frac13}=8^{\\frac79}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"8^{\\frac13}\\times8\\times(8^{\\frac43})^{\\frac13}=8^{\\frac13}\\times8^1\\times8^{\\frac49}=8^{\\frac{16}9}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q12","number":12,"question":"<p>Solve each of the following equations:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"2^x\\times2^{\\frac12}=2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"5^x\\times\\sqrt5=\\frac1{25}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^{x+1}=9^x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4^{2x}=\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2^{3x-1}=32\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2^{3x+2}=4^{x+5}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"9^{2x-1}=\\frac1{\\sqrt3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{9^x}{3^{x+2}}=27\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^{x^2-x}=729\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x+\\frac12=1\\Rightarrow x=\\frac12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"x+\\frac12=-2\\Rightarrow x=-\\frac52\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"x+1=2x\\Rightarrow x=1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"(2^2)^{2x}=2^{\\frac12}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"4x=\\frac12\\Rightarrow x=\\frac18\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"3x-1=5\\Rightarrow x=2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"3x+2=2(x+5)\\Rightarrow3x+2=2x+10\\Rightarrow x=8\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"(3^2)^{2x-1}=3^{-\\frac12}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"2(2x-1)=-\\frac12\\Rightarrow4x-2=-\\frac12\\Rightarrow x=\\frac38\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"\\frac{3^{2x}}{3^{x+2}}=3^3\\Rightarrow2x-(x+2)=3\\Rightarrow x=5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"3^{x^2-x}=6^3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x^2-x-6=0\\Rightarrow x=-2\\text{ or }x=3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q13","number":13,"question":"<p>Simplify each of the following into a single term (selecting the smaller base):</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"4^x+4^x+4^x+4^x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2^{2x}+4^x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3\\times2^{3x}+5\\times8^x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"5\\times16^{2x}-3\\times2^{8x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^{2x+1}+3^{2x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"8\\times2^x+3\\times2^{x+1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2^{2x+4}+4^x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"4\\times4^x=4^1\\times4^x=4^{1+x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"2^{2x}+(2^2)^x=2\\times2^{2x}=2^1\\times2^{2x}=2^{2x+1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"3\\times2^{3x}+5\\times(2^3)^x=8\\times2^{3x}=2^3\\times2^{3x}=2^{3x+3}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"5\\times(2^4)^{2x}-3\\times2^{8x}=5\\times2^{8x}-3\\times2^{8x}=2^1\\times2^{8x}=2^{1+8x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"3^1\\times3^{2x}+3^{2x}=4\\times3^{2x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"8\\times2^x+3\\times2^1\\times2^x=14\\times2^x\\text{ or }7\\times2^{x+1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"2^4\\times2^{2x}+2^{2x}=17\\times2^{2x}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q14","number":14,"question":"<p>Simplify each of the following so that there are only positive exponents in the numerator and denominator:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{x+x^{-2}}{x^2y+x^{-1}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^2y^{-1}+x^{-1}}{xy^2+x^{-2}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^4-x^{-2}yz^3}{x^2+z^{-1}\\sqrt y}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{x^5-x^{-1}yz^4}{x^{-3}+z^2y^{-\\frac12}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^3+1}{x^4y+x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^4+xy}{x^3y^3+y}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^6z-yz^4}{x^4z+x^2y^{\\frac12}}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{x^8y^{\\frac12}-x^2y^{\\frac32}z^4}{y^{\\frac12}+x^3z^2}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q15","number":15,"question":"<p>Solve each of the following equations:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"4^{2x}\\times3^{2x}=12\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"5^x\\times2^{2x}=20\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^{2x}\\times9^x=9\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2^x}{2^{\\frac x2}\\times2^4}=1\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"3^{2x}\\times3^{2x}=3^2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"2^x=2^{4+\\frac12x}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x=4+\\frac12x\\Rightarrow x=8\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.01-q16","number":16,"question":"<p>Find the solutions to <span class=\"inline-math\" data-math=\"4^{x+2}-2^{2x+3}-16=0\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}(2^2)^{x+2}-2^{2x+3}&amp;=2^4\\\\2^{2x+4}-2^{2x+3}&amp;=2^4\\\\2^4\\times2^{2x}-2^3\\times2^{2x}&amp;=2^4\\\\8\\times2^{2x}&amp;=2^4\\\\2^3\\times2^{2x}&amp;=2^4\\\\2x+3&amp;=4\\Rightarrow x=\\frac12\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.01-q17","number":17,"question":"<p>Find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> such that <span class=\"inline-math\" data-math=\"\\frac{2^{501}-2^{497}}{30}=64^k\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}2^{501}-2^{497}&amp;=30\\times64^k\\\\2^{497}\\times(2^4-1)&amp;=30\\times(2^6)^k\\\\2^{497}\\times15&amp;=30\\times(2^6)^k\\\\2^{497}&amp;=\\frac{30}{15}\\times(2^6)^k\\\\2^{497}&amp;=(2^1)\\times(2^6)^k\\\\497&amp;=1+6k\\Rightarrow k=\\frac{248}3\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.01-q18","number":18,"question":"<p>Solve <span class=\"inline-math\" data-math=\"\\frac{2^x}{32\\times2^{\\sqrt{x}}}=2\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}\\frac{2^x}{2^5\\times2^{\\sqrt x}}=2&amp;\\Rightarrow2^x=2^1\\times2^5\\times2^{\\sqrt x}\\\\&amp;\\Rightarrow x=6+x^{\\frac12}\\\\&amp;\\Rightarrow x-x^{\\frac12}-6=0\\Rightarrow(x^{\\frac12}-3)(x^{\\frac12}+2)=0\\end{aligned}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x^{\\frac12}=3\\Rightarrow x=9\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x^{\\frac12}=-2\" data-display=\"false\"></span> cannot be a solution since <span class=\"inline-math\" data-math=\"\\sqrt x\\geq0\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.01-q19","number":19,"question":"<p>Find one solution to <span class=\"inline-math\" data-math=\"(x^2-4x-1)^{3x+2}=\\frac14\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"(x^2-4x-1)^{3x+2}=4^{-1}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x^2-4x-1=4\\Rightarrow x=5,\\ x=-1\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"3x+2=-1\\Rightarrow x=-1\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\therefore x=-1\" data-display=\"false\"></span>  (or <span class=\"inline-math\" data-math=\"x=-0.2988475575\\ldots\" data-display=\"false\"></span>)</p>"]}]