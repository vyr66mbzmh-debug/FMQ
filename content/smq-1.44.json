[{"id":"smq-year1-1.44-q1","number":1,"question":"<p>Solve the following equations, giving your answer in exact form:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"5x^4=3-2x^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3x-16\\sqrt{x}=35\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2x^{\\frac23}+7x^{\\frac13}=15\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac6{x^2}+\\frac7x=5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"7^x+7^{2x}=2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4^x-3\\times2^{x-1}+\\frac12=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3^{3x+1}+20\\times3^{2x}-7\\times3^x=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2^{x+1}+11=\\frac6{2^x}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"5x^4+2x^2-3=(x^2+1)(5x^2-3)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore x^2=-1,x^2=\\frac35\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x^2=-1\" data-display=\"false\"></span> has no solution.</p>","<span class=\"equation\" data-math=\"x=\\pm\\sqrt{\\frac35}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"3x-16\\sqrt{x}-35=(\\sqrt{x}-7)(3\\sqrt{x}+5)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\sqrt{x}=-\\frac53,\\sqrt{x}=7\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\sqrt{x}=-\\frac53\" data-display=\"false\"></span> has no solution.</p>","<span class=\"equation\" data-math=\"x=49\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"2x^{\\frac23}+7x^{\\frac13}-15=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left(2x^{\\frac13}-3\\right)\\left(x^{\\frac13}+5\\right)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore x^{\\frac13}=\\frac32,x^{\\frac13}=-5\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x^{\\frac13}=-5\" data-display=\"false\"></span> has no solution.</p>","<p><span class=\"inline-math\" data-math=\"x^{\\frac13}=\\frac32\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"x=\\frac{27}8\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\frac6{x^2}+\\frac7x =5\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n6+7x =5x^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n5x^2-7x-6 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(x-2)(5x+3) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=2,x =-\\frac35\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\n7^x+7^{2x}-2 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(7^x+2)(7^x-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore7^x=-2,7^x =1\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"7^x=-2\" data-display=\"false\"></span> has no solution.</p>","<span class=\"equation\" data-math=\"x=0\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\n2^{2x}-3\\times2^{-1}\\times2^x+2^{-1} =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2^{2x}-\\frac32\\times2^x+\\frac12 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2\\times2^{2x}-3\\times2^x+1 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2^x-1)(2\\times2^x-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore 2^x=1,2^x =\\frac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=0,x =-1\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">g)</h3><span class=\"equation\" data-math=\"\n3^{3x+1}+20\\times3^{2x}-7\\times3^x =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3\\times3^{3x}+20\\times3^{2x}-7\\times3^x =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3^x(3\\times3^{2x}+20\\times3^x-7) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3^x(3\\times3^x-1)(3^x+7) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore3^x=0,3^x=-7,3^x =\\frac13\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"3^x=0\" data-display=\"false\"></span> has no solution</p>","<p><span class=\"inline-math\" data-math=\"3^x=-7\" data-display=\"false\"></span> has no solution</p>","<p><span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span> is the only solution.</p>","<h3 class=\"part-label\">h)</h3><span class=\"equation\" data-math=\"\n2^{x+1}+11 =\\frac6{2^x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2^{2x+1}+11\\times2^x =6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2\\times2^{2x}+11\\times2^x-6 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2^x+6)(2\\times2^x-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore2^x=-6,2^x =\\frac12\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"2^x=-6\" data-display=\"false\"></span> has no solution</p>","<p><span class=\"inline-math\" data-math=\"2^x=\\frac12\\Rightarrow x=-1\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.44-q2","number":2,"question":"<p>By first factorising, express <span class=\"inline-math\" data-math=\"5^8-3^8\" data-display=\"false\"></span> as a product of its prime factors.</p>","steps":["<span class=\"equation\" data-math=\"\n5^8-3^8 =(5^4-3^4)(5^4+3^4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(625-81)(625+81)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =544\\times706\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2^5\\times17\\times2\\times353\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2^6\\times17\\times353\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q3","number":3,"question":"<p>Find the solutions to</p><span class=\"equation\" data-math=\"\\frac{2x^4+2}5=x^2\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\frac{2x^4+2}5 =x^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x^4-5x^2+2 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2x^2-1)(x^2-2) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2=\\frac12\\text{ or }x^2 =2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx=\\pm\\frac1{\\sqrt2}\\text{ or }x =\\pm\\sqrt2\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q4","number":4,"question":"<p>Given</p><span class=\"equation\" data-math=\"\\mathrm f(x)=8x^3+\\frac1{x^3}\" data-display=\"true\"></span><p>solve <span class=\"inline-math\" data-math=\"\\mathrm f(x)=-9\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n8x^3+\\frac1{x^3} =-9\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n8x^6+1 =-9x^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n8x^6+9x^3+1 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(8x^3+1)(x^3+1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x^3=-\\frac18,x^3 =-1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx=-\\frac12,x =-1\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q5","number":5,"question":"<p>Given</p><span class=\"equation\" data-math=\"\\mathrm f(x)=2x^6+\\frac1{x^3}\\text{ and }\\mathrm g(x)=x^3+2\" data-display=\"true\"></span><p>solve <span class=\"inline-math\" data-math=\"\\mathrm f(x)=\\mathrm g(x)\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n2x^6+\\frac1{x^3} =x^3+2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x^9+1 =x^6+2x^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x^9-x^6-2x^3+1 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2x^3-1)(x^3+1)(x^3-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x^3=\\frac12,x^3=-1,x^3 =1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx=\\frac1{\\sqrt[3]2},x=-1,x =1\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q6","number":6,"question":"<p>Find the solutions to</p><span class=\"equation\" data-math=\"\\left(x-\\frac4x\\right)^2+8=6\\left(x-\\frac4x\\right)\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\left(x-\\frac4x\\right)^2+8 =6\\left(x-\\frac4x\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny^2-6y+8 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(y-4)(y-2) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny=4\\text{ or }y =2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx-\\frac4x=4\\text{ or }x-\\frac4x =2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2-4=4x\\text{ or }x^2-4 =2x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2-4x-4=0\\text{ or }x^2-2x-4 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx=2\\pm\\sqrt2\\text{ or }x =1\\pm\\sqrt5\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q7","number":7,"question":"<p>Find the solutions to</p><span class=\"equation\" data-math=\"\\frac{5x^2}{\\sqrt x}+22+\\frac{24}{\\sqrt x}=12x+\\frac{39x}{\\sqrt x}\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n5x^2-12x\\sqrt{x}-39x+22\\sqrt{x}+24 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n5(\\sqrt{x})^4-12(\\sqrt{x})^3-39(\\sqrt{x})^2+22\\sqrt{x}+24 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(\\sqrt{x}-4)(5\\sqrt{x}+3)(\\sqrt{x}+2)(\\sqrt{x}-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\sqrt{x}=-2,\\sqrt{x}=-\\frac35,\\sqrt{x}=1,\\sqrt{x} =4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=1,x =16\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q8","number":8,"question":"<p>Find the solutions to</p><span class=\"equation\" data-math=\"3^{2x+1}+20\\times3^x+\\frac{75}{3^{2x}}=22+\\frac{220}{3^x}\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n3^{2x+1}+20\\times3^x+\\frac{75}{3^{2x}} =22+\\frac{220}{3^x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3^{4x+1}+20\\times3^{3x}+75 =22\\times3^{2x}+220\\times3^x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3\\times3^{4x}+20\\times3^{3x}+75 =22\\times3^{2x}+220\\times3^x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3(3^x)^4+20(3^x)^3+75 =22(3^x)^2+220(3^x)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3(3^x)^4+20(3^x)^3-22(3^x)^2-220(3^x)+75 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(3^x+5)^2(3^x-3)(3\\times3^x-1) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore3^x=\\frac13,3^x=3,3^x =-5\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"3^x=-5\" data-display=\"false\"></span> has no solution</p>","<p><span class=\"inline-math\" data-math=\"\\therefore x=-1,x=1\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.44-q9","number":9,"question":"<h3>Prerequisite knowledge for Q9--Q12: Exponentials and Logarithms</h3><p>Solve the following equations, giving your answer in exact form:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"3\\times2^{2x}+7\\times2^x=6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2e^{3x}+3e^{2x}-17e^x+12=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4\\times3^x+13=\\frac2{3^x}+\\frac{15}{3^{2x}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n3\\times2^{2x}+7\\times2^x-6 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(x+2^x)(3\\times2^x-2) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore2^x=-3,2^x =\\frac23\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"2^x=-3\" data-display=\"false\"></span> has no solution</p>","<span class=\"equation\" data-math=\"x=\\log_2\\frac23\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n 2e^{3x}+3e^{2x}-17e^x+12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(e^x+4)(2e^x-3)(e^x-1)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore e^x=-4,e^x=1,e^x=\\frac32\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"e^x=-4\" data-display=\"false\"></span> has no solution</p>","<p><span class=\"inline-math\" data-math=\"x=\\ln1=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=\\ln\\frac32\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n4\\times3^x+13 =\\frac2{3^x}+\\frac{15}{3^{2x}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4\\times3^{4x}+13\\times3^{3x} =2\\times3^{2x}+15\\times3^x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4\\times3^{4x}+13\\times3^{3x}-2\\times3^{2x}-15\\times3^x =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3^x(3^x-1)(3^x+3)(4\\times3^x+5) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore3^x=-3,3^x=-\\frac54,3^x=0,3^x =1\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"3^x=-3,3^x=-\\frac54,3^x=0\" data-display=\"false\"></span> have no solution</p>","<p><span class=\"inline-math\" data-math=\"3^x=1\\Rightarrow x=0\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.44-q10","number":10,"question":"<ol class=\"parts\" start=\"1\"><li><p>Solve</p><span class=\"equation\" data-math=\"\\frac4{(x-2)^2}-\\frac7{x-2}=2\" data-display=\"true\"></span></li><li><p>Hence, solve</p><span class=\"equation\" data-math=\"\\frac4{(5^x-2)^2}-\\frac7{5^x-2}=2\" data-display=\"true\"></span><p>giving your answer in exact form.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n4-7(x-2) =2(x-2)^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4-7x+14 =2x^2-8x+8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x^2-x-10 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2x-5)(x+2) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=\\frac52,x =-2\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"5^x=\\frac52,5^x=-2\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"5^x=-2\" data-display=\"false\"></span> has no solutions</p>","<span class=\"equation\" data-math=\"x=\\log_5\\left(\\frac52\\right)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q11","number":11,"question":"<p>Solve the following equations, giving your answer in exact form:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\log_2(x+3)=2\\log_2x-\\log_24\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\log_4(5x+2)=\\log_4(13x-6)-2\\log_4x\" data-display=\"false\"></span></p></li><li><span class=\"equation\" data-math=\"-1+\\log_5(x^4+4)\" data-display=\"true\"></span><span class=\"equation\" data-math=\"=\\log_5x+\\log_5(3x+14-5x^2)-\\log_56\" data-display=\"true\"></span></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\log_2(x+3) =\\log_2x^2-\\log_24\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\log_2(x+3) =\\log_2\\left(\\frac{x^2}4\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx+3 =\\frac{x^2}4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n12+4x =x^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2-4x-12 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(x-6)(x+2) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=6,x =-2\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\log_4(5x+2) =\\log_4(13x-6)-2\\log_4x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\log_4(5x+2) =\\log_4(13x-6)-\\log_4(x^2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\log_4(5x+2) =\\log_4\\left(\\frac{13x-6}{x^2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n5x+2 =\\frac{13x-6}{x^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2(5x+2) =13x-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n5x^3+2x^2 =13x-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n5x^3+2x^2-13x+6 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(x-1)(x+2)(5x-3) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=1,x=-2,x =\\frac35\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"5\\times-2+1&lt;0\\ \\therefore\" data-display=\"false\"></span> reject <span class=\"inline-math\" data-math=\"x=-2\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore x=1,x=\\frac35\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n-1+\\log_5(x^4+4) =\\log_5x+\\log_5(3x+14-5x^2)-\\log_56\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\log_5(x^4+4)-\\log_55 =\\log_5(x(3x+14-5x^2))-\\log_56\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\log_5\\left(\\frac{x^4+4}5\\right) =\\log_5\\left(\\frac{3x^2+14x-5x^3}6\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{x^4+4}5 =\\frac{3x^2+14x-5x^3}6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n6x^4+24 =15x^2+70x-25x^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n6x^4+25x^3-15x^2-70x+24 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(x+2)(3x-1)(x+4)(2x-3) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore x=-4,x=-2,x=\\frac13,x =\\frac32\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"3\\times-4+14-5(-4)^2&lt;0\" data-display=\"false\"></span> so reject <span class=\"inline-math\" data-math=\"x=-4\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"3\\times-2+14-5(-2)^2&lt;0\" data-display=\"false\"></span> so reject <span class=\"inline-math\" data-math=\"x=-2\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore x=\\frac13,x=\\frac32\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q12","number":12,"question":"<p>Solve for the following equation giving your answer in exact form</p><span class=\"equation\" data-math=\"\\ln x+\\frac4{\\ln x}=\\frac{\\ln(x^4)}{\\ln x}\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n(\\ln x)^2+4 =\\ln x^4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(\\ln x)^2-\\ln x^4+4 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(\\ln x)^2-4\\ln x+4=(\\ln x-2)^2 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\ln x =2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx =e^2\n\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.44-q13","number":13,"question":"<h3>Prerequisite knowledge for Q13--Q14: Solving Trigonometric Equations</h3><p>Solve</p><span class=\"equation\" data-math=\"\\sin^2x=\\frac{7-13\\sin x}2\" data-display=\"true\"></span><p>for <span class=\"inline-math\" data-math=\"0\\leq x\\leq360{}^\\circ\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\sin^2x =\\frac{7-13\\sin x}2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2\\sin^2x =7-13\\sin x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2\\sin^2x+13\\sin x-7 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2\\sin x-1)(\\sin x+7) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\sin x=\\frac12,\\sin x =-7\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\sin x=-7\" data-display=\"false\"></span> has no solutions</p>","<p><span class=\"inline-math\" data-math=\"\\sin x=\\frac12\" data-display=\"false\"></span> has solutions <span class=\"inline-math\" data-math=\"x=30{}^\\circ,x=150{}^\\circ\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.44-q14","number":14,"question":"<p>Solve</p><span class=\"equation\" data-math=\"\\frac{\\cos^2x(3\\cos x+11)}{20}=\\cos x\" data-display=\"true\"></span><p>for <span class=\"inline-math\" data-math=\"0\\leq x\\leq360{}^\\circ\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac{\\cos^2x(3\\cos x+11)}{20} =\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\cos^2x(3\\cos x+11) =20\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3\\cos^3x+11\\cos^2x =20\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3\\cos^3x+11\\cos^2x-20\\cos x =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\cos x(3\\cos x-4)(\\cos x+5) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\therefore\\cos x=-5,\\cos x=0,\\cos x =\\frac43\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\cos x=-5\" data-display=\"false\"></span> has no solutions</p>","<p><span class=\"inline-math\" data-math=\"\\cos x=\\frac43\" data-display=\"false\"></span> has no solutions</p>","<p><span class=\"inline-math\" data-math=\"\\cos x=0\" data-display=\"false\"></span> has solutions <span class=\"inline-math\" data-math=\"x=90{}^\\circ,x=270{}^\\circ\" data-display=\"false\"></span></p>"]}]