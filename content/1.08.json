[{"id":"fm-core1-1.08-q1","number":1,"question":"<p>In each case, shade the region on the Argand diagram for the complex number <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span>, labelling any points where loci intersect with the axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"|z|\\geq2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z+2i|&lt;4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-3+i|\\leq1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z+1-i|&gt;5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\leq|z|\\leq4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-1-i|\\geq1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z-2-2i|\\leq2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p1-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p1-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"(x-3)^2+(y+1)^2=4\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=3\\pm\\sqrt3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p1-3.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"(x+1)^2+(y-1)^2=25\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=1\\pm2\\sqrt6\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=-1\\pm2\\sqrt6\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p2-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p2-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">f)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p2-3.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"fm-core1-1.08-q2","number":2,"question":"<p>In each case, shade the region on the Argand diagram for the complex number <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span>, labelling any points where loci intersect with the axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"0&lt;\\arg(z-2i)&lt;\\frac\\pi4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac\\pi3\\leq\\arg(z+1)\\leq\\frac{2\\pi}3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-\\frac\\pi4&lt;\\arg(z-1+3i)\\leq\\frac\\pi3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-\\frac\\pi6\\leq\\arg(z+2-i)&lt;\\frac\\pi6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arg(z-4+2i)\\leq\\frac{2\\pi}3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\arg(z+2-i)\\geq\\frac\\pi4\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p3-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=\\tan\\frac\\pi3(x+1)\\Rightarrow y=\\sqrt3x+\\sqrt3\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\sqrt3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p3-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y+3=\\tan\\frac\\pi3(x-1)\\Rightarrow y=\\sqrt3x-\\sqrt3-3\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=\\frac{\\sqrt3+3}{\\sqrt3}=\\sqrt3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p4-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"y-1=\\tan\\frac\\pi6(x+2)\\Rightarrow y=\\frac{\\sqrt3}3x+\\frac{2\\sqrt3}3+1\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\frac{2\\sqrt3}3+1\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"y-1=\\tan\\left(-\\frac\\pi6\\right)(x+2)\\Rightarrow y=-\\frac{\\sqrt3}3x-\\frac{2\\sqrt3}3+1\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=-\\frac{2\\sqrt3}3+1\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=\\frac{-\\frac{2\\sqrt3}3+1}{\\frac{\\sqrt3}3}=2-\\sqrt3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p4-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"y-1=\\tan\\frac\\pi4(x+2)\\Rightarrow y=x+3\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=3\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"y+2=\\tan\\left(\\frac{2\\pi}3\\right)(x-4)\\Rightarrow y=-\\sqrt3x+4\\sqrt3-2\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=-2\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=\\frac{-4\\sqrt3+2}{-\\sqrt3}=4-\\frac{\\sqrt3}2\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p5-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"fm-core1-1.08-q3","number":3,"question":"<p>In each case, shade the region on the Argand diagram for the complex number <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span>, labelling any points where loci intersect with the axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"|z-2|&gt;|z-5|\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-3|\\geq|z+4i|\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z+1-2i|&lt;|z-4i|\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-4-3i|\\leq|z+2-8i|\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-1|&gt;|z+3|\" data-display=\"false\"></span><br>and <span class=\"inline-math\" data-math=\"|z-3-2i|\\geq|z+1-4i|\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"(7,2)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p5-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"\\left(\\frac32,-2\\right)\" data-display=\"false\"></span> and Gradient: <span class=\"inline-math\" data-math=\"\\frac43\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p6-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Line: <span class=\"inline-math\" data-math=\"y+2=-\\frac34\\left(x-\\frac32\\right)\\Rightarrow y=-\\frac34x-\\frac78\" data-display=\"false\"></span></p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=-\\frac78\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=-\\frac76\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"\\left(-\\frac12,3\\right)\" data-display=\"false\"></span> and Gradient: 2</p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p6-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Line: <span class=\"inline-math\" data-math=\"y-3=-\\frac12\\left(x+\\frac12\\right)\\Rightarrow y=-\\frac12x+\\frac{11}4\" data-display=\"false\"></span></p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\frac{11}4\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=\\frac{11}2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"\\left(1,\\frac{11}2\\right)\" data-display=\"false\"></span> and Gradient: <span class=\"inline-math\" data-math=\"-\\frac56\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p7-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Line: <span class=\"inline-math\" data-math=\"y-\\frac{11}2=\\frac65(x-1)\\Rightarrow y=\\frac65x+\\frac{43}{10}\" data-display=\"false\"></span></p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\frac{43}{10}\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=-\\frac{43}{12}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"(-1,0)\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span></p>","<p>Midpoint: <span class=\"inline-math\" data-math=\"(1,3)\" data-display=\"false\"></span> and Gradient: <span class=\"inline-math\" data-math=\"-\\frac12\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p7-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Line: <span class=\"inline-math\" data-math=\"y-3=2(x-1)\\Rightarrow y=2x+1\" data-display=\"false\"></span></p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=1\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=-\\frac12\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.08-q4","number":4,"question":"<p>For each of the following Argand diagrams state the conditions for the set of points <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span> represented by the shaded region. Give your answer in set notation.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/1.08/questions/assets/diagrams/108-q4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/1.08/questions/assets/diagrams/108-q4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/1.08/questions/assets/diagrams/108-q4c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/1.08/questions/assets/diagrams/108-q4d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"|z-2-2i|=2\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\tan\\left(\\frac11\\right)=\\frac\\pi4\" data-display=\"false\"></span> which gives <span class=\"inline-math\" data-math=\"\\arg(z-2-2i)=\\frac\\pi4\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"\\arg(z-2-2i)\\leq\\frac\\pi4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z-2-2i|\\leq2\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\left\\{z\\in\\mathbb C:\\arg(z-2-2i)\\leq\\frac\\pi4\\right\\}\\cap\\{z\\in\\mathbb C:|z-2-2i|\\leq2\\}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"|z-1|=|z-3|\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"|z-2|=1\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"|z-2|&lt;1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z-1|\\leq|z-3|\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-2|&lt;1\\}\\cap\\{z\\in\\mathbb C:|z-1|\\leq|z-3|\\}\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"|z-2i|=|z-2|\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\tan\\left(\\frac11\\right)=\\frac\\pi4\" data-display=\"false\"></span> which gives <span class=\"inline-math\" data-math=\"\\arg(z-2)=\\frac\\pi4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\arg(z-2)=\\frac{3\\pi}4\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"|z-2i|&gt;|z-2|\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\frac\\pi4\\leq\\arg(z-2)&lt;\\frac{3\\pi}4\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-2i|&gt;|z-2|\\}\\cap\\left\\{z\\in\\mathbb C:\\frac\\pi4\\leq\\arg(z-2)&lt;\\frac{3\\pi}4\\right\\}\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"|z-1-i|=2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"|z-1-i|=1\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"|z-1-i|\\leq2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z-1-i|&gt;1\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:1&lt;|z-1-i|\\leq2\\}\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.08-q5","number":5,"question":"<ol class=\"parts\" start=\"1\"><li><p>On separate Argand diagrams shade the regions represented by <span class=\"inline-math\" data-math=\"|z-3-4i|\\leq2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"0\\leq\\arg(z-2-i)\\leq\\frac\\pi4\" data-display=\"false\"></span></p></li><li><p>Hence shade the region satisfied by</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-3-4i|\\leq2\\}\" data-display=\"true\"></span><span class=\"equation\" data-math=\"\\cap\\left\\{z\\in\\mathbb C:0\\leq\\arg(z-2-i)\\leq\\frac\\pi4\\right\\}\" data-display=\"true\"></span></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p9-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p9-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y-1=\\tan\\frac\\pi4(x-2)\\Rightarrow y=x-1\" data-display=\"false\"></span> so the line passes through <span class=\"inline-math\" data-math=\"(5,4)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p9-3.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"fm-core1-1.08-q6","number":6,"question":"<ol class=\"parts\" start=\"1\"><li><p>On separate Argand diagrams shade the regions represented by <span class=\"inline-math\" data-math=\"\\left|z-2-\\frac12i\\right|&lt;4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\frac\\pi4&lt;\\arg(z-3)\\leq\\frac{3\\pi}4\" data-display=\"false\"></span>. You do not need to label intersections with the axes.</p></li><li><p>Determine whether <span class=\"inline-math\" data-math=\"2+\\frac12i\" data-display=\"false\"></span> lies in the region <span class=\"inline-math\" data-math=\"\\frac\\pi4&lt;\\arg(z-3)\\leq\\frac{3\\pi}4\" data-display=\"false\"></span></p></li><li><p>Hence, shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\left\\{z\\in\\mathbb C:\\left|z-2-\\frac12i\\right|\\leq4\\right\\}\" data-display=\"true\"></span><span class=\"equation\" data-math=\"\\cap\\left\\{z\\in\\mathbb C:\\frac\\pi4&lt;\\arg(z-3)\\leq\\frac{3\\pi}4\\right\\}\" data-display=\"true\"></span></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p10-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p10-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Consider the <span class=\"inline-math\" data-math=\"\\arg(z-3)=\\frac{3\\pi}4\" data-display=\"false\"></span> in cartesian form:</p>","<span class=\"equation\" data-math=\"y=\\tan\\left(\\frac{3\\pi}4\\right)(x-3)\\Rightarrow y=-(x-3)=-x+3\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=-2+3=1\" data-display=\"false\"></span> so the line lies above the point <span class=\"inline-math\" data-math=\"2+\\frac12i\" data-display=\"false\"></span></p>","<p>So <span class=\"inline-math\" data-math=\"2+\\frac12i\" data-display=\"false\"></span> is not in the region.</p>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p11-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"fm-core1-1.08-q7","number":7,"question":"<ol class=\"parts\" start=\"1\"><li><p>Shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-4-3i|\\leq2\\}\" data-display=\"true\"></span></li><li><p>Find the greatest and least value of <span class=\"inline-math\" data-math=\"\\arg z\" data-display=\"false\"></span> giving your answer in exact form.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p11-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Find where <span class=\"inline-math\" data-math=\"y=mx\" data-display=\"false\"></span> meets the equation of the circle <span class=\"inline-math\" data-math=\"(x+4)^2+(y+4)^2=4\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}(x-4)^2+(mx-3)^2=4\\\\x^2-8x+16+m^2x^2-6mx+9-4=0\\\\(1+m^2)x^2+(-8-6m)x+21=0\\end{gathered}\" data-display=\"true\"></span>","<p>Consider <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\begin{gathered}(-8-6m)^2-4\\times21(1+m^2)=0\\\\36m^2+96m+64-84-84m^2=0\\\\-48m^2+96m-20=0\\\\12m^2-24m+5=0\\\\m=\\frac{24\\pm\\sqrt{576-240}}{24}=1\\pm\\frac{\\sqrt{21}}6\\end{gathered}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"m=\\tan\\theta\\therefore\\arctan\\left(1+\\frac{\\sqrt{21}}6\\right)=1.055017\\ldots\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\arctan\\left(1-\\frac{\\sqrt{21}}6\\right)=0.231984\\ldots\" data-display=\"false\"></span></p>","<p>Therefore the least and greatest value of <span class=\"inline-math\" data-math=\"\\arg z\" data-display=\"false\"></span> are:</p>","<p>0.232 (3 SF) and 1.06 (3 SF)</p>"]},{"id":"fm-core1-1.08-q8","number":8,"question":"<ol class=\"parts\" start=\"1\"><li><p>Shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z+4+4i|\\leq2\\}\" data-display=\"true\"></span></li><li><p>Find the greatest and least value of <span class=\"inline-math\" data-math=\"\\arg z\" data-display=\"false\"></span> giving your answer to 3 significant figures.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p12-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Find where <span class=\"inline-math\" data-math=\"y=mx\" data-display=\"false\"></span> meets the equation of the circle <span class=\"inline-math\" data-math=\"(x+4)^2+(y+4)^2=4\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}(x+4)^2+(mx+4)^2=4\\\\x^2+8x+16+m^2x^2+8mx+16-4=0\\\\(1+m^2)x^2+(8+8m)x+28=0\\end{gathered}\" data-display=\"true\"></span>","<p>Consider <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\begin{gathered}(8+8m)^2-4\\times28(1+m^2)=0\\\\64m^2+128m+64-112-112m^2=0\\\\3m^2-8m+3=0\\\\m=\\frac{8\\pm\\sqrt{64-36}}6=\\frac43\\pm\\frac{\\sqrt7}3\\end{gathered}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"m=\\tan\\theta\\therefore\\arctan\\left(\\frac43+\\frac{\\sqrt7}3\\right)=1.146765\\ldots\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\arctan\\left(\\frac43-\\frac{\\sqrt7}3\\right)=0.424031\\ldots\" data-display=\"false\"></span></p>","<p>Therefore the least and greatest value of <span class=\"inline-math\" data-math=\"\\arg z\" data-display=\"false\"></span> are:</p>","<p><span class=\"inline-math\" data-math=\"1.146765\\ldots-\\pi=-1.99\" data-display=\"false\"></span> (3 SF) and <span class=\"inline-math\" data-math=\"0.424031\\ldots-\\pi=-2.72\" data-display=\"false\"></span> (3 SF)</p>"]},{"id":"fm-core1-1.08-q9","number":9,"question":"<p>For the complex number <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span> find the maximum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> such that</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"|z-4i|\\leq4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"0\\leq\\arg z\\leq\\frac\\pi3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-2|\\leq4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\frac\\pi4\\leq\\arg z\\leq\\frac{3\\pi}4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-1-i|\\leq3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z-1-i|\\geq|z+1-i|\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p13-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Maximum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the point where the circle and the line intersect:</p>","<p><span class=\"inline-math\" data-math=\"x^2+(y-4)^2=16\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac\\pi3\\right)x=\\sqrt3x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}x^2+(\\sqrt3x-4)^2=16\\\\x^2+3x^2-8\\sqrt3x+16=16\\\\4x^2-8\\sqrt3x=0\\\\4x(x-2\\sqrt3)=0\\therefore x=2\\sqrt3,\\ y=6\\end{gathered}\" data-display=\"true\"></span>","<p>Maximum value of <span class=\"inline-math\" data-math=\"|z|=\\sqrt{(2\\sqrt3)^2+6^2}=4\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p14-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Maximum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the point where the circle and the line created by <span class=\"inline-math\" data-math=\"\\arg z=\\frac\\pi4\" data-display=\"false\"></span> intersect:</p>","<p><span class=\"inline-math\" data-math=\"(x-2)^2+y^2=16\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac\\pi2\\right)x=x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}(x-2)^2+x^2=16\\\\x^2-4x+4+x^2=16\\\\2x^2-4x-12=0\\therefore x=1\\pm\\sqrt7,\\ y=1\\pm\\sqrt7\\end{gathered}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\begin{aligned}\\text{Maximum value of }|z|&amp;=\\sqrt{(1+\\sqrt7)^2+(1+\\sqrt7)^2}\\\\&amp;=\\sqrt{16+4\\sqrt7}=\\sqrt{4(4+\\sqrt7)}=2\\sqrt{4+\\sqrt7}\\end{aligned}\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>Midpoint <span class=\"inline-math\" data-math=\"(0,1)\" data-display=\"false\"></span> so line is <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p15-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Maximum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the point where the circle crosses the imaginary axis:</p>","<p><span class=\"inline-math\" data-math=\"(x-1)^2+(y-1)^2=9\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"(y-1)^2=8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore y=1\\pm2\\sqrt2,\\ x=0\" data-display=\"true\"></span>","<p>Maximum value of <span class=\"inline-math\" data-math=\"|z|=\\sqrt{0^2+(1+2\\sqrt2)^2}=1+2\\sqrt2\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.08-q10","number":10,"question":"<p>For the complex number <span class=\"inline-math\" data-math=\"z\" data-display=\"false\"></span> find the minimum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> such that</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"|z-2-4i|\\leq2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"0\\leq\\arg z\\leq\\frac\\pi4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-3-3i|\\leq\\sqrt2\" data-display=\"false\"></span><br>and <span class=\"inline-math\" data-math=\"\\frac\\pi4\\leq\\arg(z-1-i)\\leq\\frac{3\\pi}4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"|z-2|\\leq3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"|z+7-5i|\\leq|z+3+7i|\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p15-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Minimum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the first point where the circle and the line intersect:</p>","<p><span class=\"inline-math\" data-math=\"(x-2)^2+(y-4)^2=4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac\\pi4\\right)x=x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}(x-2)^2+(x-4)^2=4\\\\x^2-4x+4+x^2-8x+16=4\\\\2x^2-12x+16=0\\\\\\therefore x=2\\text{ or }x=4,\\text{ so }(2,2)\\text{ and }(4,4)\\end{gathered}\" data-display=\"true\"></span>","<p>Minimum value of <span class=\"inline-math\" data-math=\"|z|=\\sqrt{2^2+2^2}=\\sqrt8=2\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p16-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Minimum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the first point where the <span class=\"inline-math\" data-math=\"\\arg z=\\frac\\pi4\" data-display=\"false\"></span> meets the circle:</p>","<p><span class=\"inline-math\" data-math=\"(x-3)^2+(y-3)^2=2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac\\pi4\\right)x=x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"(x-3)^2+(x-3)^2=2\\Rightarrow2(x-3)^2=2\\Rightarrow(x-3)^2=1\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore x=2\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=4\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"(2,2)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(4,4)\" data-display=\"false\"></span></p>","<p>Minimum value of <span class=\"inline-math\" data-math=\"|z|=\\sqrt{2^2+2^2}=\\sqrt8=2\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"(-5,-1)\" data-display=\"false\"></span> Gradient: <span class=\"inline-math\" data-math=\"-3\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"y+1=\\frac13(x+5)\\Rightarrow y=\\frac13x+\\frac23\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p16-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Minimum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the shortest distance to the line:</p>","<p>Find the perpendicular line passing through <span class=\"inline-math\" data-math=\"(0,0)\" data-display=\"false\"></span>: <span class=\"inline-math\" data-math=\"y=-3x\" data-display=\"false\"></span></p>","<p>Find the point where these two lines intersect: <span class=\"inline-math\" data-math=\"y=\\frac13x+\\frac23\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=-3x\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"\\frac13x+\\frac23=-3x\\therefore x=-\\frac15\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\frac35\" data-display=\"false\"></span> so minimum value of <span class=\"inline-math\" data-math=\"|z|=\\sqrt{\\left(-\\frac15\\right)^2+\\left(\\frac35\\right)^2}=\\frac{\\sqrt{10}}5\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.08-q11","number":11,"question":"<ol class=\"parts\" start=\"1\"><li><p>Shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-2-2i|\\leq6\\}\" data-display=\"true\"></span><p>Label any intersects with the axes.</p></li><li><p>Determine whether <span class=\"inline-math\" data-math=\"9\\left(\\cos\\frac\\pi4+i\\sin\\frac\\pi4\\right)\" data-display=\"false\"></span> lies in the region.</p></li><li><p>Determine whether <span class=\"inline-math\" data-math=\"4\\left(\\cos\\frac{3\\pi}4+i\\sin\\frac{3\\pi}4\\right)\" data-display=\"false\"></span> lies in the region.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"(x-2)^2+(y-2)^2=36\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(y-1)^2=32\\Rightarrow y=2\\pm4\\sqrt2\" data-display=\"false\"></span></p>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(x-2)^2=35\\Rightarrow x=2\\pm4\\sqrt2\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p17-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\left|9\\left(\\cos\\frac\\pi4+i\\sin\\frac\\pi4\\right)\\right|=9\" data-display=\"true\"></span>","<p>Distance to the maximum <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> with angle <span class=\"inline-math\" data-math=\"\\frac\\pi4\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"\\sqrt{2^2+2^2}+6=6+2\\sqrt2\" data-display=\"false\"></span></p>","<p>Since <span class=\"inline-math\" data-math=\"6+2\\sqrt2&lt;9\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"9\\left(\\cos\\frac\\pi4+i\\sin\\frac\\pi4\\right)\" data-display=\"false\"></span> is outside the region.</p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\left|4\\left(\\cos\\frac{3\\pi}4+i\\sin\\frac{3\\pi}4\\right)\\right|=4\" data-display=\"true\"></span>","<p>Distance away from when <span class=\"inline-math\" data-math=\"\\Real(z)=0\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"\\left|4\\cos\\frac{3\\pi}4\\right|=2\\sqrt2\" data-display=\"false\"></span></p>","<p>Since <span class=\"inline-math\" data-math=\"|2\\sqrt2|&lt;|2-4\\sqrt2|\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"4\\left(\\cos\\frac{3\\pi}4+i\\sin\\frac{3\\pi}4\\right)\" data-display=\"false\"></span> lies inside the region.</p>"]},{"id":"fm-core1-1.08-q12","number":12,"question":"<ol class=\"parts\" start=\"1\"><li><p>Shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\left\\{z\\in\\mathbb C:\\tan^{-1}\\left(\\frac34\\right)\\leq\\arg(z+3i)\\leq\\frac\\pi2\\right\\}\" data-display=\"true\"></span><span class=\"equation\" data-math=\"\\cap\\{z\\in\\mathbb C:|z-1+2i|\\leq1\\}\" data-display=\"true\"></span></li><li><p>Find the value at which <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is a minimum.</p></li></ol><p><strong>Prerequisite knowledge for Q13-Q15: Sector Area in Radians</strong></p>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p18-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Minimum value of <span class=\"inline-math\" data-math=\"|z|\" data-display=\"false\"></span> is the shortest distance to the circle along the line which passes through the origin and <span class=\"inline-math\" data-math=\"1-2i\" data-display=\"false\"></span>:</p>","<p><span class=\"inline-math\" data-math=\"(x-1)^2+(y+2)^2=1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=-2x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{gathered}(x-1)^2+(-2x+2)^2=1\\\\x^2-2x+1+4x^2-8x+4=1\\\\5x^2-10x+4=0\\\\\\therefore x=1\\pm\\frac{\\sqrt5}5,\\ y=-2\\mp\\frac{2\\sqrt5}5\\end{gathered}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\begin{aligned}\\text{so minimum value of }|z|&amp;=\\sqrt{\\left(1-\\frac{\\sqrt5}5\\right)^2+\\left(-2+\\frac{2\\sqrt5}5\\right)^2}\\\\&amp;=\\sqrt{6-2\\sqrt5}=\\sqrt5-1\\\\&amp;\\approx1.23\\text{ (3 SF)}\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.08-q13","number":13,"question":"<p>A region may be defined by</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z|\\leq5\\}\\cap\\left\\{z\\in\\mathbb C:\\frac\\pi3\\leq\\arg z\\leq\\frac{3\\pi}4\\right\\}\" data-display=\"true\"></span><p>as shown in the diagram below:</p><figure class=\"diagram\"><img src=\"assets/1.08/questions/assets/diagrams/108-q13.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><ol class=\"parts\" start=\"1\"><li><p>Find the complex numbers representing points <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> on the diagram, giving your answer in exact form.</p></li><li><p>Find the area of the shaded region.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>The circle <span class=\"inline-math\" data-math=\"x^2+y^2=25\" data-display=\"false\"></span> and the line <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac\\pi3\\right)x=\\sqrt3x\" data-display=\"false\"></span> when:</p>","<span class=\"equation\" data-math=\"\\begin{gathered}x^2+(\\sqrt3x)^2=25\\\\x^2+3x^2=25\\\\x^2=\\frac{25}4\\end{gathered}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x=\\pm\\frac52\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"x=\\frac52\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac{5\\sqrt3}2\" data-display=\"false\"></span></p>","<p>The circle <span class=\"inline-math\" data-math=\"x^2+y^2=25\" data-display=\"false\"></span> and the line <span class=\"inline-math\" data-math=\"y=\\tan\\left(\\frac{3\\pi}4\\right)x=-x\" data-display=\"false\"></span> when:</p>","<span class=\"equation\" data-math=\"\\begin{gathered}x^2+(-x)^2=25\\\\2x^2=25\\\\x^2=\\frac{25}2\\end{gathered}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x=\\pm\\sqrt{\\frac{25}2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"x=-\\frac{5\\sqrt2}2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac{5\\sqrt2}2\" data-display=\"false\"></span></p>","<p>So <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"-\\frac{5\\sqrt2}2+\\frac{5\\sqrt2}2i\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"\\frac52+\\frac{5\\sqrt3}2i\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p>Area of sector <span class=\"inline-math\" data-math=\"=\\frac12\\times5^2\\times\\left(\\frac{3\\pi}4-\\frac\\pi3\\right)=\\frac{125\\pi}{24}\" data-display=\"false\"></span> units<span class=\"inline-math\" data-math=\"^2\" data-display=\"false\"></span></p>","<p>Area of circle <span class=\"inline-math\" data-math=\"=5^2\\pi=25\\pi\" data-display=\"false\"></span> units<span class=\"inline-math\" data-math=\"^2\" data-display=\"false\"></span></p>","<p>Shaded area <span class=\"inline-math\" data-math=\"=25\\pi-\\frac{125\\pi}{24}=\\frac{475\\pi}{24}\" data-display=\"false\"></span> units<span class=\"inline-math\" data-math=\"^2\" data-display=\"false\"></span></p>"]},{"id":"fm-core1-1.08-q14","number":14,"question":"<ol class=\"parts\" start=\"1\"><li><p>Shade on an Argand diagram, the set of points</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z-4-3i|\\leq4\\}\" data-display=\"true\"></span><span class=\"equation\" data-math=\"\\cap\\{z\\in\\mathbb C:|z-2|\\leq|z-10|\\}\" data-display=\"true\"></span></li><li><p>Show that the area of the shaded region is</p><span class=\"equation\" data-math=\"\\frac{32}3\\pi+4\\sqrt3\" data-display=\"true\"></span></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Midpoint: <span class=\"inline-math\" data-math=\"(6,0)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p19-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p>Radius of circle: 4</p>","<p>Cartesian equation of circle: <span class=\"inline-math\" data-math=\"(x-4)^2+(y-3)^2=16\" data-display=\"false\"></span></p>","<p>So when <span class=\"inline-math\" data-math=\"x=6\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=3\\pm2\\sqrt3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p20-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Let <span class=\"inline-math\" data-math=\"\\phi=\\frac12\\theta\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\tan\\phi=\\frac{3+2\\sqrt3-3}{6-4}=\\sqrt3\" data-display=\"true\"></span>","<p>Angle: <span class=\"inline-math\" data-math=\"\\theta=2\\times\\arctan\\sqrt3=2\\arctan(\\sqrt3)=\\frac{2\\pi}3\" data-display=\"false\"></span></p>","<p>Area is Circle -- Segment</p>","<p>Area of segment:</p>","<span class=\"equation\" data-math=\"\\frac12r^2(\\theta-\\sin\\theta)=\\frac12\\times4^2\\left(\\frac{2\\pi}3-\\sin\\frac{2\\pi}3\\right)=\\frac{16\\pi}3-4\\sqrt3\" data-display=\"true\"></span>","<p>Area of circle: <span class=\"inline-math\" data-math=\"\\pi r^2=16\\pi\" data-display=\"false\"></span></p>","<p>Area of shaded region: <span class=\"inline-math\" data-math=\"16\\pi-\\frac{16\\pi}3+4\\sqrt3=\\frac{32\\pi}3+4\\sqrt3\" data-display=\"false\"></span> as req.</p>"]},{"id":"fm-core1-1.08-q15","number":15,"question":"<p>Find the area of the region defined by</p><span class=\"equation\" data-math=\"\\{z\\in\\mathbb C:|z|\\leq2\\}\\cap\\{z\\in\\mathbb C:|z-3i|\\leq3\\}\" data-display=\"true\"></span><p>Give your answer to 3 significant figures.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p21-1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Points of intersection are where <span class=\"inline-math\" data-math=\"x^2+(y-3)^2=9\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x^2+y^2=4\" data-display=\"false\"></span> intersect:</p>","<span class=\"equation\" data-math=\"\\begin{gathered}4-y^2+(y-3)^2=9\\\\4-y^2+y^2-6y+9=9\\end{gathered}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore y=\\frac23\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\left(-\\frac{4\\sqrt2}3,\\frac23\\right)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\left(\\frac{4\\sqrt2}3,\\frac23\\right)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/1.08/solutions/assets/diagrams/108-p21-2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p><span class=\"inline-math\" data-math=\"\\tan\\theta=\\frac{\\frac{4\\sqrt2}3}{3-\\frac23}=\\frac{4\\sqrt2}7\\therefore\" data-display=\"false\"></span> the required angle is <span class=\"inline-math\" data-math=\"2\\arctan\\left(\\frac{4\\sqrt2}7\\right)\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"\\therefore\" data-display=\"false\"></span> segment of larger circle is</p>","<span class=\"equation\" data-math=\"\\frac12\\times3^2\\times2\\arctan\\left(\\frac{4\\sqrt2}7\\right)-\\frac12\\times3^2\\sin\\left(2\\arctan\\left(\\frac{4\\sqrt2}7\\right)\\right)=1.7172888\\ldots\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\tan\\phi=\\frac{\\frac{4\\sqrt2}3}{\\frac23}=2\\sqrt2\\therefore\" data-display=\"false\"></span> the required angle is <span class=\"inline-math\" data-math=\"2\\arctan(2\\sqrt2)\" data-display=\"false\"></span></p>","<p><span class=\"inline-math\" data-math=\"\\therefore\" data-display=\"false\"></span> segment of smaller circle is</p>","<span class=\"equation\" data-math=\"\\frac12\\times2^2\\times2\\arctan(2\\sqrt2)-\\frac12\\times2^2\\sin(2\\arctan(2\\sqrt2))=0.5763007515\\ldots\" data-display=\"true\"></span>","<p>Total is area is <span class=\"inline-math\" data-math=\"\\approx2.29\" data-display=\"false\"></span> units<span class=\"inline-math\" data-math=\"^2\" data-display=\"false\"></span> (3 SF)</p>"]}]