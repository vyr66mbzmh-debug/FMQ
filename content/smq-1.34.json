[{"id":"smq-year1-1.34-q1","number":1,"question":"<p>For each of following, find the value(s) of <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> for which <span class=\"inline-math\" data-math=\"\\dfrac{dy}{dx}=0\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=x^2-2x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-2x^2+18x-37\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x^3-3x^2+3x-4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x-\\dfrac4{x^2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x+\\dfrac4x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\dfrac{x^3+2}{x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\dfrac{x^4+3}{3x^3}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=2x-2=0\\text{ so }x=1.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=-4x+18=0\\text{ so }x=\\frac92.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=3x^2-6x+3=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"3(x^2-2x+1)=3(x-1)^2\\text{ so }x=1.\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"y=x-4x^{-2}\\text{ and }\\frac{dy}{dx}=1+8x^{-3}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"1+\\frac8{x^3}=0\\Rightarrow x^3=-8\\text{ so }x=-2.\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"y=x+4x^{-1}\\text{ and }\\frac{dy}{dx}=1-4x^{-2}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"1-\\frac4{x^2}=0\\Rightarrow x^2=4\\text{ so }x=\\pm2.\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"y=x^2+2x^{-1}\\text{ and }\\frac{dy}{dx}=2x-2x^{-2}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"2x-\\frac2{x^2}=0\\Rightarrow x^3=1\\text{ so }x=1.\" data-display=\"true\"></span>","<h3 class=\"part-label\">g)</h3><span class=\"equation\" data-math=\"y=\\frac13x+x^{-3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac13-3x^{-4}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac13-\\frac3{x^4}=0\\Rightarrow x^4=9\\text{ so }x=\\pm\\sqrt3.\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.34-q2","number":2,"question":"<p>Find the interval on which each of the following functions are decreasing, giving your answer in set notation:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"f(x)=x^2+4x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=6x^2-10x+5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=x^3-3x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=2x^3+3x^2-36x-10\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=-2x^3-18x^2-48x-1\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"f'(x)=2x+4&lt;0\\text{ so }x&lt;-2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\{x:x\\in\\mathbb R,x&lt;-2\\}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"f'(x)=12x-10&lt;0\\text{ so }x&lt;\\frac56\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left\\{x:x\\in\\mathbb R,x&lt;\\frac56\\right\\}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"f'(x)=3x^2-3=3(x-1)(x+1)&lt;0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"-1&lt;x&lt;1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\{x:x\\in\\mathbb R,-1&lt;x&lt;1\\}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{aligned}f'(x)&amp;=6x^2+6x-36=6(x^2+x-6)\\\\&amp;=6(x+3)(x-2)&lt;0\\end{aligned}\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"-3&lt;x&lt;2\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\{x:x\\in\\mathbb R,-3&lt;x&lt;2\\}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\\begin{aligned}f'(x)&amp;=-6x^2-36x-48=-6(x^2+6x+8)\\\\&amp;=-6(x+4)(x+2)&lt;0\\end{aligned}\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x&lt;-4\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x&gt;-2\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\{x:x\\in\\mathbb R,x&lt;-4\\}\\cup\\{x:x\\in\\mathbb R,x&gt;-2\\}.\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.34-q3","number":3,"question":"<p>Find the interval on which the function</p><span class=\"equation\" data-math=\"f(x)=-x^3-6x^2+15x+1\" data-display=\"true\"></span><p>is increasing, giving your answer in interval notation.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}f'(x)&amp;=-3x^2-12x+15=-3(x^2+4x-5)\\\\&amp;=-3(x+5)(x-1)&gt;0\\end{aligned}\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"-5&lt;x&lt;1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"x\\in(-5,1).\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.34-q4","number":4,"question":"<p>Show that the function</p><span class=\"equation\" data-math=\"f(x)=x^3-3x^2+4x-8\" data-display=\"true\"></span><p>is always increasing.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}f'(x)&amp;=3x^2-6x+4=3(x^2-2x)+4\\\\&amp;=3[(x-1)^2-1]+4=3(x-1)^2+1.\\end{aligned}\" data-display=\"true\"></span>","<p>As <span class=\"inline-math\" data-math=\"(x-1)^2\\geq0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"3(x-1)^2+1&gt;0\" data-display=\"false\"></span> for all <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> always increasing.</p>"]},{"id":"smq-year1-1.34-q5","number":5,"question":"<p>Show that the function</p><span class=\"equation\" data-math=\"f(x)=-3x^3+3x^2-8x+2\" data-display=\"true\"></span><p>is always decreasing.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}f'(x)&amp;=-9x^2+6x-8=-(9x^2-6x+8)\\\\&amp;=-\\left(9\\left(x^2-\\frac23x\\right)+8\\right)\\\\&amp;=-\\left(9\\left(\\left(x-\\frac13\\right)^2-\\frac19\\right)+8\\right)\\\\&amp;=-\\left(9\\left(x-\\frac13\\right)^2-1+8\\right)\\\\&amp;=-9\\left(x-\\frac13\\right)^2-7.\\end{aligned}\" data-display=\"true\"></span>","<p>As <span class=\"inline-math\" data-math=\"\\left(x-\\frac13\\right)^2\\geq0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"-9\\left(x-\\frac13\\right)^2-7&lt;0\" data-display=\"false\"></span> for all <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> always decreasing.</p>"]},{"id":"smq-year1-1.34-q6","number":6,"question":"<p>Find the coordinates of the stationary points of the following curves and determine their types:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-x^2+5x-6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2x^3-15x^2+24x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2x^3-3x^2-12x+7\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-x^3+3x^2+72x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2x^4-4x^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=4x+\\dfrac1x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\dfrac1{x^2}+2x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=3x^6-6x^3\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=-2x+5\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-2x+5=0\\text{ so }x=\\frac52,\\quad y=-\\left(\\frac52\\right)^2+5\\times\\frac52-6=\\frac14\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=-2\\text{ so }\\left.\\frac{d^2y}{dx^2}\\right|_{x=\\frac52}=-2&lt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore\\left(\\frac52,\\frac14\\right)\" data-display=\"false\"></span> is a maximum.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=6x^2-30x+24\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"6(x-1)(x-4)=0\\text{ so }x=1\\text{ or }x=4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=1}=2-15+24=11,\\quad\\left.y\\right|_{x=4}=128-240+96=-16\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=12x-30\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=-18&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=4}=18&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(1,11)\" data-display=\"false\"></span> is a maximum and <span class=\"inline-math\" data-math=\"(4,-16)\" data-display=\"false\"></span> is a minimum.</p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=6x^2-6x-12\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"6(x+1)(x-2)=0\\text{ so }x=-1\\text{ or }x=2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-1}=-2-3+12+7=14,\\quad\\left.y\\right|_{x=2}=16-12-24+7=-13\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=12x-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-1}=-18&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=4}=18&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(-1,14)\" data-display=\"false\"></span> is a maximum and <span class=\"inline-math\" data-math=\"(2,-13)\" data-display=\"false\"></span> is a minimum.</p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=-3x^2+6x+72\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-3(x+4)(x-6)=0\\text{ so }x=-4\\text{ or }x=6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-4}=64+48-288=-176,\\quad\\left.y\\right|_{x=6}=-216+108+432=324\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=-6x+6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-4}=30&gt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=6}=-30&lt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(-4,-176)\" data-display=\"false\"></span> is a minimum and <span class=\"inline-math\" data-math=\"(6,324)\" data-display=\"false\"></span> is a maximum.</p>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=8x^3-8x\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"8x(x^2-1)=8x(x+1)(x-1)=0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-1}=2-4=-2,\\quad\\left.y\\right|_{x=0}=0,\\quad\\left.y\\right|_{x=1}=2-4=-2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=24x^2-8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-1}=16&gt;0,\\quad\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=-8&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=16&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(-1,-2)\" data-display=\"false\"></span> is a minimum, <span class=\"inline-math\" data-math=\"(0,0)\" data-display=\"false\"></span> is a maximum and <span class=\"inline-math\" data-math=\"(1,-2)\" data-display=\"false\"></span> is a minimum.</p>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=4-x^{-2}\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"4-\\frac1{x^2}=0\\Rightarrow4=\\frac1{x^2}\\Rightarrow\\frac14=x^2\\Rightarrow x=\\pm\\frac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-\\frac12}=-2-2=-4,\\quad\\left.y\\right|_{x=\\frac12}=2+2=4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=-2x^{-3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-\\frac12}=-16&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=\\frac12}=16&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore\\left(-\\frac12,-4\\right)\" data-display=\"false\"></span> is a maximum, <span class=\"inline-math\" data-math=\"\\left(\\frac12,4\\right)\" data-display=\"false\"></span> is a minimum.</p>","<h3 class=\"part-label\">g)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=-2x^{-3}+2\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-\\frac2{x^3}+2=0\\Rightarrow2=\\frac2{x^3}\\Rightarrow1=x^3\\Rightarrow x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=1}=1+2=3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=6x^{-4}\\text{ so }\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=6&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(1,3)\" data-display=\"false\"></span> is a minimum.</p>","<h3 class=\"part-label\">h)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=18x^5-18x^2\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"18x^2(x^3-1)=8x(x^2+x+1)(x-1)=0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=0}=0,\\quad\\left.y\\right|_{x=1}=3-6=-3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=90x^4-36x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=0}=0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=54&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=-0.1}=18x^5-18x^2=-0.180818\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=0.1}=18x^5-18x^2=-0.17982\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(0,0)\" data-display=\"false\"></span> is a stationary point of inflection and <span class=\"inline-math\" data-math=\"(1,-3)\" data-display=\"false\"></span> is a minimum.</p>"]},{"id":"smq-year1-1.34-q7","number":7,"question":"<p>Find the coordinates of the maximum of the gradient function of</p><span class=\"equation\" data-math=\"y=-3x^3-2x^2+1.\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=-9x^2-4x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\begin{aligned}-9x^2-4x&amp;=-9\\left(x^2+\\frac49x\\right)\\\\&amp;=-9\\left(\\left(x+\\frac29\\right)^2-\\frac4{81}\\right)\\\\&amp;=-9\\left(x+\\frac29\\right)^2+\\frac49.\\end{aligned}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=-\\frac29\" data-display=\"false\"></span>, the maximum of the gradient function is <span class=\"inline-math\" data-math=\"\\frac49\" data-display=\"false\"></span>. This occurs at <span class=\"inline-math\" data-math=\"\\left(-\\frac29,\\frac{227}{243}\\right)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.34-q8","number":8,"question":"<p>Find the coordinates of the stationary points, determine their types and hence sketch each of the following curves:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=x^3-3x^2-45x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=16x^4-32x^2+7\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=5x-2x^{\\frac12}\" data-display=\"false\"></span> for <span class=\"inline-math\" data-math=\"x\\geq0\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=3x^2-6x-45\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"3(x^2-2x-15)=3(x-5)(x+3)=0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x=-3\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"x=5\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-3}=-27-27+135=81,\\quad\\left.y\\right|_{x=5}=125-75-225=-175\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=6x-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-3}=-24&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=5}=24&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(-3,81)\" data-display=\"false\"></span> is a maximum and <span class=\"inline-math\" data-math=\"(5,-175)\" data-display=\"false\"></span> is a minimum.</p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>. When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>,</p>","<span class=\"equation\" data-math=\"x^3-3x^2-45x=x(x^2-3x-45)=0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x=\\dfrac{3\\pm3\\sqrt{21}}2\" data-display=\"false\"></span>.</p>","<figure class=\"diagram\"><img src=\"assets/smq-1.34/solutions/diagrams/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=64x^3-64x\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"64x(x^2-1)=0\\text{ so }x=-1,\\ x=0\\text{ or }x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=-1}=16-32+7=-9,\\quad\\left.y\\right|_{x=0}=7,\\quad\\left.y\\right|_{x=1}=16-32+7=-9\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=192x^2-64\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=-1}=128&gt;0,\\quad\\left.\\frac{d^2y}{dx^2}\\right|_{x=0}=-64&lt;0\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=1}=128&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore(-1,-9)\" data-display=\"false\"></span> is a minimum, <span class=\"inline-math\" data-math=\"(0,7)\" data-display=\"false\"></span> is a maximum and <span class=\"inline-math\" data-math=\"(1,-9)\" data-display=\"false\"></span> is a minimum.</p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=-1\" data-display=\"false\"></span>.</p>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"16x^4-32x^2-7=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"(2x-1)(2x+1)(4x^2-7)=0\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=-\\frac12\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x=\\dfrac{\\pm\\sqrt7}2\" data-display=\"false\"></span>.</p>","<figure class=\"diagram\"><img src=\"assets/smq-1.34/solutions/diagrams/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=5-x^{-\\frac12}\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"5-\\frac1{\\sqrt x}=0\\Rightarrow\\sqrt x=\\frac15\\text{ so }x=\\frac1{25}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.y\\right|_{x=\\frac1{25}}=\\frac15-\\frac25=-\\frac15\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=\\frac12x^{-\\frac32},\\quad\\left.\\frac{d^2y}{dx^2}\\right|_{x=\\frac1{25}}=\\frac1{150}&gt;0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\therefore\\left(\\frac1{25},-\\frac15\\right)\" data-display=\"false\"></span> is a minimum.</p>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>.</p>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"5x-2\\sqrt x=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\Rightarrow x\\left(5-\\frac2{\\sqrt x}\\right)=0\\text{ so }x=0\" data-display=\"true\"></span>","<p>or <span class=\"inline-math\" data-math=\"5=\\dfrac2{\\sqrt x}\\Rightarrow\\sqrt x=\\dfrac25\\Rightarrow x=\\dfrac4{25}\" data-display=\"false\"></span>.</p>","<figure class=\"diagram\"><img src=\"assets/smq-1.34/solutions/diagrams/s8c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.34-q9","number":9,"question":"<p>Find the values of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> such that</p><span class=\"equation\" data-math=\"y=-x^3+ax^2+bx+c\" data-display=\"true\"></span><p>has stationary points when <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span>, and passes through the point <span class=\"inline-math\" data-math=\"(2,4)\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=-3x^2+2ax+b\" data-display=\"true\"></span>","<p>Stationary point: <span class=\"inline-math\" data-math=\"\\dfrac{dy}{dx}=0\" data-display=\"false\"></span> at <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"0=-3+2a+b\" data-display=\"true\"></span>","<p>Stationary point: <span class=\"inline-math\" data-math=\"\\dfrac{dy}{dx}=0\" data-display=\"false\"></span> at <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"0=-27+6a+b\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"a=6\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b=-9\" data-display=\"false\"></span>.</p>","<p>At <span class=\"inline-math\" data-math=\"(2,4)\" data-display=\"false\"></span>,</p>","<span class=\"equation\" data-math=\"4=-8+24-18+c\\text{ so }c=6.\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.34-q10","number":10,"question":"<p>Find the values of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> such that</p><span class=\"equation\" data-math=\"y=ax^4+bx^2+c\" data-display=\"true\"></span><p>passes through the points <span class=\"inline-math\" data-math=\"(1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(0,-3)\" data-display=\"false\"></span>, and has a stationary point at <span class=\"inline-math\" data-math=\"(\\sqrt2,1)\" data-display=\"false\"></span>. Find all the stationary points and determine their types.</p>","steps":["<span class=\"equation\" data-math=\"y=ax^4+bx^2+c\\text{ so }\\frac{dy}{dx}=4ax^3+2bx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=12ax^2+2b\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"(1,0)\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"0=a+b+c\" data-display=\"false\"></span>.</p>","<p><span class=\"inline-math\" data-math=\"(0,-3)\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"c=-3\\Rightarrow a+b=3\" data-display=\"false\"></span>.</p>","<p><span class=\"inline-math\" data-math=\"(\\sqrt2,1)\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"8\\sqrt2a+2\\sqrt2b=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\Rightarrow4a+b=0\\text{ so }a=-1,\\ b=4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=-x^4+4x^2-3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{dy}{dx}=-4x^3+8x=0\\Rightarrow-4x(x^2-2)=0\" data-display=\"true\"></span>","<p>So stat pts at <span class=\"inline-math\" data-math=\"x=0,-\\sqrt2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\sqrt2\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=-12x^2+8\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=0}=8,\\quad\\left.\\frac{d^2y}{dx^2}\\right|_{x=-\\sqrt2}=-16\\text{ and }\\left.\\frac{d^2y}{dx^2}\\right|_{x=\\sqrt2}=-16\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"x=0,-\\sqrt2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\sqrt2\" data-display=\"false\"></span>.</p>","<p>So maximum at <span class=\"inline-math\" data-math=\"(-\\sqrt2,1)\" data-display=\"false\"></span>, minimum at <span class=\"inline-math\" data-math=\"(0,-3)\" data-display=\"false\"></span> and maximum at <span class=\"inline-math\" data-math=\"(\\sqrt2,1)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.34-q11","number":11,"question":"<h3>Prerequisite knowledge for Q11--Q13: Differentiation of the form <span class=\"inline-math\" data-math=\"ae^{kx}\" data-display=\"false\"></span></h3><p>Giving your answer in set notation, find the interval on which <span class=\"inline-math\" data-math=\"f(x)=e^{2x}-x\" data-display=\"false\"></span> is increasing.</p>","steps":["<span class=\"equation\" data-math=\"f'(x)=2e^{2x}-1\\quad\\text{increasing when }f'(x)&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"2e^{2x}-1&gt;0\\Rightarrow e^{2x}&gt;\\frac12\\Rightarrow2x&gt;\\ln\\frac12\\Rightarrow x&gt;\\frac12\\ln\\frac12\" data-display=\"true\"></span>","<p>or <span class=\"inline-math\" data-math=\"x&gt;-\\frac12\\ln2\" data-display=\"false\"></span>.</p>","<p>So <span class=\"inline-math\" data-math=\"x\\in\\left(-\\frac12\\ln2,\\infty\\right)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.34-q12","number":12,"question":"<p>The diagram shows the curve</p><span class=\"equation\" data-math=\"y=5e^x-e^{2x}.\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/smq-1.34/questions/diagrams/q12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><ol class=\"parts\" start=\"1\"><li><p>Find the coordinates at which the curve crosses the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis and the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis.</p></li><li><p>Find the coordinates of the stationary point, giving your answer in exact form.</p></li><li><p>Show that the stationary point is a maximum.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=5-1=3\\ \\therefore(0,4)\" data-display=\"false\"></span>.</p>","<p>When <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"5e^x-e^{2x}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"e^x(5-e^x)=0\\text{ so }e^x=5\\Rightarrow x=\\ln5\\ \\therefore(\\ln5,0).\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=5e^x-2e^{2x}\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"5e^x-2e^{2x}=0\\Rightarrow e^x(5-2e^x)=0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"e^x\\ne0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"5-2e^x=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\Rightarrow e^x=\\frac52\\Rightarrow x=\\ln\\left(\\frac52\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=5e^{\\ln(\\frac52)}-e^{2\\ln(\\frac52)}=\\frac{25}2-\\frac{25}4=\\frac{25}4\" data-display=\"true\"></span>","<p>So stat point at <span class=\"inline-math\" data-math=\"\\left(\\ln\\left(\\frac52\\right),\\frac{25}4\\right)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=5e^x-4e^{2x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=\\ln(\\frac52)}=-\\frac{25}2&lt;0\" data-display=\"true\"></span>","<p>so maximum at <span class=\"inline-math\" data-math=\"\\left(\\ln\\left(\\frac52\\right),\\frac{25}4\\right)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.34-q13","number":13,"question":"<p>Find the coordinates of the stationary point of</p><span class=\"equation\" data-math=\"y=e^{3x}-e^{2x}-e^x\" data-display=\"true\"></span><p>and determine its type.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=3e^{3x}-2e^{2x}-e^x\\quad\\text{stat pt when }\\frac{dy}{dx}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"3e^{3x}-2e^{2x}-e^x=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow e^x(3e^{2x}-2e^x-1)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow e^x(3e^x+1)(e^x-1)=0\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"e^x\\ne0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"3e^x+1\\ne0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"e^x=1\\Rightarrow x=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"y=1-1-1=-1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=9e^{3x}-4e^{2x}-e^x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=0}=4&gt;0\" data-display=\"true\"></span>","<p>so minimum at <span class=\"inline-math\" data-math=\"(0,-1)\" data-display=\"false\"></span>.</p>"]}]