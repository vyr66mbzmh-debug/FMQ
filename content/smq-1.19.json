[{"id":"smq-year1-1.19-q1","number":1,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\sqrt x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\sqrt x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.19/solutions/assets/diagrams/s1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.19/solutions/assets/diagrams/s1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.19-q2","number":2,"question":"<p>Find the equation of the following graph in the form <span class=\"inline-math\" data-math=\"y=k\\sqrt x\" data-display=\"false\"></span>.</p><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"7=k\\sqrt4\\Rightarrow7=2k\\Rightarrow k=\\frac72\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"y=\\frac72\\sqrt x\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.19-q3","number":3,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=\\sqrt{x-a}\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\sqrt{x-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\sqrt{x+3}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.19-q4","number":4,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=\\sqrt{x-a}+b\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\sqrt{x+5}-3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\sqrt{x+2}-\\sqrt2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.19-q5","number":5,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\sqrt{x-3}-2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=4-\\sqrt{x+2}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.19/solutions/assets/diagrams/s5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.19/solutions/assets/diagrams/s5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.19-q6","number":6,"question":"<p>The diagram below shows the graphs <span class=\"inline-math\" data-math=\"y=4-\\sqrt x\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\sqrt{x+4}\" data-display=\"false\"></span>. Find the exact coordinates of the points of intersection.</p><figure class=\"diagram\"><img src=\"assets/smq-1.19/questions/assets/diagrams/q6.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"4-\\sqrt x=\\sqrt{x+4}\\Rightarrow(4-\\sqrt x)^2=x+4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow16-8\\sqrt x+x=x+4\\Rightarrow8\\sqrt x=12\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow\\sqrt x=\\frac32\\Rightarrow x=\\frac94\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=4-\\sqrt{\\frac94}=4-\\frac52=\\frac52\" data-display=\"false\"></span>  So the graphs intersect at <span class=\"inline-math\" data-math=\"(\\frac94,\\frac52)\" data-display=\"false\"></span></p>"]}]