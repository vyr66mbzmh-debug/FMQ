[{"id":"fm-core2-2.68-q1","number":1,"question":"<p>Show that each of the following vectors are eigenvectors of the given matrix <span class=\"inline-math\" data-math=\"\\mathbf A\" data-display=\"false\"></span> and in each case state the associated eigenvalue:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}2\\\\-1\\end{pmatrix},\\mathbf A=\\begin{pmatrix}4&amp;2\\\\1&amp;5\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}1\\\\2\\end{pmatrix},\\mathbf A=\\begin{pmatrix}3&amp;1\\\\2&amp;4\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}1\\\\-2\\end{pmatrix},\\mathbf A=\\begin{pmatrix}0&amp;1\\\\2&amp;-1\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}4&amp;2\\\\1&amp;5\\end{pmatrix}\\begin{pmatrix}2\\\\-1\\end{pmatrix}=\\lambda\\begin{pmatrix}2\\\\-1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\begin{pmatrix}6\\\\-3\\end{pmatrix}=\\lambda\\begin{pmatrix}2\\\\-1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=3\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}3&amp;1\\\\2&amp;4\\end{pmatrix}\\begin{pmatrix}1\\\\2\\end{pmatrix}=\\lambda\\begin{pmatrix}1\\\\2\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\begin{pmatrix}5\\\\10\\end{pmatrix}=\\lambda\\begin{pmatrix}1\\\\2\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=5\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}0&amp;1\\\\2&amp;-1\\end{pmatrix}\\begin{pmatrix}1\\\\-2\\end{pmatrix}=\\lambda\\begin{pmatrix}1\\\\-2\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\begin{pmatrix}-2\\\\4\\end{pmatrix}=\\lambda\\begin{pmatrix}1\\\\2\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-2\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q2","number":2,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}3&amp;-5\\\\0&amp;-2\\end{pmatrix}\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p>Show that the characteristic equation of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"\\lambda^2-\\lambda-6=0\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> is an eigenvalue of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span></p></li><li><p>Hence state the eigenvalues of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}3&amp;-5\\\\0&amp;-2\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}3-\\lambda&amp;-5\\\\0&amp;-2-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(3-\\lambda)(-2-\\lambda)=\\lambda^2-\\lambda-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda^2-\\lambda-6=0\\quad\\text{as req.}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\lambda=3,\\lambda=-2\" data-display=\"false\"></span></p>"]},{"id":"fm-core2-2.68-q3","number":3,"question":"<p>Find the eigenvalues of each of the following matrices:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}4&amp;2\\\\1&amp;3\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}-3&amp;6\\\\-2&amp;1\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}0&amp;-5\\\\1&amp;0\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}2&amp;7\\\\0&amp;2\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}-1&amp;4\\\\-3&amp;5\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}6&amp;-1\\\\2&amp;3\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}\\frac{1}{2}&amp;-\\frac{3}{4}\\\\\\frac{3}{4}&amp;\\frac{1}{2}\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}4&amp;2\\\\1&amp;3\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}4&amp;2\\\\1&amp;3\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}4-\\lambda&amp;2\\\\1&amp;3-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(4-\\lambda)(3-\\lambda)-2=\\lambda^2-7\\lambda+10\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(\\lambda-2)(\\lambda-5)=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=2\\text{ or }\\lambda=5\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}-3&amp;6\\\\-2&amp;1\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}-3&amp;6\\\\-2&amp;1\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-3-\\lambda&amp;6\\\\-2&amp;1-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(-3-\\lambda)(1-\\lambda)-(-12)=\\lambda^2+2\\lambda+9\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\lambda^2+2\\lambda+9=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-1\\pm2\\sqrt2i\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}0&amp;-5\\\\1&amp;0\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}0&amp;-5\\\\1&amp;0\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-\\lambda&amp;-5\\\\1&amp;-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=\\lambda^2-5\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\lambda^2-5=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=\\pm\\sqrt5i\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}2&amp;7\\\\0&amp;2\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}2&amp;7\\\\0&amp;2\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}2-\\lambda&amp;7\\\\0&amp;2-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(2-\\lambda)(2-\\lambda)-0\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(2-\\lambda)(2-\\lambda)=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=2\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}-1&amp;4\\\\-3&amp;5\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}-1&amp;4\\\\-3&amp;5\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-1-\\lambda&amp;4\\\\-3&amp;5-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(-1-\\lambda)(5-\\lambda)-(-12)=\\lambda^2-4\\lambda+7\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\lambda^2-4\\lambda+7=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=2\\pm\\sqrt3i\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}6&amp;-1\\\\2&amp;3\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}6&amp;-1\\\\2&amp;3\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}6-\\lambda&amp;-1\\\\2&amp;3-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(6-\\lambda)(3-\\lambda)-(-2)=\\lambda^2-9\\lambda+20\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(\\lambda-4)(\\lambda-5)=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=4\\text{ or }\\lambda=5\" data-display=\"true\"></span>","<h3 class=\"part-label\">g)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}\\frac{1}{2}&amp;-\\frac{3}{4}\\\\\\frac{3}{4}&amp;\\frac{1}{2}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}\\frac{1}{2}&amp;-\\frac{3}{4}\\\\\\frac{3}{4}&amp;\\frac{1}{2}\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}\\frac{1}{2}-\\lambda&amp;-\\frac{3}{4}\\\\\\frac{3}{4}&amp;\\frac{1}{2}-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(\\frac12-\\lambda)(\\frac12-\\lambda)+\\frac9{16}=\\lambda^2-\\lambda+\\frac{13}{16}\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\lambda^2-\\lambda+\\frac{13}{16}=0\\Rightarrow16\\lambda^2-16\\lambda+13=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=\\frac12\\pm\\frac34i\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q4","number":4,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}5&amp;2\\\\1&amp;4\\end{pmatrix}\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p>Show that the characteristic equation of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"\\lambda^2-9\\lambda+18=0\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> is an eigenvalue of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span></p></li><li><p>Hence state the eigenvalues and corresponding eigenvectors of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}5&amp;2\\\\1&amp;4\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}5&amp;2\\\\1&amp;4\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}5-\\lambda&amp;2\\\\1&amp;4-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(5-\\lambda)(4-\\lambda)-2=\\lambda^2-9\\lambda+18\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda^2-9\\lambda+18=0\\quad\\text{as req.}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>So <span class=\"inline-math\" data-math=\"(\\lambda-3)(\\lambda-6)=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore\\lambda=3\\text{ or }\\lambda=6\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=3\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-3\\mathbf I=\\begin{pmatrix}2&amp;2\\\\1&amp;1\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}2&amp;2\\\\1&amp;1\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 2x+2y=0\\text{ so }-y=x\\therefore\\mathbf v_1=\\begin{pmatrix}-1\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=6\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-6\\mathbf I=\\begin{pmatrix}-1&amp;2\\\\1&amp;-2\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-1&amp;2\\\\1&amp;-2\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -x+2y=0\\text{ so }2y=x\\therefore\\mathbf v_2=\\begin{pmatrix}2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=3,\\mathbf v_1=\\begin{pmatrix}-1\\\\1\\end{pmatrix}\\text{ and }\\lambda_2=6,\\mathbf v_2=\\begin{pmatrix}2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q5","number":5,"question":"<p>Determine the eigenvalues and eigenvectors for each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}4&amp;2\\\\-3&amp;-3\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}-87&amp;120\\\\-64&amp;89\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}60&amp;10\\\\-10&amp;40\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}67&amp;-54\\\\27&amp;-32\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}\\frac{4}{15}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{1}{15}\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}-\\frac{26}{15}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{2}{5}\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}4&amp;2\\\\-3&amp;-3\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}4&amp;2\\\\-3&amp;-3\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}4-\\lambda&amp;2\\\\-3&amp;-3-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(4-\\lambda)(-3-\\lambda)+6=\\lambda^2-\\lambda-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\text{So }(\\lambda+2)(\\lambda-3)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-2\\text{ or }\\lambda=3\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=-2\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+2\\mathbf I=\\begin{pmatrix}6&amp;2\\\\-3&amp;-1\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}6&amp;2\\\\-3&amp;-1\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 6x+2y=0\\text{ so }y=-3x\\therefore\\mathbf v_1=\\begin{pmatrix}1\\\\-3\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=3\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-3\\mathbf I=\\begin{pmatrix}1&amp;2\\\\-3&amp;-6\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}1&amp;2\\\\-3&amp;-6\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow x+2y=0\\text{ so }-2y=x\\therefore\\mathbf v_2=\\begin{pmatrix}-2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=-2,\\mathbf v_1=\\begin{pmatrix}1\\\\-3\\end{pmatrix}\\text{ and }\\lambda_2=3,\\mathbf v_2=\\begin{pmatrix}-2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}-87&amp;120\\\\-64&amp;89\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-87-\\lambda&amp;120\\\\-64&amp;89-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(-87-\\lambda)(89-\\lambda)+64\\times120=\\lambda^2-2\\lambda-7743+7680\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\lambda^2-2\\lambda-63=(\\lambda-9)(\\lambda+7)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=9\\text{ or }\\lambda=-7\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=9\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-9\\mathbf I=\\begin{pmatrix}-96&amp;120\\\\-64&amp;80\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-96&amp;120\\\\-64&amp;80\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -96x+120y=0\\text{ so }5y=4x\\therefore\\mathbf v_1=\\begin{pmatrix}5\\\\4\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=-7\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+7\\mathbf I=\\begin{pmatrix}-80&amp;120\\\\-64&amp;96\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-80&amp;120\\\\-64&amp;96\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -80x+120y=0\\text{ so }3y=2x\\therefore\\mathbf v_2=\\begin{pmatrix}3\\\\2\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=9,\\mathbf v_1=\\begin{pmatrix}5\\\\4\\end{pmatrix}\\text{ and }\\lambda_2=-7,\\mathbf v_2=\\begin{pmatrix}3\\\\2\\end{pmatrix}\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}60&amp;10\\\\-10&amp;40\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}60&amp;10\\\\-10&amp;40\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}60-\\lambda&amp;10\\\\-10&amp;40-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(60-\\lambda)(40-\\lambda)+100=\\lambda^2-100\\lambda+2500\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\text{So }(\\lambda-50)^2=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=50\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda=50\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-50\\mathbf I=\\begin{pmatrix}10&amp;10\\\\-10&amp;-10\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}10&amp;10\\\\-10&amp;-10\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 10x+10y=0\\text{ so }y=-x\\therefore\\mathbf v=\\begin{pmatrix}-1\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=50,\\mathbf v=\\begin{pmatrix}-1\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}67&amp;-54\\\\27&amp;-32\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}67&amp;-54\\\\27&amp;-32\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}67-\\lambda&amp;-54\\\\27&amp;-32-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(67-\\lambda)(-32-\\lambda)-54\\times27=\\lambda^2-35\\lambda-686\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\text{So }(\\lambda-49)(\\lambda+14)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=49\\text{ or }\\lambda=-14\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=49\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-49\\mathbf I=\\begin{pmatrix}18&amp;-54\\\\27&amp;-81\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}18&amp;-54\\\\27&amp;-81\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 18x-54y=0\\text{ so }3y=x\\therefore\\mathbf v_1=\\begin{pmatrix}3\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=-14\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+14\\mathbf I=\\begin{pmatrix}81&amp;-54\\\\27&amp;-18\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}81&amp;-54\\\\27&amp;-18\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 81x-54y=0\\text{ so }2y=3x\\therefore\\mathbf v_2=\\begin{pmatrix}2\\\\3\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=49,\\mathbf v_1=\\begin{pmatrix}3\\\\1\\end{pmatrix}\\text{ and }\\lambda_2=-14,\\mathbf v_2=\\begin{pmatrix}2\\\\3\\end{pmatrix}\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}\\frac{4}{15}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{1}{15}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}\\frac{4}{15}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{1}{15}\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}\\frac{4}{15}-\\lambda&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{1}{15}-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(\\frac4{15}-\\lambda)(-\\frac1{15}-\\lambda)-\\frac29=\\lambda^2-\\frac15\\lambda-\\frac6{25}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow25\\lambda^2-5\\lambda-6=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-\\frac{2}{5}\\text{ or }\\lambda=\\frac{3}{5}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=-\\frac{2}{5}\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+\\frac{2}{5}\\mathbf I=\\begin{pmatrix}\\frac{2}{3}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;\\frac{1}{3}\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}\\frac{2}{3}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;\\frac{1}{3}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow \\frac23x+\\frac23y=0\\text{ so }y=-x\\therefore\\mathbf v_1=\\begin{pmatrix}1\\\\-1\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=\\frac{3}{5}\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-\\frac{3}{5}\\mathbf I=\\begin{pmatrix}-\\frac{1}{3}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{2}{3}\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-\\frac{1}{3}&amp;\\frac{2}{3}\\\\\\frac{1}{3}&amp;-\\frac{2}{3}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -\\frac13x+\\frac23y=0\\text{ so }2y=x\\therefore\\mathbf v_2=\\begin{pmatrix}2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=-\\frac{2}{5},\\mathbf v_1=\\begin{pmatrix}1\\\\-1\\end{pmatrix}\\text{ and }\\lambda_2=\\frac{3}{5},\\mathbf v_2=\\begin{pmatrix}2\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}-\\frac{26}{15}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{2}{5}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}-\\frac{26}{15}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{2}{5}\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-\\frac{26}{15}-\\lambda&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{2}{5}-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(-\\frac{26}{15}-\\lambda)(\\frac25-\\lambda)-\\frac{16}{25}=\\lambda^2+\\frac43\\lambda-\\frac43\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow3\\lambda^2+4\\lambda-4=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-2\\text{ or }\\lambda=\\frac{2}{3}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=-2\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+2\\mathbf I=\\begin{pmatrix}\\frac{4}{15}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{12}{5}\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}\\frac{4}{15}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;\\frac{12}{5}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow \\frac4{15}x+\\frac45y=0\\text{ so }3y=-x\\therefore\\mathbf v_1=\\begin{pmatrix}-3\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=\\frac{2}{3}\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-\\frac{2}{3}\\mathbf I=\\begin{pmatrix}-\\frac{12}{5}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;-\\frac{4}{15}\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-\\frac{12}{5}&amp;\\frac{4}{5}\\\\\\frac{4}{5}&amp;-\\frac{4}{15}\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -\\frac{12}5x+\\frac45y=0\\text{ so }y=3x\\therefore\\mathbf v_2=\\begin{pmatrix}1\\\\3\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=-2,\\mathbf v_1=\\begin{pmatrix}-3\\\\1\\end{pmatrix}\\text{ and }\\lambda_2=\\frac{2}{3},\\mathbf v_2=\\begin{pmatrix}1\\\\3\\end{pmatrix}\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q6","number":6,"question":"<p>Given that the matrix <span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}6&amp;-2\\\\k-3&amp;2\\end{pmatrix}\" data-display=\"false\"></span> has a repeated eigenvalue, find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\begin{pmatrix}6&amp;-2\\\\k-3&amp;2\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}6&amp;-2\\\\k-3&amp;2\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}6-\\lambda&amp;-2\\\\k-3&amp;2-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(6-\\lambda)(2-\\lambda)+2(k-3)=\\lambda^2-8\\lambda+12+2(k-3)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\lambda^2-8\\lambda+6+2k=0\" data-display=\"true\"></span>","<p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(-8)^2-4(6+2k)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow64-24-8k=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore k=5\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q7","number":7,"question":"<p>Given that in each case, the matrix <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> has two distinct real eigenvalues, find the range of values for <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a real constant:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}4&amp;1\\\\k&amp;3\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}k&amp;2\\\\3&amp;5\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}4&amp;1\\\\k&amp;3\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}4&amp;1\\\\k&amp;3\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}4-\\lambda&amp;1\\\\k&amp;3-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(4-\\lambda)(3-\\lambda)-k=\\lambda^2-7\\lambda+12-k=0\" data-display=\"true\"></span>","<p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac&gt;0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(-7)^2-4(12-k)&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow49-48+4k=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore k&gt;-\\frac14\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}k&amp;2\\\\3&amp;5\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}k&amp;2\\\\3&amp;5\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}k-\\lambda&amp;2\\\\3&amp;5-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(k-\\lambda)(5-\\lambda)-6=\\lambda^2-(k+5)\\lambda+(5k-6)=0\" data-display=\"true\"></span>","<p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac&gt;0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(-(k+5))^2-4(5k-6)&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow k^2-10k+49&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow(k-5)^2+24&gt;0\" data-display=\"true\"></span>","<p>Since <span class=\"inline-math\" data-math=\"(k-5)^2\\geq0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"24&gt;0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore k\\in\\mathbb R\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q8","number":8,"question":"<p>The matrix <span class=\"inline-math\" data-math=\"\\mathbf M=\\begin{pmatrix}-1&amp;k\\\\4&amp;k-1\\end{pmatrix}\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a real constant.</p><ol class=\"parts\" start=\"1\"><li><p>Show that the characteristic equation of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> is given by <span class=\"inline-math\" data-math=\"\\lambda^2+(2-k)\\lambda-(5k-1)=0\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> is an eigenvalue of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span></p></li><li><p>Find the range of values for <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> for which <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> has two distinct real eigenvalues.</p></li><li><p>Given that <span class=\"inline-math\" data-math=\"k=9\" data-display=\"false\"></span>, find the eigenvalues and corresponding eigenvectors of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span> giving your answer in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}-1&amp;k\\\\4&amp;k-1\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}-1&amp;k\\\\4&amp;k-1\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}-1-\\lambda&amp;k\\\\4&amp;k-1-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(-1-\\lambda)(k-1-\\lambda)-4k=\\lambda^2+(2-k)\\lambda-k+1-4k\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\lambda^2+(2-k)\\lambda+1-5k=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda^2+(2-k)\\lambda-(5k-1)=0\\quad\\text{as req.}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac&gt;0\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(2-k)^2-4(1-5k)&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow k^2-4k+4-4+20k&gt;0\\Rightarrow k^2+16k&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow k(k+16)&gt;0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore k&lt;-16\\text{ or }k&gt;0\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>When <span class=\"inline-math\" data-math=\"k=9\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\lambda^2-7\\lambda-44=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=-4\\text{ or }\\lambda=11\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_1=-4\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A+4\\mathbf I=\\begin{pmatrix}3&amp;9\\\\4&amp;12\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}3&amp;9\\\\4&amp;12\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow 3x+9y=0\\text{ so }3y=-x\\therefore\\mathbf v_1=\\begin{pmatrix}-3\\\\1\\end{pmatrix}\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"\\lambda_2=11\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"\\mathbf A-11\\mathbf I=\\begin{pmatrix}-12&amp;9\\\\4&amp;-3\\end{pmatrix}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-12&amp;9\\\\4&amp;-3\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=0\\Rightarrow -12x+9y=0\\text{ so }3y=4x\\therefore\\mathbf v_2=\\begin{pmatrix}3\\\\4\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda_1=-4,\\mathbf v_1=\\begin{pmatrix}-3\\\\1\\end{pmatrix}\\text{ and }\\lambda_2=11,\\mathbf v_2=\\begin{pmatrix}3\\\\4\\end{pmatrix}\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q9","number":9,"question":"<p>Show that the matrix</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}p&amp;-q\\\\q&amp;p\\end{pmatrix}\" data-display=\"false\"></span> for constants <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"q\\neq0\" data-display=\"false\"></span> has complex eigenvalues <span class=\"inline-math\" data-math=\"\\lambda=p\\pm qi\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\begin{pmatrix}p&amp;q\\\\0&amp;p\\end{pmatrix}\" data-display=\"false\"></span> for constants <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"q\\neq0\" data-display=\"false\"></span> has eigenvalue given by <span class=\"inline-math\" data-math=\"\\lambda=p\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}p&amp;-q\\\\q&amp;p\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}p&amp;-q\\\\q&amp;p\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}p-\\lambda&amp;-q\\\\q&amp;p-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(p-\\lambda)(p-\\lambda)+q^2=\\lambda^2-2p\\lambda+p^2+q^2=0\" data-display=\"true\"></span>","<p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(-2p)^2-4(p^2+q^2)=4p^2-4p^2-4q^2=-4q^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=\\frac{2p\\pm\\sqrt{-4q^2}}2=\\frac{2p\\pm2qi}2=p\\pm qi\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}p&amp;q\\\\0&amp;p\\end{pmatrix}\\begin{pmatrix}x\\\\y\\end{pmatrix}=\\lambda\\begin{pmatrix}x\\\\y\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf A-\\lambda\\mathbf I=\\begin{pmatrix}p&amp;q\\\\0&amp;p\\end{pmatrix}-\\lambda\\begin{pmatrix}1&amp;0\\\\0&amp;1\\end{pmatrix}=\\begin{pmatrix}p-\\lambda&amp;q\\\\0&amp;p-\\lambda\\end{pmatrix}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\det(\\mathbf A-\\lambda\\mathbf I)=(p-\\lambda)(p-\\lambda)=\\lambda^2-2p\\lambda+p^2=0\" data-display=\"true\"></span>","<p>Discriminant: <span class=\"inline-math\" data-math=\"b^2-4ac\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\therefore(-2p)^2-4(p^2)=4p^2-4p^2=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=\\frac{2p\\pm\\sqrt0}2=\\frac{2p}2=p\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.68-q10","number":10,"question":"<p>Prove that if <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> is an eigenvalue of the matrix <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span>, then <span class=\"inline-math\" data-math=\"\\lambda^n\" data-display=\"false\"></span> is an eigenvalue of <span class=\"inline-math\" data-math=\"\\mathbf M^n\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"n\" data-display=\"false\"></span> is a positive whole number.</p>","steps":["<p>If <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> is an eigenvalue of <span class=\"inline-math\" data-math=\"\\mathbf M\" data-display=\"false\"></span>, then there exists a non-zero vector <span class=\"inline-math\" data-math=\"\\mathbf v\" data-display=\"false\"></span> such that <span class=\"inline-math\" data-math=\"\\mathbf{Mv}=\\lambda\\mathbf v\" data-display=\"false\"></span></p>","<p>Prove true for <span class=\"inline-math\" data-math=\"n=1\" data-display=\"false\"></span>:</p>","<p><span class=\"inline-math\" data-math=\"\\mathbf M^1\\mathbf v=\\mathbf{Mv}=\\lambda\\mathbf v=\\lambda^1\\mathbf v\" data-display=\"false\"></span> so true for <span class=\"inline-math\" data-math=\"n=1\" data-display=\"false\"></span></p>","<p>Assume true for <span class=\"inline-math\" data-math=\"n=k\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\mathbf M^k\\mathbf v=\\lambda^k\\mathbf v\" data-display=\"true\"></span>","<p>Prove true for <span class=\"inline-math\" data-math=\"n=k+1\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\mathbf M^{k+1}\\mathbf v =\\mathbf M^1(\\mathbf M^k\\mathbf v)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\mathbf M(\\lambda^k\\mathbf v)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lambda^k\\mathbf{Mv}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lambda^k\\lambda\\mathbf v\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lambda^{k+1}\\mathbf v\" data-display=\"true\"></span>","<p>Which is <span class=\"inline-math\" data-math=\"\\mathbf M^n\\mathbf v=\\lambda^n\\mathbf v\" data-display=\"false\"></span> with <span class=\"inline-math\" data-math=\"k+1\" data-display=\"false\"></span> substituted in.</p>","<p>As the statement is true for <span class=\"inline-math\" data-math=\"n=1\" data-display=\"false\"></span>, and if the statement is true for <span class=\"inline-math\" data-math=\"n=k\" data-display=\"false\"></span> then the statement is true for <span class=\"inline-math\" data-math=\"n=k+1\" data-display=\"false\"></span>, so the statement is true for all integers <span class=\"inline-math\" data-math=\"n\\geq1\" data-display=\"false\"></span></p>"]},{"id":"fm-core2-2.68-q11","number":11,"question":"<p>For each of the following, <span class=\"inline-math\" data-math=\"\\mathbf v\" data-display=\"false\"></span> is an eigenvector of both the matrix <span class=\"inline-math\" data-math=\"\\mathbf A\" data-display=\"false\"></span> and matrix <span class=\"inline-math\" data-math=\"\\mathbf B\" data-display=\"false\"></span>. The corresponding eigenvalues for <span class=\"inline-math\" data-math=\"\\mathbf v\" data-display=\"false\"></span> in each case are also given, with an equation involving matrix <span class=\"inline-math\" data-math=\"\\mathbf A\" data-display=\"false\"></span>, matrix <span class=\"inline-math\" data-math=\"\\mathbf B\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\mathbf v\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span>. Find the value of <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\lambda_A=3,\\lambda_B=2,\\mathbf {ABv}=\\lambda\\mathbf v\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lambda_A=4,\\lambda_B=5,\\mathbf A^2\\mathbf {Bv}=\\lambda\\mathbf v\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lambda_A=-1,\\lambda_B=2,\\mathbf A\\mathbf B^3\\mathbf v=\\lambda\\mathbf v\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lambda_A=-2,\\lambda_B=-4,\\mathbf A^2\\mathbf B^3\\mathbf v=\\lambda\\mathbf v\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lambda_A=p,\\lambda_B=q,\\mathbf A^m\\mathbf B^n\\mathbf v=\\lambda\\mathbf v\" data-display=\"false\"></span> for constants <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> and positive constants <span class=\"inline-math\" data-math=\"m\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"n\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"3\\times2=6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"4^2\\times5=80\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"-1\\times2^3=-8\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"(-2)^2\\times(-4)^3=-256\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"p^mq^n\" data-display=\"false\"></span></p>"]}]