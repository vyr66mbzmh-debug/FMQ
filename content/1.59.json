[{"id":"fm-core1-1.59-q1","number":1,"question":"<p>Find a vector equation of the planes that pass through these points:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"(1,0,1)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(2,1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(1,2,2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(-1,2,-3)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(3,2,3)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(-1,-1,2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(0,0,0)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(3,4,1)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(-9,-3,7)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Let <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C\" data-display=\"false\"></span> be <span class=\"inline-math\" data-math=\"(1,0,1)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(2,1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(1,2,2)\" data-display=\"false\"></span> respectively.</p>","<span class=\"equation\" data-math=\"\\overrightarrow{AB}=\\overrightarrow{OB}-\\overrightarrow{OA}=\\begin{pmatrix}2\\\\1\\\\0\\end{pmatrix}-\\begin{pmatrix}1\\\\0\\\\1\\end{pmatrix}=\\begin{pmatrix}1\\\\1\\\\-1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AC}=\\overrightarrow{OC}-\\overrightarrow{OA}=\\begin{pmatrix}1\\\\2\\\\2\\end{pmatrix}-\\begin{pmatrix}1\\\\0\\\\1\\end{pmatrix}=\\begin{pmatrix}0\\\\2\\\\1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\mathbf r=\\begin{pmatrix}1\\\\0\\\\1\\end{pmatrix}+\\lambda\\begin{pmatrix}1\\\\1\\\\-1\\end{pmatrix}+\\mu\\begin{pmatrix}0\\\\2\\\\1\\end{pmatrix}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>Let <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C\" data-display=\"false\"></span> be <span class=\"inline-math\" data-math=\"(-1,2,-3)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(3,2,3)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(-1,-1,2)\" data-display=\"false\"></span> respectively.</p>","<span class=\"equation\" data-math=\"\\overrightarrow{AB}=\\overrightarrow{OB}-\\overrightarrow{OA}=\\begin{pmatrix}3\\\\2\\\\3\\end{pmatrix}-\\begin{pmatrix}-1\\\\2\\\\-3\\end{pmatrix}=\\begin{pmatrix}4\\\\0\\\\6\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AC}=\\overrightarrow{OC}-\\overrightarrow{OA}=\\begin{pmatrix}-1\\\\-1\\\\2\\end{pmatrix}-\\begin{pmatrix}-1\\\\2\\\\-3\\end{pmatrix}=\\begin{pmatrix}0\\\\-3\\\\5\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\mathbf r=\\begin{pmatrix}-1\\\\2\\\\-3\\end{pmatrix}+\\lambda\\begin{pmatrix}4\\\\0\\\\6\\end{pmatrix}+\\mu\\begin{pmatrix}0\\\\-3\\\\5\\end{pmatrix}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>Let <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C\" data-display=\"false\"></span> be <span class=\"inline-math\" data-math=\"(0,0,0)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(3,4,1)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(-9,-3,7)\" data-display=\"false\"></span> respectively.</p>","<span class=\"equation\" data-math=\"\\overrightarrow{AB}=\\overrightarrow{OB}-\\overrightarrow{OA}=\\begin{pmatrix}3\\\\4\\\\1\\end{pmatrix}-\\begin{pmatrix}0\\\\0\\\\0\\end{pmatrix}=\\begin{pmatrix}3\\\\4\\\\1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AC}=\\overrightarrow{OC}-\\overrightarrow{OA}=\\begin{pmatrix}-9\\\\-3\\\\7\\end{pmatrix}-\\begin{pmatrix}0\\\\0\\\\0\\end{pmatrix}=\\begin{pmatrix}-9\\\\-3\\\\7\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\mathbf r=\\begin{pmatrix}0\\\\0\\\\0\\end{pmatrix}+\\lambda\\begin{pmatrix}3\\\\4\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}-9\\\\-3\\\\7\\end{pmatrix}\\Rightarrow\\mathbf r=\\lambda\\begin{pmatrix}3\\\\4\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}-9\\\\-3\\\\7\\end{pmatrix}.\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.59-q2","number":2,"question":"<p>Determine whether each of these points lies on the plane with equation</p><span class=\"equation\" data-math=\"\\mathbf r=\\begin{pmatrix}3\\\\2\\\\-5\\end{pmatrix}+\\lambda\\begin{pmatrix}-1\\\\2\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}2\\\\3\\\\-1\\end{pmatrix}:\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"(9,18,-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(24,23,-17)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(19,5,-22)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}9\\\\18\\\\-7\\end{pmatrix}=\\begin{pmatrix}3\\\\2\\\\-5\\end{pmatrix}+\\lambda\\begin{pmatrix}-1\\\\2\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}2\\\\3\\\\-1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"9=3-\\lambda+2\\mu\\Rightarrow-\\lambda+2\\mu=6\\quad(1).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"18=2+2\\lambda+3\\mu\\Rightarrow2\\lambda+3\\mu=16\\quad(2).\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\lambda=2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\mu=4\" data-display=\"false\"></span>. Check:</p>","<span class=\"equation\" data-math=\"-5+2(1)+4(-1)=-7.\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(9,18,-7)\" data-display=\"false\"></span> lies on the plane.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}24\\\\23\\\\-17\\end{pmatrix}=\\begin{pmatrix}3\\\\2\\\\-5\\end{pmatrix}+\\lambda\\begin{pmatrix}-1\\\\2\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}2\\\\3\\\\-1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"24=3-\\lambda+2\\mu\\Rightarrow-\\lambda+2\\mu=21\\quad(1).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"23=2+2\\lambda+3\\mu\\Rightarrow2\\lambda+3\\mu=21\\quad(2).\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\lambda=-3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\mu=9\" data-display=\"false\"></span>. Check:</p>","<span class=\"equation\" data-math=\"-5-3(1)+9(-1)=-17.\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(24,23,-17)\" data-display=\"false\"></span> lies on the plane.</p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}19\\\\5\\\\-22\\end{pmatrix}=\\begin{pmatrix}3\\\\2\\\\-5\\end{pmatrix}+\\lambda\\begin{pmatrix}-1\\\\2\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}2\\\\3\\\\-1\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"19=3-\\lambda+2\\mu\\Rightarrow-\\lambda+2\\mu=16\\quad(1).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"5=2+2\\lambda+3\\mu\\Rightarrow2\\lambda+3\\mu=3\\quad(2).\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"\\lambda=-6\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\mu=5\" data-display=\"false\"></span>. Check:</p>","<span class=\"equation\" data-math=\"-5-6(1)+5(-1)=-16\\ne-22.\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(19,5,-22)\" data-display=\"false\"></span> does not lie on the plane.</p>"]},{"id":"fm-core1-1.59-q3","number":3,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"A(2,-3,5)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B(-6,2,3)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C(34,-23,13)\" data-display=\"false\"></span> relative to a fixed origin <span class=\"inline-math\" data-math=\"O\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p>Find <span class=\"inline-math\" data-math=\"\\lambda\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\mu\" data-display=\"false\"></span> such that <span class=\"inline-math\" data-math=\"\\overrightarrow{OC}=\\lambda\\overrightarrow{OA}+\\mu\\overrightarrow{OB}\" data-display=\"false\"></span>.</p></li><li><p>Explain what your answer to part (a) tells you about the points <span class=\"inline-math\" data-math=\"O\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\overrightarrow{OC}=\\lambda\\overrightarrow{OA}+\\mu\\overrightarrow{OB}\\Rightarrow\\begin{pmatrix}34\\\\-23\\\\13\\end{pmatrix}=\\lambda\\begin{pmatrix}2\\\\-3\\\\5\\end{pmatrix}+\\mu\\begin{pmatrix}-6\\\\2\\\\3\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"34=2\\lambda-6\\mu\\quad(1).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-23=-3\\lambda+2\\mu\\quad(2).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore\\lambda=5\\text{ and }\\mu=-4.\" data-display=\"true\"></span>","<p>Check:</p>","<span class=\"equation\" data-math=\"5(5)-4(3)=13.\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\overrightarrow{OC}=5\\overrightarrow{OA}-4\\overrightarrow{OB}\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p>This tells us that <span class=\"inline-math\" data-math=\"O\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C\" data-display=\"false\"></span> are coplanar.</p>"]},{"id":"fm-core1-1.59-q4","number":4,"question":"<p>The plane <span class=\"inline-math\" data-math=\"\\Pi\" data-display=\"false\"></span> has equation</p><span class=\"equation\" data-math=\"\\mathbf r=\\begin{pmatrix}-2\\\\1\\\\4\\end{pmatrix}+\\lambda\\begin{pmatrix}3\\\\-9\\\\8\\end{pmatrix}+\\mu\\begin{pmatrix}3\\\\7\\\\-14\\end{pmatrix}.\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p>Show that the vector <span class=\"inline-math\" data-math=\"35\\mathbf i+33\\mathbf j+24\\mathbf k\" data-display=\"false\"></span> is a normal vector to the plane.</p></li><li><p>Hence find the equation of the plane <span class=\"inline-math\" data-math=\"\\Pi\" data-display=\"false\"></span> in cartesian form, <span class=\"inline-math\" data-math=\"ax+by+cz=d\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a,b,c\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span> are integers.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}3\\\\-9\\\\8\\end{pmatrix}\\cdot\\begin{pmatrix}35\\\\33\\\\24\\end{pmatrix}=3\\times35+(-9)\\times33+8\\times24=105-297+192=0.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\begin{pmatrix}3\\\\7\\\\-14\\end{pmatrix}\\cdot\\begin{pmatrix}35\\\\33\\\\24\\end{pmatrix}=3\\times35+7\\times33+(-14)\\times24=105+231-336=0.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore35\\mathbf i+33\\mathbf j+24\\mathbf k\\text{ is a normal vector to the plane}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>The plane has equation <span class=\"inline-math\" data-math=\"35x+33y+24z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=35(-2)+33(1)+24(4)=59.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore35x+33y+24z=59.\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.59-q5","number":5,"question":"<p>Determine whether the line with equation <span class=\"inline-math\" data-math=\"\\mathbf r=2\\mathbf i+\\lambda(-\\mathbf i+2\\mathbf j-3\\mathbf k)\" data-display=\"false\"></span> lies in the plane with equation <span class=\"inline-math\" data-math=\"\\mathbf r=\\mathbf j+\\alpha(\\mathbf i-\\mathbf k)+\\beta(\\mathbf i-2\\mathbf j+3\\mathbf k)\" data-display=\"false\"></span>.</p>","steps":["<p>First determine whether the point <span class=\"inline-math\" data-math=\"(2,0,0)\" data-display=\"false\"></span> lies on the plane:</p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}2\\\\0\\\\0\\end{pmatrix}=\\begin{pmatrix}0\\\\1\\\\0\\end{pmatrix}+\\alpha\\begin{pmatrix}1\\\\0\\\\-1\\end{pmatrix}+\\beta\\begin{pmatrix}1\\\\-2\\\\3\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"2=\\alpha+\\beta\\Rightarrow\\alpha+\\beta=2\\quad(1).\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"0=1-2\\beta\\Rightarrow\\beta=\\frac12\\quad(2).\" data-display=\"true\"></span>","<p>Solve (1) and (2) to get <span class=\"inline-math\" data-math=\"\\alpha=\\frac32\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\beta=\\frac12\" data-display=\"false\"></span>. Check:</p>","<span class=\"equation\" data-math=\"0-\\left(\\frac32\\right)+3\\left(\\frac12\\right)=0\\quad\\text{as required}.\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"(2,0,0)\" data-display=\"false\"></span> lies on the plane. We also have that</p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}-1\\\\2\\\\-3\\end{pmatrix}=-\\begin{pmatrix}1\\\\-2\\\\3\\end{pmatrix}\" data-display=\"true\"></span>","<p>so the direction vector of the line is parallel to one of the direction vectors of the plane. So the line lies in the plane.</p>"]},{"id":"fm-core1-1.59-q6","number":6,"question":"<p>Find the acute angle between the following pairs of planes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\Pi_1:\\mathbf r=\\begin{pmatrix}1\\\\0\\\\-4\\end{pmatrix}+\\alpha\\begin{pmatrix}2\\\\1\\\\4\\end{pmatrix}+\\beta\\begin{pmatrix}3\\\\1\\\\0\\end{pmatrix},\\quad \\Pi_2:\\mathbf r=\\begin{pmatrix}-2\\\\1\\\\1\\end{pmatrix}+\\gamma\\begin{pmatrix}1\\\\3\\\\-2\\end{pmatrix}+\\delta\\begin{pmatrix}2\\\\1\\\\-1\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\Pi_1:\\mathbf r=\\begin{pmatrix}6\\\\2\\\\-5\\end{pmatrix}+\\alpha\\begin{pmatrix}4\\\\0\\\\5\\end{pmatrix}+\\beta\\begin{pmatrix}3\\\\-2\\\\0\\end{pmatrix},\\quad \\Pi_2:\\mathbf r=\\begin{pmatrix}4\\\\3\\\\0\\end{pmatrix}+\\gamma\\begin{pmatrix}-2\\\\1\\\\1\\end{pmatrix}+\\delta\\begin{pmatrix}3\\\\-2\\\\3\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\mathbf n_1=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\2&amp;1&amp;4\\\\3&amp;1&amp;0\\end{vmatrix}=(1\\times0-4\\times1)\\mathbf i-(2\\times0-4\\times3)\\mathbf j+(2\\times1-1\\times3)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-4\\mathbf i+12\\mathbf j-\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf n_2=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\1&amp;3&amp;-2\\\\2&amp;1&amp;-1\\end{vmatrix}=(3\\times(-1)-(-2)\\times1)\\mathbf i-(1\\times(-1)-(-2)\\times2)\\mathbf j+(1\\times1-3\\times2)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-\\mathbf i-3\\mathbf j-5\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\cos\\theta=\\frac{\\begin{pmatrix}-4\\\\12\\\\-1\\end{pmatrix}\\cdot\\begin{pmatrix}-1\\\\-3\\\\-5\\end{pmatrix}}{\\sqrt{(-4)^2+12^2+(-1)^2}\\times\\sqrt{(-1)^2+(-3)^2+(-5)^2}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac{(-4)\\times(-1)+12\\times(-3)+(-1)\\times(-5)}{\\sqrt{161}\\times\\sqrt{35}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=-\\frac{27\\sqrt{115}}{805}\\Rightarrow\\theta=111.080\\ldots^\\circ.\" data-display=\"true\"></span>","<p>Acute Angle <span class=\"inline-math\" data-math=\"=68.9^\\circ\" data-display=\"false\"></span> (1 DP).</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\mathbf n_1=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\5&amp;0&amp;2\\\\3&amp;-2&amp;0\\end{vmatrix}=(0\\times0-2\\times(-2))\\mathbf i-(5\\times0-2\\times3)\\mathbf j+(5\\times(-2)-0\\times3)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=4\\mathbf i+6\\mathbf j-10\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\mathbf n_2=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\-2&amp;1&amp;1\\\\3&amp;-2&amp;3\\end{vmatrix}=(1\\times3-1\\times(-2))\\mathbf i-((-2)\\times3-1\\times3)\\mathbf j+((-2)\\times(-2)-1\\times3)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=5\\mathbf i+9\\mathbf j+\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\cos\\theta=\\frac{\\begin{pmatrix}4\\\\6\\\\-10\\end{pmatrix}\\cdot\\begin{pmatrix}5\\\\9\\\\1\\end{pmatrix}}{\\sqrt{4^2+6^2+(-10)^2}\\times\\sqrt{5^2+9^2+1^2}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac{4\\times5+6\\times9+(-10)\\times1}{\\sqrt{152}\\times\\sqrt{107}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac{16\\sqrt{4066}}{2033}\\Rightarrow\\theta=59.878\\ldots^\\circ.\" data-display=\"true\"></span>","<p>Acute Angle <span class=\"inline-math\" data-math=\"=59.9^\\circ\" data-display=\"false\"></span> (1 DP).</p>"]},{"id":"fm-core1-1.59-q7","number":7,"question":"<p>Write the equation of each of these planes in cartesian form, <span class=\"inline-math\" data-math=\"ax+by+cz=d\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a,b,c\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span> are integers:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\begin{pmatrix}0\\\\1\\\\0\\end{pmatrix}+\\lambda\\begin{pmatrix}1\\\\0\\\\0\\end{pmatrix}+\\mu\\begin{pmatrix}0\\\\1\\\\1\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\begin{pmatrix}1\\\\2\\\\5\\end{pmatrix}+\\lambda\\begin{pmatrix}2\\\\1\\\\1\\end{pmatrix}+\\mu\\begin{pmatrix}4\\\\3\\\\1\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\begin{pmatrix}4\\\\2\\\\-5\\end{pmatrix}+\\lambda\\begin{pmatrix}3\\\\2\\\\0\\end{pmatrix}+\\mu\\begin{pmatrix}0\\\\-5\\\\6\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\begin{pmatrix}-2\\\\-8\\\\10\\end{pmatrix}+\\lambda\\begin{pmatrix}-2\\\\4\\\\-7\\end{pmatrix}+\\mu\\begin{pmatrix}5\\\\0\\\\-4\\end{pmatrix}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}1\\\\0\\\\0\\end{pmatrix}\\times\\begin{pmatrix}0\\\\1\\\\1\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\1&amp;0&amp;0\\\\0&amp;1&amp;1\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(0\\times1-0\\times1)\\mathbf i-(1\\times1-0\\times0)\\mathbf j+(1\\times1-0\\times0)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-\\mathbf j+\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-y+z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=-(1)+(0)=-1.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-y+z=-1.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y-z=1.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}2\\\\1\\\\1\\end{pmatrix}\\times\\begin{pmatrix}4\\\\3\\\\1\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\2&amp;1&amp;1\\\\4&amp;3&amp;1\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(1\\times1-1\\times3)\\mathbf i-(2\\times1-1\\times4)\\mathbf j+(2\\times3-1\\times4)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-2\\mathbf i+2\\mathbf j+2\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-2x+2y+2z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=-2(1)+2(2)+2(5)=12.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-2x+2y+2z=12.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow-x+y+z=6.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}3\\\\2\\\\0\\end{pmatrix}\\times\\begin{pmatrix}0\\\\-5\\\\6\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\3&amp;2&amp;0\\\\0&amp;-5&amp;6\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(2\\times6-0\\times(-5))\\mathbf i-(3\\times6-0\\times0)\\mathbf j+(3\\times(-5)-2\\times0)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=12\\mathbf i-18\\mathbf j-15\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"12x-18y-15z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=12(4)-18(2)-15(-5)=87.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"12x-18y-15z=87.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow4x-6y-5z=29.\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}-2\\\\4\\\\-7\\end{pmatrix}\\times\\begin{pmatrix}5\\\\0\\\\-4\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\-2&amp;4&amp;-7\\\\5&amp;0&amp;-4\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(4\\times(-4)-(-7)\\times0)\\mathbf i-((-2)\\times(-4)-(-7)\\times5)\\mathbf j+((-2)\\times0-4\\times5)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-16\\mathbf i-43\\mathbf j-20\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-16x-43y-20z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=-16(-2)-43(-8)-20(10)=176.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-16x-43y-20z=176.\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.59-q8","number":8,"question":"<p>Write the equation of each of these planes in cartesian form, <span class=\"inline-math\" data-math=\"ax+by+cz=d\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a,b,c\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span> are integers:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\mathbf i-10\\mathbf j-2\\mathbf k+\\lambda(2\\mathbf i+\\mathbf j+5\\mathbf k)+\\mu(-3\\mathbf i-2\\mathbf j+9\\mathbf k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\lambda(2\\mathbf i+3\\mathbf j-15\\mathbf k)+\\mu(8\\mathbf i+7\\mathbf k)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}2\\\\1\\\\5\\end{pmatrix}\\times\\begin{pmatrix}-3\\\\-2\\\\9\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\2&amp;1&amp;5\\\\-3&amp;-2&amp;9\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(1\\times9-5\\times(-2))\\mathbf i-(2\\times9-5\\times(-3))\\mathbf j+(2\\times(-2)-1\\times(-3))\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=19\\mathbf i-33\\mathbf j-\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"19x-33y-z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=19(1)-33(-10)-(-2)=351.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"19x-33y-z=351.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}2\\\\3\\\\-15\\end{pmatrix}\\times\\begin{pmatrix}8\\\\0\\\\7\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\2&amp;3&amp;-15\\\\8&amp;0&amp;7\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(3\\times7-(-15)\\times0)\\mathbf i-(2\\times7-(-15)\\times8)\\mathbf j+(2\\times0-3\\times8)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=21\\mathbf i-134\\mathbf j-24\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"21x-134y-24z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=21(0)-134(0)-24(0)=0.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"21x-134y-24z=0.\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.59-q9","number":9,"question":"<p>Write the equation of each of these planes in the form <span class=\"inline-math\" data-math=\"\\mathbf r\\cdot\\mathbf n=p\" data-display=\"false\"></span>:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=\\begin{pmatrix}2\\\\1\\\\1\\end{pmatrix}+\\lambda\\begin{pmatrix}0\\\\1\\\\3\\end{pmatrix}+\\mu\\begin{pmatrix}-2\\\\3\\\\2\\end{pmatrix}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\mathbf r=-8\\mathbf j+16\\mathbf k+\\lambda(20\\mathbf i-8\\mathbf j+5\\mathbf k)+\\mu(15\\mathbf i+8\\mathbf j)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}0\\\\1\\\\3\\end{pmatrix}\\times\\begin{pmatrix}-2\\\\3\\\\2\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\0&amp;1&amp;3\\\\-2&amp;3&amp;2\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(1\\times2-3\\times3)\\mathbf i-(0\\times2-3\\times(-2))\\mathbf j+(0\\times3-1\\times(-2))\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-7\\mathbf i-6\\mathbf j+2\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-7x-6y+2z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=-7(2)-6(1)+2(1)=-18.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-7x-6y+2z=-18.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\begin{pmatrix}x\\\\y\\\\z\\end{pmatrix}\\cdot\\begin{pmatrix}-7\\\\-6\\\\2\\end{pmatrix}=-18.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\mathbf r\\cdot\\begin{pmatrix}-7\\\\-6\\\\2\\end{pmatrix}=-18.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\begin{pmatrix}20\\\\-8\\\\5\\end{pmatrix}\\times\\begin{pmatrix}15\\\\8\\\\0\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\20&amp;-8&amp;5\\\\15&amp;8&amp;0\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=((-8)\\times0-5\\times8)\\mathbf i-(20\\times0-5\\times15)\\mathbf j+(20\\times8-(-8)\\times15)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-40\\mathbf i+75\\mathbf j+280\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-40x+75y+280z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=-40(0)+75(-8)+280(16)=3880.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"-40x+75y+280z=3880.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow-8x+15y+56z=776.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\begin{pmatrix}x\\\\y\\\\z\\end{pmatrix}\\cdot\\begin{pmatrix}-8\\\\15\\\\56\\end{pmatrix}=776.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\mathbf r\\cdot\\begin{pmatrix}-8\\\\15\\\\56\\end{pmatrix}=776.\" data-display=\"true\"></span>"]},{"id":"fm-core1-1.59-q10","number":10,"question":"<p>Three planes, <span class=\"inline-math\" data-math=\"\\Pi_1\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\Pi_2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\Pi_3\" data-display=\"false\"></span>, have equations:</p><span class=\"equation\" data-math=\"\\Pi_1:2x-3y+8z=-2,\\qquad \\Pi_2:\\mathbf r\\cdot\\begin{pmatrix}4\\\\1\\\\2\\end{pmatrix}=3,\\qquad \\Pi_3:\\mathbf r=\\begin{pmatrix}3\\\\-5\\\\6\\end{pmatrix}+\\lambda\\begin{pmatrix}2\\\\6\\\\-3\\end{pmatrix}+\\mu\\begin{pmatrix}5\\\\4\\\\-1\\end{pmatrix}.\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p>Find the acute angle between <span class=\"inline-math\" data-math=\"\\Pi_1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\Pi_2\" data-display=\"false\"></span>.</p></li><li><p>Find the acute angle between <span class=\"inline-math\" data-math=\"\\Pi_1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\Pi_3\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\cos\\theta=\\frac{\\begin{pmatrix}2\\\\-3\\\\8\\end{pmatrix}\\cdot\\begin{pmatrix}-4\\\\1\\\\2\\end{pmatrix}}{\\sqrt{2^2+(-3)^2+8^2}\\times\\sqrt{(-4)^2+1^2+2^2}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac{2\\times(-4)+(-3)\\times1+8\\times2}{\\sqrt{77}\\times\\sqrt{21}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac5{\\sqrt{1617}}\\Rightarrow\\theta=82.857\\ldots^\\circ.\" data-display=\"true\"></span>","<p>Acute angle is <span class=\"inline-math\" data-math=\"82.9^\\circ\" data-display=\"false\"></span> (1 DP).</p>","<h3 class=\"part-label\">b)</h3><p>First write <span class=\"inline-math\" data-math=\"\\Pi_3\" data-display=\"false\"></span> in cartesian form:</p>","<span class=\"equation\" data-math=\"\\begin{pmatrix}2\\\\6\\\\-3\\end{pmatrix}\\times\\begin{pmatrix}5\\\\4\\\\-1\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\2&amp;6&amp;-3\\\\5&amp;4&amp;-1\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(6\\times(-1)-(-3)\\times4)\\mathbf i-(2\\times(-1)-(-3)\\times5)\\mathbf j+(2\\times4-6\\times5)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=6\\mathbf i-13\\mathbf j-22\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"6x-13y-22z=d\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"d=6(3)-13(-5)-22(6)=-49.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"6x-13y-22z=-49.\" data-display=\"true\"></span>","<p>Now find the angle:</p>","<span class=\"equation\" data-math=\"\\cos\\theta=\\frac{\\begin{pmatrix}2\\\\-3\\\\8\\end{pmatrix}\\cdot\\begin{pmatrix}6\\\\-13\\\\-22\\end{pmatrix}}{\\sqrt{2^2+(-3)^2+8^2}\\times\\sqrt{6^2+(-13)^2+(-22)^2}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=\\frac{2\\times6+(-3)\\times(-13)+8\\times(-22)}{\\sqrt{77}\\times\\sqrt{689}}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow\\cos\\theta=-\\frac{125}{\\sqrt{53053}}\\Rightarrow\\theta=122.867\\ldots^\\circ.\" data-display=\"true\"></span>","<p>Acute angle is <span class=\"inline-math\" data-math=\"180^\\circ-122.867\\ldots^\\circ=57.1^\\circ\" data-display=\"false\"></span> (1 DP).</p>"]},{"id":"fm-core1-1.59-q11","number":11,"question":"<p>A plane contains the points <span class=\"inline-math\" data-math=\"A(0,2,6)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B(-3,1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C(3,0,-4)\" data-display=\"false\"></span>. Find the equation of the plane in the form <span class=\"inline-math\" data-math=\"ax+by+cz+d=0\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a,b,c\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span> are integers.</p>","steps":["<span class=\"equation\" data-math=\"\\overrightarrow{AB}=\\overrightarrow{OB}-\\overrightarrow{OA}=\\begin{pmatrix}-3\\\\1\\\\0\\end{pmatrix}-\\begin{pmatrix}0\\\\2\\\\6\\end{pmatrix}=\\begin{pmatrix}-3\\\\-1\\\\-6\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AC}=\\overrightarrow{OC}-\\overrightarrow{OA}=\\begin{pmatrix}3\\\\0\\\\-4\\end{pmatrix}-\\begin{pmatrix}0\\\\2\\\\6\\end{pmatrix}=\\begin{pmatrix}3\\\\-2\\\\-10\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AB}\\times\\overrightarrow{AC}=\\begin{pmatrix}-3\\\\-1\\\\-6\\end{pmatrix}\\times\\begin{pmatrix}3\\\\-2\\\\-10\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\-3&amp;-1&amp;-6\\\\3&amp;-2&amp;-10\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=((-1)\\times(-10)-(-6)\\times(-2))\\mathbf i-((-3)\\times(-10)-(-6)\\times3)\\mathbf j+((-3)\\times(-2)-(-1)\\times3)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=-2\\mathbf i-48\\mathbf j+9\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation <span class=\"inline-math\" data-math=\"-2x-48y+9z+d=0\" data-display=\"false\"></span>. Substitute in the point <span class=\"inline-math\" data-math=\"A(0,2,6)\" data-display=\"false\"></span> to find <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"-2(0)-48(2)+9(6)+d=0\\Rightarrow d=42.\" data-display=\"true\"></span>","<p>So the plane has equation <span class=\"inline-math\" data-math=\"-2x-48y+9z+42=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"2x+48y-9z-42=0\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core1-1.59-q12","number":12,"question":"<p>A plane contains the points <span class=\"inline-math\" data-math=\"A(4,-5,1)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"B(2,3,12)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"C(6,-2,10)\" data-display=\"false\"></span>. Find the equation of the plane in the form <span class=\"inline-math\" data-math=\"(\\mathbf r-\\mathbf a)\\cdot\\mathbf n=0\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\overrightarrow{AB}=\\overrightarrow{OB}-\\overrightarrow{OA}=\\begin{pmatrix}2\\\\3\\\\12\\end{pmatrix}-\\begin{pmatrix}4\\\\-5\\\\1\\end{pmatrix}=\\begin{pmatrix}-2\\\\8\\\\11\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AC}=\\overrightarrow{OC}-\\overrightarrow{OA}=\\begin{pmatrix}6\\\\-2\\\\10\\end{pmatrix}-\\begin{pmatrix}4\\\\-5\\\\1\\end{pmatrix}=\\begin{pmatrix}2\\\\3\\\\9\\end{pmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\overrightarrow{AB}\\times\\overrightarrow{AC}=\\begin{pmatrix}-2\\\\8\\\\11\\end{pmatrix}\\times\\begin{pmatrix}2\\\\3\\\\9\\end{pmatrix}=\\begin{vmatrix}\\mathbf i&amp;\\mathbf j&amp;\\mathbf k\\\\-2&amp;8&amp;11\\\\2&amp;3&amp;9\\end{vmatrix}.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=(8\\times9-11\\times3)\\mathbf i-((-2)\\times9-11\\times2)\\mathbf j+((-2)\\times3-8\\times2)\\mathbf k.\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"=39\\mathbf i+40\\mathbf j-22\\mathbf k.\" data-display=\"true\"></span>","<p>The plane has equation</p>","<span class=\"equation\" data-math=\"\\left(\\mathbf r-\\begin{pmatrix}4\\\\-5\\\\1\\end{pmatrix}\\right)\\cdot\\begin{pmatrix}39\\\\40\\\\-22\\end{pmatrix}=0.\" data-display=\"true\"></span>"]}]