[{"id":"fm-core2-2.09-q1","number":1,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to\\infty}(1+e^{-x})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}(x^4e^x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to\\infty}(1+e^{-x})=1.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to0}(x^4e^x)=0.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q2","number":2,"question":"<p>Evaluate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\sqrt{\\frac{x^3-2x^2+10}{4x^3+1}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\frac{x+4}{\\sqrt{3x^2-5x+2}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\frac{\\sqrt{2x^3-5x^2-1}}{x^2-2}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Since <span class=\"inline-math\" data-math=\"4\\times0^3+1\\ne0\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to0}\\sqrt{\\frac{x^3-2x^2+10}{4x^3+1}} =\\lim_{x\\to0}\\sqrt{\\frac{0-0+10}{0+1}}=\\sqrt{10}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>Since <span class=\"inline-math\" data-math=\"3\\times0^2-0+2\\ne0\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to0}\\frac{x+4}{\\sqrt{3x^2-5x+2}} =\\lim_{x\\to0}\\frac{0+4}{\\sqrt{0-0+2}}=\\frac4{\\sqrt2}=2\\sqrt2.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>Since <span class=\"inline-math\" data-math=\"(0)^2-2\\ne0\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to0}\\frac{\\sqrt{2x^3-5x^2-1}}{x^2-2} =\\lim_{x\\to0}\\sqrt{\\frac{0-0-1}{0-2}}=\\frac1{\\sqrt2}=\\frac{\\sqrt2}{2}.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q3","number":3,"question":"<p>Find each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{5-4n}{n}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{2n-3}{n^2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{n+7}{2n+1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{10-3n}{n-3}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{5-4n}{n} =\\lim_{n\\to\\infty}\\left(\\frac5n-\\frac{4n}{n}\\right)=\\lim_{n\\to\\infty}\\left(\\frac5n-4\\right)=-4.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{2n-3}{n^2} =\\lim_{n\\to\\infty}\\left(\\frac{2n}{n^2}-\\frac3{n^2}\\right)=\\lim_{n\\to\\infty}\\left(\\frac2n-\\frac3{n^2}\\right)=0.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{n+7}{2n+1} =\\lim_{n\\to\\infty}\\left(\\frac{1+\\frac7n}{2+\\frac1n}\\right)=\\frac12.\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{10-3n}{n-3} =\\lim_{n\\to\\infty}\\left(\\frac{\\frac{10}{n}-3}{1-\\frac3n}\\right)=-3.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q4","number":4,"question":"<p>Evaluate these limits:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{2n^2-4n+5}{3n^2+n-4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{5n^2+2n+1}{2n^2-n-7}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{n\\to\\infty}\\frac{5n^2-4n+5}{4-n-7n^2}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{2n^2-4n+5}{3n^2+n-4} =\\lim_{n\\to\\infty}\\left(\\frac{\\frac{2n^2}{n^2}-\\frac{4n}{n^2}+\\frac5{n^2}}{\\frac{3n^2}{n^2}+\\frac n{n^2}-\\frac4{n^2}}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{n\\to\\infty}\\left(\\frac{2-\\frac4n+\\frac5{n^2}}{3+\\frac1n-\\frac4{n^2}}\\right)=\\frac23.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{5n^2+2n+1}{2n^2-n-7} =\\lim_{n\\to\\infty}\\left(\\frac{\\frac{5n^2}{n^2}+\\frac{2n}{n^2}+\\frac1{n^2}}{\\frac{2n^2}{n^2}-\\frac n{n^2}-\\frac7{n^2}}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{n\\to\\infty}\\left(\\frac{5+\\frac2n+\\frac1{n^2}}{2-\\frac1n-\\frac7{n^2}}\\right)=\\frac52.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\lim_{n\\to\\infty}\\frac{5n^2-4n+5}{4-n-7n^2} =\\lim_{n\\to\\infty}\\left(\\frac{\\frac{5n^2}{n^2}-\\frac{4n}{n^2}+\\frac5{n^2}}{\\frac4{n^2}-\\frac n{n^2}-\\frac{7n^2}{n^2}}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{n\\to\\infty}\\left(\\frac{5-\\frac4n+\\frac5{n^2}}{\\frac4{n^2}-\\frac1n-7}\\right)=-\\frac57.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q5","number":5,"question":"<p>Find each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to2}\\frac{x^2-4}{x-2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to1}\\frac{x^3-1}{x-1}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to2}\\left(\\frac{x^2-4}{x-2}\\right) =\\lim_{x\\to2}\\left(\\frac{(x-2)(x+2)}{x-2}\\right).\n\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"x\\ne2\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to2}\\left(\\frac{(x-2)(x+2)}{x-2}\\right)=\\lim_{x\\to2}(x+2)=4.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to1}\\left(\\frac{x^3-1}{x-1}\\right) =\\lim_{x\\to1}\\left(\\frac{(x-1)(x^2+x+1)}{x-1}\\right).\n\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"x\\ne1\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to1}(x^2+x+1)=1+1+1=3.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q6","number":6,"question":"<p>Find each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to3}\\frac{\\sqrt{x}-\\sqrt3}{x-3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to4}\\frac{\\sqrt{x}-2}{x-4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to k}\\frac{\\sqrt{k}-\\sqrt{x}}{x-k}\" data-display=\"false\"></span>, for positive constant <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to3}\\left(\\frac{\\sqrt{x}-\\sqrt3}{x-3}\\right) =\\lim_{x\\to3}\\left(\\frac{\\sqrt{x}-\\sqrt3}{x-3}\\times\\frac{\\sqrt{x}+\\sqrt3}{\\sqrt{x}-\\sqrt3}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{x\\to3}\\left(\\frac{x-3}{(x-3)(\\sqrt{x}+\\sqrt3)}\\right).\n\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"x\\ne3\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to3}\\left(\\frac{x-3}{(x-3)(\\sqrt{x}+\\sqrt3)}\\right)=\\lim_{x\\to3}\\left(\\frac1{\\sqrt{x}+\\sqrt3}\\right)=\\frac1{2\\sqrt3}.\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to4}\\left(\\frac{\\sqrt{x}-2}{x-4}\\right) =\\lim_{x\\to4}\\left(\\frac{\\sqrt{x}-2}{x-4}\\times\\frac{\\sqrt{x}+2}{\\sqrt{x}+2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{x\\to4}\\left(\\frac{x-4}{(x-4)(\\sqrt{x}+2)}\\right).\n\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"x\\ne4\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to4}\\left(\\frac{x-4}{(x-4)(\\sqrt{x}+2)}\\right)=\\lim_{x\\to4}\\left(\\frac1{\\sqrt{x}+2}\\right)=\\frac14.\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\lim_{x\\to k}\\left(\\frac{\\sqrt{k}-\\sqrt{x}}{x-k}\\right) =\\lim_{x\\to k}\\left(\\frac{\\sqrt{k}-\\sqrt{x}}{x-k}\\times\\frac{\\sqrt{k}+\\sqrt{x}}{\\sqrt{k}-\\sqrt{x}}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\lim_{x\\to k}\\left(\\frac{k-x}{(x-k)(\\sqrt{k}+\\sqrt{x})}\\right).\n\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"x\\ne k\" data-display=\"false\"></span>, then</p>","<span class=\"equation\" data-math=\"\\lim_{x\\to k}\\left(\\frac{k-x}{(x-k)(\\sqrt{k}+\\sqrt{x})}\\right)=\\lim_{x\\to k}\\left(\\frac{-1}{\\sqrt{k}+\\sqrt{x}}\\right)=-\\frac1{2\\sqrt{k}}.\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q7","number":7,"question":"<p>Use small angle approximations to show that</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{\\sin x}{x}\\right)=1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{\\cos x-1}{x}\\right)=0\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{\\sin x}{x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{x}{x}\\right)=\\lim_{x\\to0}1=1.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{\\cos x-1}{x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{1-\\frac{x^2}{2}-1}{x}\\right)=\\lim_{x\\to0}\\left(\\frac{-\\frac{x^2}{2}}{x}\\right)=\\lim_{x\\to0}\\left(-\\frac{x}{2}\\right)=0.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q8","number":8,"question":"<p>Find each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{\\sin3x}{x}\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{1-\\cos4x}{x^2}\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{4\\cos x}{\\sin x+\\cos x}\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{\\sin3x}{x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{3x}{x}\\right)=\\lim_{x\\to0}(3)=3.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{1-\\cos4x}{x^2}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{1-(1-\\frac{(4x)^2}{2})}{x^2}\\right)=\\lim_{x\\to0}\\left(\\frac{8x^2}{x^2}\\right)=\\lim_{x\\to0}(8)=8.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{4\\cos x}{\\sin x+\\cos x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{4(1-\\frac{x^2}{2})}{x+1-\\frac{x^2}{2}}\\right)=\\lim_{x\\to0}\\left(\\frac{4-2x^2}{x+1-\\frac{x^2}{2}}\\right)=4.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q9","number":9,"question":"<p>By using the approximation <span class=\"inline-math\" data-math=\"\\ln(1+\\frac{x}{2})=\\frac{x}{2}-\\frac{x^2}{8}+\\frac{x^3}{24}\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> is small, find <span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{8\\ln(1+\\frac{x}{2})}{x}\\right)\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{8\\ln(1+\\frac{x}{2})}{x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{8(\\frac{x}{2}-\\frac{x^2}{8}+\\frac{x^3}{24})}{x}\\right)=\\lim_{x\\to0}\\left(\\frac{4x-x^2+\\frac{x^3}{3}}{x}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\lim_{x\\to0}\\left(4-x+\\frac{x^2}{3}\\right)=4.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q10","number":10,"question":"<p>By using the approximations <span class=\"inline-math\" data-math=\"\\cos2x\\approx1-2x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\sin3x\\approx3x-\\frac92x^3\" data-display=\"false\"></span> for small values of <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>, find <span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{3x\\cos2x-\\sin3x}{3x^3}\\right)\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{3x\\cos2x-\\sin3x}{3x^3}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{3x(1-2x^2)-(3x-\\frac92x^3)}{3x^3}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\lim_{x\\to0}\\left(\\frac{-\\frac32x^3}{3x^3}\\right)=\\lim_{x\\to0}\\left(-\\frac12\\right)=-\\frac12.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.09-q11","number":11,"question":"<p>By considering the first 4 terms in the expansion of <span class=\"inline-math\" data-math=\"\\sqrt{4+x}\" data-display=\"false\"></span>, find <span class=\"inline-math\" data-math=\"\\displaystyle\\lim_{x\\to0}\\left(\\frac{-2+\\sqrt{x+4}}{x}\\right)\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n(4+x)^{\\frac12} =2\\left(1+\\frac{x}{4}\\right)^{\\frac12}=2\\left(1+\\frac18x-\\frac1{128}x^2+\\frac1{1024}x^3\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2+\\frac14x-\\frac1{64}x^2+\\frac1{512}x^3.\n\" data-display=\"true\"></span>","<p>So</p>","<span class=\"equation\" data-math=\"\n\\lim_{x\\to0}\\left(\\frac{-2+\\sqrt{x+4}}{x}\\right) \\approx\\lim_{x\\to0}\\left(\\frac{-2+2+\\frac14x-\\frac1{64}x^2+\\frac1{512}x^3}{x}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\lim_{x\\to0}\\left(\\frac{\\frac{x}{4}-\\frac{x^2}{64}+\\frac{x^3}{512}}{x}\\right)=\\lim_{x\\to0}\\left(\\frac14-\\frac{x}{64}+\\frac{x^2}{512}\\right)=\\frac14.\n\" data-display=\"true\"></span>"]}]