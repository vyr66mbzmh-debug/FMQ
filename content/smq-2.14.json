[{"id":"smq-year2-2.14-q1","number":1,"question":"<p>Sketch the following graphs, in radians, identifying the coordinates of any endpoints and the equations of any asymptotes.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arcsin x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arccos x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arctan x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s1c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q2","number":2,"question":"<p>Sketch the following graphs, in radians, identifying the coordinates of any endpoints.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=3\\arcsin x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac14\\arcsin x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q3","number":3,"question":"<p>Sketch the following graphs, in radians, identifying the coordinates of any endpoints.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arcsin3x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcsin\\frac25x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q4","number":4,"question":"<p>The following are all functions that are single transformations of <span class=\"inline-math\" data-math=\"y=\\arcsin x\" data-display=\"false\"></span>. Write down the equation in each case.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q4c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q4d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\arcsin x+\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-\\arcsin x\\text{ or }y=\\arcsin(-x)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\arcsin(x-1)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=\\arcsin(x+1)-\\frac\\pi2\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q5","number":5,"question":"<p>Sketch the graph of <span class=\"inline-math\" data-math=\"y=-\\arcsin(x+1)\" data-display=\"false\"></span> in radians, identifying the coordinates of any endpoints.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s5.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q6","number":6,"question":"<p>Sketch the graph of <span class=\"inline-math\" data-math=\"y=\\frac\\pi2-\\arcsin x\" data-display=\"false\"></span> in radians, identifying the coordinates of any endpoints.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s6.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q7","number":7,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"f(x)=\\arcsin x\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"-1\\le x\\le1\" data-display=\"false\"></span>. Find the exact value for which <span class=\"inline-math\" data-math=\"\\pi-3f(2x-3)=0\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n\\pi-3\\arcsin(2x-3)=0 \\Rightarrow\\arcsin(2x-3)=\\frac\\pi3,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x-3=\\sin\\frac\\pi3 \\Rightarrow2x-3=\\frac{\\sqrt3}2\\Rightarrow x=\\frac{\\frac{\\sqrt3}2+3}2,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx =\\frac{\\sqrt3}4+\\frac32.\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.14-q8","number":8,"question":"<p><strong>Prerequisite knowledge for Q8: Domain and Range and Inverse Functions</strong> It is given that <span class=\"inline-math\" data-math=\"f(x)=2-3\\sin x\" data-display=\"false\"></span> for <span class=\"inline-math\" data-math=\"-\\frac\\pi2\\le x\\le\\frac\\pi2\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p>Show that <span class=\"inline-math\" data-math=\"f^{-1}(x)=\\arcsin\\left(\\frac{2-x}3\\right)\" data-display=\"false\"></span>.</p></li><li><p>State the domain and range of <span class=\"inline-math\" data-math=\"y=f^{-1}(x)\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"f(x)=2-3\\sin x\" data-display=\"false\"></span>. Let <span class=\"inline-math\" data-math=\"y=f(x)\\Rightarrow y=2-3\\sin x\" data-display=\"false\"></span>. Swap <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>s and <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>s: <span class=\"inline-math\" data-math=\"x=2-3\\sin y\" data-display=\"false\"></span>. Rearrange to make <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> the subject: <span class=\"inline-math\" data-math=\"x=2-3\\sin y\\Rightarrow3\\sin y=2-x\\Rightarrow\\sin y=\\frac{2-x}3\\Rightarrow y=\\arcsin\\left(\\frac{2-x}3\\right)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p>Domain of <span class=\"inline-math\" data-math=\"f^{-1}(x)\" data-display=\"false\"></span>: <span class=\"inline-math\" data-math=\"\\{x:x\\in\\mathbb R,-1\\le x\\le5\\}\" data-display=\"false\"></span>. Range of <span class=\"inline-math\" data-math=\"f^{-1}(x)\" data-display=\"false\"></span>: <span class=\"inline-math\" data-math=\"\\{f^{-1}(x):f^{-1}(x)\\in\\mathbb R,-\\frac\\pi2\\le f^{-1}(x)\\le\\frac\\pi2\\}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q9","number":9,"question":"<p>Sketch the following graphs, in radians, identifying the coordinates of any endpoints.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\frac52\\arccos x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac15\\arccos x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s9a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s9b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q10","number":10,"question":"<p>Sketch the following graphs, in radians, identifying the coordinates of any endpoints.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arccos4x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arccos\\frac45x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q11","number":11,"question":"<p>The following are all functions that are single transformations of <span class=\"inline-math\" data-math=\"y=\\arccos x\" data-display=\"false\"></span>. Write down the equation in each case.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q11a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q11b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q11c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q11d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=-\\arccos x\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\arccos(-x)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\arccos x-\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=\\arccos(x+1)-\\pi\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q12","number":12,"question":"<p>Sketch the graph of <span class=\"inline-math\" data-math=\"y=-\\arccos(x-1)\" data-display=\"false\"></span> in radians, identifying the coordinates of any endpoints.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q13","number":13,"question":"<p>Sketch the graph of <span class=\"inline-math\" data-math=\"y=\\arccos2x-\\pi\" data-display=\"false\"></span> in radians, identifying the coordinates of any endpoints.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s13.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q14","number":14,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"g(x)=\\arccos x\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"-1\\le x\\le1\" data-display=\"false\"></span>. Find the exact value for which <span class=\"inline-math\" data-math=\"6\\pi-9g(0.2x+3)=0\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\n6\\pi-9\\arccos(\\tfrac15x+3)=0 \\Rightarrow\\arccos(\\tfrac15x+3)=\\frac{2\\pi}3,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\tfrac15x+3=\\cos\\frac{2\\pi}3 \\Rightarrow\\tfrac15x+3=-\\frac12\\Rightarrow\\tfrac15x=-\\frac72\\Rightarrow x=-\\frac{35}2.\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.14-q15","number":15,"question":"<ol class=\"parts\" start=\"1\"><li><p>Solve the equation <span class=\"inline-math\" data-math=\"\\arccos x=\\frac\\pi3\" data-display=\"false\"></span>.</p></li><li><p>Hence find the exact value of <span class=\"inline-math\" data-math=\"\\arcsin x\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\arccos x=\\frac\\pi3\\Rightarrow x=\\cos\\frac\\pi3=\\frac12\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin x=\\theta\\Rightarrow\\sin\\theta=x\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"\\sin\\theta=\\frac12\\Rightarrow\\theta=\\frac\\pi6\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q16","number":16,"question":"<p>Sketch the following graphs, in radians, identifying the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=8\\arctan x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac16\\arctan x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s16a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s16b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q17","number":17,"question":"<p>Sketch the following graphs, in radians, identifying the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=2+3\\arctan x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=5-2\\arctan x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s17a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s17b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q18","number":18,"question":"<p>Sketch the following graphs, in radians, identifying any endpoints and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=3\\arcsin x+\\pi\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arccos(\\frac12x-2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2\\arctan x-\\frac\\pi3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcsin(4x+5)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac{2\\pi}3-\\arccos x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=3\\pi-\\arctan x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18e.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">f)</h3><figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s18f.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year2-2.14-q19","number":19,"question":"<p>Write down <strong>two</strong> suitable equations for the following graphs:</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q19a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q19b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-2.14/questions/assets/diagrams/214-q19c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=2\\arcsin x+\\frac\\pi4\" data-display=\"false\"></span>.  <span class=\"inline-math\" data-math=\"y=\\frac{5\\pi}4-2\\arccos x\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac\\pi2+\\arcsin(\\frac14-2x)\" data-display=\"false\"></span>.  <span class=\"inline-math\" data-math=\"y=\\arccos(2x-\\frac14)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\arcsin(3x+\\frac56)\" data-display=\"false\"></span>.  <span class=\"inline-math\" data-math=\"y=\\frac\\pi2-\\arccos(3x+\\frac56)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q20","number":20,"question":"<p>Solve the equation <span class=\"inline-math\" data-math=\"\\arcsin x=\\arccos x\" data-display=\"false\"></span>.</p>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arcsin x\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"y=\\arccos x\" data-display=\"false\"></span> also. <span class=\"inline-math\" data-math=\"\\sin y=x\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\cos y=x\" data-display=\"false\"></span>. We know that <span class=\"inline-math\" data-math=\"\\sin^2y+\\cos^2y=1\\Rightarrow x^2+x^2=1\\Rightarrow2x^2=1\\Rightarrow x^2=\\frac12\\Rightarrow x=\\pm\\frac1{\\sqrt2}\" data-display=\"false\"></span>.</p>","<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s20.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>As can be seen from the diagram above, there is only one point of intersection and that is when <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> is positive, so the only solution is <span class=\"inline-math\" data-math=\"x=\\frac1{\\sqrt2}=\\frac{\\sqrt2}2\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q21","number":21,"question":"<p><strong>Prerequisite knowledge for Q21: Double Angle Formulae</strong></p><ol class=\"parts\" start=\"1\"><li><p>Solve the equation <span class=\"inline-math\" data-math=\"\\arcsin x=2\\arccos x\" data-display=\"false\"></span>.</p></li><li><p>Solve the equation <span class=\"inline-math\" data-math=\"2\\arcsin x=\\arccos x\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Let <span class=\"inline-math\" data-math=\"y=\\arcsin x\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"y=2\\arccos x\" data-display=\"false\"></span> also. <span class=\"inline-math\" data-math=\"\\sin y=x\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\cos(\\frac12y)=x\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"\\cos2A=2\\cos^2A-1\\Rightarrow\\cos y=2\\cos^2(\\frac12y)-1\\Rightarrow\\cos y=2x^2-1\" data-display=\"false\"></span>. We know that <span class=\"inline-math\" data-math=\"\\sin^2y+\\cos^2y=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\nx^2+(2x^2-1)^2=1 \\Rightarrow x^2+4x^4-4x^2+1=1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4x^4-3x^2=0 \\Rightarrow(4x^2-3)x^2=0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx=0\\text{ or }4x^2-3=0 \\Rightarrow x=\\pm\\frac{\\sqrt3}2.\n\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s21a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>As can be seen from the diagram above, there is only one point of intersection and that is when <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> is positive, so the only solution is <span class=\"inline-math\" data-math=\"x=\\frac{\\sqrt3}2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p>Let <span class=\"inline-math\" data-math=\"y=2\\arcsin x\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"y=\\arccos x\" data-display=\"false\"></span> also. <span class=\"inline-math\" data-math=\"\\sin(\\frac12y)=x\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\cos y=x\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"\\cos2A=2\\cos^2A-1\\Rightarrow\\cos y=2\\cos^2(\\frac12y)-1\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"x=2\\cos^2(\\frac12y)-1\\Rightarrow\\cos^2(\\frac12y)=\\frac{x+1}2\\Rightarrow\\cos(\\frac12y)=\\sqrt{\\frac{x+1}2}\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"\\sin2A=2\\sin A\\cos A\\Rightarrow\\sin y=2\\sin(\\frac12y)\\cos(\\frac12y)\\Rightarrow\\sin y=2x\\sqrt{\\frac{x+1}2}\" data-display=\"false\"></span>. We know that <span class=\"inline-math\" data-math=\"\\sin^2y+\\cos^2y=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\n\\left(2x\\sqrt{\\frac{x+1}2}\\right)^2+x^2=1 \\Rightarrow4x^2\\left(\\frac{x+1}2\\right)+x^2=1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2x^3+2x^2+x^2-1=0 \\Rightarrow2x^3+3x^2-1=0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2x-1)(x+1)^2=0 \\Rightarrow x=\\frac12\\text{ or }x=-1.\n\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/smq-2.14/solutions/assets/diagrams/214-s21b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>As can be seen from the diagram above, there is only one point of intersection and that is when <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> is positive, so the only solution is <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q22","number":22,"question":"<p>Given <span class=\"inline-math\" data-math=\"\\arcsin x=\\frac\\pi5\" data-display=\"false\"></span>, show that <span class=\"inline-math\" data-math=\"x=\\sqrt{\\frac{5-\\sqrt5}8}\" data-display=\"false\"></span>.   <strong>The remaining questions in this exercise are all in radians and are to be completed without a calculator.</strong></p>","steps":["<p><span class=\"inline-math\" data-math=\"\\arcsin x=\\frac\\pi5\\Rightarrow x=\\sin\\frac\\pi5\" data-display=\"false\"></span>. Let <span class=\"inline-math\" data-math=\"\\theta=\\frac\\pi5\\Rightarrow5\\theta=\\pi\" data-display=\"false\"></span>. Subtract <span class=\"inline-math\" data-math=\"2\\theta\" data-display=\"false\"></span> from both sides: <span class=\"inline-math\" data-math=\"3\\theta=\\pi-2\\theta\" data-display=\"false\"></span>. Take sine of both sides: <span class=\"inline-math\" data-math=\"\\sin3\\theta=\\sin(\\pi-2\\theta)\" data-display=\"false\"></span>. We have that <span class=\"inline-math\" data-math=\"\\sin(\\pi-A)=\\sin A\" data-display=\"false\"></span>. <span class=\"inline-math\" data-math=\"\\therefore\\sin3\\theta=\\sin2\\theta\" data-display=\"false\"></span>. Use the triple and double angle formulae:</p>","<span class=\"equation\" data-math=\"\n3\\sin\\theta-4\\sin^3\\theta =2\\sin\\theta\\cos\\theta,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(3-4\\sin^2\\theta)\\sin\\theta =2\\sin\\theta\\cos\\theta,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3-4\\sin^2\\theta =2\\cos\\theta\\text{ as }\\sin\\theta&gt;0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3-4(1-\\cos^2\\theta) =2\\cos\\theta,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n3-4+4\\cos^2\\theta =2\\cos\\theta,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4\\cos^2\\theta-2\\cos\\theta-1 =0\\Rightarrow\\cos\\theta=\\frac{1\\pm\\sqrt5}4.\n\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\cos\\theta=\\frac{1+\\sqrt5}4\" data-display=\"false\"></span> as <span class=\"inline-math\" data-math=\"\\cos\\theta&gt;0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\n\\sin^2\\theta+\\cos^2\\theta=1 \\Rightarrow\\sin^2\\theta+\\left(\\frac{1+\\sqrt5}4\\right)^2=1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\sin\\theta=\\sqrt{1-\\left(\\frac{1+\\sqrt5}4\\right)^2} \\Rightarrow\\sin\\theta=\\sqrt{1-\\frac{3+\\sqrt5}8},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\sin\\theta =\\sqrt{\\frac{5-\\sqrt5}8}.\n\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\sin\\frac\\pi5=\\sqrt{\\frac{5-\\sqrt5}8}\\Rightarrow\\arcsin\\sqrt{\\frac{5-\\sqrt5}8}=\\frac\\pi5\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q23","number":23,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\arcsin1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos(-1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arcsin0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos1\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin1=\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\arccos(-1)=\\pi\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin0=0\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\arccos1=0\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q24","number":24,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\frac{\\sqrt2}2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\frac{\\sqrt2}2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(-\\frac{\\sqrt2}2\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\left(-\\frac{\\sqrt2}2\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\frac{\\sqrt2}2=\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\frac{\\sqrt2}2=\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(-\\frac{\\sqrt2}2\\right)=-\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\left(-\\frac{\\sqrt2}2\\right)=\\frac{3\\pi}4\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q25","number":25,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\arctan1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arctan(-1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arctan\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arctan\\left(-\\frac{\\sqrt3}3\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\arctan1=\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\arctan(-1)=-\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\arctan\\sqrt3=\\frac\\pi3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\arctan\\left(-\\frac{\\sqrt3}3\\right)=-\\frac\\pi6\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q26","number":26,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac\\pi2\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac\\pi2\\right)\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac{3\\pi}2\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac{3\\pi}2\\right)\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac\\pi3\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\frac{2\\pi}3\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac{5\\pi}3\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac\\pi3\\right)\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arctan\\left(\\tan\\frac\\pi4\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\arctan\\left(\\tan\\frac{2\\pi}3\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac\\pi2\\right)=\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac\\pi2\\right)\\right)=\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac{3\\pi}2\\right)=-\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac{3\\pi}2\\right)\\right)=\\frac\\pi2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac\\pi3\\right)=\\frac\\pi3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\frac{2\\pi}3\\right)=\\frac{2\\pi}3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\arcsin\\left(\\sin\\frac{5\\pi}3\\right)=-\\frac\\pi3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"\\arccos\\left(\\cos\\left(-\\frac\\pi3\\right)\\right)=\\frac\\pi3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"\\arctan\\left(\\tan\\frac\\pi4\\right)=\\frac\\pi4\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">j)</h3><p><span class=\"inline-math\" data-math=\"\\arctan\\left(\\tan\\frac{2\\pi}3\\right)=-\\frac\\pi3\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.14-q27","number":27,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arcsin\\frac{\\sqrt2}2\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arccos\\left(-\\frac{\\sqrt2}2\\right)\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arccos\\frac12\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arcsin\\frac12\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arccos\\frac{\\sqrt3}2\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arcsin\\left(-\\frac{\\sqrt3}2\\right)\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\tan\\left(\\arcsin\\left(-\\frac12\\right)\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arcsin\\frac{\\sqrt2}2\\right)=\\frac{\\sqrt2}2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arccos\\left(-\\frac{\\sqrt2}2\\right)\\right)=-\\frac{\\sqrt2}2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arccos\\frac12\\right)=\\frac{\\sqrt3}2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arcsin\\frac12\\right)=\\frac{\\sqrt3}2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\sin\\left(\\arccos\\frac{\\sqrt3}2\\right)=\\frac12\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\cos\\left(\\arcsin\\left(-\\frac{\\sqrt3}2\\right)\\right)=\\frac12\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\tan\\left(\\arcsin\\left(-\\frac12\\right)\\right)=-\\frac{\\sqrt3}3\" data-display=\"false\"></span>.</p>"]}]