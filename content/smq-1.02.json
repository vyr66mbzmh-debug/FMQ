[{"id":"smq-year1-1.02-q1","number":1,"question":"<p><strong>We would expect completion of these questions without the use of a calculator.</strong> Simplify</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt{32}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\sqrt{12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{45}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{200}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-4\\sqrt{50}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{32}=\\sqrt{16\\times2}=4\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt{12}=2\\sqrt{4\\times3}=4\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{45}=\\sqrt{9\\times5}=3\\sqrt5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{200}=\\sqrt{100\\times2}=10\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"-4\\sqrt{50}=-4\\sqrt{25\\times2}=-20\\sqrt2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q2","number":2,"question":"<p>Simplify</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt5\\times\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt5\\sqrt{15}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt8\\times3\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{\\frac19}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{28}}{\\sqrt{14}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{25x^2}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt5\\sqrt2=\\sqrt{10}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt5\\sqrt{15}=\\sqrt{75}=\\sqrt{25\\times3}=5\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"3\\sqrt2\\sqrt8=3\\sqrt{16}=12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{\\frac19}=\\frac{\\sqrt1}{\\sqrt9}=\\frac13\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{28}}{\\sqrt{14}}=\\sqrt{\\frac{28}{14}}=\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{25x^2}=\\sqrt{25}\\sqrt{x^2}=5x\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q3","number":3,"question":"<p>Simplify</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"2\\sqrt5-\\sqrt5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt8+2\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{12}-\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{128}-\\sqrt{72}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3\\sqrt{12}+\\sqrt{27}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{150}-\\sqrt{96}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt3+\\sqrt{27}+\\sqrt{12}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{350}+\\sqrt{24}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{32a}+2\\sqrt a-\\sqrt{28a}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt5-\\sqrt5=\\sqrt5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt8+2\\sqrt2=\\sqrt{4\\times2}+2\\sqrt2=2\\sqrt2+2\\sqrt2=4\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{12}-\\sqrt3=\\sqrt{4\\times3}-\\sqrt3=2\\sqrt3-\\sqrt3=\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{128}-\\sqrt{72}=\\sqrt{64\\times2}-\\sqrt{36\\times2}=8\\sqrt2-6\\sqrt2=2\\sqrt2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"3\\sqrt{12}+\\sqrt{27}=3\\sqrt{4\\times3}+\\sqrt{9\\times3}=6\\sqrt3+3\\sqrt3=9\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{150}-\\sqrt{96}=\\sqrt{25\\times6}-\\sqrt{16\\times6}=5\\sqrt6-4\\sqrt6=\\sqrt6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt3+\\sqrt{27}+\\sqrt{12}=\\sqrt3+\\sqrt{9\\times3}+\\sqrt{4\\times3}=\\sqrt3+3\\sqrt3+2\\sqrt3=6\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{350}+\\sqrt{24}=\\sqrt{25\\times14}+\\sqrt{4\\times6}=5\\sqrt{14}+2\\sqrt6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{32a}+2\\sqrt a-\\sqrt{28a}=\\sqrt{16\\times2a}+2\\sqrt a-\\sqrt{4\\times7a}=4\\sqrt{2a}+2\\sqrt a-2\\sqrt{7a}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q4","number":4,"question":"<p>Simplify</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt2\\times\\sqrt7\\times\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{18}\\times\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\sqrt3\\times2\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"5\\sqrt3\\times2\\sqrt5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-3\\sqrt3\\times2\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(2\\sqrt6)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(3\\sqrt8)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(2\\sqrt5)^3\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt2\\times\\sqrt7\\times\\sqrt3=\\sqrt{42}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{18}\\times\\sqrt2=\\sqrt{36}=6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt3\\times2\\sqrt3=4\\times3=12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"5\\sqrt3\\times2\\sqrt5=10\\sqrt{15}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"-3\\sqrt3\\times2\\sqrt3=-6\\times3=-18\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"(2\\sqrt6)^2=4\\times6=24\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"(3\\sqrt8)^2=9\\times8=72\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"(2\\sqrt5)^3=8\\times5\\sqrt5=40\\sqrt5\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q5","number":5,"question":"<p>Express each of the following in the form <span class=\"inline-math\" data-math=\"\\sqrt a\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> is a positive integer:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"2\\sqrt5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4\\sqrt3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3\\sqrt2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\sqrt7\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\sqrt{43}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt5=\\sqrt{2^2\\times5}=\\sqrt{20}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"4\\sqrt3=\\sqrt{4^2\\times3}=\\sqrt{48}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"3\\sqrt2=\\sqrt{3^2\\times2}=\\sqrt{18}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt7=\\sqrt{2^2\\times7}=\\sqrt{28}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt{43}=\\sqrt{2^2\\times43}=\\sqrt{172}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q6","number":6,"question":"<p>Express the following as a single square root:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"a\\sqrt b\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2\\sqrt a\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt a)^5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(a\\sqrt b)^3\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"a\\sqrt b=\\sqrt{a^2b}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"2\\sqrt a=\\sqrt{2^2a}=\\sqrt{4a}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"(\\sqrt a)^5=\\sqrt a\\times\\sqrt a\\times\\sqrt a\\times\\sqrt a\\times\\sqrt a=a\\times a\\times\\sqrt a=a^2\\sqrt a=\\sqrt{a^4\\times a}=\\sqrt{a^5}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"(a\\sqrt b)^3=a\\sqrt b\\times a\\sqrt b\\times a\\sqrt b=a^3b\\sqrt b=\\sqrt{a^6b^2b}=\\sqrt{a^6b^3}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q7","number":7,"question":"<p>Express <span class=\"inline-math\" data-math=\"\\sqrt{525}\" data-display=\"false\"></span> in the form <span class=\"inline-math\" data-math=\"p\\sqrt q\\sqrt r\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"r\" data-display=\"false\"></span> are prime numbers.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\sqrt{525}=\\sqrt{25\\times3\\times7}=5\\sqrt3\\sqrt7\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q8","number":8,"question":"<p>Write this ratio in its simplest form: <span class=\"inline-math\" data-math=\"\\sqrt{300}:\\sqrt{48}:\\sqrt{27}\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\sqrt{100\\times3}:\\sqrt{16\\times3}:\\sqrt{9\\times3}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"10\\sqrt3:4\\sqrt3:3\\sqrt3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"10:4:3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q9","number":9,"question":"<p>Rationalise the following surds:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac3{\\sqrt2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac6{\\sqrt3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac6{\\sqrt{10}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac2{\\sqrt6}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{10}{\\sqrt{10}}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{4\\sqrt2}{\\sqrt8}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac3{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}=\\frac{3\\sqrt2}2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac6{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}=\\frac{6\\sqrt3}3=2\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac6{\\sqrt{10}}\\times\\frac{\\sqrt{10}}{\\sqrt{10}}=\\frac{6\\sqrt{10}}{10}=\\frac{3\\sqrt{10}}5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac2{\\sqrt6}\\times\\frac{\\sqrt6}{\\sqrt6}=\\frac{2\\sqrt6}6=\\frac{\\sqrt6}3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{10}{\\sqrt{10}}\\times\\frac{\\sqrt{10}}{\\sqrt{10}}=\\frac{10\\sqrt{10}}{10}=\\sqrt{10}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{4\\sqrt2}{\\sqrt8}\\times\\frac{\\sqrt8}{\\sqrt8}=\\frac{4\\sqrt{16}}8=\\frac{16}8=2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q10","number":10,"question":"<p>Expand and simplify the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt5(1+\\sqrt5)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\sqrt{11}(2+\\sqrt{11})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4(\\sqrt3+2\\sqrt5)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt3+1)(\\sqrt3-1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt6+1)(2+\\sqrt6)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt8-1)(2+\\sqrt8)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"(\\sqrt{24}+1)(\\sqrt2-3)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt5(1+\\sqrt5)=\\sqrt5+\\sqrt5\\sqrt5=\\sqrt5+5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{11}(2+\\sqrt{11})=2\\sqrt{11}+\\sqrt{11}\\sqrt{11}=2\\sqrt{11}+11\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"4(\\sqrt3+2\\sqrt5)=4\\sqrt3+8\\sqrt5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"(\\sqrt3+1)(\\sqrt3-1)=\\sqrt3\\sqrt3-\\sqrt3+\\sqrt3-1=3-1=2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"(\\sqrt6+1)(2+\\sqrt6)=2\\sqrt6+\\sqrt6\\sqrt6+2+\\sqrt6=3\\sqrt6+6+2=3\\sqrt6+8\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"(\\sqrt8-1)(2+\\sqrt8)=2\\sqrt8+\\sqrt8\\sqrt8-2-\\sqrt8=\\sqrt8+8-2=\\sqrt8+6=2\\sqrt2+6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><span class=\"equation\" data-math=\"\\begin{aligned}(\\sqrt{24}+1)(\\sqrt2-3)&amp;=\\sqrt{24}\\sqrt2-3\\sqrt{24}+\\sqrt2-3\\\\&amp;=\\sqrt{16\\times3}-3\\sqrt{4\\times6}+\\sqrt2-3\\\\&amp;=4\\sqrt3-6\\sqrt6+\\sqrt2-3\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.02-q11","number":11,"question":"<p>Rationalise the following surds:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac1{\\sqrt2+1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac3{\\sqrt5-2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac2{1-\\sqrt6}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{a+\\sqrt b}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac1{a-\\sqrt{2b}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{\\sqrt2+1}\\times\\frac{\\sqrt2-1}{\\sqrt2-1}=\\frac{\\sqrt2-1}{2-1}=\\sqrt2-1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac3{\\sqrt5-2}\\times\\frac{\\sqrt5+2}{\\sqrt5+2}=\\frac{3(\\sqrt5+2)}{5-4}=3\\sqrt5+6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac2{1-\\sqrt6}\\times\\frac{1+\\sqrt6}{1+\\sqrt6}=\\frac{2+2\\sqrt6}{1-6}=-\\frac25-\\frac25\\sqrt6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{a+\\sqrt b}\\times\\frac{a-\\sqrt b}{a-\\sqrt b}=\\frac{a-\\sqrt b}{a^2-b}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac1{a-\\sqrt{2b}}\\times\\frac{a+\\sqrt{2b}}{a+\\sqrt{2b}}=\\frac{a+\\sqrt{2b}}{a^2-2b}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q12","number":12,"question":"<p>Simplify the following, giving your answers in the form <span class=\"inline-math\" data-math=\"p\\sqrt q\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> are non-zero rational numbers:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\sqrt{27}+\\frac{15}{\\sqrt3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{54}}2-\\frac{10}{\\sqrt6}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{150}}5+\\frac{30}{\\sqrt{24}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\sqrt{27}+\\frac{15}{\\sqrt3}=\\sqrt{9\\times3}+\\frac{15}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}=3\\sqrt3+5\\sqrt3=8\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt{54}}2-\\frac{10}{\\sqrt6}=\\frac{\\sqrt{9\\times6}}2-\\frac{10}{\\sqrt6}\\times\\frac{\\sqrt6}{\\sqrt6}=\\frac32\\sqrt6-\\frac{10}6\\sqrt6=-\\frac16\\sqrt6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac{\\sqrt{150}}5+\\frac{30}{\\sqrt{24}}&amp;=\\frac{\\sqrt{25\\times6}}5+\\frac{30}{\\sqrt{24}}\\times\\frac{\\sqrt{24}}{\\sqrt{24}}\\\\&amp;=\\sqrt6+\\frac{30}{24}\\sqrt{24}=\\sqrt6+\\frac54\\sqrt{4\\times6}\\\\&amp;=\\sqrt6+\\frac52\\sqrt6=\\frac72\\sqrt6\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.02-q13","number":13,"question":"<p>Solve <span class=\"inline-math\" data-math=\"x(4-\\sqrt6)=10\" data-display=\"false\"></span> giving your answer in the form <span class=\"inline-math\" data-math=\"a+b\\sqrt6\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are non-zero integers to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"x=\\frac{10}{4-\\sqrt6}\\times\\frac{4+\\sqrt6}{4+\\sqrt6}=\\frac{40+10\\sqrt6}{16-6}=4+\\sqrt6\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q14","number":14,"question":"<p>Rationalise the denominator and simplify the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt3}{\\sqrt2-2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2\\sqrt5-1}{\\sqrt5+4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{5\\sqrt3-2}{2-\\sqrt7}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{2\\sqrt3-7}{2\\sqrt3-3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{1-\\sqrt k}{2+\\sqrt{2k}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt3}{\\sqrt2-2}\\times\\frac{\\sqrt2+2}{\\sqrt2+2}=\\frac{\\sqrt3\\sqrt2+2\\sqrt3}{2-4}=\\frac{\\sqrt6+2\\sqrt3}{-2}=-\\frac12\\sqrt6-\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{2\\sqrt5-1}{\\sqrt5+4}\\times\\frac{\\sqrt5-4}{\\sqrt5-4}=\\frac{10-8\\sqrt5-\\sqrt5+4}{5-16}=\\frac{14-9\\sqrt5}{-11}=-\\frac{14}{11}+\\frac9{11}\\sqrt5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac{5\\sqrt3-2}{2-\\sqrt7}\\times\\frac{2+\\sqrt7}{2+\\sqrt7}&amp;=\\frac{10\\sqrt3+5\\sqrt{21}-4-2\\sqrt7}{4-7}\\\\&amp;=\\frac{10\\sqrt3+5\\sqrt{21}-4-2\\sqrt7}{-3}\\\\&amp;=-\\frac{10\\sqrt3}3-\\frac{5\\sqrt{21}}3+\\frac43+\\frac{2\\sqrt7}3\\end{aligned}\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{2\\sqrt3-7}{2\\sqrt3-3}\\times\\frac{2\\sqrt3+3}{2\\sqrt3+3}=\\frac{12+6\\sqrt3-14\\sqrt3-21}{12-9}=\\frac{-9-8\\sqrt3}3=-3-\\frac83\\sqrt3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac{1-\\sqrt k}{2+\\sqrt{2k}}\\times\\frac{2-\\sqrt{2k}}{2-\\sqrt{2k}}&amp;=\\frac{2-\\sqrt{2k}-2\\sqrt k+\\sqrt k\\sqrt{2k}}{4-2k}\\\\&amp;=\\frac{2-(\\sqrt2+2)\\sqrt k+\\sqrt2k}{4-2k}\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.02-q15","number":15,"question":"<p>Solve <span class=\"inline-math\" data-math=\"x(1-\\sqrt2)+\\sqrt2=5\" data-display=\"false\"></span> giving your answer in the form <span class=\"inline-math\" data-math=\"a+b\\sqrt2\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are non-zero integers to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"x=\\frac{5-\\sqrt2}{1-\\sqrt2}\\times\\frac{1+\\sqrt2}{1+\\sqrt2}=\\frac{5+5\\sqrt2-\\sqrt2-2}{1-2}=\\frac{3+4\\sqrt2}{-1}=-3-4\\sqrt2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q16","number":16,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\frac{3\\sqrt{10}}{\\sqrt2+\\sqrt5}\" data-display=\"false\"></span> may be written in the form <span class=\"inline-math\" data-math=\"p\\sqrt q-q\\sqrt p\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> are non-zero integers to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac{3\\sqrt{10}}{\\sqrt2+\\sqrt5}\\times\\frac{\\sqrt2-\\sqrt5}{\\sqrt2-\\sqrt5}=\\frac{3\\sqrt{20}-3\\sqrt{50}}{2-5}=\\frac{6\\sqrt5-15\\sqrt2}{-3}=5\\sqrt2-2\\sqrt5\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q17","number":17,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\frac{\\sqrt3+\\sqrt7}{\\sqrt3-\\sqrt7}\" data-display=\"false\"></span> may be written in the form <span class=\"inline-math\" data-math=\"a+b\\sqrt{21}\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are non-zero constants to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac{\\sqrt3+\\sqrt7}{\\sqrt3-\\sqrt7}\\times\\frac{\\sqrt3+\\sqrt7}{\\sqrt3+\\sqrt7}=\\frac{3+2\\sqrt{21}+7}{3-7}=\\frac{10+2\\sqrt{21}}{-4}=-\\frac52-\\frac12\\sqrt{21}\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q18","number":18,"question":"<p>The expression <span class=\"inline-math\" data-math=\"\\frac{a+\\sqrt6}{1-\\sqrt6}\" data-display=\"false\"></span> may be written in the form <span class=\"inline-math\" data-math=\"p+q\\sqrt6\" data-display=\"false\"></span>. Find the values of <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}\\frac{a+\\sqrt6}{1-\\sqrt6}\\times\\frac{1+\\sqrt6}{1+\\sqrt6}&amp;=\\frac{a+a\\sqrt6+\\sqrt6+6}{1-6}\\\\&amp;=\\frac{a+6+(a+1)\\sqrt6}{-5}\\\\&amp;=-\\frac{a+6}5-\\frac{a+1}5\\sqrt6\\end{aligned}\" data-display=\"true\"></span>","<p>so <span class=\"inline-math\" data-math=\"p=-\\frac{a+6}5\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q=-\\frac{a+1}5\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.02-q19","number":19,"question":"<p>Fully simplify the expression <span class=\"inline-math\" data-math=\"\\frac{12}{\\frac1{\\sqrt3}+\\sqrt3}\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac{12}{\\frac1{\\sqrt3}+\\sqrt3}=\\frac{12\\sqrt3}{1+3}=3\\sqrt3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.02-q20","number":20,"question":"<p>A cylinder has a height of <span class=\"inline-math\" data-math=\"(\\sqrt3+1)\\text{cm}\" data-display=\"false\"></span> and a radius of <span class=\"inline-math\" data-math=\"(\\frac1{\\sqrt3-2})\\text{cm}\" data-display=\"false\"></span>. Show that the volume of the cylinder is exactly <span class=\"inline-math\" data-math=\"\\pi(19+11\\sqrt3)\\text{cm}^3\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}\\left(\\frac1{\\sqrt3-2}\\right)^2&amp;=\\frac1{\\sqrt3-2}\\times\\frac1{\\sqrt3-2}=\\frac1{3-4\\sqrt3+4}=\\frac1{7-4\\sqrt3}\\\\\\pi\\left(\\frac1{\\sqrt3-2}\\right)^2(\\sqrt3+1)&amp;=\\pi\\frac{\\sqrt3+1}{7-4\\sqrt3}\\times\\frac{7+4\\sqrt3}{7+4\\sqrt3}\\\\&amp;=\\pi\\frac{7\\sqrt3+12+7+4\\sqrt3}{49-48}\\\\&amp;=\\pi(19+11\\sqrt3)\\text{ as req.}\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.02-q21","number":21,"question":"<p>The expression <span class=\"inline-math\" data-math=\"\\frac{-k+2\\sqrt3}{\\sqrt{27}+1}\" data-display=\"false\"></span> may be written in the form <span class=\"inline-math\" data-math=\"a+b\\sqrt3\" data-display=\"false\"></span>. Find the values of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}\\frac{-k+2\\sqrt3}{\\sqrt{27}+1}\\times\\frac{\\sqrt{27}-1}{\\sqrt{27}-1}&amp;=\\frac{-\\sqrt{27}k+k+18-2\\sqrt3}{27-1}\\\\&amp;=\\frac{-3\\sqrt3k-2\\sqrt3+k+18}{26}\\\\&amp;=\\left(\\frac{-3k-2}{26}\\right)\\sqrt3+\\frac{k+18}{26}\\end{aligned}\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"a=\\frac{k+18}{26}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b=\\frac{-3k-2}{26}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.02-q22","number":22,"question":"<p>The expression <span class=\"inline-math\" data-math=\"\\frac{2-\\sqrt k}{1+\\sqrt k}\" data-display=\"false\"></span> may be written in the form <span class=\"inline-math\" data-math=\"a+b\\sqrt k\" data-display=\"false\"></span>. Find the values of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac{2-\\sqrt k}{1+\\sqrt k}\\times\\frac{1-\\sqrt k}{1-\\sqrt k}=\\frac{2-2\\sqrt k-\\sqrt k+k}{1-k}=\\frac{k+2}{1-k}-\\frac3{1-k}\\sqrt k\" data-display=\"false\"></span>  So <span class=\"inline-math\" data-math=\"a=\\frac{k+2}{1-k}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b=-\\frac3{1-k}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.02-q23","number":23,"question":"<ol class=\"parts\" start=\"1\"><li><p>Simplify <span class=\"inline-math\" data-math=\"\\frac{\\sqrt{a+1}-\\sqrt a}{\\sqrt{a+1}+\\sqrt a}\" data-display=\"false\"></span>.</p></li><li><p>Hence write down the solution to <span class=\"inline-math\" data-math=\"\\frac{\\sqrt7-\\sqrt6}{\\sqrt7+\\sqrt6}\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{aligned}\\frac{\\sqrt{a+1}-\\sqrt a}{\\sqrt{a+1}+\\sqrt a}\\times\\frac{\\sqrt{a+1}-\\sqrt a}{\\sqrt{a+1}-\\sqrt a}&amp;=\\frac{(a+1)-\\sqrt a\\sqrt{a+1}-\\sqrt a\\sqrt{a+1}+a}{(a+1)-a}\\\\&amp;=\\frac{2a+1-2\\sqrt a\\sqrt{a+1}}1\\\\&amp;=2a+1-2\\sqrt a\\sqrt{a+1}\\end{aligned}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>So <span class=\"inline-math\" data-math=\"\\frac{\\sqrt{6+1}-\\sqrt6}{\\sqrt{6+1}+\\sqrt6}=2\\times6+1-2\\sqrt6\\sqrt{6+1}=13-2\\sqrt{42}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.02-q24","number":24,"question":"<p>Evaluate the sum <span class=\"inline-math\" data-math=\"\\frac1{\\sqrt1+\\sqrt2}+\\frac1{\\sqrt2+\\sqrt3}+\\cdots+\\frac1{\\sqrt{99}+\\sqrt{100}}\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\frac1{\\sqrt a+\\sqrt{a+1}}\\times\\frac{\\sqrt a-\\sqrt{a+1}}{\\sqrt a-\\sqrt{a+1}}=\\frac{\\sqrt a-\\sqrt{a+1}}{a-(a+1)}=\\sqrt{a+1}-\\sqrt a\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac1{\\sqrt1+\\sqrt2}=\\sqrt2-\\sqrt1,\\quad\\frac1{\\sqrt2+\\sqrt3}=\\sqrt3-\\sqrt2,\\ \\ldots,\\quad\\frac1{\\sqrt{99}+\\sqrt{100}}=\\sqrt{100}-\\sqrt{99}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\begin{aligned}\\frac1{\\sqrt1+\\sqrt2}+\\frac1{\\sqrt2+\\sqrt3}+\\cdots+\\frac1{\\sqrt{99}+\\sqrt{100}}&amp;=\\sqrt2-\\sqrt1+\\sqrt3-\\sqrt2+\\sqrt4-\\sqrt3\\\\&amp;\\quad+\\sqrt5-\\sqrt4+\\cdots+\\sqrt{99}-\\sqrt{98}+\\sqrt{100}-\\sqrt{99}\\\\&amp;=-\\sqrt1+\\sqrt{100}=-1+\\sqrt{100}=9\\end{aligned}\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.02-q25","number":25,"question":"<p>By using algebraic methods, show that <span class=\"inline-math\" data-math=\"\\sqrt2+\\sqrt3&gt;\\sqrt5\" data-display=\"false\"></span>.</p>","steps":["<p>If <span class=\"inline-math\" data-math=\"a&gt;b&gt;0\" data-display=\"false\"></span> then <span class=\"inline-math\" data-math=\"a^2&gt;b^2\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"(\\sqrt2+\\sqrt3)^2=2+2\\sqrt2\\sqrt3+3=5+2\\sqrt6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"(\\sqrt5)^2=5\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"5+2\\sqrt6&gt;5\\Rightarrow(\\sqrt2+\\sqrt3)^2&gt;(\\sqrt5)^2\\Rightarrow\\sqrt2+\\sqrt3&gt;\\sqrt5\" data-display=\"false\"></span> as req.</p>"]},{"id":"smq-year1-1.02-q26","number":26,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\frac2{\\sqrt5+\\sqrt2+1}=3+2\\sqrt2-\\sqrt5-\\sqrt{10}\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\\begin{aligned}\\frac2{\\sqrt5+(\\sqrt2+1)}\\times\\frac{\\sqrt5-(\\sqrt2+1)}{\\sqrt5-(\\sqrt2+1)}&amp;=\\frac{2\\sqrt5-2\\sqrt2-2}{5-(2+2\\sqrt2+1)}\\\\&amp;=\\frac{2\\sqrt5-2\\sqrt2-2}{2-2\\sqrt2}\\times\\frac{2+2\\sqrt2}{2+2\\sqrt2}\\\\&amp;=\\frac{4\\sqrt5-4\\sqrt2-4+4\\sqrt{10}-8-4\\sqrt2}{4-8}\\\\&amp;=\\frac{-12-8\\sqrt2+4\\sqrt5+4\\sqrt{10}}{-4}\\\\&amp;=3+2\\sqrt2-\\sqrt5-\\sqrt{10}\\end{aligned}\" data-display=\"true\"></span>"]}]