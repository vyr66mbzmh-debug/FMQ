[{"id":"smq-year1-1.08-q1","number":1,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=(x+a)(x+b)\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q1c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x+3)(x-3)\\Rightarrow y=x^2-9\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=(x+2)(x-4)\\Rightarrow y=x^2-2x-8\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=(x+3)(x+1)\\Rightarrow y=x^2+4x+3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q2","number":2,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-5)(x-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+4)(x-2)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q3","number":3,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=-(x+a)(x+b)\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q3c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=-(x+4)(x-4)\\Rightarrow y=-x^2+16\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-(x+5)(x-1)\\Rightarrow y=-x^2-4x+5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=-(x-2)(x-6)\\Rightarrow y=-x^2+8x-12\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q4","number":4,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x+2)(x-5)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-(x+8)(x+1)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q5","number":5,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=(x+a)^2+b\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q5c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x-2)^2+1\\Rightarrow y=x^2-4x+5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=(x+2)^2+3\\Rightarrow y=x^2+4x+7\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=(x+3)^2-5\\Rightarrow y=x^2+6x+4\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q6","number":6,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the y-axis:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-4)^2+5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-5)^2-6\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s6a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s6b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q7","number":7,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=-(x+a)^2+b\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q7a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q7b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q7c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=-(x-2)^2-3\\Rightarrow y=-x^2+4x-7\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-(x-4)^2+3\\Rightarrow y=-x^2+8x-13\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=-(x+2)^2+6\\Rightarrow y=-x^2-4x+2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q8","number":8,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the y-axis:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x+6)^2+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-(x-3)^2-4\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q9","number":9,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=a(x+b)(x+c)\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q9a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q9b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q9c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=k(x+3)(x-2)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,-12):-12=k(3)(-2)\\Rightarrow k=2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=2(x+3)(x-2)\\Rightarrow y=2x^2+2x-12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=k(x+4)(x+1)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,16):16=k(4)(1)\\Rightarrow k=4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=4(x+4)(x+1)\\Rightarrow y=4x^2+20x+16\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=k(x+3)(x-2)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,9):9=k(3)(-2)\\Rightarrow k=-\\frac32\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac32(x+3)(x-2)\\Rightarrow y=-\\frac32x^2-\\frac32x+9\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q10","number":10,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=3(x-1)(x+2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-2(x+4)(x+3)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q11","number":11,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=a(x+b)^2+c\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q11a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q11b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q11c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=k(x-3)^2+4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,31):31=k(-3)^2+4\\Rightarrow k=3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=3(x-3)^2+4\\Rightarrow y=3x^2-18x+31\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=k(x+6)^2-5\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,7):7=k(6)^2-5\\Rightarrow k=\\frac13\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac13(x+6)^2-5\\Rightarrow y=\\frac13x^2+4x+7\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=k(x-4)^2+4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,-16):-16=k(-4)^2+4\\Rightarrow k=-\\frac54\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac54(x-4)^2+4\\Rightarrow y=-\\frac54x^2+10x-16\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q12","number":12,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the y-axis:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=5(x+1)^2-2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\frac32(x-6)^2-12\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s12a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s12b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q13","number":13,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"y=ax^2+bx+c\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q13a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q13b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.08/questions/assets/diagrams/q13c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=k(x-(1-\\sqrt3))(x-(1+\\sqrt3))\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,-4):-4=k(-(1-\\sqrt3))(-(1+\\sqrt3))\\Rightarrow k=2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=2(x-(1-\\sqrt3))(x-(1+\\sqrt3))\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=2x^2-4x-4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=k(x-(-4-\\sqrt6))(x-(-4+\\sqrt6))\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,-25):-25=k(-(-4-\\sqrt6))(-(-4+\\sqrt6))\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow k=-\\frac52\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac52(x-(-4-\\sqrt6))(x-(-4+\\sqrt6))\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=-\\frac52x^2-20x-25\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=k(x-4)^2+12\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,0):0=k(-4)^2+12\\Rightarrow k=-\\frac34\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac34(x-4)^2+12\\Rightarrow y=-\\frac34x^2+6x\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.08-q14","number":14,"question":"<p>Sketch the following graph, showing the coordinates of the turning point and where it intersects the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis: <span class=\"inline-math\" data-math=\"y=\\frac12(x+8)^2-32\" data-display=\"false\"></span>.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s14.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q15","number":15,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x+2)(x-8)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-6)(x+4)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=3(x+6)(x+2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-4(x-2)(x-4)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x+2)(x-8)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=x^2-6x-16\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=(x-3)^2-25\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s15a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=(x-6)(x+4)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=x^2-2x-24\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=(x-1)^2-25\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s15b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=3(x+6)(x+2)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=3x^2+24x+36\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=3(x+4)^2-12\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s15c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=-4(x-2)(x-4)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-4x^2+24x-32\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-4(x-3)^2+4\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s15d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q16","number":16,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-3)(x-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac13(x+2)(x+6)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-(x+9)(x+5)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\frac74(x-8)(x+4)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x-3)(x-7)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=x^2-10x+21\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=(x-5)^2-4\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s16a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac13(x+2)(x+6)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac13x^2+\\frac83x+4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac13(x+4)^2-\\frac43\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s16b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=-(x+9)(x+5)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-x^2-14x-45\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-(x+7)^2+4\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s16c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=-\\frac74(x-8)(x+4)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac74x^2+7x+56\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac74(x-2)^2+63\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s16d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q17","number":17,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-6)^2-2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=8-(x+2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac43(x+6)^2-9\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\frac83(x-3)^2+12\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x-6)^2-2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=x^2-12x+34\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=(x-(6-\\sqrt2))(x-(6+\\sqrt2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s17a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=8-(x+2)^2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-x^2-4x+4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-(x-(-2-2\\sqrt2))(x-(-2+2\\sqrt2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s17b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac43(x+6)^2-9\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac43x^2+16x+39\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac43(x-(\\frac{-12-3\\sqrt3}2))(x-(\\frac{-12+3\\sqrt3}2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s17c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=-\\frac83(x-3)^2+12\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac83x^2+16x-12\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac83(x-(\\frac{6-3\\sqrt2}2))(x-(\\frac{6+3\\sqrt2}2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s17d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q18","number":18,"question":"<p>Sketch the following graphs, showing the coordinates of the turning point and where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=3x^2-9x+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-2x^2+10x+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac12x^2-6x+9\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\frac15x^2+2x+10\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=3x^2-9x+2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=3(x-\\frac32)^2-\\frac{19}4\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=3(x-(\\frac{9+\\sqrt{57}}6))(x-(\\frac{9-\\sqrt{57}}6))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s18a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-2x^2+10x+2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-2(x-\\frac52)^2+\\frac{29}2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-2(x-(\\frac{5+\\sqrt{29}}2))(x-(\\frac{5-\\sqrt{29}}2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s18b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\frac12x^2-6x+9\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac12(x-6)^2-9\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=\\frac12(x-(6+3\\sqrt2))(x-(6-3\\sqrt2))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s18c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y=-\\frac15x^2+2x+10\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac15(x-5)^2+15\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=-\\frac15(x-(5+5\\sqrt3))(x-(5-5\\sqrt3))\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s18d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q19","number":19,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the following graphs, identifying the turning point and where they cross the coordinate axes in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=k(2x+k)(x-2k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=k-\\frac13(x-3k)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=10+\\frac2k(kx+1)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(3kx+2)(3k-x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\begin{aligned}y&amp;=k(2x+k)(x-2k)\\\\\\Rightarrow y&amp;=k(2x^2-3kx-2k^2)\\\\\\Rightarrow y&amp;=2kx^2-3k^2x-2k^3\\\\\\Rightarrow y&amp;=2k(x^2-\\frac{3k}2x)-2k^3\\\\\\Rightarrow y&amp;=2k((x-\\frac{3k}4)^2-\\frac{9k^2}{16})-2k^3\\\\\\Rightarrow y&amp;=2k(x-\\frac{3k}4)^2-\\frac{9k^3}8-2k^3\\\\\\Rightarrow y&amp;=2k(x-\\frac{3k}4)^2-\\frac{25k^3}8\\end{aligned}\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s19a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s19b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=10+\\frac2k(kx+1)^2\\Rightarrow y=10+\\frac2k(k(x+\\frac1k))^2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=10+\\frac2k\\times k^2(x+\\frac1k)^2\\Rightarrow y=10+2k(x+\\frac1k)^2\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s19c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\begin{aligned}y&amp;=(3kx+2)(3k-x)\\\\\\Rightarrow y&amp;=9k^2x-3kx^2+6k-2x\\\\\\Rightarrow y&amp;=-3kx^2+(9k^2-2)x+6k\\\\\\Rightarrow y&amp;=-3k(x^2-(3k-\\frac2{3k})x)+6k\\\\\\Rightarrow y&amp;=-3k((x-(\\frac{3k}2-\\frac1{3k}))^2-(\\frac{3k}2-\\frac1{3k})^2)+6k\\\\\\Rightarrow y&amp;=-3k((x-(\\frac{3k}2-\\frac1{3k}))^2-(\\frac{9k^2}4-1+\\frac1{9k^2}))+6k\\\\\\Rightarrow y&amp;=-3k(x-(\\frac{3k}2-\\frac1{3k}))^2+\\frac{27k^3}4-3k+\\frac1{3k}+6k\\\\\\Rightarrow y&amp;=-3k(x-(\\frac{3k}2-\\frac1{3k}))^2+\\frac{27k^3}4+3k+\\frac1{3k}\\end{aligned}\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s19d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.08-q20","number":20,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the graphs of <span class=\"inline-math\" data-math=\"y=(k-x)(3x+k)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=k-x\" data-display=\"false\"></span> on the same axes, showing clearly where the two graphs cross the coordinate axes and where they intersect in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"(k-x)(3x+k)=k-x\\Rightarrow3x+k=1\\Rightarrow x=\\frac{1-k}3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\therefore y=k-\\frac{1-k}3\\Rightarrow y=k-\\frac13+\\frac k3\\Rightarrow y=\\frac{4k}3-\\frac13\\Rightarrow y=\\frac{4k-1}3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.08/solutions/assets/diagrams/s20.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]}]