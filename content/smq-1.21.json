[{"id":"smq-year1-1.21-q1","number":1,"question":"<p>Sketch and shade the region satisfied by</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y&gt;3x+1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y\\le2x-5\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q2","number":2,"question":"<p>Sketch and shade the region satisfied by both</p><span class=\"equation\" data-math=\"y\\le2x-1\\text{ and }x+2y&gt;8\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"x+2y=8\\Rightarrow y=-\\frac12x+4\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"2x-1=-\\frac12x+4\\Rightarrow\\frac52x=5\\Rightarrow x=2,y=3\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q3","number":3,"question":"<p>Sketch and shade the region satisfied by both</p><span class=\"equation\" data-math=\"y&gt;3x+8\\text{ and }x+3y&lt;4\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"x+3y=4\\Rightarrow y=-\\frac13x+\\frac43\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"-\\frac13x+\\frac43=3x+8\\Rightarrow\\frac{10}{3}x=-\\frac{20}{3}\\Rightarrow x=-2,y=2\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s3.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q4","number":4,"question":"<p>In each case, sketch a diagram and shade the region which satisfies the inequality:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y\\le(x-5)(x+3)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y\\ge(2x+1)(x-4)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y&lt;x^2+x-2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y&gt;2x^2-7x-15\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y&lt;(x+2)(x-1)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s4c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"y&gt;(2x+3)(x-5)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s4d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q5","number":5,"question":"<p>In each case, sketch a diagram and shade the region which satisfies the inequalities:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y+x&lt;-5\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y&gt;x^2+x-20\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y-2x&lt;6\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y\\le-x^2-x+6\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x^2+x-20=(x+5)(x-4)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y+x=-5\\Rightarrow y=-x-5\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"x^2+x-20=-x-5\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow x^2+2x-15=(x+5)(x-3)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(-5,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(3,-8)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"-x^2-x+6=-(x+3)(x-2)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=2x+6\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"-x^2-x+6=2x+6\\Rightarrow0=x^2+3x\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(0,6),(-3,0)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q6","number":6,"question":"<p>Sketch and shade the region satisfied by</p><span class=\"equation\" data-math=\"3y\\ge x,y+x&lt;4\\text{ and }y\\ge(x-2)^2\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"y=\\frac13x\\Rightarrow\\frac13x=(x-2)^2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\frac13x=x^2-4x+4\\Rightarrow3x^2-13x+12=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(x-3)(4x-3)=0\\Rightarrow(3,1),(\\frac43,\\frac49)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s6.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q7","number":7,"question":"<p>Sketch and shade the region satisfied by</p><span class=\"equation\" data-math=\"y\\ge x^2,x+y\\le6\\text{ and }x\\le0\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"y=6-x\\Rightarrow6-x=x^2\\Rightarrow x^2+x-6=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(x-2)(x+3)=0\\Rightarrow(-3,9),(2,4)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s7.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q8","number":8,"question":"<p>The diagram shows the line <span class=\"inline-math\" data-math=\"y=x+1\" data-display=\"false\"></span> and the curve <span class=\"inline-math\" data-math=\"y=6+5x-x^2\" data-display=\"false\"></span></p><figure class=\"diagram\"><img src=\"assets/smq-1.21/questions/assets/diagrams/q8.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><ol class=\"parts\" start=\"1\"><li><p>Write down the inequalities that define the shaded region.</p></li><li><p>Find the coordinates of the points <span class=\"inline-math\" data-math=\"P\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"Q\" data-display=\"false\"></span></p></li><li><p>Solve the inequality</p><span class=\"equation\" data-math=\"6+5x-x^2&gt;x+1\" data-display=\"true\"></span><p>giving your answer in set notation.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y&gt;x+1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y\\le6+5x-x^2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"6+5x-x^2=x+1\\Rightarrow x^2-4x-5=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(x-5)(x+1)=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"x=5,x=-1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"P\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"(-1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"Q\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"(5,6)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"-1&lt;x&lt;5\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\{x:x\\in\\mathbb R,-1&lt;x&lt;5\\}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.21-q9","number":9,"question":"<p>The diagram shows two curves of the form</p><span class=\"equation\" data-math=\"y=ax^2+bx+c\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"a,b,c\" data-display=\"false\"></span> are non-zero constants.</p><figure class=\"diagram\"><img src=\"assets/smq-1.21/questions/assets/diagrams/q9.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><ol class=\"parts\" start=\"1\"><li><p>Write down the inequalities that define the shaded region.</p></li><li><p>Find the coordinates of the points <span class=\"inline-math\" data-math=\"P\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(x-3)(x-4)=x^2-7x+12\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=-(x+2)(x-4)=-x^2+2x+8\" data-display=\"false\"></span><br> So the inequalities are:<br> <span class=\"inline-math\" data-math=\"y\\ge x^2-7x+12\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y&lt;-x^2+2x+8\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"x^2-7x+12=-x^2+2x+8\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow2x^2-9x+4=0\\Rightarrow(x-4)(2x-1)=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"x=\\frac12,y=\\frac{35}{4}\" data-display=\"false\"></span><br> P is <span class=\"inline-math\" data-math=\"(\\frac12,\\frac{35}{4})\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.21-q10","number":10,"question":"<ol class=\"parts\" start=\"1\"><li><p>Sketch and shade the region which satisfies both</p><span class=\"equation\" data-math=\"y+3\\ge x^2\\text{ and }y+2x^2&lt;x+1\" data-display=\"true\"></span></li><li><p>Hence, solve the inequality</p><span class=\"equation\" data-math=\"3x^2-x-4&lt;0\" data-display=\"true\"></span><p>giving your answer in set notation.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=x^2-3\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=-2x^2+x+1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"x^2-3=-2x^2+x+1\\Rightarrow3x^2-x-4=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(3x-4)(x+1)=0\\Rightarrow(-1,-2),(\\frac43,-\\frac{11}{9})\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"-1&lt;x&lt;\\frac43\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\{x:x\\in\\mathbb R,-1&lt;x&lt;\\frac43\\}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.21-q11","number":11,"question":"<p><strong>Prerequisite knowledge for Q11-Q12: Cubic Curves</strong> Sketch and shade the region which satisfies</p><span class=\"equation\" data-math=\"y&lt;x(x-2)(x+4)\" data-display=\"true\"></span>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s11.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q12","number":12,"question":"<p>Sketch and shade the region which satisfies</p><span class=\"equation\" data-math=\"y\\ge x^3-6x^2+11x-6\\text{ and }y&lt;2x-2\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"x^3-6x^2+11x-6=(x-1)(x-2)(x-3)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"x^3-6x^2+11x-6=2x-2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow x^3-6x^2+9x-4=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(x-4)(x-1)^2=0\\Rightarrow(1,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(4,6)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q13","number":13,"question":"<p><strong>Prerequisite knowledge for Q13-Q14: Circles</strong></p><ol class=\"parts\" start=\"1\"><li><p>Show that <span class=\"inline-math\" data-math=\"x^2+2x+y^2=3\" data-display=\"false\"></span> is an equation of a circle, stating the centre and the radius.</p></li><li><p>Hence sketch a diagram and shade the region which satisfies</p><span class=\"equation\" data-math=\"x^2+2x+y^2&lt;3\" data-display=\"true\"></span></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"(x+1)^2-1+y^2=3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(x+1)^2+y^2=4\" data-display=\"false\"></span> which is a circle with centre <span class=\"inline-math\" data-math=\"(-1,0)\" data-display=\"false\"></span> and radius 2.</p>","<h3 class=\"part-label\">b)</h3><p>When <span class=\"inline-math\" data-math=\"x=0,y=\\pm\\sqrt3\\Rightarrow(0,-\\sqrt3),(0,\\sqrt3)\" data-display=\"false\"></span><br> When <span class=\"inline-math\" data-math=\"y=0,x^2+2x-3=(x-1)(x+3)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(1,0),(-3,0)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s13b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.21-q14","number":14,"question":"<p>Sketch a diagram and shade the region which satisfies both</p><span class=\"equation\" data-math=\"(x-3)^2+(y-1)^2\\le25\\text{ and }y&gt;3-x\" data-display=\"true\"></span>","steps":["<p><span class=\"inline-math\" data-math=\"(x-3)^2+(y-1)^2=25\" data-display=\"false\"></span> has centre <span class=\"inline-math\" data-math=\"(3,1)\" data-display=\"false\"></span><br> When <span class=\"inline-math\" data-math=\"x=0,(-3)^2+(y-1)^2=25\\Rightarrow y=1\\pm4\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(0,-3)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(0,5)\" data-display=\"false\"></span><br> When <span class=\"inline-math\" data-math=\"y=0,(x-3)^2+(-1)^2=25\\Rightarrow y=3\\pm2\\sqrt6\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=3-x\\Rightarrow(x-3)^2+(3-x-1)^2=25\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow x^2-6x+9+4-4x+x^2=25\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow2x^2-10x-12=0\\Rightarrow2(x-6)(x+1)=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow(-1,4)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(6,-3)\" data-display=\"false\"></span></p>","<figure class=\"diagram\"><img src=\"assets/smq-1.21/solutions/assets/diagrams/s14.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]}]