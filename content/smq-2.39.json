[{"id":"smq-year2-2.39-q1","number":1,"question":"<ol class=\"parts\" start=\"1\"><li><p>Write <span class=\"inline-math\" data-math=\"\\cos2x\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"\\cos x\" data-display=\"false\"></span></p></li><li><p>Hence show that <span class=\"inline-math\" data-math=\"\\int_0^{\\pi/4}\\cos^2x\\,dx=\\frac{2+\\pi}{8}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\cos2x=2\\cos^2x-1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\cos2x=2\\cos^2x-1 \\Rightarrow\\cos^2x=\\tfrac12(\\cos2x+1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow\\cos^2x=\\tfrac12\\cos2x+\\tfrac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^{\\pi/4}\\cos^2x\\,dx =\\int_0^{\\pi/4}(\\tfrac12\\cos2x+\\tfrac12)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac14\\sin2x+\\tfrac12x]_0^{\\pi/4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac14\\sin(2\\times\\tfrac\\pi4)+\\tfrac12\\times\\tfrac\\pi4)-(\\tfrac14\\sin(2\\times0)+\\tfrac12\\times0)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac14+\\tfrac\\pi8)-(0+0)=\\tfrac28+\\tfrac\\pi8=\\tfrac{2+\\pi}{8}\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q2","number":2,"question":"<ol class=\"parts\" start=\"1\"><li><p>Write <span class=\"inline-math\" data-math=\"\\cos2x\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"\\sin x\" data-display=\"false\"></span></p></li><li><p>Hence show that <span class=\"inline-math\" data-math=\"\\int_0^{\\pi/2}\\sin^2x\\,dx=\\frac\\pi4\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\cos2x=1-2\\sin^2x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\cos2x=1-2\\sin^2x \\Rightarrow\\sin^2x=\\tfrac12(1-\\cos2x)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow\\sin^2x=\\tfrac12-\\tfrac12\\cos2x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^{\\pi/2}\\sin^2x\\,dx =\\int_0^{\\pi/2}(\\tfrac12-\\tfrac12\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac12x-\\tfrac14\\sin2x]_0^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac12\\times\\tfrac\\pi2-\\tfrac14\\sin(2\\times\\tfrac\\pi2))-(\\tfrac12\\times0-\\tfrac14\\sin(2\\times0))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac\\pi4-0)-(0-0)=\\tfrac\\pi4\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q3","number":3,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int(1+\\sin x)^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(1-\\cos x)^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(\\sin x-\\cos x)^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(\\sin x-\\cos x)(\\sin x+\\cos x)\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int(1+\\sin x)^2\\,dx =\\int(1+2\\sin x+\\sin^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\bigl(1+2\\sin x+(\\tfrac12-\\tfrac12\\cos2x)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\tfrac32+2\\sin x-\\tfrac12\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\tfrac32x-2\\cos x-\\tfrac14\\sin2x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int(1-\\cos x)^2\\,dx =\\int(1-2\\cos x+\\cos^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\bigl(1-2\\cos x+(\\tfrac12\\cos2x+\\tfrac12)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\tfrac32-2\\cos x+\\tfrac12\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\tfrac32x-2\\sin x+\\tfrac14\\sin2x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\int(\\sin x-\\cos x)^2\\,dx =\\int(\\sin^2x-2\\sin x\\cos x+\\cos^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\sin^2x+\\cos^2x-2\\sin x\\cos x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(1-\\sin2x)\\,dx=x+\\tfrac12\\cos2x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int(\\sin x-\\cos x)(\\sin x+\\cos x)\\,dx =\\int(\\sin^2x-\\cos^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\bigl((\\tfrac12-\\tfrac12\\cos2x)-(\\tfrac12\\cos2x+\\tfrac12)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(\\tfrac12-\\tfrac12\\cos2x-\\tfrac12\\cos2x-\\tfrac12)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(-\\cos2x)\\,dx=-\\tfrac12\\sin2x+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q4","number":4,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int\\sin x\\cos x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int8\\sin2x\\cos2x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int12\\sin5x\\cos5x\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int\\cos^2 6x\\tan6x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\int\\sin x\\cos x\\,dx=\\int\\tfrac12(2\\sin x\\cos x)\\,dx=\\int\\tfrac12\\sin2x\\,dx=-\\tfrac14\\cos2x+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\int8\\sin2x\\cos2x\\,dx=\\int4(2\\sin2x\\cos2x)\\,dx=\\int4\\sin4x\\,dx=-\\cos4x+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\int12\\sin5x\\cos5x\\,dx=\\int6(2\\sin5x\\cos5x)\\,dx=\\int6\\sin10x\\,dx=-\\tfrac35\\cos10x+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int\\cos^2 6x\\tan6x\\,dx =\\int\\cos^2 6x\\times\\frac{\\sin6x}{\\cos6x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\sin6x\\cos6x\\,dx=\\int\\tfrac12(2\\sin6x\\cos6x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\tfrac12\\sin12x\\,dx=-\\tfrac1{24}\\cos12x+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q5","number":5,"question":"<p>Evaluate the following definite integrals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int_0^{\\pi/2}(4-3\\sin x)^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_0^{\\pi/2}(1-6\\cos x)^2\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int_0^{\\pi/2}(4-3\\sin x)^2\\,dx =\\int_0^{\\pi/2}(16-24\\sin x+9\\sin^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}\\bigl(16-24\\sin x+9(\\tfrac12-\\tfrac12\\cos2x)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}(16-24\\sin x+\\tfrac92-\\tfrac92\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}(\\tfrac{41}2-24\\sin x-\\tfrac92\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac{41}2x+24\\cos x-\\tfrac94\\sin2x]_0^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{41}2\\times\\tfrac\\pi2+24\\cos\\tfrac\\pi2-\\tfrac94\\sin(2\\times\\tfrac\\pi2))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(\\tfrac{41}2\\times0+24\\cos0-\\tfrac94\\sin(2\\times0))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{41\\pi}4+0-0)-(0+24-0)=\\tfrac{41\\pi}4-24\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int_0^{\\pi/2}(1-6\\cos x)^2\\,dx =\\int_0^{\\pi/2}(1-12\\cos x+36\\cos^2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}\\bigl(1-12\\cos x+36(\\tfrac12\\cos2x+\\tfrac12)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}(1-12\\cos x+18\\cos2x+18)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/2}(19-12\\cos x+18\\cos2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[19x-12\\sin x+9\\sin2x]_0^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(19\\times\\tfrac\\pi2-12\\sin\\tfrac\\pi2+9\\sin(2\\times\\tfrac\\pi2))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(19\\times0-12\\sin0+9\\sin(2\\times0))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{19\\pi}2-12+0)-(0-0+0)=\\tfrac{19\\pi}2-12\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q6","number":6,"question":"<p>Evaluate the following definite integrals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int_0^{\\pi/4}(1-8\\sin2x)^2\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{-\\pi}^\\pi(7+9\\cos3x)^2\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\int_0^{\\pi/4}(1-8\\sin2x)^2\\,dx =\\int_0^{\\pi/4}(1-16\\sin2x+64\\sin^2 2x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/4}\\bigl(1-16\\sin2x+64(\\tfrac12-\\tfrac12\\cos4x)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/4}(1-16\\sin2x+32-32\\cos4x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/4}(33-16\\sin2x-32\\cos4x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[33x+8\\cos2x-8\\sin4x]_0^{\\pi/4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(33\\times\\tfrac\\pi4+8\\cos(2\\times\\tfrac\\pi4)-8\\sin(4\\times\\tfrac\\pi4))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(33\\times0+8\\cos(2\\times0)-8\\sin(4\\times0))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{33\\pi}4+0-0)-(0+8-0)=\\tfrac{33\\pi}4-8\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\int_{-\\pi}^\\pi(7+9\\cos3x)^2\\,dx =\\int_{-\\pi}^\\pi(49+126\\cos3x+81\\cos^2 3x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-\\pi}^\\pi\\bigl(49+126\\cos3x+81(\\tfrac12\\cos6x+\\tfrac12)\\bigr)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-\\pi}^\\pi(49+126\\cos3x+\\tfrac{81}2\\cos6x+\\tfrac{81}2)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-\\pi}^\\pi(\\tfrac{179}2+126\\cos3x+\\tfrac{81}2\\cos6x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac{179}2x+42\\sin3x+\\tfrac{27}4\\sin6x]_{-\\pi}^\\pi\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{179}2\\times\\pi+42\\sin(3\\times\\pi)+\\tfrac{27}4\\sin(6\\times\\pi))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(\\tfrac{179}2\\times(-\\pi)+42\\sin(3\\times(-\\pi))+\\tfrac{27}4\\sin(6\\times(-\\pi)))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{179\\pi}2+0+0)-(-\\tfrac{179\\pi}2+0+0)=179\\pi\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q7","number":7,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int(2\\cos^2 3x-1)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(1-2\\sin^2 5x)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(\\sin4x\\cot2x-1)\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(1-\\sin20x\\tan10x)\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\int(2\\cos^2 3x-1)\\,dx=\\int\\cos6x\\,dx=\\frac16\\sin6x+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\int(1-2\\sin^2 5x)\\,dx=\\int\\cos10x\\,dx=\\frac1{10}\\sin10x+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\n\\int(\\sin4x\\cot2x-1)\\,dx =\\int\\left(2\\sin2x\\cos2x\\times\\frac{\\cos2x}{\\sin2x}-1\\right)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(2\\cos^2 2x-1)\\,dx=\\int\\cos4x\\,dx=\\tfrac14\\sin4x+c\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\int(1-\\sin20x\\tan10x)\\,dx =\\int\\left(1-2\\sin10x\\cos10x\\times\\frac{\\sin10x}{\\cos10x}\\right)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int(1-2\\sin^2 10x)\\,dx=\\int\\cos20x\\,dx=\\tfrac1{20}\\sin20x+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q8","number":8,"question":"<p>Find <span class=\"inline-math\" data-math=\"\\displaystyle\\int\\frac{10\\sin x\\cos x}{2\\cos^2x+3}\\,dx\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\int\\frac{10\\sin x\\cos x}{2\\cos^2x+3}\\,dx =\\int\\frac{5(2\\sin x\\cos x)}{(2\\cos^2x-1)+4}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int\\frac{5\\sin2x}{\\cos2x+4}\\,dx=-\\tfrac52\\ln|\\cos2x+4|+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q9","number":9,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function</p><span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac{4\\tan x}{\\sqrt{2\\cos2x+2}}\" data-display=\"true\"></span><p>and passes through the point <span class=\"inline-math\" data-math=\"(\\pi,6)\" data-display=\"false\"></span>.</p><p>Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a\\sec x+b\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are integers to be found.</p>","steps":["<span class=\"equation\" data-math=\"\n\\frac{dy}{dx}=\\frac{4\\tan x}{\\sqrt{2\\cos2x+2}} \\Rightarrow\\frac{dy}{dx}=\\frac{4\\tan x}{\\sqrt{2(2\\cos^2x-1)+2}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow\\frac{dy}{dx}=\\frac{4\\tan x}{\\sqrt{4\\cos^2x-2+2}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow\\frac{dy}{dx}=\\frac{4\\tan x}{\\sqrt{4\\cos^2x}}\\Rightarrow\\frac{dy}{dx}=\\frac{4\\tan x}{2\\cos x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow\\frac{dy}{dx}=2\\tan x\\sec x\\Rightarrow y=2\\sec x+c\n\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=\\pi\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=6\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"6=2\\sec\\pi+c\\Rightarrow6=\\frac2{\\cos\\pi}+c\\Rightarrow6=-2+c\\Rightarrow c=8\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=2\\sec x+8\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.39-q10","number":10,"question":"<p>Evaluate the following definite integral</p><span class=\"equation\" data-math=\"\\int_0^{\\pi/4}\\frac{\\sqrt{1-\\cos2x}}{\\cos2x+1}\\,dx\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\int_0^{\\pi/4}\\frac{\\sqrt{1-\\cos2x}}{\\cos2x+1}\\,dx =\\int_0^{\\pi/4}\\frac{\\sqrt{1-(1-2\\sin^2x)}}{(2\\cos^2x-1)+1}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/4}\\frac{\\sqrt{2\\sin^2x}}{2\\cos^2x}\\,dx=\\int_0^{\\pi/4}\\frac{\\sqrt2\\sin x}{2\\cos^2x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^{\\pi/4}\\tfrac{\\sqrt2}2\\tan x\\sec x\\,dx=[\\tfrac{\\sqrt2}2\\sec x]_0^{\\pi/4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{\\sqrt2}2\\sec\\tfrac\\pi4)-(\\tfrac{\\sqrt2}2\\sec0)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{\\sqrt2}2\\times\\tfrac1{\\cos(\\pi/4)})-(\\tfrac{\\sqrt2}2\\times\\tfrac1{\\cos0})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{\\sqrt2}2\\times\\sqrt2)-(\\tfrac{\\sqrt2}2\\times1)=1-\\tfrac{\\sqrt2}2\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q11","number":11,"question":"<p>Find the exact value of</p><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=\\pi/4}^{\\pi/2}\\frac{(\\cos2x+1)\\operatorname{cosec}x}{\\sin2x}\\,\\delta x\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\n\\lim_{\\delta x\\to0}\\sum_{x=\\pi/4}^{\\pi/2}\\frac{(\\cos2x+1)\\operatorname{cosec}x}{\\sin2x}\\,\\delta x\n =\\int_{\\pi/4}^{\\pi/2}\\frac{(\\cos2x+1)\\operatorname{cosec}x}{\\sin2x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}\\frac{(2\\cos^2x-1+1)\\times\\frac1{\\sin x}}{2\\sin x\\cos x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}\\frac{2\\cos^2x}{2\\sin^2x\\cos x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}\\frac{\\cos x}{\\sin^2x}\\,dx=\\int_{\\pi/4}^{\\pi/2}\\operatorname{cosec}x\\cot x\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[-\\operatorname{cosec}x]_{\\pi/4}^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\operatorname{cosec}\\tfrac\\pi2)-(-\\operatorname{cosec}\\tfrac\\pi4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac1{\\sin(\\pi/2)})-(-\\tfrac1{\\sin(\\pi/4)})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-1)-(-\\sqrt2)=\\sqrt2-1\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q12","number":12,"question":"<p>The diagram below shows the curve with equation</p><span class=\"equation\" data-math=\"y=\\frac{2\\cos x}{\\sin2x(\\operatorname{cosec}x-\\sin x)}\" data-display=\"true\"></span><p>Find the exact value of the shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.39/questions/assets/diagrams/239-q12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n\\int_{\\pi/6}^{\\pi/3}\\frac{2\\cos x}{\\sin2x(\\operatorname{cosec}x-\\sin x)}\\,dx\n =\\int_{\\pi/6}^{\\pi/3}\\frac{2\\cos x}{2\\sin x\\cos x(\\frac1{\\sin x}-\\sin x)}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/6}^{\\pi/3}\\frac1{\\sin x(\\frac1{\\sin x}-\\sin x)}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/6}^{\\pi/3}\\frac1{1-\\sin^2x}\\,dx=\\int_{\\pi/6}^{\\pi/3}\\frac1{\\cos^2x}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/6}^{\\pi/3}\\sec^2x\\,dx=[\\tan x]_{\\pi/6}^{\\pi/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tan\\tfrac\\pi3)-(\\tan\\tfrac\\pi6)=(\\sqrt3)-(\\tfrac{\\sqrt3}3)=\\tfrac{2\\sqrt3}3\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q13","number":13,"question":"<ol class=\"parts\" start=\"1\"><li><p>Use the Compound Angle Formulae to show that <span class=\"inline-math\" data-math=\"\\sin3x\\equiv3\\sin x-4\\sin^3x\" data-display=\"false\"></span></p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\int\\sin^3x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\sin3x \\equiv\\sin(2x+x)\\equiv\\sin2x\\cos x+\\cos2x\\sin x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv(2\\sin x\\cos x)\\cos x+(1-2\\sin^2x)\\sin x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\sin x\\cos^2x+\\sin x-2\\sin^3x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\sin x(1-\\sin^2x)+\\sin x-2\\sin^3x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\sin x-2\\sin^3x+\\sin x-2\\sin^3x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv3\\sin x-4\\sin^3x\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\sin3x=3\\sin x-4\\sin^3x \\Rightarrow\\sin^3x=\\frac{3\\sin x-\\sin3x}4=\\tfrac34\\sin x-\\tfrac14\\sin3x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int\\sin^3x\\,dx =\\int(\\tfrac34\\sin x-\\tfrac14\\sin3x)\\,dx=-\\tfrac34\\cos x+\\tfrac1{12}\\cos3x+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q14","number":14,"question":"<ol class=\"parts\" start=\"1\"><li><p>Use the Compound Angle Formulae to show that <span class=\"inline-math\" data-math=\"\\cos3x\\equiv4\\cos^3x-3\\cos x\" data-display=\"false\"></span></p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\int\\cos^3x\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\cos3x \\equiv\\cos(2x+x)\\equiv\\cos2x\\cos x-\\sin2x\\sin x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv(2\\cos^2x-1)\\cos x-2\\sin x\\cos x\\times\\sin x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\cos^3x-\\cos x-2\\sin^2x\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\cos^3x-\\cos x-2(1-\\cos^2x)\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv2\\cos^3x-\\cos x-2\\cos x+2\\cos^3x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\equiv4\\cos^3x-3\\cos x\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\cos3x=4\\cos^3x-3\\cos x \\Rightarrow\\cos^3x=\\frac{\\cos3x+3\\cos x}4=\\tfrac14\\cos3x+\\tfrac34\\cos x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int\\cos^3x\\,dx =\\int(\\tfrac14\\cos3x+\\tfrac34\\cos x)\\,dx=\\tfrac1{12}\\sin3x+\\tfrac34\\sin x+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q15","number":15,"question":"<p><strong>Prerequisite knowledge for Q15-Q16: Integration by Substitution</strong> Evaluate the following definite integral</p><span class=\"equation\" data-math=\"\\int_0^{1/2}\\sqrt{\\frac{16x}{1-x}}\\,dx\" data-display=\"true\"></span><p>using the substitution <span class=\"inline-math\" data-math=\"x=\\cos^2u\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\int_0^{1/2}\\sqrt{\\frac{16x}{1-x}}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"x=\\cos^2u\\Rightarrow\\frac{dx}{du}=-2\\sin u\\cos u\\Rightarrow dx=-2\\sin u\\cos u\\,du\" data-display=\"true\"></span>","<p>Change limits:</p>","<span class=\"equation\" data-math=\"x=\\tfrac12\\Rightarrow\\tfrac12=\\cos^2u\\Rightarrow\\cos u=\\tfrac1{\\sqrt2}\\Rightarrow u=\\arccos\\tfrac1{\\sqrt2}=\\tfrac\\pi4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"x=0\\Rightarrow0=\\cos^2u\\Rightarrow\\cos u=0\\Rightarrow u=\\tfrac\\pi2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^{1/2}\\sqrt{\\frac{16x}{1-x}}\\,dx =\\int_{\\pi/2}^{\\pi/4}\\sqrt{\\frac{16\\cos^2u}{1-\\cos^2u}}\\times-2\\sin u\\cos u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}\\sqrt{\\frac{16\\cos^2u}{\\sin^2u}}\\times2\\sin u\\cos u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}\\frac{4\\cos u}{\\sin u}\\times2\\sin u\\cos u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}8\\cos^2u\\,du=\\int_{\\pi/4}^{\\pi/2}8\\times\\tfrac12(\\cos2u+1)\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{\\pi/4}^{\\pi/2}(4\\cos2u+4)\\,du=[2\\sin2u+4u]_{\\pi/4}^{\\pi/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2\\sin(2\\times\\tfrac\\pi2)+4\\times\\tfrac\\pi2)-(2\\sin(2\\times\\tfrac\\pi4)+4\\times\\tfrac\\pi4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(0+2\\pi)-(2+\\pi)=\\pi-2\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.39-q16","number":16,"question":"<p>Evaluate the following definite integral</p><span class=\"equation\" data-math=\"\\int_{-1}^5\\sqrt{(x+1)(5-x)}\\,dx\" data-display=\"true\"></span><p>using the substitution <span class=\"inline-math\" data-math=\"x=2-3\\cos u\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\int_{-1}^5\\sqrt{(x+1)(5-x)}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"x=2-3\\cos u\\Rightarrow\\frac{dx}{du}=3\\sin u\\Rightarrow dx=3\\sin u\\,du\" data-display=\"true\"></span>","<p>Change limits:</p>","<span class=\"equation\" data-math=\"x=5\\Rightarrow5=2-3\\cos u\\Rightarrow\\cos u=-1\\Rightarrow u=\\arccos(-1)=\\pi\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"x=-1\\Rightarrow-1=2-3\\cos u\\Rightarrow\\cos u=1\\Rightarrow u=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^5\\sqrt{(x+1)(5-x)}\\,dx =\\int_0^\\pi\\sqrt{((2-3\\cos u)+1)(5-(2-3\\cos u))}\\times3\\sin u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =3\\int_0^\\pi\\sqrt{(3-3\\cos u)(3+3\\cos u)}\\sin u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =3\\int_0^\\pi\\sqrt{9-9\\cos^2u}\\sin u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =3\\int_0^\\pi\\sqrt{9(1-\\cos^2u)}\\sin u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =3\\int_0^\\pi\\sqrt{9\\sin^2u}\\sin u\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^\\pi9\\sin^2u\\,du=\\int_0^\\pi9\\times\\tfrac12(1-\\cos2u)\\,du\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^\\pi(\\tfrac92-\\tfrac92\\cos2u)\\,du=[\\tfrac92u-\\tfrac94\\sin2u]_0^\\pi\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac92\\times\\pi-\\tfrac94\\sin(2\\times\\pi))-(\\tfrac92\\times0-\\tfrac94\\sin(2\\times0))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{9\\pi}2-0)-(0-0)=\\tfrac{9\\pi}2\n\" data-display=\"true\"></span>"]}]