[{"id":"smq-year1-1.15-q1","number":1,"question":"<p>The following graphs are all functions that can be written in the form <span class=\"inline-math\" data-math=\"y=(x-p)^3+q\" data-display=\"false\"></span>. Find the equation of the curve in the form</p><span class=\"equation\" data-math=\"y=x^3+bx^2+cx+d\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q1c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=x^3-4\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x-2)^3+1\\Rightarrow y=x^3-6x^2+12x-7\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x+3)^3-20\\Rightarrow y=x^3+9x^2+27x+7\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q2","number":2,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x+5)(x+3)(x+1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-5)(x-3)(x-1)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q3","number":3,"question":"<p>The following graphs are all functions that can be written in the form <span class=\"inline-math\" data-math=\"y=q-(x-p)^3\" data-display=\"false\"></span>. Find the equation of the curve in the form</p><span class=\"equation\" data-math=\"y=-x^3+bx^2+cx+d\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q3c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=-3-x^3\\Rightarrow y=-x^3-3\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=-(x+4)^3\\Rightarrow y=-x^3-12x^2-48x-64\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y =20-(x-2)^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow y =20-(x^3-6x^2+12x-8)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow y =-x^3+6x^2-12x+28\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q4","number":4,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x+5)(x+3)(x+1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-(x-5)(x-3)(x-1)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q5","number":5,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=(x-a)(x-b)(x-c)\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q5c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=(x+3)(x+1)(x-2)\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x+2)(x-1)(x-4)\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x-2)(x-3)(x-5)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q6","number":6,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x+2)(x-2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-2)(x+2)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s6a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s6b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q7","number":7,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=(x-a)(x-b)^2\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q7a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q7b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q7c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=(x+4)(x+2)^2\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x+3)^2(x-1)\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x+4)x^2\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q8","number":8,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x+3)(x-3)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(3-x)(x+3)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q9","number":9,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=k(x-a)(x-b)(x-c)\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q9a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q9b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q9c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y =k(x+3)(x-2)(x-4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(0,-48):\\ -48 =k(3)(-2)(-4)\\Rightarrow k=-2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny =-2(x+3)(x-2)(x-4)\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y =k(x+6)(x+3)(x-2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(0,24):\\ 24 =k(6)(3)(-2)\\Rightarrow k=-\\tfrac23\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny =-\\tfrac23(x+6)(x+3)(x-2)\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y =kx(x+2)(x-4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(2,-8):\\ -8 =k(2)(4)(-2)\\Rightarrow k=\\tfrac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny =\\tfrac12x(x+2)(x-4)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q10","number":10,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\tfrac13(x-6)(x-3)(x+3)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\tfrac34(x+8)(x+4)(x-4)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q11","number":11,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(2x+1)(x-2)(2x-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(3x-1)(2x-3)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x(4x-1)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x^2(4x-1)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s11a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s11b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s11c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s11d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q12","number":12,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x+3)(2x-1)(2x-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(4-x)(3x+2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\tfrac15(x+5)^2(5x-4)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\tfrac53(x+9)(x-3)(x-6)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s12a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s12b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s12c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s12d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q13","number":13,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-k)(x-2k)(x-3k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+k)(x+2k)(x-3k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(k-x)(x-2k)(x+3k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(k-x)(2k-x)(x+3k)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s13a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s13b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s13c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s13d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q14","number":14,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive constant, find the equation of the following graph in the form</p><span class=\"equation\" data-math=\"y=a(bx+c)(dx+e)(fx+g)\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/smq-1.15/questions/assets/q14a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"y=a\\left(x+\\frac{5k}{2}\\right)\\left(x-\\frac6k\\right)(x-6k)\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"y=60k\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"60k=a\\left(\\frac{5k}{2}\\right)\\left(-\\frac6k\\right)(-6k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow60k=90ka\\Rightarrow a=\\frac23\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore y=\\frac23\\left(x+\\frac{5k}{2}\\right)\\left(x-\\frac6k\\right)(x-6k)\" data-display=\"true\"></span>","<p><strong>Alternatively:</strong></p>","<span class=\"equation\" data-math=\"y=a\\left(x+\\frac{5k}{2}\\right)\\left(x-\\frac6k\\right)(x-6k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=\\frac{a}{2k}(2x+5k)(kx-6)(x-6k)\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"y=60k\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"60k=\\frac{a}{2k}(5k)(-6)(-6k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow60k=90ka\\Rightarrow a=\\frac23\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore y=\\frac1{3k}(2x+5k)(kx-6)(x-6k)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.15-q15","number":15,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the following graph:</p><span class=\"equation\" data-math=\"y=k(2k-x)(x-k)^2\" data-display=\"true\"></span>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s15.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.15-q16","number":16,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the graphs of</p><span class=\"equation\" data-math=\"y=(x-2k)(3kx+20)\" data-display=\"true\"></span><p>and</p><span class=\"equation\" data-math=\"y=(x-2k)(3kx+20)x\" data-display=\"true\"></span><p>on the same axes, showing clearly where the two graphs cross the coordinate axes and each other.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-1.15/solutions/assets/s16.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<span class=\"equation\" data-math=\"(x-2k)(3kx+20) =(x-2k)(3kx+20)x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow (x-2k)(3kx+20) -(x-2k)(3kx+20)x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow (x-2k)(3kx+20)(1-x) =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow x=2k\\text{ or }x =-\\frac{20}{3k}\\text{ or }x=1\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=(1-2k)(3k+20)\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\Rightarrow y=-6k^2-37k+20\" data-display=\"true\"></span>","<p>So the curves intersect at <span class=\"inline-math\" data-math=\"\\left(-\\frac{20}{3k},0\\right)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(2k,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(1,-6k^2-37k+20)\" data-display=\"false\"></span>.</p>"]}]