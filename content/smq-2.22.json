[{"id":"smq-year2-2.22-q1","number":1,"question":"<p><strong>Differentiation of <span class=\"inline-math\" data-math=\"(ax^k+\\ldots)^n\" data-display=\"false\"></span></strong> Find the gradient function of:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(2x^2+1)^3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(2x^3-5x)^4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(3x^4-1)^{1/2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(1-x^2)^{-3/2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac1{5+\\sqrt x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(\\frac1x-x)^7\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=3(4x)(2x^2+1)^2=12x(2x^2+1)^2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=4(6x^2-5)(2x^3-5x)^3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac12(12x^3)(3x^4-1)^{-1/2}=6x^3(3x^4-1)^{-1/2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\frac32(-2x)(1-x^2)^{-5/2}=3x(1-x^2)^{-5/2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"y=(5+x^{1/2})^{-1}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-(\\frac12x^{-1/2})(5+x^{1/2})^{-2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"y=(x^{-1}-x)^7\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=7(-x^{-2}-1)(x^{-1}-x)^6\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q2","number":2,"question":"<p>Find the gradient of the curve <span class=\"inline-math\" data-math=\"y=\\sqrt{5x^2-2x+1}\" data-display=\"false\"></span> at <span class=\"inline-math\" data-math=\"(2,\\sqrt{17})\" data-display=\"false\"></span></p>","steps":["<p><span class=\"inline-math\" data-math=\"y=(5x^2-2x+1)^{1/2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac12(10x-2)(5x^2-2x+1)^{-1/2}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=2}=\\frac9{\\sqrt{17}}\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q3","number":3,"question":"<p>Find the equation of the tangent to the curve <span class=\"inline-math\" data-math=\"y=\\sqrt{1+7x^2}\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span> giving your answer in the form <span class=\"inline-math\" data-math=\"ay+bx=c\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"y=(1+7x^2)^{1/2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac12(14x)(1+7x^2)^{-1/2}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=3}=\\frac{21}8\" data-display=\"true\"></span>","<p>At <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=8\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"y-8=\\tfrac{21}8(x-3)\\Rightarrow8y-64=21x-63\\Rightarrow8y-21x=1\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q4","number":4,"question":"<p>Find the equation of the normal to the curve <span class=\"inline-math\" data-math=\"y=\\frac1{\\sqrt{4-3x^2}}\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span> giving your answer in the form <span class=\"inline-math\" data-math=\"ay+bx=c\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers to be found.</p>","steps":["<p><span class=\"inline-math\" data-math=\"y=(4-3x^2)^{-1/2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\frac12(6x)(4-3x^2)^{-3/2}\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=-1}=3\" data-display=\"true\"></span>","<p>At <span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"y-1=-\\tfrac13(x+1)\\Rightarrow3y-x=4\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q5","number":5,"question":"<p>Find the coordinates of all the stationary points of each of the following curves:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(3x^2-1)^4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac1{\\sqrt{1+x^2}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=4(6x)(3x^2-1)^3=24x(3x^2-1)^3\" data-display=\"true\"></span>","<p>Stat pt when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"16x(3x^2-1)^3=0\\Rightarrow x=0\\text{ or }x=\\pm\\tfrac1{\\sqrt3}\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"(-\\frac1{\\sqrt3},0)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(0,1)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(\\frac1{\\sqrt3},0)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=(1+x^2)^{-1/2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\frac12(2x)(1+x^2)^{-3/2}\" data-display=\"false\"></span> Stat pt when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"-\\tfrac12(2x)(1+x^2)^{-3/2}=0\\Rightarrow x=0\" data-display=\"true\"></span>","<p>Stat pt is <span class=\"inline-math\" data-math=\"(0,1)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.22-q6","number":6,"question":"<p>For each of the following, find <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}\" data-display=\"false\"></span> giving your answer in terms of <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x=3y^2-y\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x=2y^4-1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x=(3y^2-1)^{1/4}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dx}{dy}=6y-1\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac1{6y-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dx}{dy}=8y^3\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac1{8y^3}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dx}{dy}=\\frac14(6y)(3y^2-1)^{-3/4}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac2{3y}(3y^2-1)^{3/4}\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q7","number":7,"question":"<p>Find <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}\" data-display=\"false\"></span> of each of the following at the given point:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x=(3-y)^5\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"y=2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x=(y^2-2y+1)^{1/2}\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"y=4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x=\\frac1{\\sqrt{y^4+3}}\" data-display=\"false\"></span> for <span class=\"inline-math\" data-math=\"y&gt;0\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dx}{dy}=-5(3-y)^5\\text{ so }\\left.\\frac{dx}{dy}\\right|_{y=2}=-5\\quad\\therefore\\left.\\frac{dy}{dx}\\right|_{y=2}=-\\tfrac15\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dx}{dy}=\\tfrac12(2y-2)(y^2-2y+1)^{-1/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{dx}{dy}\\right|_{y=4}=\\tfrac12\\times6\\times\\tfrac13=1\\quad\\therefore\\left.\\frac{dy}{dx}\\right|_{y=4}=1\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><p>When <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\sqrt{y^4+3}=2\\Rightarrow y=1\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"x=(y^4+3)^{-1/2},\\quad\\frac{dx}{dy}=-\\tfrac12(4y^3)(y^4+3)^{-3/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{dx}{dy}\\right|_{y=1}=-\\tfrac12(4)(1+3)^{-3/2}=-\\tfrac14\\quad\\therefore\\left.\\frac{dy}{dx}\\right|_{y=1}=-4\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q8","number":8,"question":"<p>Find the tangent of the curve <span class=\"inline-math\" data-math=\"y=\\frac13(x^2+5)^{3/2}\" data-display=\"false\"></span> at <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span> giving your answers in the form <span class=\"inline-math\" data-math=\"y=mx+c\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\tfrac12(2x)(x^2+5)^{1/2}\\text{ so }\\left.\\frac{dy}{dx}\\right|_{x=2}=6\" data-display=\"true\"></span>","<p>At <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=9\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"y-9=6(x-2)\\Rightarrow y=6x-3\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q9","number":9,"question":"<p>A curve has equation <span class=\"inline-math\" data-math=\"x=(y-2)^6\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p>Find <span class=\"inline-math\" data-math=\"\\frac{dx}{dy}\" data-display=\"false\"></span> in terms of <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span></p></li><li><p>Hence find <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=x^{1/6}+2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{dx}{dy}=6(y-2)^5=6(x^{1/6}+2-2)^5=6x^{5/6}\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><p>So <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac1{6x^{5/6}}=\\frac16x^{-5/6}\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q10","number":10,"question":"<p><strong>Prerequisite knowledge for Q10: Points of Inflection</strong> Find the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-value of the point of inflection on the curve <span class=\"inline-math\" data-math=\"\\mathrm f(x)\" data-display=\"false\"></span> given that <span class=\"inline-math\" data-math=\"\\mathrm f'(x)=\\frac1{(1+3x-2x^2)^3}\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=(1+3x-2x^2)^{-3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{d^2y}{dx^2}=-3(3-4x)(1+3x-2x^2)^{-4}=\\frac{12x-9}{(1+3x-2x^2)^4}\" data-display=\"true\"></span>","<p>Pt of inflection when <span class=\"inline-math\" data-math=\"\\frac{d^2y}{dx^2}=0\\Rightarrow12x-9=0\" data-display=\"false\"></span> therefore at <span class=\"inline-math\" data-math=\"x=\\frac34\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.22-q11","number":11,"question":"<p><strong>Differentiation of <span class=\"inline-math\" data-math=\"\\sin(\\mathrm f(x))\" data-display=\"false\"></span> &amp; <span class=\"inline-math\" data-math=\"\\cos(\\mathrm f(x))\" data-display=\"false\"></span></strong> Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\sin^2x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\cos^2x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2\\sin(3x-7)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\frac15\\cos(\\pi x-\\frac\\pi2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\cos\\sqrt x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-2\\sin(x^3)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\cos(\\sin x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\sin(\\sin x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\sqrt{\\sin x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\sqrt[3]{\\cos x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=1-\\cos^3(5x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=(\\sin x)^2\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=2\\cos x(\\sin x)^1=2\\cos x\\sin x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=(\\cos x)^2\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-2\\sin x(\\cos x)^1=-2\\sin x\\cos x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=6\\cos(3x-7)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac\\pi5\\sin(\\pi x-\\frac\\pi2)\" data-display=\"false\"></span> (or <span class=\"inline-math\" data-math=\"-\\frac\\pi5\\cos(\\pi x)\" data-display=\"false\"></span>)</p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\frac12x^{-1/2}\\sin(\\sqrt x)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-6x^2\\cos(x^3)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\cos x\\times-\\sin(\\sin x)=-\\cos x\\sin(\\sin x)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\cos x\\times\\cos(\\sin x)=\\cos x\\cos(\\sin x)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">i)</h3><p><span class=\"inline-math\" data-math=\"y=(\\sin x)^{1/2}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac12\\cos x(\\sin x)^{-1/2}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">j)</h3><p><span class=\"inline-math\" data-math=\"y=(\\cos x)^{1/3}\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\frac13\\sin x(\\cos x)^{-2/3}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">k)</h3><p><span class=\"inline-math\" data-math=\"y=(\\cos(5x))^3\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=5\\times\\sin(5x)\\times3(\\cos(5x))^2=15\\sin(5x)\\cos^2(5x)\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q12","number":12,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\frac d{dx}[\\frac1{\\sin x}]=-\\operatorname{cosec}x\\cot x\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\n\\frac d{dx}[(\\sin x)^{-1}] =-\\cos x(\\sin x)^{-2}=-\\frac{\\cos x}{\\sin^2x}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{\\sin x}\\times\\frac{\\cos x}{\\sin x}=-\\operatorname{cosec}x\\cot x\\text{ as req.}\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q13","number":13,"question":"<p>A model for the tide height over a 24-hour period in Southampton is</p><span class=\"equation\" data-math=\"x=2.85+0.75\\sin\\left(\\frac{17\\pi}{120}t+\\frac{3\\pi}2\\right)\" data-display=\"true\"></span><p>where the depth of the water is <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> metres and <span class=\"inline-math\" data-math=\"t\" data-display=\"false\"></span> is the number of hours passed since midnight.</p><ol class=\"parts\" start=\"1\"><li><p>State the maximum and minimum height the water reaches.</p></li><li><p>By using Calculus, find the two times at which it reaches its maximum depth in the first 24-hour period.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Max and min are <span class=\"inline-math\" data-math=\"2.85+0.75=3.6\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"2.85-0.75=2.1\" data-display=\"false\"></span> respectively.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dx}{dt}=0.75\\times\\frac{17\\pi}{120}\\cos\\left(\\frac{17\\pi}{120}t+\\frac{3\\pi}2\\right)\" data-display=\"true\"></span>","<p>Stat pt when <span class=\"inline-math\" data-math=\"\\frac{dx}{dt}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"0.75\\times\\frac{17\\pi}{120}\\cos\\left(\\frac{17\\pi}{120}t+\\frac{3\\pi}2\\right)=0\\Rightarrow\\cos\\left(\\frac{17\\pi}{120}t+\\frac{3\\pi}2\\right)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{17\\pi}{120}t+\\frac{3\\pi}2=\\frac\\pi2,\\frac{3\\pi}2,\\frac{5\\pi}2,\\frac{7\\pi}2,\\ldots\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"t=0,\\frac{120}{17},\\frac{240}{17},\\frac{360}{17},\\ldots\" data-display=\"true\"></span>","<p>So at <span class=\"inline-math\" data-math=\"(0,2.1)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(\\frac{120}{17},3.6)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(\\frac{240}{17},2.1)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(\\frac{360}{17},3.6)\" data-display=\"false\"></span>. Maximums at <span class=\"inline-math\" data-math=\"\\frac{120}{17}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\frac{360}{17}\" data-display=\"false\"></span> therefore 07:04 and 21:11.</p>"]},{"id":"smq-year2-2.22-q14","number":14,"question":"<p>A curve is given by <span class=\"inline-math\" data-math=\"y=a\\sin^2x+b\\cos^2x\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are positive constants and are such that <span class=\"inline-math\" data-math=\"a\\ne b\" data-display=\"false\"></span>. Show that the gradient function of the curve at <span class=\"inline-math\" data-math=\"x=\\frac\\pi4\" data-display=\"false\"></span> is never zero.</p>","steps":["<p><span class=\"inline-math\" data-math=\"y=a(\\sin x)^2+b(\\cos x)^2\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=2a\\cos x\\sin x-2b\\sin x\\cos x\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\left.\\frac{dy}{dx}\\right|_{x=\\pi/4}=a-b\" data-display=\"true\"></span>","<p>But since <span class=\"inline-math\" data-math=\"a\\ne b\" data-display=\"false\"></span> the gradient at <span class=\"inline-math\" data-math=\"x=\\frac\\pi4\" data-display=\"false\"></span> is never zero.</p>"]},{"id":"smq-year2-2.22-q15","number":15,"question":"<p>A model for the number of daylight hours, <span class=\"inline-math\" data-math=\"t\" data-display=\"false\"></span> (in hours), on the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>th day of the year may be given by</p><span class=\"equation\" data-math=\"t=10+2.7\\sin\\left(\\frac{2\\pi}{365}(x-78)\\right)\" data-display=\"true\"></span><p>Use this model to compare how the number of hours of daylight is changing on day 17 compared to on day 85.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dt}{dx}=2.7\\times\\frac{2\\pi}{365}\\cos\\left(\\frac{2\\pi}{365}(x-78)\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\left.\\frac{dt}{dx}\\right|_{t=17}=0.0231236\\text{ and }\\left.\\frac{dt}{dx}\\right|_{t=85}=0.0461413\" data-display=\"true\"></span>","<p>The rate at which the number of daylight hours is increasing is higher on day85 compared to on day17.</p>"]},{"id":"smq-year2-2.22-q16","number":16,"question":"<p>Show that the stationary points of <span class=\"inline-math\" data-math=\"\\mathrm f(x)=\\sin(\\frac\\pi2e^x)\" data-display=\"false\"></span> occur when <span class=\"inline-math\" data-math=\"x=\\ln k\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive odd integer.</p>","steps":["<span class=\"equation\" data-math=\"\\mathrm f'(x)=\\tfrac\\pi2e^x\\cos(\\tfrac\\pi2e^x)\" data-display=\"true\"></span>","<p>Stat pt when <span class=\"inline-math\" data-math=\"\\mathrm f'(x)=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\tfrac\\pi2e^x\\cos(\\tfrac\\pi2e^x)=0\\text{ but }e^x\\ne0\\Rightarrow\\cos(\\tfrac\\pi2e^x)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\tfrac\\pi2e^x=\\tfrac\\pi2,\\tfrac{3\\pi}2,\\tfrac{5\\pi}2,\\tfrac{7\\pi}2,\\ldots\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"e^x=1,3,5,7,\\ldots\\Rightarrow x=\\ln1,\\ln3,\\ln5,\\ln7,\\ldots\" data-display=\"false\"></span> Therefore <span class=\"inline-math\" data-math=\"x=\\ln k\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is positive odd integer.</p>"]},{"id":"smq-year2-2.22-q17","number":17,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\mathrm f(x)=\\frac12x+\\cos(\\frac2x)\" data-display=\"false\"></span> is an increasing function for all <span class=\"inline-math\" data-math=\"x&gt;2\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\mathrm f(x)=\\tfrac12x+\\cos(2x^{-1})\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"\\mathrm f'(x)=\\frac12+2x^{-2}\\sin(2x^{-1})=\\frac12+\\frac2{x^2}\\sin(\\frac2x)\" data-display=\"false\"></span>. Increasing function when <span class=\"inline-math\" data-math=\"\\mathrm f'(x)&gt;0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\tfrac12&gt;\\frac2{x^2}\\sin(\\tfrac2x)\\Rightarrow x^2&gt;4\\sin(\\tfrac2x)\" data-display=\"true\"></span>","<p>Largest <span class=\"inline-math\" data-math=\"\\sin(\\frac2x)\" data-display=\"false\"></span> can be is1.</p>","<span class=\"equation\" data-math=\"x^2&gt;4\\Rightarrow x^2-4&gt;0\\Rightarrow(x-2)(x+2)&gt;0\" data-display=\"true\"></span>","<p>Which is true for <span class=\"inline-math\" data-math=\"x&lt;-2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x&gt;2\" data-display=\"false\"></span>. Therefore always increasing for <span class=\"inline-math\" data-math=\"x&gt;2\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.22-q18","number":18,"question":"<p><strong>Differentiation of <span class=\"inline-math\" data-math=\"e^{\\mathrm f(x)}\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\ln(\\mathrm f(x))\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"a^{\\mathrm f(x)}\" data-display=\"false\"></span></strong> Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(e^{2x}-1)^5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(5^x-1)^4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(\\ln x)^4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=e^{3x^2-1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=4^{x^2+5x+1}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-5^{2x^2+1}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=10e^{2x}(e^{2x}-1)^4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=4\\ln5\\times5^x(5^x-1)^3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac4x(\\ln x)^3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=6xe^{3x^2-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(2x+5)\\ln4\\times4^{x^2+5x+1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=-\\ln5\\times4x\\times5^{2x^2+1}\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q19","number":19,"question":"<p>Find coordinates of the stationary points on the following curves:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=6x-e^{2x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2\\ln(x-x^2)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=6-2e^{2x}\" data-display=\"false\"></span> stat pt when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"6-2e^{2x}=0\\Rightarrow6=2e^{2x}\\Rightarrow e^{2x}=3\\Rightarrow2x=\\ln3\\Rightarrow x=\\tfrac12\\ln3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=6(\\tfrac12\\ln3)-e^{2\\times\\frac12\\ln3}=3\\ln3-3\" data-display=\"true\"></span>","<p>Stat pt is <span class=\"inline-math\" data-math=\"(\\frac12\\ln3,3\\ln3-3)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{2(1-2x)}{x-x^2}\" data-display=\"false\"></span> stat pt when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\frac{2(1-2x)}{x-x^2}=0\\Rightarrow2(1-2x)=0\\Rightarrow x=\\tfrac12\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=2\\ln(\\tfrac14)=-2\\ln4\" data-display=\"true\"></span>","<p>Stat pt is <span class=\"inline-math\" data-math=\"(\\frac12,-2\\ln4)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.22-q20","number":20,"question":"<p>Differentiate each of these:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\ln(2x^3+x^2-1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(\\sqrt x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(\\frac1{\\sqrt x})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(\\sin x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(e^x+1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(\\ln x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{6x^2+2x}{2x^3+x^2-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{\\frac12x^{-1/2}}{x^{1/2}}=\\frac12x^{-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{-\\frac12x^{-3/2}}{x^{-1/2}}=-\\frac12x^{-1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{\\cos x}{\\sin x}=\\cot x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{e^x}{e^x+1}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac1{x\\ln x}\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q21","number":21,"question":"<p><strong>Differentiation of <span class=\"inline-math\" data-math=\"\\tan(\\mathrm f(x))\" data-display=\"false\"></span></strong> Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\tan\\sqrt x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\tan(\\sin x-x^2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=e^{\\tan x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\tan(\\ln x+e^{2x})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\tan(\\tan x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac1{2\\sqrt x}\\sec^2\\sqrt x\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(\\cos x-2x)\\sec^2(\\sin x-x^2)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sec^2x\\ e^{\\tan x}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(\\frac1x+2e^{2x})\\sec^2(\\ln x+e^{2x})\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sec^2x\\ (\\sec^2(\\tan x))\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.22-q22","number":22,"question":"<p>Show that <span class=\"inline-math\" data-math=\"\\frac d{dx}[\\ln(\\tan x)]=\\operatorname{cosec}x\\sec x\" data-display=\"false\"></span></p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac{\\sec^2x}{\\tan x}=\\frac1{\\cos^2x}\\times\\frac{\\cos x}{\\sin x}=\\frac1{\\cos x}\\times\\frac1{\\sin x}=\\sec x\\operatorname{cosec}x\\text{ as req.}\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.22-q23","number":23,"question":"<p>A curve is given by <span class=\"inline-math\" data-math=\"y=\\tan(x^2)\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"0&lt;x&lt;\\sqrt{\\frac\\pi2}\" data-display=\"false\"></span>. Show that the curve is always increasing.</p>","steps":["<p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=2x\\sec^2(x^2)\" data-display=\"false\"></span>. Since <span class=\"inline-math\" data-math=\"\\sec^2(x^2)\\geq1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span> it is always increasing.</p>"]},{"id":"smq-year2-2.22-q24","number":24,"question":"<p>A curve is given by <span class=\"inline-math\" data-math=\"y=\\tan^2(ax)\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"0&lt;a\\leq2\\pi\" data-display=\"false\"></span>. Given that when <span class=\"inline-math\" data-math=\"x=1.5\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span> find the possible values of <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span></p>","steps":["<p><span class=\"inline-math\" data-math=\"y=(\\tan(ax))^2\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=2a\\sec^2(ax)\\tan(ax)\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"2a\\sec^2(1.5a)\\tan(1.5a)=0\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"a=0\" data-display=\"false\"></span> but <span class=\"inline-math\" data-math=\"a&gt;0\" data-display=\"false\"></span>, or <span class=\"inline-math\" data-math=\"\\sec^2(1.5a)=0\" data-display=\"false\"></span> no solutions, or <span class=\"inline-math\" data-math=\"\\tan(1.5a)=0\\Rightarrow1.5a=\\pi,2\\pi,3\\pi\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"a=\\tfrac23\\pi\\text{ or }a=\\tfrac43\\pi\\text{ or }a=2\\pi\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"a\\in\\{\\frac23\\pi,\\frac43\\pi,2\\pi\\}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.22-q25","number":25,"question":"<p>An ice cream cone is to be made from <span class=\"inline-math\" data-math=\"30\\pi\\ \\mathrm{cm^2}\" data-display=\"false\"></span> of wafer. The ice cream cone may be modelled with radius <span class=\"inline-math\" data-math=\"r\" data-display=\"false\"></span> cm, height <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> cm and slant height <span class=\"inline-math\" data-math=\"h\" data-display=\"false\"></span> cm and an assumption of negligible thickness.</p><figure class=\"diagram\"><img src=\"assets/smq-2.22/questions/assets/diagrams/222-q25.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p>Curved surface area: <span class=\"inline-math\" data-math=\"A=\\pi rh\" data-display=\"false\"></span></p><p>Volume: <span class=\"inline-math\" data-math=\"V=\\frac13\\pi r^2y\" data-display=\"false\"></span></p><ol class=\"parts\" start=\"1\"><li><p>Show that the volume is given by <span class=\"inline-math\" data-math=\"V=\\frac13\\pi\\sqrt{900r^2-r^6}\" data-display=\"false\"></span></p></li><li><p>Hence, find the maximum volume of the cone.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Surface area: <span class=\"inline-math\" data-math=\"30\\pi=\\pi rh\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"h=\\frac{30}r\" data-display=\"false\"></span>. Relationship between lengths: <span class=\"inline-math\" data-math=\"r^2+y^2=h^2\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"r^2+y^2=(\\tfrac{30}r)^2\\text{ so }y=\\sqrt{\\tfrac{900}{r^2}-r^2}=\\tfrac1r\\sqrt{900-r^4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nV =\\tfrac13\\pi r^2\\times\\tfrac1r\\sqrt{900-r^4}=\\tfrac13\\pi r\\sqrt{900-r^4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\tfrac13\\pi\\sqrt{900r^2-r^6}=\\tfrac13\\pi(900r^2-r^6)^{1/2}\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dV}{dr}=\\tfrac16\\pi(1800r-6r^5)(900r^2-r^6)^{-1/2}\" data-display=\"true\"></span>","<p>Stat pt when <span class=\"inline-math\" data-math=\"\\frac{dV}{dr}=0\" data-display=\"false\"></span>.</p>","<span class=\"equation\" data-math=\"\\tfrac16\\pi(1800r-6r^5)(900r^2-r^6)^{-1/2}=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\frac{\\pi r(1800-6r^4)}{6\\sqrt{900r^2-r^6}}=0\\Rightarrow1800-6r^4=0\\Rightarrow1800=6r^4\\Rightarrow r^4=300\\Rightarrow r=\\sqrt[4]{300}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"V=\\tfrac13\\pi(900(\\sqrt[4]{300})^2-(\\sqrt[4]{300})^6)^{1/2}=106.75409835\\ldots\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"v=107\\ \\mathrm{cm^3}\" data-display=\"false\"></span> (3 SF)</p>"]}]