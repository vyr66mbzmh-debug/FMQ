[{"id":"fm-core2-2.26-q1","number":1,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\arsinh x)=\\frac1{\\sqrt{x^2+1}}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arsinh x\" data-display=\"false\"></span>. Then <span class=\"inline-math\" data-math=\"\\sinh y=x\" data-display=\"false\"></span>, so</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\sinh y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\cosh y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac1{\\cosh y}=\\frac1{\\sqrt{\\sinh^2y+1}}=\\frac1{\\sqrt{x^2+1}},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q2","number":2,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\arcosh x)=\\frac1{\\sqrt{x^2-1}}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arcosh x\" data-display=\"false\"></span>. Then <span class=\"inline-math\" data-math=\"\\cosh y=x\" data-display=\"false\"></span>, so</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\cosh y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\sinh y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac1{\\sinh y}=\\frac1{\\sqrt{\\cosh^2y-1}}=\\frac1{\\sqrt{x^2-1}},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q3","number":3,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\artanh x)=\\frac1{1-x^2}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\artanh x\" data-display=\"false\"></span>. Then <span class=\"inline-math\" data-math=\"\\tanh y=x\" data-display=\"false\"></span>, so</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\tanh y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\sech^2y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac1{\\sech^2y}=\\frac1{1-\\tanh^2y}=\\frac1{1-x^2},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q4","number":4,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh3x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcosh2x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh5x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh\\frac12x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcosh\\frac{x}{4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh\\left(-\\frac{x}{6}\\right)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny=\\arsinh3x\\quad\\Rightarrow\\quad\\frac{dy}{dx}=3\\times\\frac1{\\sqrt{(3x)^2+1}}=\\frac3{\\sqrt{9x^2+1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny=\\arcosh2x\\quad\\Rightarrow\\quad\\frac{dy}{dx}=2\\times\\frac1{\\sqrt{(2x)^2-1}}=\\frac2{\\sqrt{4x^2-1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\ny=\\artanh5x\\quad\\Rightarrow\\quad\\frac{dy}{dx}=5\\times\\frac1{1-(5x)^2}=\\frac5{1-25x^2}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\ny =\\arsinh\\frac{x}{2},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac12\\times\\frac1{\\sqrt{(x/2)^2+1}}=\\frac1{2\\sqrt{1+x^2/4}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{2\\sqrt{(x^2+4)/4}}=\\frac1{\\sqrt{x^2+4}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\ny =\\arcosh\\frac{x}{4},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac14\\times\\frac1{\\sqrt{(x/4)^2-1}}=\\frac1{4\\sqrt{x^2/16-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{4\\sqrt{(x^2-16)/16}}=\\frac1{\\sqrt{x^2-16}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\ny =\\artanh\\left(-\\frac{x}{6}\\right),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-\\frac16\\times\\frac1{1-(-x/6)^2}=-\\frac1{6(1-x^2/36)}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac6{36-x^2}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q5","number":5,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=2\\arsinh2x-2\\arcosh4x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac13\\artanh3x-\\frac23\\artanh6x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =2\\arsinh2x-2\\arcosh4x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =2\\times2\\times\\frac1{\\sqrt{(2x)^2+1}}-2\\times4\\times\\frac1{\\sqrt{(4x)^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac4{\\sqrt{4x^2+1}}-\\frac8{\\sqrt{16x^2-1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\frac13\\artanh3x-\\frac23\\artanh6x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac13\\times3\\times\\frac1{1-(3x)^2}-\\frac23\\times6\\times\\frac1{1-(6x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{1-9x^2}-\\frac4{1-36x^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{(1-36x^2)-4(1-9x^2)}{(1-9x^2)(1-36x^2)}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac3{(1-9x^2)(1-36x^2)}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q6","number":6,"question":"<p>Find the equation of the tangent to the curve <span class=\"inline-math\" data-math=\"y=4\\arsinh x\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>, writing your answer in the form <span class=\"inline-math\" data-math=\"y=ax+b\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are constants in exact form.</p>","steps":["<span class=\"equation\" data-math=\"\ny =4\\arsinh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny\\big|_{x=2} =4\\ln(2+\\sqrt{2^2+1})=4\\ln(2+\\sqrt5),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac4{\\sqrt{x^2+1}},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\left.\\frac{dy}{dx}\\right|_{x=2} =\\frac4{\\sqrt5}=\\frac{4\\sqrt5}{5}.\n\" data-display=\"true\"></span>","<p>So the tangent is</p>","<span class=\"equation\" data-math=\"\ny-4\\ln(2+\\sqrt5)=\\frac{4\\sqrt5}{5}(x-2),\n\" data-display=\"true\"></span>","<p>and hence <span class=\"inline-math\" data-math=\"y=\\frac{4\\sqrt5}{5}x+4\\ln(2+\\sqrt5)-\\frac{8\\sqrt5}{5}\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q7","number":7,"question":"<p>Find the equation of the tangent to the curve <span class=\"inline-math\" data-math=\"y=-6\\arcosh\\frac{x}{2}\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=4\" data-display=\"false\"></span>, writing your answer in the form <span class=\"inline-math\" data-math=\"y=ax+b\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are constants in exact form.</p>","steps":["<span class=\"equation\" data-math=\"\ny =-6\\arcosh\\frac{x}{2},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny\\big|_{x=4} =-6\\ln\\left(2+\\sqrt{2^2-1}\\right)=-6\\ln(2+\\sqrt3),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-6\\times\\frac12\\times\\frac1{\\sqrt{(x/2)^2-1}}=-\\frac6{\\sqrt{x^2-4}},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\left.\\frac{dy}{dx}\\right|_{x=4} =-\\frac6{\\sqrt{12}}=-\\sqrt3.\n\" data-display=\"true\"></span>","<p>So the tangent is <span class=\"inline-math\" data-math=\"y+6\\ln(2+\\sqrt3)=-\\sqrt3(x-4)\" data-display=\"false\"></span>, and hence <span class=\"inline-math\" data-math=\"y=-\\sqrt3x+4\\sqrt3-6\\ln(2+\\sqrt3)\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q8","number":8,"question":"<p>Find the equation of the tangent to the curve <span class=\"inline-math\" data-math=\"y=10\\artanh\\frac{x}{5}\" data-display=\"false\"></span> when <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span>, writing your answer in the form <span class=\"inline-math\" data-math=\"y=ax+b\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are constants in exact form.</p>","steps":["<span class=\"equation\" data-math=\"\ny =10\\artanh\\frac{x}{5},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny\\big|_{x=3} =10\\times\\frac12\\ln\\left(\\frac{1+3/5}{1-3/5}\\right)=5\\ln4,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =10\\times\\frac15\\times\\frac1{1-(x/5)^2}=\\frac{50}{25-x^2},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\left.\\frac{dy}{dx}\\right|_{x=3} =\\frac{50}{16}=\\frac{25}{8}.\n\" data-display=\"true\"></span>","<p>So the tangent is <span class=\"inline-math\" data-math=\"y-5\\ln4=\\frac{25}{8}(x-3)\" data-display=\"false\"></span>, and hence <span class=\"inline-math\" data-math=\"y=\\frac{25}{8}x+5\\ln4-\\frac{75}{8}\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q9","number":9,"question":"<p>Determine whether the curve with equation</p><span class=\"equation\" data-math=\"\ny=\\arsinh4x-\\arcosh2x\n\" data-display=\"true\"></span><p>is convex (concave upwards) or concave (concave downwards) when <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\ny =\\arsinh4x-\\arcosh2x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac4{\\sqrt{16x^2+1}}-\\frac2{\\sqrt{4x^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =4(16x^2+1)^{-1/2}-2(4x^2-1)^{-1/2},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{d^2y}{dx^2} =-64x(16x^2+1)^{-3/2}+8x(4x^2-1)^{-3/2}.\n\" data-display=\"true\"></span>","<p>At <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>,</p>","<span class=\"equation\" data-math=\"\n\\left.\\frac{d^2y}{dx^2}\\right|_{x=2} =-128(65)^{-3/2}+16(15)^{-3/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{128\\sqrt{65}}{4225}+\\frac{16\\sqrt{15}}{225}=0.0311\\ldots&gt;0.\n\" data-display=\"true\"></span>","<p>As <span class=\"inline-math\" data-math=\"\\left.\\frac{d^2y}{dx^2}\\right|_{x=2}&gt;0\" data-display=\"false\"></span>, the curve is convex (concave upwards) at <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q10","number":10,"question":"<p>It is given that the curve with equation</p><span class=\"equation\" data-math=\"\ny=\\sqrt{x^2+1}+\\arsinh x\n\" data-display=\"true\"></span><p>has a single stationary point. Find the exact coordinates of the stationary point.</p>","steps":["<span class=\"equation\" data-math=\"\ny =\\sqrt{x^2+1}+\\arsinh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{x}{\\sqrt{x^2+1}}+\\frac1{\\sqrt{x^2+1}}=\\frac{x+1}{\\sqrt{x^2+1}}.\n\" data-display=\"true\"></span>","<p>Stationary points exist when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"x+1=0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x=-1\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\ny\\big|_{x=-1}=\\sqrt2+\\ln(-1+\\sqrt2).\n\" data-display=\"true\"></span>","<p>So the stationary point is <span class=\"inline-math\" data-math=\"\\left(-1,\\sqrt2+\\ln(-1+\\sqrt2)\\right)\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q11","number":11,"question":"<p>The graph of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span>, where</p><span class=\"equation\" data-math=\"\nf(x)=12\\arcosh x-3x,\\qquad x\\geq1,\n\" data-display=\"true\"></span><p>is shown below. Find the exact range of <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span>, giving your answer in set notation.</p><figure class=\"diagram\"><img src=\"assets/2.26/questions/assets/diagrams/226-q11.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\ny =12\\arcosh x-3x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{12}{\\sqrt{x^2-1}}-3.\n\" data-display=\"true\"></span>","<p>A stationary point exists when</p>","<span class=\"equation\" data-math=\"\n\\frac{12}{\\sqrt{x^2-1}}-3 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{12}{\\sqrt{x^2-1}} =3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n4 =\\sqrt{x^2-1}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx =\\sqrt{17},\n\" data-display=\"true\"></span>","<p>since <span class=\"inline-math\" data-math=\"\\arcosh x\" data-display=\"false\"></span> is defined only for <span class=\"inline-math\" data-math=\"x\\geq1\" data-display=\"false\"></span>. At this point</p>","<span class=\"equation\" data-math=\"\ny =12\\arcosh(\\sqrt{17})-3\\sqrt{17}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =12\\ln(4+\\sqrt{17})-3\\sqrt{17}.\n\" data-display=\"true\"></span>","<p>So the range is <span class=\"inline-math\" data-math=\"\\{f(x):f(x)\\in\\mathbb R,\\ f(x)\\leq12\\ln(4+\\sqrt{17})-3\\sqrt{17}\\}\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q12","number":12,"question":"<p>The graph of <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span> is shown below, where</p><span class=\"equation\" data-math=\"\nf(x)=2\\sqrt{x^2-9}-12\\arcosh\\frac{x}{3}.\n\" data-display=\"true\"></span><p>The point <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span> lies on the curve and on the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis.</p><ol class=\"parts\" start=\"1\"><li><p>State the coordinates of the point <span class=\"inline-math\" data-math=\"A\" data-display=\"false\"></span>.</p></li><li><p>Find the range of <span class=\"inline-math\" data-math=\"f\" data-display=\"false\"></span> in set notation.</p></li></ol><figure class=\"diagram\"><img src=\"assets/2.26/questions/assets/diagrams/226-q12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"A(3,0)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =2\\sqrt{x^2-9}-12\\arcosh\\frac{x}{3},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{2x}{\\sqrt{x^2-9}}-\\frac4{\\sqrt{(x/3)^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{2x}{\\sqrt{x^2-9}}-\\frac{12}{\\sqrt{x^2-9}}=\\frac{2x-12}{\\sqrt{x^2-9}}.\n\" data-display=\"true\"></span>","<p>Stationary points exist when <span class=\"inline-math\" data-math=\"2x-12=0\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"x=6\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\ny\\big|_{x=6} =2\\sqrt{6^2-9}-12\\arcosh2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =6\\sqrt3-12\\ln(2+\\sqrt3).\n\" data-display=\"true\"></span>","<p>So the stationary point is <span class=\"inline-math\" data-math=\"\\left(6,6\\sqrt3-12\\ln(2+\\sqrt3)\\right)\" data-display=\"false\"></span> and the range is <span class=\"inline-math\" data-math=\"\\{f(x):f(x)\\in\\mathbb R,\\ f(x)\\geq6\\sqrt3-12\\ln(2+\\sqrt3)\\}\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q13","number":13,"question":"<p>It is given that the curve with equation</p><span class=\"equation\" data-math=\"\ny=4\\artanh x+\\ln(x+1)-6x\n\" data-display=\"true\"></span><p>has two stationary points. It is also given that the curve has a single point of inflection.</p><ol class=\"parts\" start=\"1\"><li><p>Find the exact coordinates of both stationary points.</p></li><li><p>Find the exact <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-coordinate of the point of inflection. Fully justify your answer.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =4\\artanh x+\\ln(x+1)-6x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac4{1-x^2}+\\frac1{x+1}-6\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{4+1-x-6(1-x^2)}{1-x^2}=\\frac{6x^2-x-1}{1-x^2}.\n\" data-display=\"true\"></span>","<p>Stationary points exist when <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n6x^2-x-1 =0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n(3x+1)(2x-1) =0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx =-\\frac13\\quad\\text{or}\\quad x=\\frac12.\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny\\big|_{x=-1/3} =4\\artanh\\left(-\\frac13\\right)+\\ln\\frac23+2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2\\ln\\frac12+\\ln\\frac23+2=2-\\ln6,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\ny\\big|_{x=1/2} =4\\artanh\\frac12+\\ln\\frac32-3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2\\ln3+\\ln\\frac32-3=\\ln\\frac{27}{2}-3.\n\" data-display=\"true\"></span>","<p>So the stationary points are <span class=\"inline-math\" data-math=\"\\left(-\\frac13,2-\\ln6\\right)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"\\left(\\frac12,\\ln\\frac{27}{2}-3\\right)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\frac{d^2y}{dx^2} =\\frac{(1-x^2)(12x-1)-(6x^2-x-1)(-2x)}{(1-x^2)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{-x^2+10x-1}{(1-x^2)^2}.\n\" data-display=\"true\"></span>","<p>Points of inflection exist when <span class=\"inline-math\" data-math=\"\\frac{d^2y}{dx^2}=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n-x^2+10x-1 =0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2-10x+1 =0,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx =5\\pm2\\sqrt6.\n\" data-display=\"true\"></span>","<p><span class=\"inline-math\" data-math=\"5+2\\sqrt6=9.89\" data-display=\"false\"></span> (3 SF) and <span class=\"inline-math\" data-math=\"5-2\\sqrt6=0.101\" data-display=\"false\"></span> (3 SF). The domain of <span class=\"inline-math\" data-math=\"\\artanh x\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"\\{x:x\\in\\mathbb R,-1&lt;x&lt;1\\}\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"x\\ne5+2\\sqrt6\" data-display=\"false\"></span>. Checking either side of <span class=\"inline-math\" data-math=\"x=5-2\\sqrt6\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n\\left.\\frac{d^2y}{dx^2}\\right|_{x=0.1}=-0.0102\\ldots&lt;0,\\qquad \\left.\\frac{d^2y}{dx^2}\\right|_{x=0.2}=1.04\\ldots&gt;0.\n\" data-display=\"true\"></span>","<p>Therefore there is a point of inflection for the curve at <span class=\"inline-math\" data-math=\"x=5-2\\sqrt6\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q14","number":14,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh(\\sqrt{x})\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcosh\\left(\\frac1{\\sqrt{x}}\\right)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh(\\sqrt[3]{x})\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =\\arsinh(\\sqrt{x})=\\arsinh(x^{1/2}),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac12x^{-1/2}\\times\\frac1{\\sqrt{(x^{1/2})^2+1}}=\\frac1{2\\sqrt{x}\\sqrt{x+1}}=\\frac1{2\\sqrt{x(x+1)}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\arcosh\\left(\\frac1{\\sqrt{x}}\\right)=\\arcosh(x^{-1/2}),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-\\frac12x^{-3/2}\\times\\frac1{\\sqrt{(x^{-1/2})^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{2x^{3/2}\\sqrt{x^{-1}-1}}=-\\frac1{2\\sqrt{x^2(1-x)}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\ny =\\artanh(\\sqrt[3]{x})=\\artanh(x^{1/3}),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac13x^{-2/3}\\times\\frac1{1-(x^{1/3})^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{3x^{2/3}(1-x^{2/3})}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q15","number":15,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p>Show that <span class=\"inline-math\" data-math=\"\\displaystyle\\frac{d}{dx}\\left(\\arsinh\\frac1x\\right)=-\\frac1{x\\sqrt{x^2+1}}\" data-display=\"false\"></span>.</p></li><li><p>A curve has equation <span class=\"inline-math\" data-math=\"y=\\sqrt{x^2+1}-\\arsinh\\frac1x\" data-display=\"false\"></span>. Show that the curve has no stationary points.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac{d}{dx}\\left(\\arsinh\\frac1x\\right) =\\frac{d}{dx}(\\arsinh x^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-x^{-2}\\times\\frac1{\\sqrt{(x^{-1})^2+1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{x^2}\\times\\frac1{\\sqrt{x^{-2}+1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{x^2}\\times\\frac{x}{\\sqrt{x^2+1}}=-\\frac1{x\\sqrt{x^2+1}},\n\" data-display=\"true\"></span>","<p>as required, since <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\sqrt{x^2+1}-\\arsinh\\frac1x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{x}{\\sqrt{x^2+1}}+\\frac1{x\\sqrt{x^2+1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{x^2+1}{x\\sqrt{x^2+1}}.\n\" data-display=\"true\"></span>","<p>For all <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x^2+1&gt;1\" data-display=\"false\"></span>, so there are no real values of <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span> for which <span class=\"inline-math\" data-math=\"\\frac{x^2+1}{x\\sqrt{x^2+1}}=0\" data-display=\"false\"></span>. Hence the curve has no stationary points.</p>"]},{"id":"fm-core2-2.26-q16","number":16,"question":"<ol class=\"parts\" start=\"1\"><li><p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}\\left(\\artanh\\frac{2x}{\\sqrt{4x^2+1}}\\right)=\\frac2{\\sqrt{4x^2+1}}.\n\" data-display=\"true\"></span></li><li><p>A curve has equation</p><span class=\"equation\" data-math=\"\ny=\\sqrt{4x^2+1}-\\artanh\\frac{2x}{\\sqrt{4x^2+1}}.\n\" data-display=\"true\"></span><p>Show that the curve has a single stationary point and find its exact coordinates.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\n\\frac{d}{dx}\\left(\\artanh\\frac{2x}{\\sqrt{4x^2+1}}\\right)\n =\\frac{\\sqrt{4x^2+1}\\times2-2x\\times8x\\times\\frac12(4x^2+1)^{-1/2}}{4x^2+1}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad\\times\\frac1{1-\\left(\\frac{2x}{\\sqrt{4x^2+1}}\\right)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{2}{(4x^2+1)^{3/2}}\\times(4x^2+1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac2{\\sqrt{4x^2+1}},\n\" data-display=\"true\"></span>","<p>as required.</p>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\sqrt{4x^2+1}-\\artanh\\frac{2x}{\\sqrt{4x^2+1}},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{4x}{\\sqrt{4x^2+1}}-\\frac2{\\sqrt{4x^2+1}}=\\frac{4x-2}{\\sqrt{4x^2+1}}.\n\" data-display=\"true\"></span>","<p>Stationary points exist when <span class=\"inline-math\" data-math=\"4x-2=0\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\ny\\big|_{x=1/2} =\\sqrt2-\\artanh\\left(\\frac{\\sqrt2}{2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\sqrt2-\\frac12\\ln\\left(\\frac{1+\\sqrt2/2}{1-\\sqrt2/2}\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\sqrt2-\\frac12\\ln(3+2\\sqrt2).\n\" data-display=\"true\"></span>","<p>So there is a single stationary point at <span class=\"inline-math\" data-math=\"\\left(\\frac12,\\sqrt2-\\frac12\\ln(3+2\\sqrt2)\\right)\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q17","number":17,"question":"<p>It is given that</p><span class=\"equation\" data-math=\"\nf(x)=\\arcosh2x+\\arcosh\\frac2x.\n\" data-display=\"true\"></span><p>For <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span>, find the exact coordinates of the stationary point of the curve <span class=\"inline-math\" data-math=\"y=f(x)\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\nf(x) =\\arcosh2x+\\arcosh\\frac2x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nf'(x) =\\frac2{\\sqrt{4x^2-1}}-\\frac2{x\\sqrt{4-x^2}}.\n\" data-display=\"true\"></span>","<p>Stationary points exist when <span class=\"inline-math\" data-math=\"f'(x)=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\n\\frac1{\\sqrt{4x^2-1}} =\\frac1{x\\sqrt{4-x^2}},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx\\sqrt{4-x^2} =\\sqrt{4x^2-1},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^2(4-x^2) =4x^2-1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\nx^4 =1.\n\" data-display=\"true\"></span>","<p>As <span class=\"inline-math\" data-math=\"x&gt;0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"x=1\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\nf(1) =\\arcosh2+\\arcosh2=2\\arcosh2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =2\\ln(2+\\sqrt3)=\\ln(7+4\\sqrt3).\n\" data-display=\"true\"></span>","<p>So there is a stationary point at <span class=\"inline-math\" data-math=\"(1,\\ln(7+4\\sqrt3))\" data-display=\"false\"></span>.</p>"]},{"id":"fm-core2-2.26-q18","number":18,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh(\\cosh x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcosh(\\tanh x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh(\\sinh x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh(\\tanh x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arcosh(\\sinh x)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh(\\cosh x)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =\\arsinh(\\cosh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\sinh x\\times\\frac1{\\sqrt{\\cosh^2x+1}}=\\frac{\\sinh x}{\\sqrt{\\cosh^2x+1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\arcosh(\\tanh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\sech^2x\\times\\frac1{\\sqrt{\\tanh^2x-1}}=\\frac{\\sech^2x}{\\sqrt{\\tanh^2x-1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\ny =\\artanh(\\sinh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\cosh x\\times\\frac1{1-\\sinh^2x}=\\frac{\\cosh x}{1-\\sinh^2x}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\ny =\\arsinh(\\tanh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\sech^2x\\times\\frac1{\\sqrt{\\tanh^2x+1}}=\\frac{\\sech^2x}{\\sqrt{\\tanh^2x+1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\ny =\\arcosh(\\sinh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\cosh x\\times\\frac1{\\sqrt{\\sinh^2x-1}}=\\frac{\\cosh x}{\\sqrt{\\sinh^2x-1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">f)</h3><span class=\"equation\" data-math=\"\ny =\\artanh(\\cosh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\sinh x\\times\\frac1{1-\\cosh^2x}=\\frac{\\sinh x}{1-\\cosh^2x}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q19","number":19,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=x^2\\arsinh x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\sinh x\\arsinh x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\cosh x\\arcosh x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\arsinh x\\arcosh x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\artanh2x\\artanh4x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =x^2\\arsinh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =x^2\\times\\frac1{\\sqrt{x^2+1}}+2x\\arsinh x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{x^2}{\\sqrt{x^2+1}}+2x\\arsinh x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\sinh x\\arsinh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\sinh x\\times\\frac1{\\sqrt{x^2+1}}+\\cosh x\\arsinh x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\sinh x}{\\sqrt{x^2+1}}+\\cosh x\\arsinh x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\ny =\\cosh x\\arcosh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\cosh x\\times\\frac1{\\sqrt{x^2-1}}+\\sinh x\\arcosh x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\cosh x}{\\sqrt{x^2-1}}+\\sinh x\\arcosh x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\ny =\\arsinh x\\arcosh x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\arsinh x\\times\\frac1{\\sqrt{x^2-1}}+\\frac1{\\sqrt{x^2+1}}\\arcosh x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\arsinh x}{\\sqrt{x^2-1}}+\\frac{\\arcosh x}{\\sqrt{x^2+1}}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">e)</h3><span class=\"equation\" data-math=\"\ny =\\artanh2x\\artanh4x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\artanh2x\\times\\frac4{1-16x^2}+\\frac2{1-4x^2}\\artanh4x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{4\\artanh2x}{1-16x^2}+\\frac{2\\artanh4x}{1-4x^2}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q20","number":20,"question":"<p>Differentiate each of the following:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\displaystyle\\frac{x}{\\arsinh x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\displaystyle\\frac{\\arsinh x}{\\arcosh x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\displaystyle\\frac{\\arcosh3x}{\\arsinh6x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\displaystyle\\frac{\\arsinh4x}{\\artanh8x}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =\\frac{x}{\\arsinh x},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{\\arsinh x\\times1-x\\times\\frac1{\\sqrt{x^2+1}}}{(\\arsinh x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\arsinh x-\\frac{x}{\\sqrt{x^2+1}}}{(\\arsinh x)^2}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\ny =\\frac{\\arsinh x}{\\arcosh x},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{\\arcosh x\\times\\frac1{\\sqrt{x^2+1}}-\\arsinh x\\times\\frac1{\\sqrt{x^2-1}}}{(\\arcosh x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\frac{\\arcosh x}{\\sqrt{x^2+1}}-\\frac{\\arsinh x}{\\sqrt{x^2-1}}}{(\\arcosh x)^2}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\ny =\\frac{\\arcosh3x}{\\arsinh6x},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{\\arsinh6x\\times\\frac3{\\sqrt{9x^2-1}}-\\arcosh3x\\times\\frac6{\\sqrt{36x^2+1}}}{(\\arsinh6x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\frac{3\\arsinh6x}{\\sqrt{9x^2-1}}-\\frac{6\\arcosh3x}{\\sqrt{36x^2+1}}}{(\\arsinh6x)^2}.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\ny =\\frac{\\arsinh4x}{\\artanh8x},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{\\artanh8x\\times\\frac4{\\sqrt{16x^2+1}}-\\arsinh4x\\times\\frac8{1-64x^2}}{(\\artanh8x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac{\\frac{4\\artanh8x}{\\sqrt{16x^2+1}}-\\frac{8\\arsinh4x}{1-64x^2}}{(\\artanh8x)^2}.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q21","number":21,"question":"<p>It is given that</p><span class=\"equation\" data-math=\"\ny=\\sinh(2\\arcosh x),\\qquad x\\geq1.\n\" data-display=\"true\"></span><p>Show that</p><span class=\"equation\" data-math=\"\n(x^2-1)\\frac{d^2y}{dx^2}+x\\frac{dy}{dx}=4y.\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\ny =\\sinh(2\\arcosh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac2{\\sqrt{x^2-1}}\\cosh(2\\arcosh x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{d^2y}{dx^2} =\\frac{4\\sqrt{x^2-1}\\sinh(2\\arcosh x)-2x\\cosh(2\\arcosh x)}{(x^2-1)^{3/2}}.\n\" data-display=\"true\"></span>","<p>Now</p>","<span class=\"equation\" data-math=\"\n(x^2-1)\\frac{d^2y}{dx^2}+x\\frac{dy}{dx}\n =\\frac{4\\sqrt{x^2-1}\\sinh(2\\arcosh x)-2x\\cosh(2\\arcosh x)}{\\sqrt{x^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad+\\frac{2x\\cosh(2\\arcosh x)}{\\sqrt{x^2-1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =4\\sinh(2\\arcosh x)=4y.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q22","number":22,"question":"<p>It is given that</p><span class=\"equation\" data-math=\"\ny=(\\arsinh4x)^2,\\qquad x&gt;0.\n\" data-display=\"true\"></span><p>Show that</p><span class=\"equation\" data-math=\"\n(16x^2+1)\\frac{d^2y}{dx^2}+16x\\frac{dy}{dx}=32.\n\" data-display=\"true\"></span>","steps":["<span class=\"equation\" data-math=\"\ny =(\\arsinh4x)^2,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =\\frac{8\\arsinh4x}{\\sqrt{16x^2+1}},\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{d^2y}{dx^2} =\\frac{32\\sqrt{16x^2+1}-128x\\arsinh4x}{(16x^2+1)^{3/2}}.\n\" data-display=\"true\"></span>","<p>Therefore</p>","<span class=\"equation\" data-math=\"\n(16x^2+1)\\frac{d^2y}{dx^2}+16x\\frac{dy}{dx}\n =\\frac{32\\sqrt{16x^2+1}-128x\\arsinh4x}{\\sqrt{16x^2+1}}+\\frac{128x\\arsinh4x}{\\sqrt{16x^2+1}}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =32.\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q23","number":23,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\arcosech x)=-\\frac1{x\\sqrt{x^2+1}}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arcosech x\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"\\cosech y=x\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\cosech y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n-\\coth y\\cosech y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-\\frac1{\\coth y\\cosech y}=-\\frac1{\\sqrt{\\cosech^2y+1}\\,\\cosech y}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{x\\sqrt{x^2+1}},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q24","number":24,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\arcsech x)=-\\frac1{x\\sqrt{1-x^2}}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arcsech x\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"\\sech y=x\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\sech y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n-\\tanh y\\sech y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-\\frac1{\\tanh y\\sech y}=-\\frac1{\\sqrt{1-\\sech^2y}\\,\\sech y}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac1{x\\sqrt{1-x^2}},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q25","number":25,"question":"<p>Show that</p><span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\arcoth x)=\\frac1{1-x^2}.\n\" data-display=\"true\"></span>","steps":["<p>Let <span class=\"inline-math\" data-math=\"y=\\arcoth x\" data-display=\"false\"></span>, so <span class=\"inline-math\" data-math=\"\\coth y=x\" data-display=\"false\"></span>. Then</p>","<span class=\"equation\" data-math=\"\n\\frac{d}{dx}(\\coth y) =\\frac{d}{dx}(x),\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n-\\cosech^2y\\frac{dy}{dx} =1,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =-\\frac1{\\cosech^2y}=-\\frac1{\\coth^2y-1}=-\\frac1{x^2-1}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac1{1-x^2},\n\" data-display=\"true\"></span>","<p>as required.</p>"]},{"id":"fm-core2-2.26-q26","number":26,"question":"<p>A curve has equation</p><span class=\"equation\" data-math=\"\ny=x^2\\arcosech2x,\\qquad x&gt;0.\n\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><p>Differentiate <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> with respect to <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>.</p></li><li><p>Hence find the exact gradient of the curve when <span class=\"inline-math\" data-math=\"x=\\frac12\" data-display=\"false\"></span>.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\ny =x^2\\arcosech2x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =x^2\\times2\\times\\left(-\\frac1{(2x)\\sqrt{(2x)^2+1}}\\right)+2x\\arcosech2x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{2x^2}{2x\\sqrt{4x^2+1}}+2x\\arcosech2x\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{x}{\\sqrt{4x^2+1}}+2x\\arcosech2x.\n\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\n\\left.\\frac{dy}{dx}\\right|_{x=1/2} =-\\frac{1/2}{\\sqrt{4(1/2)^2+1}}+2\\left(\\frac12\\right)\\arcosech\\left(2\\times\\frac12\\right)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{\\sqrt2}{4}+\\arcosech1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac{\\sqrt2}{4}+\\ln(1+\\sqrt2).\n\" data-display=\"true\"></span>"]},{"id":"fm-core2-2.26-q27","number":27,"question":"<p>A curve has equation</p><span class=\"equation\" data-math=\"\ny=\\arcsech x^2+\\arcoth3x,\n\" data-display=\"true\"></span><p>where <span class=\"inline-math\" data-math=\"-1\\leq x&lt; -\\frac13\" data-display=\"false\"></span>. Find the exact gradient of the curve when <span class=\"inline-math\" data-math=\"x=-\\frac12\" data-display=\"false\"></span>.</p>","steps":["<span class=\"equation\" data-math=\"\ny =\\arcsech x^2+\\arcoth3x,\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\frac{dy}{dx} =2x\\times\\left(-\\frac1{x^2\\sqrt{1-(x^2)^2}}\\right)+\\frac3{1-(3x)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-\\frac2{x\\sqrt{1-x^4}}+\\frac3{1-9x^2}.\n\" data-display=\"true\"></span>","<p>At <span class=\"inline-math\" data-math=\"x=-\\frac12\" data-display=\"false\"></span>,</p>","<span class=\"equation\" data-math=\"\n\\left.\\frac{dy}{dx}\\right|_{x=-1/2} =-\\frac2{(-1/2)\\sqrt{1-(-1/2)^4}}+\\frac3{1-9(-1/2)^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\frac4{\\sqrt{15/16}}-\\frac{12}{5}=\\frac{16\\sqrt{15}}{15}-\\frac{12}{5}.\n\" data-display=\"true\"></span>"]}]