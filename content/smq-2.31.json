[{"id":"smq-year2-2.31-q1","number":1,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=x^3\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q1.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"x^2=x^3\\Rightarrow x^3-x^2=0\\Rightarrow x^2(x-1)=0\\Rightarrow x=0\\text{ or }x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^1x^2\\,dx-\\int_0^1x^3\\,dx =\\int_0^1(x^2-x^3)\\,dx=[\\tfrac13x^3-\\tfrac14x^4]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac13\\times1^3-\\tfrac14\\times1^4)-(\\tfrac13\\times0^3-\\tfrac14\\times0^4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac1{12})-(0)=\\tfrac1{12}\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q2","number":2,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=4-x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=x^2+2\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q2.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"4-x^2=x^2+2\\Rightarrow2x^2=2\\Rightarrow x^2=1\\Rightarrow x=\\pm1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^1(4-x^2)\\,dx-\\int_{-1}^1(x^2+2)\\,dx =\\int_{-1}^1(2-2x^2)\\,dx=[2x-\\tfrac23x^3]_{-1}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2\\times1-\\tfrac23\\times1^3)-(2\\times(-1)-\\tfrac23\\times(-1)^3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac43)-(-\\tfrac43)=\\tfrac83\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q3","number":3,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=5-x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=(x-1)^2\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q3.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n5-x^2=(x-1)^2 \\Rightarrow5-x^2=x^2-2x+1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow2x^2-2x-4=0\\Rightarrow x^2-x-2=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n (x-2)(x+1)=0\\Rightarrow x=-1\\text{ or }x=2\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^2(5-x^2)\\,dx-\\int_{-1}^2(x-1)^2\\,dx =\\int_{-1}^2(5-x^2-(x-1)^2)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^2(5-x^2-(x^2-2x+1))\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^2(-2x^2+2x+4)\\,dx=[-\\tfrac23x^3+x^2+4x]_{-1}^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac23\\times2^3+2^2+4\\times2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(-\\tfrac23\\times(-1)^3+(-1)^2+4\\times(-1))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{20}3)-(-\\tfrac73)=9\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q4","number":4,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=(x-1)^2+2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=6-(x+1)^2\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q4.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n(x-1)^2+2 =6-(x+1)^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(x^2-2x+1)+2 =6-(x^2+2x+1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow x^2-2x+3 =5-x^2-2x\\Rightarrow2x^2=2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow x^2 =1\\Rightarrow x=\\pm1\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^1(6-(x+1)^2)\\,dx -\\int_{-1}^1((x-1)^2+2)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^1(4-(x+1)^2-(x-1)^2)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^1(4-(x^2+2x+1)-(x^2-2x+1))\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^1(2-2x^2)\\,dx=[2x-\\tfrac23x^3]_{-1}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2\\times1-\\tfrac23\\times1^3)-(2\\times(-1)-\\tfrac23\\times(-1)^3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac43)-(-\\tfrac43)=\\tfrac83\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q5","number":5,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=x^3+1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=3-x^3\" data-display=\"false\"></span>. Find the exact shaded area between the two curves and the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q5.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"x^3+1=3-x^3\\Rightarrow2x^3=2\\Rightarrow x^3=1\\Rightarrow x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^1(3-x^3)\\,dx-\\int_0^1(x^3+1)\\,dx =\\int_0^1(2-2x^3)\\,dx=[2x-\\tfrac12x^4]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2\\times1-\\tfrac12\\times1^4)-(2\\times0-\\tfrac12\\times0^4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac32)-(0)=\\tfrac32\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q6","number":6,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\sqrt x\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q6.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"x^2=\\sqrt x\\Rightarrow x^4=x\\Rightarrow x^4-x=0\\Rightarrow x(x^3-1)=0\\Rightarrow x=0\\text{ or }x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^1\\sqrt x\\,dx-\\int_0^1x^2\\,dx =\\int_0^1(x^{1/2}-x^2)\\,dx=[\\tfrac23x^{3/2}-\\tfrac13x^3]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac23\\times1^{3/2}-\\tfrac13\\times1^3)-(\\tfrac23\\times0^{3/2}-\\tfrac13\\times0^3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac13)-(0)=\\tfrac13\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q7","number":7,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=1-x^2\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac43(1-x^2)\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q7.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"1-x^2=\\tfrac43(1-x^2)\\Rightarrow3-3x^2=4-4x^2\\Rightarrow x^2=1\\Rightarrow x=\\pm1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^1\\tfrac43(1-x^2)\\,dx-\\int_{-1}^1(1-x^2)\\,dx =\\int_{-1}^1\\tfrac13(1-x^2)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^1(\\tfrac13-\\tfrac13x^2)\\,dx=[\\tfrac13x-\\tfrac19x^3]_{-1}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac13\\times1-\\tfrac19\\times1^3)-(\\tfrac13\\times(-1)-\\tfrac19\\times(-1)^3)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac29)-(-\\tfrac29)=\\tfrac49\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q8","number":8,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=\\frac1{x^2}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac1{x^3}\" data-display=\"false\"></span>, and the line <span class=\"inline-math\" data-math=\"x=2\" data-display=\"false\"></span>. Find the exact shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q8.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\\frac1{x^2}=\\frac1{x^3}\\Rightarrow x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_1^2\\frac1{x^2}\\,dx-\\int_1^2\\frac1{x^3}\\,dx =\\int_1^2(x^{-2}-x^{-3})\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac{x^{-1}}{-1}-\\tfrac{x^{-2}}{-2}]_1^2=[-\\tfrac1x+\\tfrac1{2x^2}]_1^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac12+\\tfrac1{2\\times2^2})-(-\\tfrac11+\\tfrac1{2\\times1^2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac38)-(-\\tfrac12)=\\tfrac18\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q9","number":9,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=x(x-1)(x+1)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=2x(x-1)(x+1)\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q9.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"x(x-1)(x+1)=2x(x-1)(x+1)\\Rightarrow x=-1\\text{ or }x=0\\text{ or }x=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^02x(x-1)(x+1)\\,dx -\\int_{-1}^0x(x-1)(x+1)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^0x(x-1)(x+1)\\,dx=\\int_{-1}^0x(x^2-1)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^0(x^3-x)\\,dx=[\\tfrac14x^4-\\tfrac12x^2]_{-1}^0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac14\\times0^4-\\tfrac12\\times0^2)-(\\tfrac14\\times(-1)^4-\\tfrac12\\times(-1)^2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(0)-(-\\tfrac14)=\\tfrac14\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_0^12x(x-1)(x+1)\\,dx -\\int_0^1x(x-1)(x+1)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^1x(x-1)(x+1)\\,dx=\\int_0^1x(x^2-1)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_0^1(x^3-x)\\,dx=[\\tfrac14x^4-\\tfrac12x^2]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac14\\times1^4-\\tfrac12\\times1^2)-(\\tfrac14\\times0^4-\\tfrac12\\times0^2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac14)-(0)=-\\tfrac14\n\" data-display=\"true\"></span>","<p>Therefore Area <span class=\"inline-math\" data-math=\"=\\frac14-(-\\frac14)=\\frac12\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.31-q10","number":10,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=(x+1)(x-2)(x-3)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=3(x+1)(x-2)(x-4)\" data-display=\"false\"></span>. Find the exact shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q10.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n(x+1)(x-2)(x-3) =3(x+1)(x-2)(x-4)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(x+1)(x-2)(x-3) -3(x+1)(x-2)(x-4)=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(x+1)(x-2)((x-3) -3(x-4))=0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(x+1)(x-2)(9-2x) =0\\Rightarrow x=-1\\text{ or }x=2\\text{ or }x=\\tfrac92\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-1}^23(x+1)(x-2)(x-4)\\,dx -\\int_{-1}^2(x+1)(x-2)(x-3)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^2(3x^3-15x^2+6x+24)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-\\int_{-1}^2(x^3-4x^2+x+6)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-1}^2(2x^3-11x^2+5x+18)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[\\tfrac12x^4-\\tfrac{11}3x^3+\\tfrac52x^2+18x]_{-1}^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac12\\times2^4-\\tfrac{11}3\\times2^3+\\tfrac52\\times2^2+18\\times2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(\\tfrac12\\times(-1)^4-\\tfrac{11}3\\times(-1)^3+\\tfrac52\\times(-1)^2+18\\times(-1))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{74}3)-(-\\tfrac{34}3)=36\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_2^{9/2}(x+1)(x-2)(x-3)\\,dx -\\int_2^{9/2}3(x+1)(x-2)(x-4)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_2^{9/2}(x^3-4x^2+x+6)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-\\int_2^{9/2}(3x^3-15x^2+6x+24)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_2^{9/2}(-2x^3+11x^2-5x-18)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[-\\tfrac12x^4+\\tfrac{11}3x^3-\\tfrac52x^2-18x]_2^{9/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac12\\times(\\tfrac92)^4+\\tfrac{11}3\\times(\\tfrac92)^3-\\tfrac52\\times(\\tfrac92)^2-18\\times\\tfrac92)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(-\\tfrac12\\times2^4+\\tfrac{11}3\\times2^3-\\tfrac52\\times2^2-18\\times2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(-\\tfrac{81}{32})-(-\\tfrac{74}3)=\\tfrac{2125}{96}\n\" data-display=\"true\"></span>","<p>Therefore Area <span class=\"inline-math\" data-math=\"=36+\\frac{2125}{96}=\\frac{5581}{96}\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.31-q11","number":11,"question":"<p>It is given that <span class=\"inline-math\" data-math=\"\\mathrm f(x)=8x^3+6x^2-36x\" data-display=\"false\"></span>. The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=\\mathrm f(x)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=81-\\mathrm f(x)\" data-display=\"false\"></span>. The curves intersect at precisely two points. Find the exact shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q11.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n8x^3+6x^2-36x =81-(8x^3+6x^2-36x)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow2(8x^3+6x^2-36x) =81\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow16x^3+12x^2-72x-81 =0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(4x-9)(2x+3)^2 =0\\Rightarrow x=\\tfrac94\\text{ or }x=-\\tfrac32\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_{-3/2}^{9/4}(81-(8x^3+6x^2-36x))\\,dx -\\int_{-3/2}^{9/4}(8x^3+6x^2-36x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\int_{-3/2}^{9/4}(81-16x^3-12x^2+72x)\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[81x-4x^4-4x^3+36x^2]_{-3/2}^{9/4}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(81\\times\\tfrac94-4\\times(\\tfrac94)^4-4\\times(\\tfrac94)^3+36\\times(\\tfrac94)^2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\quad-(81\\times(-\\tfrac32)-4\\times(-\\tfrac32)^4-4\\times(-\\tfrac32)^3+36\\times(-\\tfrac32)^2)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(\\tfrac{13851}{64})-(-\\tfrac{189}4)=\\tfrac{16875}{64}=263.671875\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.31-q12","number":12,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=\\frac1{x^2}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac2{x^2}\" data-display=\"false\"></span>, and the lines <span class=\"inline-math\" data-math=\"y=1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=2\" data-display=\"false\"></span>. Find the exact shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.31/questions/assets/diagrams/231-q12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\n2=\\frac1{x^2} \\Rightarrow x^2=\\tfrac12\\Rightarrow x=\\pm\\tfrac{\\sqrt2}2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n2=\\frac2{x^2} \\Rightarrow x^2=1\\Rightarrow x=\\pm1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n1=\\frac1{x^2} \\Rightarrow x^2=1\\Rightarrow x=\\pm1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n1=\\frac2{x^2} \\Rightarrow x^2=2\\Rightarrow x=\\pm\\sqrt2\n\" data-display=\"true\"></span>","<figure class=\"diagram\"><img src=\"assets/smq-2.31/solutions/assets/diagrams/231-s12.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<span class=\"equation\" data-math=\"\n(1-\\tfrac{\\sqrt2}2)\\times2-\\int_{\\sqrt2/2}^1\\frac1{x^2}\\,dx =(2-\\sqrt2)-\\int_{\\sqrt2/2}^1x^{-2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2-\\sqrt2)-[-\\tfrac1x]_{\\sqrt2/2}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2-\\sqrt2)-\\bigl((-\\tfrac11)-(-\\tfrac1{\\sqrt2/2})\\bigr)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2-\\sqrt2)-(-1+\\sqrt2)=3-2\\sqrt2\n\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\int_1^{\\sqrt2}\\frac2{x^2}\\,dx-(\\sqrt2-1)\\times1 =\\int_1^{\\sqrt2}2x^{-2}\\,dx-(\\sqrt2-1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =[-\\tfrac2x]_1^{\\sqrt2}-(\\sqrt2-1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =\\bigl((-\\tfrac2{\\sqrt2})-(-\\tfrac21)\\bigr)-(\\sqrt2-1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2-\\sqrt2)-(\\sqrt2-1)=3-2\\sqrt2\n\" data-display=\"true\"></span>","<p>Therefore Area <span class=\"inline-math\" data-math=\"=(3-2\\sqrt2)+(3-2\\sqrt2)=6-4\\sqrt2\" data-display=\"false\"></span></p>"]}]