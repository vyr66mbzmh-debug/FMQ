[{"id":"smq-year1-1.04-q1","number":1,"question":"<p>Find the equation of each of the linear graphs below:</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-4\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q2","number":2,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"ax+by=c\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q2c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q2d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{6-0}{0-(-2)}=3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-6=3(x-0)\\Rightarrow y-6=3x\\Rightarrow-3x+y=6\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{1-(-1)}{-5-0}=-\\frac25\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y+1=-\\frac25(x-0)\\Rightarrow5y+5=-2x\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow2x+5y=-5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{\\frac32-(-\\frac52)}{2-0}=2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y+\\frac52=2(x-0)\\Rightarrow y+\\frac52=2x\\Rightarrow2y+5=4x\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow-4x+2y=-5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{4-5}{3-0}=-\\frac13\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-5=-\\frac13(x-0)\\Rightarrow3y-15=-x\\Rightarrow x+3y=15\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q3","number":3,"question":"<p>Sketch the following linear graphs, identifying where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=2x-7\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=6-10x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\frac12x+5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=2-\\frac13x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s3c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s3d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.04-q4","number":4,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"ax+by=c\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q4c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q4d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{-\\frac34-\\frac94}{\\frac12-(-1)}=-2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac94=-2(x+1)\\Rightarrow y-\\frac94=-2x-2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow4y-9=-8x-8\\Rightarrow8x+4y=1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{\\frac{16}5-(-\\frac95)}{\\frac45-(-\\frac65)}=\\frac52\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac{16}5=\\frac52(x-\\frac45)\\Rightarrow y-\\frac{16}5=\\frac52x-2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow2y-\\frac{32}5=5x-4\\Rightarrow10y-32=25x-20\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow-25x+10y=12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{\\frac{27}8-\\frac{37}{40}}{1-\\frac3{10}}=\\frac72\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac{27}8=\\frac72(x-1)\\Rightarrow y-\\frac{27}8=\\frac72x-\\frac72\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow8y-27=28x-28\\Rightarrow-28x+8y=-1\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{-\\frac{47}{20}+\\frac{67}{40}}{3-\\frac3{10}}=-\\frac14\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y+\\frac{67}{40}=-\\frac14(x-\\frac3{10})\\Rightarrow y+\\frac{67}{40}=-\\frac14x+\\frac3{40}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow40y+67=-10x+3\\Rightarrow10x+40y=-64\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow5x+20y=-32\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q5","number":5,"question":"<p>Sketch the following linear graphs, identifying where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"2x+5y=10\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"4x-9y=36\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-7x+2y=28\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"6x+11y=-2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s5c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s5d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.04-q6","number":6,"question":"<ol class=\"parts\" start=\"1\"><li><p>Sketch the graphs of <span class=\"inline-math\" data-math=\"y=2x+8\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"2y=10-x\" data-display=\"false\"></span> on the same axes, identifying where the graphs cross the coordinate axes.</p></li><li><p>Determine where the two lines intersect.</p></li><li><p>Find the area of the triangle formed by the two lines and the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis.</p></li><li><p>Find the area of the triangle formed by the two lines and the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s6a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"2(2x+8)=10-x\\Rightarrow4x+16=10-x\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow5x=-6\\Rightarrow x=-\\frac65\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\therefore y=2\\times-\\frac65+8=\\frac{28}5\" data-display=\"false\"></span>  So the lines intersect at <span class=\"inline-math\" data-math=\"(-\\frac65,\\frac{28}5)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s6c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Area <span class=\"inline-math\" data-math=\"=\\frac12\\times(10+4)\\times\\frac{28}5=\\frac{196}5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s6d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<p>Area <span class=\"inline-math\" data-math=\"=\\frac12\\times(8-5)\\times\\frac65=\\frac95\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q7","number":7,"question":"<p>Find the equation of each of the following graphs in the form <span class=\"inline-math\" data-math=\"x+ay=b\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are constants.</p><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q7a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q7b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q7c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q7d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{-\\frac65-\\frac83}{-\\frac{21}5+\\frac{61}9}=-\\frac32\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac83=-\\frac32(x+\\frac{61}9)\\Rightarrow-\\frac23y+\\frac{16}9=x+\\frac{61}9\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow x+\\frac23y=-5\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{\\frac92+\\frac23}{\\frac{67}{30}-\\frac65}=5\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac92=5(x-\\frac{67}{30})\\Rightarrow\\frac15y-\\frac9{10}=x-\\frac{67}{30}\\Rightarrow x-\\frac15y=\\frac43\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{-\\frac92-\\frac83}{\\frac{283}{80}+\\frac{41}{15}}=-\\frac87\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-\\frac83=-\\frac87(x+\\frac{41}{15})\\Rightarrow-\\frac78y+\\frac73=x+\\frac{41}{15}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow x+\\frac78y=-\\frac25\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{\\frac{27}{50}+\\frac65}{\\frac{193}{30}+\\frac{31}6}=\\frac3{20}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y+\\frac65=\\frac3{20}(x+\\frac{31}6)\\Rightarrow\\frac{20}3y+8=x+\\frac{31}6\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow x-\\frac{20}3y=\\frac{17}6\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q8","number":8,"question":"<p>Sketch the following linear graphs, identifying where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"2y=3x-7\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"5y+1=6x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3y-3=8x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"10y=4-7x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s8c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s8d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.04-q9","number":9,"question":"<p>The diagram below shows a linear function. Find the equation of the line in the form <span class=\"inline-math\" data-math=\"y=ax+b\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are given in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"k&gt;1\" data-display=\"false\"></span>.</p><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q9.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"m=\\frac{(3k-1)-(k+1)}{(2k)-(-k)}=\\frac{2k-2}{3k}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y-(k+1)=\\frac{2k-2}{3k}(x+k)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y-(k+1)=\\frac{2k-2}{3k}x+\\frac{2k-2}3\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=\\frac{2k-2}{3k}x+\\frac23k-\\frac23+k+1\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow y=\\frac{2k-2}{3k}x+\\frac53k+\\frac13\\Rightarrow y=\\frac{2k-2}{3k}x+\\frac{5k+1}3\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.04-q10","number":10,"question":"<p>Sketch the following linear graphs, identifying where they intersect the coordinate axes. It is given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=kx+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=8-2kx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"ky=3-x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2x+7y=k\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3x+ky=9\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"6kx-y=-3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac xk+\\frac y{2k}=4\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10e.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">f)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10f.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">g)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.04/solutions/assets/diagrams/s10g.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.04-q11","number":11,"question":"<p>The diagram below shows two lines, <span class=\"inline-math\" data-math=\"l_1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"l_2\" data-display=\"false\"></span>.</p><ol class=\"parts\" start=\"1\"><li><p>Find the equation of the line <span class=\"inline-math\" data-math=\"l_1\" data-display=\"false\"></span>.</p></li><li><p>Find the equation of the line <span class=\"inline-math\" data-math=\"l_2\" data-display=\"false\"></span>.</p></li><li><p>Determine the coordinates, in terms of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>, of where <span class=\"inline-math\" data-math=\"l_1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"l_2\" data-display=\"false\"></span> intersect.</p></li></ol><figure class=\"diagram\"><img src=\"assets/smq-1.04/questions/assets/diagrams/q11.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{(12k^2-5k)-(-3k^2-5k)}{4+1}=\\frac{15k^2}5=3k^2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"l_1:y-(12k^2-5k)=3k^2(x-4)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"m=\\frac{(\\frac3k+\\frac1{k^2})-(\\frac3k-\\frac5{k^2})}{-2-10}=\\frac{\\frac6{k^2}}{-12}=-\\frac1{2k^2}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"l_2:y-(\\frac3k+\\frac1{k^2})=-\\frac1{2k^2}(x+2)\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"l_1-l_2\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\begin{aligned}(y-(12k^2-5k))-(y-(\\frac3k+\\frac1{k^2}))&amp;=(3k^2(x-4))-(-\\frac1{2k^2}(x+2))\\\\\\Rightarrow-12k^2+5k+\\frac3k+\\frac1{k^2}&amp;=3k^2x-12k^2+\\frac1{2k^2}x+\\frac1{k^2}\\\\\\Rightarrow5k+\\frac3k&amp;=(3k^2+\\frac1{2k^2})x\\\\\\Rightarrow x&amp;=\\frac{5k+\\frac3k}{3k^2+\\frac1{2k^2}}=\\frac{10k^3+6k}{6k^4+1}\\end{aligned}\" data-display=\"true\"></span>","<p>Then:</p>","<span class=\"equation\" data-math=\"\\begin{aligned}y-(12k^2-5k)&amp;=3k^2(\\frac{10k^3+6k}{6k^4+1}-4)\\\\\\Rightarrow y&amp;=\\frac{30k^5+18k^3}{6k^4+1}-5k\\\\\\Rightarrow y&amp;=\\frac{30k^5+18k^3}{6k^4+1}-\\frac{5k(6k^4+1)}{6k^4+1}\\\\\\Rightarrow y&amp;=\\frac{30k^5+18k^3}{6k^4+1}-\\frac{30k^5+5k}{6k^4+1}\\\\\\Rightarrow y&amp;=\\frac{18k^3-5k}{6k^4+1}\\end{aligned}\" data-display=\"true\"></span>","<p>So <span class=\"inline-math\" data-math=\"l_1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"l_2\" data-display=\"false\"></span> intersect at <span class=\"inline-math\" data-math=\"(\\frac{10k^3+6k}{6k^4+1},\\frac{18k^3-5k}{6k^4+1})\" data-display=\"false\"></span>.</p>"]}]