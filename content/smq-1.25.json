[{"id":"smq-year1-1.25-q1","number":1,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=e^x+b\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q1c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=e^x\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=e^x+5\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=e^x-4\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q2","number":2,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=e^x-6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=e^x+e\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q3","number":3,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=e^{x-a}+b\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q3c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=e^{x-a}+3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e^{-1}+3):e^{-1}+3=e^{-a}+3\\Rightarrow a=1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{x-1}+3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=e^{x-a}-5\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e^2-5):e^2-5=e^{-a}-5\\Rightarrow a=-2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{x+2}-5\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=e^{x-a}-1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e^{-3}-1):e^{-3}-1=e^{-a}-1\\Rightarrow a=3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{x-3}-1\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q4","number":4,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=e^{x+1}-10\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=e^{x-e}-e\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q5","number":5,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=e^{a-x}+b\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q5c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=e^{a-x}+2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e+2):e+2=e^a+2\\Rightarrow a=1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{1-x}+2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=e^{a-x}-3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e^2-3):e^2-3=e^a-3\\Rightarrow a=2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{2-x}-3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=e^{a-x}-9\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,e^{-3}-9):e^{-3}-9=e^a-9\\Rightarrow a=-3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=e^{-3-x}-9\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q6","number":6,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=e^{5-x}-20\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=e^{-1-x}+20\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s6a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s6b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q7","number":7,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=b-e^{x-a}\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q7a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q7b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q7c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=1-e^{x-a}\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,0):0=1-e^{-a}\\Rightarrow e^{-a}=1\\Rightarrow a=0\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=1-e^x\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=-2-e^{x-a}\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,-2-e^{-1}):-2-e^{-1}=-2-e^{-a}\\Rightarrow a=1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=-2-e^{x-1}\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=4-e^{x-a}\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(0,4-e^2):4-e^2=4-e^{-a}\\Rightarrow a=-2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=4-e^{x+2}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q8","number":8,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=10-e^{x+4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=5-e^{4-x}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q9","number":9,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=\\ln(x-a)\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q9a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q9b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q9c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x-3)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x+5)\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x+1)\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q10","number":10,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\ln(x-2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(x+2)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q11","number":11,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=\\ln x+b\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q11a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q11b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q11c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln x+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^{-1},0):0=\\ln e^{-1}+b\\Rightarrow0=-1+b\\Rightarrow b=1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln x+1\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln x+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^2,0):0=\\ln e^2+b\\Rightarrow0=2+b\\Rightarrow b=-2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln x-2\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln x+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^{-\\frac12},0):0=\\ln e^{-\\frac12}+b\\Rightarrow0=-\\frac12+b\\Rightarrow b=\\frac12\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln x+\\frac12\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q12","number":12,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\ln x+3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln x-e\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s12a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s12b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q13","number":13,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=\\ln(x-a)+b\" data-display=\"true\"></span><ol class=\"parts\" start=\"1\"><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q13a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q13b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li><li><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q13c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x-1)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^{-1}+1,0):0=\\ln(e^{-1}+1-1)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow0=\\ln(e^{-1})+b\\Rightarrow0=-1+b\\Rightarrow b=1\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln(x-1)+1\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x+2)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^{-3}-2,0):0=\\ln(e^{-3}-2+2)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow0=\\ln(e^{-3})+b\\Rightarrow0=-3+b\\Rightarrow b=3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln(x+2)+3\" data-display=\"false\"></span>.</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"y=\\ln(x+1)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^2-1,0):0=\\ln(e^2-1+1)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow0=\\ln(e^2)+b\\Rightarrow0=2+b\\Rightarrow b=-2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln(x+1)-2\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q14","number":14,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\ln(x-3)-3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(x-e)+e\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s14a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s14b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q15","number":15,"question":"<p>Find the equation of the following graph in the form</p><span class=\"equation\" data-math=\"y=\\ln(a-x)+b\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q15.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"y=\\ln(5-x)+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(5-e^{-2},0):0=\\ln(5-(5-e^{-2}))+b\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow0=\\ln(e^{-2})+b\\Rightarrow0=-2+b\\Rightarrow b=2\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=\\ln(5-x)+2\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year1-1.25-q16","number":16,"question":"<p>Sketch the following graphs, identifying where they intersect the coordinate axes and the equations of any asymptotes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\ln(8-x)-1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(1-x)+3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(e-x)-e\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=\\ln(-e-x)+2e\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s16a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s16b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s16c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.25/solutions/assets/diagrams/s16d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.25-q17","number":17,"question":"<p>Find the equation of the following graph in the form</p><span class=\"equation\" data-math=\"y=b-\\ln(x-a)\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/smq-1.25/questions/assets/diagrams/q17.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<p><span class=\"inline-math\" data-math=\"y=b-\\ln(x-2)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"(e^3+2,0):0=b-\\ln(e^3+2-2)\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"\\Rightarrow0=b-\\ln(e^3)\\Rightarrow0=b-3\\Rightarrow b=3\" data-display=\"false\"></span><br> <span class=\"inline-math\" data-math=\"y=3-\\ln(x-2)\" data-display=\"false\"></span>.</p>"]},