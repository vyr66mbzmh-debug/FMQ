[{"id":"smq-year1-1.10-q1","number":1,"question":"<p>Calculate the discriminant:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"x^2-2x-6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^2-9\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-x^2+x+5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-0.5x^2+12\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2x^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"2x^2-3x+2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"-3x^2+3x-1\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^2-kx+2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"(-2)^2-4\\times1\\times-6=28\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"(0)^2-4\\times1\\times-9=36\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"(1)^2-4\\times-1\\times5=21\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"(0)^2-4\\times-0.5\\times12=24\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"(0)^2-4\\times2\\times0=0\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"(-3)^2-4\\times2\\times-2=-7\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"(3)^2-4\\times-3\\times-1=-3\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">h)</h3><p><span class=\"inline-math\" data-math=\"(-k)^2-4\\times1\\times2=k^2-8\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q2","number":2,"question":"<p>State the number of roots for each of the following functions:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"f(x)=x^2-4x+5\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=x^2+x-6\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=2x^2-2x-4\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=x^2-3x+8\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=x^2+8x+16\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=-2x^2+5x+3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"f(x)=-4x^2+12x-9\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"16-4\\times1\\times5=-4&lt;0\\therefore\" data-display=\"false\"></span> no roots</p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"1-4\\times1\\times-6=25&gt;0\\therefore\" data-display=\"false\"></span> 2 roots</p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"4-4\\times2\\times-4=36\\therefore\" data-display=\"false\"></span> 2 roots</p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"9-4\\times8=-23\\therefore\" data-display=\"false\"></span> 0 roots</p>","<h3 class=\"part-label\">e)</h3><p><span class=\"inline-math\" data-math=\"64-4\\times1\\times16=0\\therefore\" data-display=\"false\"></span> 1 repeated root</p>","<h3 class=\"part-label\">f)</h3><p><span class=\"inline-math\" data-math=\"25-4\\times-2\\times3=49\\therefore\" data-display=\"false\"></span> 2 roots</p>","<h3 class=\"part-label\">g)</h3><p><span class=\"inline-math\" data-math=\"144-4\\times-4\\times-9=0\\therefore\" data-display=\"false\"></span> 1 repeated root</p>"]},{"id":"smq-year1-1.10-q3","number":3,"question":"<p>Show that <span class=\"inline-math\" data-math=\"3x=3x^2+1\" data-display=\"false\"></span> has no real solutions.</p>","steps":["<p><span class=\"inline-math\" data-math=\"3x^2-3x+1=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-3)^2-4\\times3\\times1=9-12=-3\" data-display=\"false\"></span>  So it has no real solutions.</p>"]},{"id":"smq-year1-1.10-q4","number":4,"question":"<p>Find the values of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> for each of the following equations with equal roots:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"4x^2+kx+9=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"3x^2+kx+12=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^2-3x+2+\\frac1k=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"x^2+(2k+10)x+k^2+5=0\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"16x^2+4x+k^2=0\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(k)^2-4\\times4\\times9=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k^2=144\" data-display=\"false\"></span>  So <span class=\"inline-math\" data-math=\"k=-12\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(k)^2-4\\times3\\times12=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k^2=144\" data-display=\"false\"></span>  So <span class=\"inline-math\" data-math=\"k=-12\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=12\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-3)^2-4\\times1\\times(2+\\frac1k)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"9-8-\\frac4k=0\\Rightarrow1=\\frac4k\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=4\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(2k+10)^2-4\\times1\\times(k^2+5)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"4k^2+40k+100-4(k^2+5)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"40k+80=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=-2\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">e)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(4)^2-4\\times16\\times k^2=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k^2=\\frac14\" data-display=\"false\"></span>  So <span class=\"inline-math\" data-math=\"k=\\frac12\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=-\\frac12\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q5","number":5,"question":"<p>The equation <span class=\"inline-math\" data-math=\"x^2+3px+p=0\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> is a non-zero, has equal roots. Find the value of <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span>.</p>","steps":["<p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(3p)^2-4\\times1\\times p=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"9p^2-4p=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow p(9p-4)=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"p=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"p=\\frac49\" data-display=\"false\"></span>  But <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> is non-zero so <span class=\"inline-math\" data-math=\"p=\\frac49\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q6","number":6,"question":"<p>Show that the discriminant of <span class=\"inline-math\" data-math=\"(x-p)(x-q)\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"(p-q)^2\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"x^2-(p+q)x+pq\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-(p+q))^2-4\\times1\\times pq\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=(p+q)^2-4pq=p^2+2pq+q^2-4pq\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=p^2-2pq+q^2=(p-q)^2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q7","number":7,"question":"<p>Show that the discriminant of <span class=\"inline-math\" data-math=\"k(x-p)^2+q\" data-display=\"false\"></span> is <span class=\"inline-math\" data-math=\"-4kq\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"kx^2-2pkx+kp^2+q\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-2pk)^2-4\\times k\\times(kp^2+q)\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"=4p^2k^2-4k^2p^2-4kq=-4kq\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q8","number":8,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y=-\\frac12x^2+kx+k\" data-display=\"false\"></span> touches the line <span class=\"inline-math\" data-math=\"2y-2x=5\" data-display=\"false\"></span> at one point. Find the possible value(s) of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p>","steps":["<p><span class=\"inline-math\" data-math=\"y=\\frac52+x\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"-\\frac12x^2+kx+k=\\frac52+x\" data-display=\"false\"></span>  Giving <span class=\"inline-math\" data-math=\"-\\frac12x^2+(k-1)x+(k-\\frac52)=0\" data-display=\"false\"></span>  Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>:  <span class=\"inline-math\" data-math=\"(k-1)^2-4\\times(-\\frac12)(k-\\frac52)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"k^2-2k+1+2k-5=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"k^2-4=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=-2\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=2\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q9","number":9,"question":"<p>The line <span class=\"inline-math\" data-math=\"5y+x=k\" data-display=\"false\"></span> touches the curve <span class=\"inline-math\" data-math=\"2x^2+2y=1\" data-display=\"false\"></span> once.</p><ol class=\"parts\" start=\"1\"><li><p>Find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p></li><li><p>Hence find the values at which <span class=\"inline-math\" data-math=\"5y+x=k\" data-display=\"false\"></span> intersects the <span class=\"inline-math\" data-math=\"x\" data-display=\"false\"></span>-axis and the <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span>-axis.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=-\\frac15x+\\frac15k\" data-display=\"false\"></span> which gives  <span class=\"inline-math\" data-math=\"2x^2+2(-\\frac15x+\\frac15k)=1\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"10x^2-2x+(2k-5)=0\" data-display=\"false\"></span>  Touches once: <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  so <span class=\"inline-math\" data-math=\"(-2)^2-4\\times10(2k-5)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"4+80k+200=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=\\frac{51}{20}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p>So the line is <span class=\"inline-math\" data-math=\"5y+x=\\frac{51}{20}\" data-display=\"false\"></span>  When <span class=\"inline-math\" data-math=\"x=0,y=\\frac{51}{100}\" data-display=\"false\"></span> and when <span class=\"inline-math\" data-math=\"y=0,x=\\frac{51}{20}\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(0,\\frac{51}{100})\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(\\frac{51}{20},0)\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q10","number":10,"question":"<p>A function <span class=\"inline-math\" data-math=\"f(x)=ax^2+bx+c\" data-display=\"false\"></span> has constants <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> such that <span class=\"inline-math\" data-math=\"a&lt;0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b&gt;0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c&lt;0\" data-display=\"false\"></span>. The discriminant of <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span> is 0. Sketch the graph of <span class=\"inline-math\" data-math=\"f(x)\" data-display=\"false\"></span>. Label the intersections with the axes.</p>","steps":["<p><span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"a&lt;0\" data-display=\"false\"></span> so negative quadratic  When <span class=\"inline-math\" data-math=\"x=0,y=c\" data-display=\"false\"></span>  Root at <span class=\"inline-math\" data-math=\"x=\\frac{-b}{2a}\" data-display=\"false\"></span> since <span class=\"inline-math\" data-math=\"a&lt;0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b&gt;0\" data-display=\"false\"></span> the root is positive</p>","<figure class=\"diagram\"><img src=\"assets/smq-1.10/solutions/assets/diagrams/s10.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.10-q11","number":11,"question":"<p>Show that <span class=\"inline-math\" data-math=\"y=x^2+kx-x\" data-display=\"false\"></span> for <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, always has two real roots.</p>","steps":["<p>For two real roots: <span class=\"inline-math\" data-math=\"b^2-4ac\\geq0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"y=x^2+(k-1)x\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow b^2-4ac=(k-1)^2\" data-display=\"false\"></span> which is always <span class=\"inline-math\" data-math=\"\\geq0\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q12","number":12,"question":"<p>For the equations <span class=\"inline-math\" data-math=\"2x+y=1\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"x^2-4ky+5k=0\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is non-zero constant,</p><ol class=\"parts\" start=\"1\"><li><p>Show that <span class=\"inline-math\" data-math=\"x^2+8kx+k=0\" data-display=\"false\"></span>.</p></li><li><p>Given that <span class=\"inline-math\" data-math=\"x^2+8kx+k=0\" data-display=\"false\"></span> has equal roots, find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p></li><li><p>Hence for this value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> find the solution of the simultaneous equations.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"y=1-2x\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"x^2-4k(1-2x)+5k=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x^2-4k+8kx+5k=0\\Rightarrow x^2+8kx+k=0\" data-display=\"false\"></span> as req</p>","<h3 class=\"part-label\">b)</h3><p>Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(8k)^2-4\\times1\\times k=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"64k^2-4k=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow4k(16k-1)=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=0\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=\\frac1{16}\" data-display=\"false\"></span>  Since <span class=\"inline-math\" data-math=\"k\\ne0,k=\\frac1{16}\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"x^2-\\frac14(1-2x)+\\frac5{16}=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"16x^2-4(1-2x)+5=0\\Rightarrow16x^2-4+8x+5=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"16x^2+8x+1=0\\Rightarrow(4x+1)^2=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"x=-\\frac14\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=1-2\\times-\\frac14=\\frac32\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-\\frac14,\\frac32)\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q13","number":13,"question":"<p>Find the relationship between non-zero constants <span class=\"inline-math\" data-math=\"p\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"q\" data-display=\"false\"></span>, such that the equation <span class=\"inline-math\" data-math=\"y=px^2+(p+q)x+q\" data-display=\"false\"></span> has equal roots.</p>","steps":["<p>For equal roots: <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(p+q)^2-4pq=0\\Rightarrow p^2+2pq+q^2-4pq=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow p^2-2pq+q^2=0\\Rightarrow(p-q)^2=0\" data-display=\"false\"></span> so that <span class=\"inline-math\" data-math=\"p=q\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q14","number":14,"question":"<p>The curves <span class=\"inline-math\" data-math=\"f(x)=x^2-kx-4\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"g(x)=-x^2+x+4k\" data-display=\"false\"></span> intersect once.</p><ol class=\"parts\" start=\"1\"><li><p>Find the possible value(s) of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p></li><li><p>Hence find the coordinates of the point(s) of intersection of the two curves.</p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"x^2-kx-4=-x^2+x+4k\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"2x^2-(k+1)x-(4+4k)=0\" data-display=\"false\"></span>  Touch once: <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(-(k+1))^2-4\\times2\\times-(4+4k)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"k^2+2k+1+32+32k=0\\Rightarrow k^2+34k+33=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"(k+1)(k+33)=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"k=-1\" data-display=\"false\"></span> or <span class=\"inline-math\" data-math=\"k=-33\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p>When <span class=\"inline-math\" data-math=\"k=-1\" data-display=\"false\"></span>; <span class=\"inline-math\" data-math=\"2x^2=0\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=-4\" data-display=\"false\"></span>  When <span class=\"inline-math\" data-math=\"k=-33\" data-display=\"false\"></span>; <span class=\"inline-math\" data-math=\"2x^2+32x+128=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"2(x^2+16x+64)=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"2(x+8)^2=0\" data-display=\"false\"></span> gives <span class=\"inline-math\" data-math=\"x=-8\" data-display=\"false\"></span> and  <span class=\"inline-math\" data-math=\"y=(-8)^2-33\\times8-4=-204\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\therefore(0,-4)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(-8,-204)\" data-display=\"false\"></span></p>"]},{"id":"smq-year1-1.10-q15","number":15,"question":"<p>The equation <span class=\"inline-math\" data-math=\"x^4-6x^2+k=0\" data-display=\"false\"></span> has two pairs of equal roots. Find the value of <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span>.</p>","steps":["<p>Let <span class=\"inline-math\" data-math=\"p=x^2\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"p^2-6p+k=0\" data-display=\"false\"></span>  Equal roots is <span class=\"inline-math\" data-math=\"b^2-4ac=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"36-4\\times1\\times k=0\" data-display=\"false\"></span> so <span class=\"inline-math\" data-math=\"36-4k=0\" data-display=\"false\"></span>  <span class=\"inline-math\" data-math=\"\\Rightarrow k=9\" data-display=\"false\"></span></p>"]}]