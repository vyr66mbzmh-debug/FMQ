[{"id":"smq-year1-1.16-q1","number":1,"question":"<p>The following graphs are all functions that can be written in the form <span class=\"inline-math\" data-math=\"y=(x-p)^4+q\" data-display=\"false\"></span>. Find the equation of the curve in the form</p><span class=\"equation\" data-math=\"y=x^4+bx^3+cx^2+dx+e\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q1a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q1b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q1c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=(x-1)^4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=x^4-4x^3+6x^2-4x+1\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x+2)^4+2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=x^4+8x^3+24x^2+32x+18\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x-3)^4-81\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=x^4-12x^3+54x^2-108x\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q2","number":2,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-2)(x-1)(x+1)(x+2)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-3)(x+1)(x-1)(x+4)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s2a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s2b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q3","number":3,"question":"<p>The following graphs are all functions that can be written in the form <span class=\"inline-math\" data-math=\"y=q-(x-p)^4\" data-display=\"false\"></span>. Find the equation of the curve in the form</p><span class=\"equation\" data-math=\"y=-x^4+bx^3+cx^2+dx+e\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q3a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q3b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q3c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=1-(x+1)^4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=-x^4-4x^3-6x^2-4x\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=2-(x-1)^4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=-x^4+4x^3-6x^2+4x+1\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=-(x+3)^4-19\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow y=-x^4-12x^3-54x^2-108x-100\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q4","number":4,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x-3)(x+1)(x+2)(x+3)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-(x+4)(x+3)(x+2)(x+1)\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s4a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s4b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q5","number":5,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=(x-a)(x-b)(x-c)(x-d)\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q5a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q5b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q5c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=(x+1)(x-1)(x-2)(x-3)\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x+3)(x+2)(x-1)(x-2)\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x+1)(x-2)(x-3)(x-4)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q6","number":6,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-1)(x+3)(x-2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+1)^2(x+2)(x-3)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+1)^2(x-2)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s6a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s6b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s6c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q7","number":7,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=(x-a)(x-b)(x-c)^2\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q7a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q7b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q7c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=(x-1)(x-2)(x+1)^2\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=(x+3)(x+1)(x-2)^2\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=(x+3)(x-3)(x+1)^2\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q8","number":8,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=-(x-4)(x+1)(x+2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x-1)(3-x)(x+1)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-x^2(x-3)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s8a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s8b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s8c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q9","number":9,"question":"<p>Find the equation of each of the following graphs in the form</p><span class=\"equation\" data-math=\"y=k(x-a)(x-b)(x-c)(x-d)\" data-display=\"true\"></span><p><strong>a)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q9a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>b)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q9b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure><p><strong>c)</strong></p><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q9c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"y=2(x+2)(x+1)(x-2)(x-3)\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"y=-3(x-1)(x-2)(x-3)(x-4)\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"y=-\\tfrac14(x+4)(x+1)(x-3)(x-5)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q10","number":10,"question":"<p>Sketch the following graphs:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=\\tfrac12(x-4)(x+2)(x-2)(x-6)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\tfrac23(x+3)(x-3)(x-6)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s10a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s10b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q11","number":11,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(2x-1)(x+1)(2x+1)(3x-1)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+2)(2x-1)(3x-5)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=x(3x+4)(5x+2)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-x^2(4x-3)(3x-4)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(2x-1)^2(2x+3)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\tfrac16(6x-1)^2(12x+5)^2\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">e)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11e.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">f)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s11f.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q12","number":12,"question":"<p>Sketch the following graphs, showing where they intersect the coordinate axes:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=(x-2)(x+3)^3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(2x+3)(4x-3)^3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(3-2x)x^3\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=-\\tfrac14(3x+4)(3x-1)^3\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s12a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s12b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s12c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s12d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q13","number":13,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"y=x(x-k)(x-2k)(x-3k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(x+k)(x+3k)(x-2k)(x+2k)\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(k-x)(2k+x)(3k-x)^2\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"y=(4k-x)(2k+x)^3\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s13a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">b)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s13b.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">c)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s13c.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<h3 class=\"part-label\">d)</h3><figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s13d.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>"]},{"id":"smq-year1-1.16-q14","number":14,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k\" data-display=\"false\"></span> is a positive constant, find the equation of the following graph in the form</p><span class=\"equation\" data-math=\"y=a(bx+c)(dx+e)(fx+g)(hx+i)\" data-display=\"true\"></span><figure class=\"diagram\"><img src=\"assets/smq-1.16/questions/assets/q14a.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"0=\\left(x+\\frac{k}{2}\\right)\\left(x-\\frac{k}{3}\\right)\\left(x-\\frac2k\\right)(x-4k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\Rightarrow0=(2x+k)(3x-k)(kx-2)(x-4k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=a(2x+k)(3x-k)(kx-2)(x-4k)\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"-8k=a(k)(-k)(-2)(-4k)\" data-display=\"false\"></span></p>","<span class=\"equation\" data-math=\"\\Rightarrow-8k=-8k^3a\\Rightarrow a=\\frac1{k^2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\therefore y=\\frac1{k^2}(2x+k)(3x-k)(kx-2)(x-4k)\" data-display=\"true\"></span>"]},{"id":"smq-year1-1.16-q15","number":15,"question":"<p>Given that <span class=\"inline-math\" data-math=\"k&gt;0\" data-display=\"false\"></span>, sketch the graphs of</p><span class=\"equation\" data-math=\"y=(x-3k)(x+3k)(x-k)^2\" data-display=\"true\"></span><p>and</p><span class=\"equation\" data-math=\"y=(3k-x)(3k+x)(k-x)\" data-display=\"true\"></span><p>on the same axes, showing clearly where the two graphs cross the coordinate axes and where they intersect.</p>","steps":["<figure class=\"diagram\"><img src=\"assets/smq-1.16/solutions/assets/s15.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","<span class=\"equation\" data-math=\"\n(x-3k)(x+3k)(x-k)^2=(3k-x)(3k+x)(k-x)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow(x-3k)(x+3k)(x-k)^2=(x-3k)(x+3k)(x-k)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n\\Rightarrow x-k=1\\Rightarrow x=k+1\n\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=k+1\" data-display=\"false\"></span>,</p>","<span class=\"equation\" data-math=\"\ny =(3k-(k+1))(3k+(k+1))(k-(k+1))\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =(2k-1)(4k+1)(-1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n =-(8k^2-2k-1)\n\" data-display=\"true\"></span>","<p>So the curves intersect at <span class=\"inline-math\" data-math=\"(-3k,0)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(k,0)\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"(3k,0)\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"(k+1,-8k^2+2k+1)\" data-display=\"false\"></span>.</p>"]}]