[{"id":"smq-year2-2.33-q1","number":1,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int(x+1)^3\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(x-4)^6\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int6(2+x)^7\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(10(x-1)^4-4(x-3)^5)\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\int(x+1)^3\\,dx=\\frac14(x+1)^4+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\int(x-4)^6\\,dx=\\frac17(x-4)^7+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\int6(2+x)^7\\,dx=6\\times\\frac18(2+x)^8+c=\\frac34(2+x)^8+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int(10(x-1)^4-4(x-3)^5)\\,dx=10\\times\\tfrac15(x-1)^5-4\\times\\tfrac16(x-3)^6+c=2(x-1)^5-\\tfrac23(x-3)^6+c\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q2","number":2,"question":"<p>Find the equation of the curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> given the gradient function is:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(x-3)^{3/4}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(9+x)^{-3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sqrt{x+7}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac4{\\sqrt{5+x}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(x-3)^{3/4}\\Rightarrow y=\\frac47(x-3)^{7/4}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(9+x)^{-3}\\Rightarrow y=-\\frac12(9+x)^{-2}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sqrt{x+7}\\Rightarrow\\frac{dy}{dx}=(x+7)^{1/2}\\Rightarrow y=\\frac23(x+7)^{3/2}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac4{\\sqrt{5+x}}\\Rightarrow\\frac{dy}{dx}=4(5+x)^{-1/2}\\Rightarrow y=4\\times2(5+x)^{1/2}+c\\Rightarrow y=8(5+x)^{1/2}+c\" data-display=\"false\"></span></p>"]},{"id":"smq-year2-2.33-q3","number":3,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac6{(x-2)^5}\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(3,\\frac52)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a+\\frac b{c(x-2)^4}\" data-display=\"false\"></span> where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are integers.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac6{(x-2)^5}\\Rightarrow\\frac{dy}{dx}=6(x-2)^{-5}\\Rightarrow y=6\\times-\\tfrac14(x-2)^{-4}+c=-\\tfrac32(x-2)^{-4}+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=3\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=\\frac52\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"\\tfrac52=-\\tfrac32(3-2)^{-4}+c\\Rightarrow\\tfrac52=-\\tfrac32+c\\Rightarrow c=4\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=-\\frac32(x-2)^{-4}+4\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q4","number":4,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sqrt[3]{4+x}\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(4,3)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a(4+x)^b+c\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are rational numbers, and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> is an integer.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\sqrt[3]{4+x}\\Rightarrow\\frac{dy}{dx}=(4+x)^{1/3}\\Rightarrow y=\\tfrac34(4+x)^{4/3}+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=4\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=3\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"3=\\tfrac34(4+4)^{4/3}+c\\Rightarrow3=12+c\\Rightarrow c=-9\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=\\frac34(4+x)^{4/3}-9\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q5","number":5,"question":"<p>Evaluate the following definite integrals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int_2^3(x-2)^8\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{-6}^{-3}24(6+x)^5\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{-1}^1\\sqrt{x+3}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{-3}^4\\frac{44}{\\sqrt[3]{4+x}}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\int_2^3(x-2)^8\\,dx =[\\tfrac19(x-2)^9]_2^3=(\\tfrac19(3-2)^9)-(\\tfrac19(2-2)^9)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac19\\times1)-(\\tfrac19\\times0)=\\tfrac19\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\int_{-6}^{-3}24(6+x)^5\\,dx =[24\\times\\tfrac16(6+x)^6]_{-6}^{-3}=[4(6+x)^6]_{-6}^{-3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(4(6-3)^6)-(4(6-6)^6)=(4\\times729)-(4\\times0)=2916\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\int_{-1}^1\\sqrt{x+3}\\,dx =\\int_{-1}^1(x+3)^{1/2}\\,dx=[\\tfrac23(x+3)^{3/2}]_{-1}^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac23(1+3)^{3/2})-(\\tfrac23(-1+3)^{3/2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac23\\times8)-(\\tfrac23\\times2\\sqrt2)=\\tfrac{16}3-\\tfrac{4\\sqrt2}3\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int_{-3}^4\\frac{44}{\\sqrt[3]{4+x}}\\,dx =\\int_{-3}^444(4+x)^{-1/3}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[44\\times\\tfrac32(4+x)^{2/3}]_{-3}^4=[66(4+x)^{2/3}]_{-3}^4\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(66(4+4)^{2/3})-(66(4-3)^{2/3})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(66\\times4)-(66\\times1)=(264)-(66)=198\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q6","number":6,"question":"<p>Find the exact value of:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=-5}^{26}(6+x)^{3/5}\\delta x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=19}^{84}\\frac4{\\sqrt[4]{x-3}}\\delta x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=-5}^{26}(6+x)^{3/5}\\delta x =\\int_{-5}^{26}(6+x)^{3/5}\\,dx=[\\tfrac58(6+x)^{8/5}]_{-5}^{26}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac58(6+26)^{8/5})-(\\tfrac58(6-5)^{8/5})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac58\\times256)-(\\tfrac58\\times1)=(160)-(\\tfrac58)=\\tfrac{1275}8\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=19}^{84}\\frac4{\\sqrt[4]{x-3}}\\delta x =\\int_{19}^{84}4(x-3)^{-1/4}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[4\\times\\tfrac43(x-3)^{3/4}]_{19}^{84}=[\\tfrac{16}3(x-3)^{3/4}]_{19}^{84}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac{16}3(84-3)^{3/4})-(\\tfrac{16}3(19-3)^{3/4})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac{16}3\\times27)-(\\tfrac{16}3\\times8)=(144)-(\\tfrac{128}3)=\\tfrac{304}3\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q7","number":7,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int(2x+1)^4\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(2-3x)^5\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int4(5+6x)^9\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int(3(2x-3)^3-4(4-5x)^4)\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\int(2x+1)^4\\,dx=\\frac12\\times\\frac15(2x+1)^5+c=\\frac1{10}(2x+1)^5+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\int(2-3x)^5\\,dx=-\\frac13\\times\\frac16(2-3x)^6+c=-\\frac1{18}(2-3x)^6+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\int4(5+6x)^9\\,dx=4\\times\\frac16\\times\\frac1{10}(5+6x)^{10}+c=\\frac1{15}(5+6x)^{10}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int(3(2x-3)^3-4(4-5x)^4)\\,dx =3\\times\\tfrac12\\times\\tfrac14(2x-3)^4-4\\times-\\tfrac15\\times\\tfrac15(4-5x)^5+c\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\tfrac38(2x-3)^4+\\tfrac4{25}(4-5x)^5+c\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q8","number":8,"question":"<p>Find the equation of the curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> given the gradient function is:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(5x+9)^{7/3}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(6-x)^{-5}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sqrt{10+3x}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{20}{\\sqrt[3]{1-x}}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(5x+9)^{7/3}\\Rightarrow y=\\frac15\\times\\frac3{10}(5x+9)^{10/3}+c\\Rightarrow y=\\frac3{50}(5x+9)^{10/3}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=(6-x)^{-5}\\Rightarrow y=-1\\times-\\frac14(6-x)^{-4}+c\\Rightarrow y=\\frac14(6-x)^{-4}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\sqrt{10+3x}\\Rightarrow\\frac{dy}{dx}=(10+3x)^{1/2}\\Rightarrow y=\\frac13\\times\\frac23(10+3x)^{3/2}+c\\Rightarrow y=\\frac29(10+3x)^{3/2}+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac{20}{\\sqrt[3]{1-x}}\\Rightarrow\\frac{dy}{dx}=20(1-x)^{-1/3}\\Rightarrow y=20\\times-1\\times\\tfrac32(1-x)^{2/3}+c\\Rightarrow y=-30(1-x)^{2/3}+c\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q9","number":9,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac6{(3x-2)^2}\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(0,2)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=\\frac{ax+b}{cx+d}\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"d\" data-display=\"false\"></span> are integers.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac6{(3x-2)^2}\\Rightarrow\\frac{dy}{dx}=6(3x-2)^{-2}\\Rightarrow y=6\\times\\tfrac13\\times-1\\times(3x-2)^{-1}+c=-2(3x-2)^{-1}+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=2\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"2=-2(3\\times0-2)^{-1}+c\\Rightarrow2=1+c\\Rightarrow c=1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=-2(3x-2)^{-1}+1=-\\frac2{3x-2}+1=\\frac{3x-2}{3x-2}-\\frac2{3x-2}\\Rightarrow y=\\frac{3x-4}{3x-2}\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q10","number":10,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{14}{(4x+1)^{9/2}}\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(0,2)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a+\\frac b{(4x+1)^c}\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are integers and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> is a rational number.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac{14}{(4x+1)^{9/2}}\\Rightarrow\\frac{dy}{dx}=14(4x+1)^{-9/2}\\Rightarrow y=14\\times\\tfrac14\\times-\\tfrac27(4x+1)^{-7/2}+c=-(4x+1)^{-7/2}+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=2\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"2=-(4\\times0+1)^{-7/2}+c\\Rightarrow2=-1+c\\Rightarrow c=3\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=-(4x+1)^{-7/2}+3\\Rightarrow y=3-\\frac1{(4x+1)^{7/2}}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q11","number":11,"question":"<p>Evaluate the following definite integrals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int_2^3(2x-5)^5\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{-1/4}^{1/8}\\sqrt{3+8x}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_1^2\\frac{15}{(5-6x)^2}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{5/16}^{3/2}\\frac8{\\sqrt[3]{3+16x}}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\int_2^3(2x-5)^5\\,dx =[\\tfrac12\\times\\tfrac16(2x-5)^6]_2^3=[\\tfrac1{12}(2x-5)^6]_2^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}(2\\times3-5)^6)-(\\tfrac1{12}(2\\times2-5)^6)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}\\times1)-(\\tfrac1{12}\\times1)=0\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\int_{-1/4}^{1/8}\\sqrt{3+8x}\\,dx =\\int_{-1/4}^{1/8}(3+8x)^{1/2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[\\tfrac18\\times\\tfrac23(3+8x)^{3/2}]_{-1/4}^{1/8}=[\\tfrac1{12}(3+8x)^{3/2}]_{-1/4}^{1/8}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}(3+8\\times\\tfrac18)^{3/2})-(\\tfrac1{12}(3+8\\times(-\\tfrac14))^{3/2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}\\times8)-(\\tfrac1{12}\\times1)=(\\tfrac23)-(\\tfrac1{12})=\\tfrac7{12}\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\int_1^2\\frac{15}{(5-6x)^2}\\,dx =\\int_1^215(5-6x)^{-2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[15\\times-\\tfrac16\\times-1\\times(5-6x)^{-1}]_1^2=[\\tfrac52(5-6x)^{-1}]_1^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac52(5-6\\times2)^{-1})-(\\tfrac52(5-6\\times1)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac52\\times-\\tfrac17)-(\\tfrac52\\times-1)=(-\\tfrac5{14})-(-\\tfrac52)=\\tfrac{15}7\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int_{5/16}^{3/2}\\frac8{\\sqrt[3]{3+16x}}\\,dx =\\int_{5/16}^{3/2}8(3+16x)^{-1/3}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[8\\times\\tfrac1{16}\\times\\tfrac32(3+16x)^{2/3}]_{5/16}^{3/2}=[\\tfrac34(3+16x)^{2/3}]_{5/16}^{3/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac34(3+16\\times\\tfrac32)^{2/3})-(\\tfrac34(3+16\\times\\tfrac5{16})^{2/3})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac34\\times9)-(\\tfrac34\\times4)=(\\tfrac{27}4)-(3)=\\tfrac{15}4\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q12","number":12,"question":"<p>Find the exact value of:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=-1/3}^{10}\\frac25(2+3x)^{3/5}\\delta x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=1/9}^{1/3}\\frac{243}{(4-9x)^4}\\delta x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=-1/3}^{10}\\tfrac25(2+3x)^{3/5}\\delta x =\\int_{-1/3}^{10}\\tfrac25(2+3x)^{3/5}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[\\tfrac25\\times\\tfrac13\\times\\tfrac58(2+3x)^{8/5}]_{-1/3}^{10}=[\\tfrac1{12}(2+3x)^{8/5}]_{-1/3}^{10}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}(2+3\\times10)^{8/5})-(\\tfrac1{12}(2+3\\times(-\\tfrac13))^{8/5})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{12}\\times256)-(\\tfrac1{12}\\times1)=(\\tfrac{64}3)-(\\tfrac1{12})=\\tfrac{85}4\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=1/9}^{1/3}\\frac{243}{(4-9x)^4}\\delta x =\\int_{1/9}^{1/3}243(4-9x)^{-4}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[243\\times-\\tfrac19\\times-\\tfrac13(4-9x)^{-3}]_{1/9}^{1/3}=[9(4-9x)^{-3}]_{1/9}^{1/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(9(4-9\\times\\tfrac13)^{-3})-(9(4-9\\times\\tfrac19)^{-3})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(9\\times1)-(9\\times\\tfrac1{27})=(9)-(\\tfrac13)=\\tfrac{26}3\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q13","number":13,"question":"<p>Find</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int2x(x^2+3)^5\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int12x^2(4x^3-5)^3\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int x(2x^2-5)^4\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int2x^3\\sqrt{x^4-3}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><p><span class=\"inline-math\" data-math=\"\\int2x(x^2+3)^5\\,dx=2x\\times\\frac1{2x}\\times\\frac16(x^2+3)^6+c=\\frac16(x^2+3)^6+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">b)</h3><p><span class=\"inline-math\" data-math=\"\\int12x^2(4x^3-5)^3\\,dx=12x^2\\times\\frac1{12x^2}\\times\\frac14(4x^3-5)^4+c=\\frac14(4x^3-5)^4+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">c)</h3><p><span class=\"inline-math\" data-math=\"\\int x(2x^2-5)^4\\,dx=x\\times\\frac1{4x}\\times\\frac15(2x^2-5)^5+c=\\frac1{20}(2x^2-5)^5+c\" data-display=\"false\"></span></p>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int2x^3\\sqrt{x^4-3}\\,dx=\\int2x^3(x^4-3)^{1/2}\\,dx=2x^3\\times\\frac1{4x^3}\\times\\tfrac23(x^4-3)^{3/2}+c=\\tfrac13(x^4-3)^{3/2}+c\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q14","number":14,"question":"<p>Find the equation of the curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> given the gradient function is:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=9x^2(3x^3+2)^{-2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=10x^3(2-5x^4)^{5/2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=x\\sqrt[3]{3+4x^2}\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{100x^8}{(2x^9+3)^6}\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=9x^2(3x^3+2)^{-2}\\Rightarrow y=9x^2\\times\\frac1{9x^2}\\times-1\\times(3x^3+2)^{-1}+c\\Rightarrow y=-(3x^3+2)^{-1}+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=10x^3(2-5x^4)^{5/2}\\Rightarrow y=10x^3\\times-\\frac1{20x^3}\\times\\tfrac27(2-5x^4)^{7/2}+c\\Rightarrow y=\\tfrac17(2-5x^4)^{7/2}+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\frac{dy}{dx}=x\\sqrt[3]{3+4x^2}\\Rightarrow\\frac{dy}{dx}=x(3+4x^2)^{1/3}\\Rightarrow y=x\\times\\frac1{8x}\\times\\tfrac34(3+4x^2)^{4/3}+c\\Rightarrow y=\\tfrac3{32}(3+4x^2)^{4/3}+c\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\n\\frac{dy}{dx}=\\frac{100x^8}{(2x^9+3)^6} \\Rightarrow\\frac{dy}{dx}=100x^8(2x^9+3)^{-6}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow y=100x^8\\times\\frac1{18x^8}\\times-\\tfrac15(2x^9+3)^{-5}+c\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\n \\Rightarrow y=-\\tfrac{10}9(2x^9+3)^{-5}+c\n\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q15","number":15,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=5x(5x^2-1)^7\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(0,1)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a(5x^2-1)^b+c\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"c\" data-display=\"false\"></span> are rational numbers, and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> is an integer.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=5x(5x^2-1)^7\\Rightarrow y=5x\\times\\frac1{10x}\\times\\tfrac18(5x^2-1)^8+c\\Rightarrow y=\\tfrac1{16}(5x^2-1)^8+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=0\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=1\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"1=\\tfrac1{16}\\times(5\\times0^2-1)^8+c\\Rightarrow1=\\tfrac1{16}+c\\Rightarrow c=\\tfrac{15}{16}\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=\\frac1{16}(5x^2-1)^8+\\frac{15}{16}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q16","number":16,"question":"<p>The curve <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> has gradient function <span class=\"inline-math\" data-math=\"\\frac{dy}{dx}=\\frac{9x^2}{\\sqrt{27x^3-1}}\" data-display=\"false\"></span> and passes through the point <span class=\"inline-math\" data-math=\"(\\frac13,0)\" data-display=\"false\"></span>. Show that <span class=\"inline-math\" data-math=\"y\" data-display=\"false\"></span> can be written in the form <span class=\"inline-math\" data-math=\"y=a(27x^3-1)^b\" data-display=\"false\"></span>, where <span class=\"inline-math\" data-math=\"a\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"b\" data-display=\"false\"></span> are rational numbers.</p>","steps":["<span class=\"equation\" data-math=\"\\frac{dy}{dx}=\\frac{9x^2}{\\sqrt{27x^3-1}}\\Rightarrow\\frac{dy}{dx}=9x^2(27x^2-1)^{-1/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"y=9x^2\\times\\frac1{81x^2}\\times2(27x^3-1)^{1/2}+c\\Rightarrow y=\\tfrac29(27x^3-1)^{1/2}+c\" data-display=\"true\"></span>","<p>When <span class=\"inline-math\" data-math=\"x=\\frac13\" data-display=\"false\"></span>, <span class=\"inline-math\" data-math=\"y=0\" data-display=\"false\"></span>:</p>","<span class=\"equation\" data-math=\"0=\\tfrac29\\times(27\\times(\\tfrac13)^3-1)^{1/2}+c\\Rightarrow0=0+c\\Rightarrow c=0\" data-display=\"true\"></span>","<p>Therefore <span class=\"inline-math\" data-math=\"y=\\frac29(27x^3-1)^{1/2}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q17","number":17,"question":"<p>Evaluate the following definite integrals:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\int_0^2x(10x^2+1)^4\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_{1/\\sqrt2}^{3/2}x(4x^2-1)^{2/3}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_2^3\\frac{6x^2}{(x^3+2)^2}\\,dx\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\int_0^{1/2}\\frac{800x^3}{(1-x^4)^3}\\,dx\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\int_0^2x(10x^2+1)^4\\,dx =[x\\times\\tfrac1{20x}\\times\\tfrac15(10x^2+1)^5]_0^2=[\\tfrac1{100}(10x^2+1)^5]_0^2\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{100}\\times(10\\times2^2+1)^5)-(\\tfrac1{100}\\times(10\\times0^2+1)^5)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{100}\\times115856201)-(\\tfrac1{100}\\times1)=\\tfrac{115856201}{100}-\\tfrac1{100}=1158562\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\int_{1/\\sqrt2}^{3/2}x(4x^2-1)^{2/3}\\,dx =[x\\times\\tfrac1{8x}\\times\\tfrac35(4x^2-1)^{5/3}]_{1/\\sqrt2}^{3/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[\\tfrac3{40}(4x^2-1)^{5/3}]_{1/\\sqrt2}^{3/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac3{40}\\times(4\\times(\\tfrac32)^2-1)^{5/3})-(\\tfrac3{40}\\times(4\\times(\\tfrac1{\\sqrt2})^2-1)^{5/3})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac3{40}\\times32)-(\\tfrac3{40}\\times1)=(\\tfrac{12}5)-(\\tfrac3{40})=\\tfrac{93}{40}\" data-display=\"true\"></span>","<h3 class=\"part-label\">c)</h3><span class=\"equation\" data-math=\"\\int_2^3\\frac{6x^2}{(x^3+2)^2}\\,dx =\\int_2^36x^2(x^3+2)^{-2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[6x^2\\times\\tfrac1{3x^2}\\times-1\\times(x^3+2)^{-1}]_2^3=[-2(x^3+2)^{-1}]_2^3\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-2\\times(3^3+2)^{-1})-(-2\\times(2^3+2)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-2\\times\\tfrac1{29})-(-2\\times\\tfrac1{10})=(-\\tfrac2{29})-(-\\tfrac15)=\\tfrac{19}{145}\" data-display=\"true\"></span>","<h3 class=\"part-label\">d)</h3><span class=\"equation\" data-math=\"\\int_0^{1/2}\\frac{800x^3}{(1-x^4)^3}\\,dx =\\int_0^{1/2}800x^3(1-x^4)^{-3}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[800x^3\\times-\\tfrac1{4x^3}\\times-\\tfrac12(1-x^4)^{-2}]_0^{1/2}=[100(1-x^4)^{-2}]_0^{1/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(100\\times(1-(\\tfrac12)^4)^{-2})-(100\\times(1-0^4)^{-2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(100\\times\\tfrac{256}{225})-(100\\times1)=(\\tfrac{1024}9)-(100)=\\tfrac{124}9\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q18","number":18,"question":"<p>Find the exact value of:</p><ol class=\"parts\" start=\"1\"><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=0}^198x(1+14x^2)^{5/2}\\delta x\" data-display=\"false\"></span></p></li><li><p><span class=\"inline-math\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=0}^9\\frac{\\sqrt{\\sqrt x+1}}{\\sqrt x}\\delta x\" data-display=\"false\"></span></p></li></ol>","steps":["<h3 class=\"part-label\">a)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=0}^198x(1+14x^2)^{5/2}\\delta x =\\int_0^198x(1+14x^2)^{5/2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[98x\\times\\tfrac1{28x}\\times\\tfrac27(1+14x^2)^{7/2}]_0^1=[(1+14x^2)^{7/2}]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =((1+14\\times1^2)^{7/2})-((1+14\\times0^2)^{7/2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(15^{7/2})-(1)=3375\\sqrt{15}-1\" data-display=\"true\"></span>","<h3 class=\"part-label\">b)</h3><span class=\"equation\" data-math=\"\\lim_{\\delta x\\to0}\\sum_{x=0}^9\\frac{\\sqrt{\\sqrt x+1}}{\\sqrt x}\\delta x =\\int_0^9x^{-1/2}(x^{1/2}+1)^{1/2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[x^{-1/2}\\times\\tfrac1{\\frac12x^{-1/2}}\\times\\tfrac23(x^{1/2}+1)^{3/2}]_0^9=[\\tfrac43(x^{1/2}+1)^{3/2}]_0^9\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac43\\times(9^{1/2}+1)^{3/2})-(\\tfrac43\\times(0^{1/2}+1)^{3/2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac43\\times8)-(\\tfrac43\\times1)=(\\tfrac{32}3)-(\\tfrac43)=\\tfrac{28}3\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q19","number":19,"question":"<p>The diagram below shows the curve with equation <span class=\"inline-math\" data-math=\"y=\\frac12x(x^2-1)^5\" data-display=\"false\"></span>. Find the exact value of the shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.33/questions/assets/diagrams/233-q19.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\\int_{-1}^0\\tfrac12x(x^2-1)^5\\,dx =[\\tfrac12x\\times\\tfrac1{2x}\\times\\tfrac16(x^2-1)^6]_{-1}^0=[\\tfrac1{24}(x^2-1)^6]_{-1}^0\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{24}\\times(0^2-1)^6)-(\\tfrac1{24}\\times((-1)^2-1)^6)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{24}\\times1)-(\\tfrac1{24}\\times0)=(\\tfrac1{24})-(0)=\\tfrac1{24}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\int_0^1\\tfrac12x(x^2-1)^5\\,dx =[\\tfrac1{24}(x^2-1)^6]_0^1\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{24}\\times(1^2-1)^6)-(\\tfrac1{24}\\times(0^2-1)^6)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(\\tfrac1{24}\\times0)-(\\tfrac1{24}\\times1)=(0)-(\\tfrac1{24})=-\\tfrac1{24}\" data-display=\"true\"></span>","<p>Therefore Area <span class=\"inline-math\" data-math=\"=\\frac1{24}-(-\\frac1{24})=\\frac1{12}\" data-display=\"false\"></span>.</p>"]},{"id":"smq-year2-2.33-q20","number":20,"question":"<p>The diagram below shows the curves <span class=\"inline-math\" data-math=\"y=\\frac2{(x+1)^2}\" data-display=\"false\"></span> and <span class=\"inline-math\" data-math=\"y=\\frac2{(2x+1)^2}\" data-display=\"false\"></span>. Find the exact shaded area between the two curves.</p><figure class=\"diagram\"><img src=\"assets/smq-2.33/questions/assets/diagrams/233-q20.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\\int_0^{1/2}\\frac2{(x+1)^2}\\,dx -\\int_0^{1/2}\\frac2{(2x+1)^2}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\int_0^{1/2}(\\tfrac2{(x+1)^2}-\\tfrac2{(2x+1)^2})\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =\\int_0^{1/2}(2(x+1)^{-2}-2(2x+1)^{-2})\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[2\\times-1\\times(x+1)^{-1}-2\\times\\tfrac12\\times-1\\times(2x+1)^{-1}]_0^{1/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[-2(x+1)^{-1}+(2x+1)^{-1}]_0^{1/2}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-2\\times(\\tfrac12+1)^{-1}+(2\\times\\tfrac12+1)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" \\quad-(-2\\times(0+1)^{-1}+(2\\times0+1)^{-1})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-2\\times\\tfrac23+\\tfrac12)-(-2\\times1+1)=(-\\tfrac56)-(-1)=\\tfrac16\" data-display=\"true\"></span>"]},{"id":"smq-year2-2.33-q21","number":21,"question":"<p>The diagram below shows the curve with equation <span class=\"inline-math\" data-math=\"y=\\frac{12x-9x^2}{(2x^2-x^3+1)^3}\" data-display=\"false\"></span>. Find the exact value of the shaded area.</p><figure class=\"diagram\"><img src=\"assets/smq-2.33/questions/assets/diagrams/233-q21.png\" alt=\"Original mathematical diagram\" loading=\"lazy\"></figure>","steps":["<span class=\"equation\" data-math=\"\\frac{12x-9x^2}{(2x^2-x^3+1)^3}=0\\Rightarrow12x-9x^2=0\\Rightarrow4x-3x^2=0\\Rightarrow x(4-3x)=0\\Rightarrow x=0\\text{ or }x=\\tfrac43\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\"\\int_0^{4/3}\\frac{12x-9x^2}{(2x^2-x^3+1)^3}\\,dx =\\int_0^{4/3}(12x-9x^2)(2x^2-x^3+1)^{-3}\\,dx\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[(12x-9x^2)\\times\\tfrac1{4x-3x^2}\\times-\\tfrac12(2x^2-x^3+1)^{-2}]_0^{4/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[-\\tfrac{12x-9x^2}{8x-6x^2}(2x^2-x^3+1)^{-2}]_0^{4/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[-\\tfrac{3(4x-3x^2)}{2(4x-3x^2)}(2x^2-x^3+1)^{-2}]_0^{4/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =[-\\tfrac32(2x^2-x^3+1)^{-2}]_0^{4/3}\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-\\tfrac32\\times(2\\times(\\tfrac43)^2-(\\tfrac43)^3+1)^{-2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" \\quad-(-\\tfrac32\\times(2\\times0^2-0^3+1)^{-2})\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-\\tfrac32\\times\\tfrac{729}{3481})-(-\\tfrac32\\times1)\" data-display=\"true\"></span>","<span class=\"equation\" data-math=\" =(-\\tfrac{2187}{6962})-(-\\tfrac32)=\\tfrac{6315}{3481}\" data-display=\"true\"></span>"]}]