{"chapter":8,"deckId":"mech-y1-c08-full","source":"/Users/grigua/Library/CloudStorage/OneDrive-MarlboroughCollege/01. Resources/_A LEVEL/A-Level/Mech 1/MechYr1-Chp8-Introduction.pptx","sourceSha256":"e6dd24bab4237d297197316074988992df352b2abe13e9d9f3babed3dade0c1d","width":960,"height":720,"slides":[{"id":"mech-y1-c08-full-s001","chapter":8,"sourceSlide":1,"title":"Modelling in Mechanics","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":185},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Mechanics Year 1 · Chapter 8}\\par \\textbf{Modelling in Mechanics}\\par Forces and motion · Modelling assumptions · SI units · Scalars and vectors","fontSize":40,"hangingIndent":24,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":[],"headerShapes":[],"titlePageCandidate":true,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":[],"nextActionOrder":[],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":1}},{"id":"mech-y1-c08-full-s002","chapter":8,"sourceSlide":2,"title":"Overview of Mechanics","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":529},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Forces}\\par Weight acts towards Earth. A normal reaction acts perpendicular to a surface. Friction opposes sliding or its tendency. Tension acts along a taut string.\\par In equilibrium, resultant force is zero. For a particle of constant mass, Newton’s second law connects force and motion: \\[\\mathbf F=m\\mathbf a.\\]","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":812,"y":35,"w":748,"h":698},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Motion}\\par Gradient of a displacement–time graph gives velocity. Gradient of a velocity–time graph gives acceleration. Signed area under velocity–time gives displacement; area under speed–time gives distance.\\par For constant acceleration: \\[v=u+at,\\quad s=ut+\\tfrac12at^2\\] \\[v^2=u^2+2as,\\quad s=\\tfrac12(u+v)t.\\] For variable acceleration: \\[v=\\frac{ds}{dt},\\qquad a=\\frac{dv}{dt}.\\]","fontSize":40,"hangingIndent":24,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":[],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":[],"nextActionOrder":[],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":2}},{"id":"mech-y1-c08-full-s003","chapter":8,"sourceSlide":3,"title":"Modelling Assumptions","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":572},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Common modelling assumptions}\\par \\textbf{Particle:} dimensions are negligible; mass is concentrated at a point. Rotation is ignored. Air resistance, when neglected, is a separate assumption.\\par \\textbf{Smooth surface:} no friction. A rough surface can exert friction.\\par \\textbf{Light, smooth pulley:} negligible mass and no friction; an ideal taut light string has equal tension on both sides.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":812,"y":35,"w":748,"h":679},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Inextensible string:} does not stretch. In a simple fixed-pulley system, connected particles have equal acceleration magnitudes while the string remains taut.\\par \\textbf{Rod:} a rigid body whose transverse dimensions are negligible compared with its length.\\par \\textbf{Peg or support:} fixed; dimensions may be neglected. Whether it is smooth or rough depends on the model.\\par Always state the assumption that justifies a simplification.","fontSize":40,"hangingIndent":24,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":[],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":[],"nextActionOrder":[],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":3}},{"id":"mech-y1-c08-full-s004","chapter":8,"sourceSlide":4,"title":"SI units","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":421},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{SI units}\\[\\begin{array}{lll}\\text{Quantity}&\\text{Unit}&\\text{Symbol}\\\\\\text{Mass}&\\text{kilogram}&\\mathrm{kg}\\\\\\text{Displacement}&\\text{metre}&\\mathrm m\\\\\\text{Time}&\\text{second}&\\mathrm s\\\\\\text{Velocity}&\\text{metres per second}&\\mathrm{m\\,s^{-1}}\\\\\\text{Acceleration}&\\text{metres per second squared}&\\mathrm{m\\,s^{-2}}\\\\\\text{Force}&\\text{newton}&\\mathrm N\\end{array}\\]","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":40,"y":562,"w":1520,"h":240},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Newton’s second law gives \\[1\\,\\mathrm N=1\\,\\mathrm{kg\\,m\\,s^{-2}}.\\] Convert measurements into compatible units before substituting into an equation. Mass is measured in kilograms; weight is a force measured in newtons.","fontSize":40,"hangingIndent":24,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":[],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":[],"nextActionOrder":[],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":4}},{"id":"mech-y1-c08-full-s005","chapter":8,"sourceSlide":5,"title":"Vectors ↔ Scalars","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":515},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Scalars and vectors}\\par A scalar has magnitude only. Distance and speed are non-negative; mass and time are scalar quantities.\\par A vector has magnitude and direction. Displacement, velocity, acceleration and force are vectors.\\par A displacement of \\(3\\mathbf i+4\\mathbf j\\) m has magnitude \\(5\\) m.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":812,"y":35,"w":748,"h":168},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"A particle moves 3 m opposite to the chosen positive direction. State its distance travelled and its displacement.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-3","kind":"sp","box":{"x":826,"y":233,"w":720,"h":230},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Distance \\(=3\\) m; displacement \\(=-3\\) m.\\par The sign specifies direction. A one-dimensional vector can be written as a signed number.","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":812,"y":219,"w":748,"h":587},"cover":true,"coverLabel":"Distance and displacement","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":["answer-native-3"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-3"],"nextActionOrder":["answer-native-3"],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":5}},{"id":"mech-y1-c08-full-s006","chapter":8,"sourceSlide":6,"title":"Vectors ↔ Scalars","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":114},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"1. A displacement has magnitude 5 m and is directed \\(60^\\circ\\) above the positive horizontal axis. Find its components.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":179,"w":1492,"h":140},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\mathbf s=5\\cos60^\\circ\\mathbf i+5\\sin60^\\circ\\mathbf j\\] \\[=(2.5\\mathbf i+4.33\\mathbf j)\\text{ m}\\quad(3\\text{ s.f.}).\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":165,"w":1520,"h":168},"cover":true,"coverLabel":"1","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":40,"y":369,"w":1520,"h":60},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"2. Velocity is \\((5\\mathbf i-12\\mathbf j)\\,\\mathrm{m\\,s^{-1}}\\). Find the speed.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":54,"y":459,"w":1492,"h":82},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[|\\mathbf v|=\\sqrt{5^2+(-12)^2}=13\\,\\mathrm{m\\,s^{-1}}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":40,"y":445,"w":1520,"h":110},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-5","kind":"sp","box":{"x":40,"y":591,"w":1520,"h":60},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"3. A force of 8 N acts \\(45^\\circ\\) below the positive horizontal axis. Find its vector form.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-6","kind":"sp","box":{"x":54,"y":681,"w":1492,"h":142},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\mathbf F=(8\\cos45^\\circ)\\mathbf i-(8\\sin45^\\circ)\\mathbf j\\] \\[=4\\sqrt2\\mathbf i-4\\sqrt2\\mathbf j\\text{ N}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-6"},{"id":"answer-native-6","kind":"sp","box":{"x":40,"y":667,"w":1520,"h":170},"cover":true,"coverLabel":"3","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":["answer-native-2","answer-native-4","answer-native-6"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":893,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4","answer-native-6"],"nextActionOrder":["answer-native-2","answer-native-4","answer-native-6"],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":6}},{"id":"mech-y1-c08-full-s007","chapter":8,"sourceSlide":7,"title":"Further Examples","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":114},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"1. A force of 6 N acts downwards and to the left, at \\(60^\\circ\\) to the downward vertical. Find its components.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":179,"w":1492,"h":142},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\mathbf F=-6\\sin60^\\circ\\mathbf i-6\\cos60^\\circ\\mathbf j\\] \\[=-3\\sqrt3\\mathbf i-3\\mathbf j\\text{ N}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":165,"w":1520,"h":170},"cover":true,"coverLabel":"1","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":40,"y":371,"w":1520,"h":60},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"2. Find the magnitude of acceleration \\((6\\mathbf i-8\\mathbf j)\\,\\mathrm{m\\,s^{-2}}\\).","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":54,"y":461,"w":1492,"h":82},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[|\\mathbf a|=\\sqrt{6^2+(-8)^2}=10\\,\\mathrm{m\\,s^{-2}}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":40,"y":447,"w":1520,"h":110},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-5","kind":"sp","box":{"x":40,"y":593,"w":1520,"h":114},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"3. A displacement of 4 m is directed \\(30^\\circ\\) above the negative horizontal axis. Write it using unit vectors.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-6","kind":"sp","box":{"x":54,"y":737,"w":1492,"h":142},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\mathbf s=-4\\cos30^\\circ\\mathbf i+4\\sin30^\\circ\\mathbf j\\] \\[=-2\\sqrt3\\mathbf i+2\\mathbf j\\text{ m}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-6"},{"id":"answer-native-6","kind":"sp","box":{"x":40,"y":723,"w":1520,"h":170},"cover":true,"coverLabel":"3","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":["answer-native-2","answer-native-4","answer-native-6"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":949,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4","answer-native-6"],"nextActionOrder":["answer-native-2","answer-native-4","answer-native-6"],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX draft; explicit question/answer objects","sourceSlide":7}},{"id":"mech-y1-c08-full-s008","chapter":8,"sourceSlide":8,"title":"Test Your Understanding","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":318},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"1. A man walks from \\(A\\) to \\(B\\), then to \\(C\\). His displacements are \\(\\overrightarrow{AB}=(6\\mathbf i+4\\mathbf j)\\) m and \\(\\overrightarrow{BC}=(5\\mathbf i-12\\mathbf j)\\) m.\\par a. Find the magnitude of \\(\\overrightarrow{AC}\\).\\par b. Find the total distance walked.","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":383,"w":720,"h":163},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\overrightarrow{AC}=11\\mathbf i-8\\mathbf j\\text{ m}\\] \\[|\\overrightarrow{AC}|=\\sqrt{185}=13.6\\text{ m (3 s.f.)}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":369,"w":748,"h":213.5},"cover":true,"coverLabel":"1a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":54,"y":620.5,"w":720,"h":149},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[d=\\sqrt{6^2+4^2}+\\sqrt{5^2+12^2}\\] \\[=\\sqrt{52}+13=20.2\\text{ m (3 s.f.)}.\\]","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":40,"y":606.5,"w":748,"h":199.5},"cover":true,"coverLabel":"1b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-4","kind":"sp","box":{"x":812,"y":35,"w":748,"h":168},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"2. A car’s velocity is \\((3\\mathbf i-\\mathbf j)\\,\\mathrm{m\\,s^{-1}}\\). Find the angle its direction makes with \\(\\mathbf i\\).","fontSize":40,"hangingIndent":24,"color":"#151515"}},{"id":"native-5","kind":"sp","box":{"x":826,"y":233,"w":720,"h":188},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\theta=\\tan^{-1}(1/3)=18.4^\\circ\\quad(3\\text{ s.f.}).\\] The direction is below the positive horizontal axis.","fontSize":40,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-5"},{"id":"answer-native-5","kind":"sp","box":{"x":812,"y":219,"w":748,"h":587},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"mech-y1-c08-full","courseId":"mech-y1","variant":"full","covers":["answer-native-2","answer-native-3","answer-native-5"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","background":"#ffffff","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-3","answer-native-5"],"nextActionOrder":["answer-native-2","answer-native-3","answer-native-5"],"afterAnswerActions":{},