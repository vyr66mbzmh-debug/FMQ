"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{2.}\\quad \\(3,\\ 6,\\ 12,\\ 24,\\ 48,\\ldots\\)\\par Name this type of sequence and describe the change between consecutive terms.","fontSize":32,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":826,"y":208,"w":720,"h":150},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Geometric sequence}\\par Multiply by the same number each time: \\(\\times2\\).\\par The \\textbf{common ratio} is \\(r=2\\).","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":812,"y":194,"w":748,"h":178},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-5","kind":"sp","box":{"x":40,"y":408,"w":748,"h":100},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{3.}\\quad \\(1,\\ 1,\\ 2,\\ 3,\\ 5,\\ 8,\\ldots\\)\\par How is each new term generated?","fontSize":32,"color":"#151515"}},{"id":"native-6","kind":"sp","box":{"x":54,"y":538,"w":720,"h":230},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"This is the \\textbf{Fibonacci sequence}. After the first two terms, each term is the sum of the preceding two.\\par This is a \\textbf{recurrence relation}: new terms are defined using earlier terms.","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-6"},{"id":"answer-native-6","kind":"sp","box":{"x":40,"y":524,"w":748,"h":258},"cover":true,"coverLabel":"3","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-7","kind":"sp","box":{"x":812,"y":408,"w":748,"h":235},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Definition}\\par An arithmetic sequence has a constant difference between consecutive terms.\\par Geometric sequences and recurrence relations will be explored later in this chapter.","fontSize":32,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-2","answer-native-4","answer-native-6"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4","answer-native-6"],"nextActionOrder":["answer-native-2","answer-native-4","answer-native-6"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":3}},{"id":"pure-y2-c03-full-s004","chapter":3,"sourceSlide":4,"title":"The fundamentals of sequences","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":157},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Sequence notation}\\par Consider\\[2,\\ 5,\\ 8,\\ 11,\\ 14,\\ldots\\]","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":40,"y":220,"w":748,"h":50},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"What does \\(n\\) represent?","fontSize":32,"color":"#151515"}},{"id":"native-3","kind":"sp","box":{"x":54,"y":300,"w":720,"h":100},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(n\\) is the \\textbf{position} of a term in the sequence.\\par Positions start at \\(n=1\\).","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":40,"y":286,"w":748,"h":128},"cover":true,"coverLabel":"1","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-4","kind":"sp","box":{"x":812,"y":220,"w":748,"h":51},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"What does \\(u_n\\) represent?","fontSize":32,"color":"#151515"}},{"id":"native-5","kind":"sp","box":{"x":826,"y":301,"w":720,"h":101},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(u_n\\) is the \\textbf{value of the term} at position \\(n\\).\\par For example, \\(u_3\\) means the third term.","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-5"},{"id":"answer-native-5","kind":"sp","box":{"x":812,"y":287,"w":748,"h":129},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-6","kind":"sp","box":{"x":40,"y":452,"w":1520,"h":50},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"For the value \\(8\\), state its position and its term notation.","fontSize":32,"color":"#151515"}},{"id":"native-7","kind":"sp","box":{"x":54,"y":532,"w":1492,"h":109},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[n=3,\\qquad u_3=8.\\]\\par Do not confuse the position 3 with the value 8.","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-7"},{"id":"answer-native-7","kind":"sp","box":{"x":40,"y":518,"w":1520,"h":137},"cover":true,"coverLabel":"3","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-3","answer-native-5","answer-native-7"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-3","answer-native-5","answer-native-7"],"nextActionOrder":["answer-native-3","answer-native-5","answer-native-7"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":4}},{"id":"pure-y2-c03-full-s005","chapter":3,"sourceSlide":5,"title":"nth term of an arithmetic sequence","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":490.6666666666667,"h":538},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{The general term}\\par Let \\(a\\) be the first term and \\(d\\) the common difference.\\par Moving to position \\(n\\) takes \\(n-1\\) steps.\\[\\begin{aligned}u_1&=a,\\\\u_2&=a+d,\\\\u_3&=a+2d.\\end{aligned}\\]\\[\\boxed{u_n=a+(n-1)d}\\]\\par Write down \\(a\\), \\(d\\) and the relevant position before substituting.","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":554.6666666666667,"y":35,"w":490.6666666666667,"h":197},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Example 1}\\par \\(u_n=55-2n\\).\\par (a) Find the first three terms.\\par (b) Find the first negative term.","fontSize":32,"color":"#151515"}},{"id":"native-3","kind":"sp","box":{"x":568.6666666666667,"y":262,"w":462.6666666666667,"h":66},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[u_1=53,\\quad u_2=51,\\quad u_3=49.\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":554.6666666666667,"y":248,"w":490.6666666666667,"h":94},"cover":true,"coverLabel":"1a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-4","kind":"sp","box":{"x":568.6666666666667,"y":380,"w":462.6666666666667,"h":212},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[55-2n<0\\Rightarrow n>27.5.\\]\\par The first integer position is \\(n=28\\):\\[u_{28}=55-56=-1.\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":554.6666666666667,"y":366,"w":490.6666666666667,"h":240},"cover":true,"coverLabel":"1b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-5","kind":"sp","box":{"x":1069.3333333333335,"y":35,"w":490.6666666666667,"h":241},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Example 2}\\par Find the general term of each sequence.\\par (a) \\(6,20,34,48,62,\\ldots\\)\\par (b) \\(101,94,87,80,73,\\ldots\\)","fontSize":32,"color":"#151515"}},{"id":"native-6","kind":"sp","box":{"x":1083.3333333333335,"y":306,"w":462.6666666666667,"h":109},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(a=6\\), \\(d=14\\):\\[u_n=6+14(n-1)=14n-8.\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-6"},{"id":"answer-native-6","kind":"sp","box":{"x":1069.3333333333335,"y":292,"w":490.6666666666667,"h":137},"cover":true,"coverLabel":"2a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-7","kind":"sp","box":{"x":1083.3333333333335,"y":467,"w":462.6666666666667,"h":109},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(a=101\\), \\(d=-7\\):\\[u_n=101-7(n-1)=108-7n.\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-7"},{"id":"answer-native-7","kind":"sp","box":{"x":1069.3333333333335,"y":453,"w":490.6666666666667,"h":137},"cover":true,"coverLabel":"2b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-3","answer-native-4","answer-native-6","answer-native-7"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-3","answer-native-4","answer-native-6","answer-native-7"],"nextActionOrder":["answer-native-3","answer-native-4","answer-native-6","answer-native-7"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":5}},{"id":"pure-y2-c03-full-s006","chapter":3,"sourceSlide":6,"title":"Further Examples","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":144},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{1. Find the constants}\\par A sequence is generated by \\(u_n=an+b\\), where \\(a\\) and \\(b\\) are constants. Given \\(u_3=5\\) and \\(u_8=20\\), find \\(a\\) and \\(b\\).","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":209,"w":720,"h":314},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\begin{aligned}3a+b&=5,\\\\8a+b&=20.\\end{aligned}\\]\\par Subtracting gives \\(5a=15\\), so \\(a=3\\).\\par Then \\(3(3)+b=5\\), giving \\(b=-4\\).\\[\\boxed{u_n=3n-4}\\]\\par Here \\(a\\) is the coefficient of \\(n\\), not the first term.","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":195,"w":748,"h":342},"cover":true,"coverLabel":"1","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":812,"y":35,"w":748,"h":143},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{2. Equal differences}\\par For which values of \\(x\\) do \\(-8\\), \\(x^2\\) and \\(17x\\) form the first three terms of an arithmetic sequence?","fontSize":32,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":826,"y":208,"w":720,"h":317},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Consecutive differences must be equal:\\[\\begin{aligned}x^2-(-8)&=17x-x^2,\\\\2x^2-17x+8&=0,\\\\(2x-1)(x-8)&=0.\\end{aligned}\\]\\[\\boxed{x=\\tfrac12\\ \\text{or}\\ x=8}\\]\\par Each value gives equal differences.","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":812,"y":194,"w":748,"h":345},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-2","answer-native-4"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4"],"nextActionOrder":["answer-native-2","answer-native-4"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":6,"correction":"Use 3a+b=5 and 8a+b=20 for the stated formula an+b; source working mixed a,d notation."}},{"id":"pure-y2-c03-full-s007","chapter":3,"sourceSlide":7,"title":"Test Your Understanding","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":279},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{Edexcel C1 May 2014(R), Q10}\\par Xin has a 14-day training schedule. She runs for \\(A\\) minutes on day 1 and increases her running time by \\(d+1\\) minutes each day, where \\(A\\) and \\(d\\) are constants.\\par \\textbf{(a)} Show that on day 14 she runs for \\(A+13d+13\\) minutes. (2 marks)","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":344,"w":720,"h":109},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"There are 13 increases between days 1 and 14:\\[X_{14}=A+13(d+1)=A+13d+13.\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":330,"w":748,"h":137},"cover":true,"coverLabel":"a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":812,"y":35,"w":748,"h":229},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Yi also has a 14-day schedule. She runs for \\(A-13\\) minutes on day 1 and increases her running time by \\(2d-1\\) minutes each day.\\par \\textbf{(b)} Yi and Xin run for the same time on day 14. Find \\(d\\). (3 marks)","fontSize":32,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":826,"y":294,"w":720,"h":309},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\begin{aligned}Y_{14}&=(A-13)+13(2d-1)\\\\&=A+26d-26.\\end{aligned}\\]\\par Equating the two times:\\[\\begin{aligned}A+13d+13&=A+26d-26,\\\\39&=13d,\\\\d&=3.\\end{aligned}\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":812,"y":280,"w":748,"h":337},"cover":true,"coverLabel":"b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-2","answer-native-4"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4"],"nextActionOrder":["answer-native-2","answer-native-4"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":7}},{"id":"pure-y2-c03-full-s008","chapter":3,"sourceSlide":8,"title":"Exercise 3A, Y2 pages 61-62","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":94},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{4.} The first term of an arithmetic sequence is 14. The fourth term is 32. Find the common difference.","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":159,"w":720,"h":186},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\begin{aligned}u_4&=a+3d,\\\\32&=14+3d,\\\\d&=\\frac{32-14}{3}=6.\\end{aligned}\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":145,"w":748,"h":214},"cover":true,"coverLabel":"4","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":812,"y":35,"w":748,"h":95},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{5.} A sequence is generated by \\(u_n=pn+q\\). Given \\(u_6=9\\) and \\(u_9=11\\), find \\(p\\) and \\(q\\).","fontSize":32,"color":"#151515"}},{"id":"native-4","kind":"sp","box":{"x":826,"y":160,"w":720,"h":370},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\begin{aligned}6p+q&=9,\\\\9p+q&=11.\\end{aligned}\\]\\par Subtracting gives \\(3p=2\\), so \\(p=\\tfrac23\\).\\par Substitute into the first equation:\\[6\\left(\\frac23\\right)+q=9\\Rightarrow q=5.\\]\\[\\boxed{p=\\tfrac23,\\quad q=5}\\]","fontSize":32,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":812,"y":146,"w":748,"h":398},"cover":true,"coverLabel":"5","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"pure-y2-c03-full","courseId":"pure-y2","variant":"full","covers":["answer-native-2","answer-native-4"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-4"],"nextActionOrder":["answer-native-2","answer-native-4"],"afterAnswerActions":{},"sourceMapping":{"method":"Source-checked native text and LaTeX; explicit question/answer objects","sourceSlide":8}},{"id":"pure-y2-c03-full-s009","chapter":3,"sourceSlide":9,"title":"Exercise 3A, Y2 pages 61-62","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":490.6666666666667,"h":137},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\textbf{6.} An arithmetic sequence has \\(u_3=30\\) and \\(u_9=9\\). Find its first negative term.","fontSize":32,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":202,"w":462.6666666666667,"h":342},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[d=\\frac{9-30}{9